                                       (TPM2_Created_C_TPM( TPM, Host, pke ) @ #t28)) ∧
                                      (Host_Received_C_TPM( TPM, Host, pke ) @ #t29)) ∧
                                     (TPM2_Signed_C_TPM( TPM, Host, pke ) @ #t30)) ∧
                                    (Host_Sends_Sigma( TPM, Host, pke, sigma ) @ #t31)) ∧
                                   (#t01 < #t02)) ∧
                                  (#t02 < #t04)) ∧
                                 (#t03 < #t04)) ∧
                                (#t04 < #t05)) ∧
                               (#t05 < #t06)) ∧
                              (#t06 < #t07)) ∧
                             (#t07 < #t08)) ∧
                            (#t08 < #t09)) ∧
                           (#t09 < #t10)) ∧
                          (#t10 < #t11)) ∧
                         (#t11 < #t12)) ∧
                        (#t12 < #t13)) ∧
                       (#t13 < #t14)) ∧
                      (#t14 < #t15)) ∧
                     (#t15 < #t16)) ∧
                    (#t16 < #t17)) ∧
                   (#t17 < #t18)) ∧
                  (#t18 < #t19)) ∧
                 (#t19 < #t20)) ∧
                (#t20 < #t21)) ∧
               (#t21 < #t22)) ∧
              (#t22 < #t23)) ∧
             (#t23 < #t24)) ∧
            (#t24 < #t25)) ∧
           (#t25 < #t26)) ∧
          (#t26 < #t27)) ∧
         (#t27 < #t28)) ∧
        (#t28 < #t29)) ∧
       (#t29 < #t30)) ∧
      (#t30 < #t31)) ∧
     (∀ event #i #j.
       ((OnlyOnce( event ) @ #i) ∧ (OnlyOnce( event ) @ #j)) ⇒ (#i = #j))) ∧
    (∀ event #i #j.
      ((SignOnlyOnce( event ) @ #i) ∧ (SignOnlyOnce( event ) @ #j)) ⇒
      (#i = #j))"
/*
guarded formula characterizing all satisfying traces:
"∃ TPM Host pke qpd #t01 #t02 #t03 #t04 #t05 #t06 #t07 #t08 #t09 #t10
   #t11 #t12 #t13 #t14 #t15 #t16 #t17 #t18 #t19 #t20 #t21 #t22 #t23 bsn #t24
   #t25 #t26 #t27 #t28 #t29 #t30 #t31 sigma.
  (Issuer_Init( 'Issuer' ) @ #t01) ∧
  (Host_Init( Host ) @ #t02) ∧
  (TPM_Init( TPM ) @ #t03) ∧
  (Bind( TPM, Host, 'Issuer' ) @ #t04) ∧
  (TPM2_EK_Created( TPM, Host, pke ) @ #t05) ∧
  (Store_EK( TPM, Host ) @ #t06) ∧
  (TPM2_DAA_Created( TPM, Host ) @ #t07) ∧
  (Store_DAA( TPM, Host ) @ #t08) ∧
  (IssuerReceivedKeys( 'Issuer', pke, qpd ) @ #t09) ∧
  (Passthrough_ActivateCred( TPM, Host ) @ #t10) ∧
  (CurlyK_recomputed( TPM, Host ) @ #t11) ∧
  (Received_CurlyK( TPM, Host ) @ #t12) ∧
  (TPM2_Commited( TPM, Host ) @ #t13) ∧
  (Host_Created_p( TPM, Host ) @ #t14) ∧
  (TPM2_Created_P_TPM( TPM, Host ) @ #t15) ∧
  (Host_Received_P_TPM( TPM, Host ) @ #t16) ∧
  (TPM2_Signed_P_TPM( TPM, Host ) @ #t17) ∧
  (Host_Received_Signed_P_TPM( TPM, Host ) @ #t18) ∧
  (Issuer_VerifyChallengeIssueCredentials( 'Issuer', pke ) @ #t19) ∧
  (Passthrough_ActivateCred2( TPM, Host ) @ #t20) ∧
  (CurlyK2_recomputed( TPM, Host ) @ #t21) ∧
  (JoinCompleted( TPM, Host, pke ) @ #t22) ∧
  (RandomisedCredentials( TPM, Host, pke ) @ #t23) ∧
  (SetBasename( TPM, Host, pke, bsn ) @ #t24) ∧
  (ProcessRandomisedCredentials( TPM, Host, pke, bsn ) @ #t25) ∧
  (TPMCommitRandomised( TPM, Host, pke ) @ #t26) ∧
  (GeneratedMessageForSigning( TPM, Host, pke ) @ #t27) ∧
  (TPM2_Created_C_TPM( TPM, Host, pke ) @ #t28) ∧
  (Host_Received_C_TPM( TPM, Host, pke ) @ #t29) ∧
  (TPM2_Signed_C_TPM( TPM, Host, pke ) @ #t30) ∧
  (Host_Sends_Sigma( TPM, Host, pke, sigma ) @ #t31)
 ∧
  (∀ RevealEvent ENTITY #k1.
    (KeyReveal( RevealEvent, ENTITY ) @ #k1) ⇒ ⊥) ∧
  (#t01 < #t02) ∧
  (#t02 < #t04) ∧
  (#t03 < #t04) ∧
  (#t04 < #t05) ∧
  (#t05 < #t06) ∧
  (#t06 < #t07) ∧
  (#t07 < #t08) ∧
  (#t08 < #t09) ∧
  (#t09 < #t10) ∧
  (#t10 < #t11) ∧
  (#t11 < #t12) ∧
  (#t12 < #t13) ∧
  (#t13 < #t14) ∧
  (#t14 < #t15) ∧
  (#t15 < #t16) ∧
  (#t16 < #t17) ∧
  (#t17 < #t18) ∧
  (#t18 < #t19) ∧
  (#t19 < #t20) ∧
  (#t20 < #t21) ∧
  (#t21 < #t22) ∧
  (#t22 < #t23) ∧
  (#t23 < #t24) ∧
  (#t24 < #t25) ∧
  (#t25 < #t26) ∧
  (#t26 < #t27) ∧
  (#t27 < #t28) ∧
  (#t28 < #t29) ∧
  (#t29 < #t30) ∧
  (#t30 < #t31) ∧
  (∀ event #i #j.
    (OnlyOnce( event ) @ #i) ∧ (OnlyOnce( event ) @ #j) ⇒ #i = #j) ∧
  (∀ event #i #j.
    (SignOnlyOnce( event ) @ #i) ∧ (SignOnlyOnce( event ) @ #j) ⇒ #i = #j)"
