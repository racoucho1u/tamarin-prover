rule (modulo E) Signatures_Linked:
   [
   !SignatureVerified( $V,
                       <bsn_in1, R1, S1, T1, W1, J1, K1, h2_host1, small_s1, n_M1, msg1, 
                        'TPM_Signature_Of_m'>
   ),
   !SignatureVerified( $V,
                       <bsn_in2, R2, S2, T2, W2, J2, K2, h2_host2, small_s2, n_M2, msg2, 
                        'TPM_Signature_Of_m'>
   )
   ]
  --[
  Eq( bsn_in1, bsn_in2 ), Eq( J1, J2 ), Eq( K1, K2 ),
  LinkedSignatures( bsn_in1,
                    <bsn_in1, R1, S1, T1, W1, J1, K1, h2_host1, small_s1, n_M1, msg1, 
                     'TPM_Signature_Of_m'>,
                    <bsn_in2, R2, S2, T2, W2, J2, K2, h2_host2, small_s2, n_M2, msg2, 
                     'TPM_Signature_Of_m'>
  )
  ]->
   [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Signatures_NotLinked:
   [
   !SignatureVerified( $V,
                       <bsn_in1, R1, S1, T1, W1, J1, K1, h2_host1, small_s1, n_M1, msg1, 
                        'TPM_Signature_Of_m'>
   ),
   !SignatureVerified( $V,
                       <bsn_in2, R2, S2, T2, W2, J2, K2, h2_host2, small_s2, n_M2, msg2, 
                        'TPM_Signature_Of_m'>
   )
   ]
  --[
  NotLinked( J1, J2, K1, K2 ),
  UnlinkedSignatures( <bsn_in1, R1, S1, T1, W1, J1, K1, h2_host1, 
                       small_s1, n_M1, msg1, 'TPM_Signature_Of_m'>,
                      <bsn_in2, R2, S2, T2, W2, J2, K2, h2_host2, small_s2, n_M2, msg2, 
                       'TPM_Signature_Of_m'>
  )
  ]->
   [ ]

  /* has exactly the trivial AC variant */

lemma auto_bind_restriction:
  all-traces
  "∀ Ent1 Ent2 Ent3 #i.
    (Bind( Ent1, Ent2, Ent3 ) @ #i) ⇒
    (((¬(Ent1 = Ent2)) ∧ (¬(Ent1 = Ent3))) ∧ (¬(Ent2 = Ent3)))"
/*
guarded formula characterizing all counter-examples:
"∃ Ent1 Ent2 Ent3 #i.
  (Bind( Ent1, Ent2, Ent3 ) @ #i)
 ∧
  ((Ent1 = Ent2) ∨ (Ent1 = Ent3) ∨ (Ent2 = Ent3))"
*/
by sorry

lemma auto_restriction_one_host_per_tpm:
  all-traces
  "∀ TPM Host1 Host2 #i #j.
    ((Bind( Host1, TPM, 'Issuer' ) @ #i) ∧
     (Bind( Host2, TPM, 'Issuer' ) @ #j)) ⇒
    (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ TPM Host1 Host2 #i #j.
  (Bind( Host1, TPM, 'Issuer' ) @ #i) ∧ (Bind( Host2, TPM, 'Issuer' ) @ #j)
 ∧
  ¬(#i = #j)"
*/
by sorry

