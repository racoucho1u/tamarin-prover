rule (modulo E) Host_CredentialsReveal:
   [ Host_Org_Creds( $PS, $AS, pk(KDF_EK(TPM_EK_Seed)), A, B, C, D ) ]
  --[
  KeyReveal( 'Host_OrgCred_Reveal', $AS ),
  KeyReveal( 'TPM_OrgCred_Reveal', $PS ),
  KeyReveal( 'PKE_OrgCred_Reveal', pk(KDF_EK(TPM_EK_Seed)) )
  ]->
   [ Out( <A, B, C, D> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Host_Randomise_Credentials:
   [
   !Host_State_RNDCreds( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)), A, B, C, D ),
   Fr( ~l )
   ]
  --[ RandomisedCredentials( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)) ) ]->
   [
   !Host_Random_Credentials( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)),
                             multp(~l, A), multp(~l, B), multp(~l, C), multp(~l, D)
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Generate_Basename:
   [
   !Host_Join_Complete( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)) ),
   Fr( ~BaseName )
   ]
  --[ GenerateBasename( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)) ) ]->
   [ !Host_BaseName( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)), BSN(~BaseName) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Host_Basename:
   [
   !Host_Random_Credentials( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)), R, S, T, W
   ),
   !Host_BaseName( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)), bsn )
   ]
  --[ SetBasename( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)), bsn ) ]->
   [ !Host_State_07( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)), R, S, T, W, bsn ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Host_Process_Credentials:
   [
   !Host_State_07( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)),
                   multp(~l, multp(r, 'P1')), multp(~l, multp(y, multp(r, 'P1'))),
                   multp(~l,
                         plus(multp(x, multp(r, 'P1')), multp(multp(multp(r, x), y), Q))),
                   multp(~l, multp(multp(r, y), Q)), BSN(basename)
   )
   ]
  --[
  ProcessRandomisedCredentials( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)),
                                BSN(basename)
  ),
  SignOnlyOnce( 'Host_Randomise_Credentials' )
  ]->
   [
   Out_S( $AS, $PS,
          <F1(BSN(basename)), F2(BSN(basename)), 
           multp(~l, multp(y, multp(r, 'P1'))), 'TPM2_Commit_rand'>
   ),
   Host_State_08( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)), BSN(basename),
                  multp(~l, multp(r, 'P1')), multp(~l, multp(y, multp(r, 'P1'))),
                  multp(~l,
                        plus(multp(x, multp(r, 'P1')), multp(multp(multp(r, x), y), Q))),
                  multp(~l, multp(multp(r, y), Q)),
                  PointG1(H_p(F1(BSN(basename))), F2(BSN(basename)))
   ),
   Host_Rnd_Creds( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)), BSN(basename),
                   multp(~l, multp(r, 'P1')), multp(~l, multp(y, multp(r, 'P1'))),
                   multp(~l,
                         plus(multp(x, multp(r, 'P1')), multp(multp(multp(r, x), y), Q))),
                   multp(~l, multp(multp(r, y), Q))
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Host_RandomCredentialsReveal:
   [ Host_Rnd_Creds( $PS, $AS, pk(KDF_EK(TPM_EK_Seed)), bsn, R, S, T, W ) ]
  --[
  KeyReveal( 'Host_RndCred_Reveal', $AS ),
  KeyReveal( 'TPM_RndCred_Reveal', $PS ),
  KeyReveal( 'PKE_RndCred_Reveal', pk(KDF_EK(TPM_EK_Seed)) )
  ]->
   [ Out( <bsn, R, S, T, W> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) TPM2_Commit_2:
   [
   In_S( $AS, $PS, <F1(bsn), F2(bsn), S, 'TPM2_Commit_rand'> ),
   !TPM_DAA_SK( $PS, pk(KDF_EK(~TPM_EK_Seed)), ~f ), Fr( ~cv1 ),
   Fr( ~r_cv1 )
   ]
  --[
  TPMCommitRandomised( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)) ),
  CheckInG1( PointG1(H_p(F1(bsn)), F2(bsn)) ),
  SignOnlyOnce( 'TPM2_Commit_2' )
  ]->
   [
   Out_S( $PS, $AS,
          <multp(~f, PointG1(H_p(F1(bsn)), F2(bsn))), 
           L_J(~r_cv1, PointG1(H_p(F1(bsn)), F2(bsn))), E_S(~r_cv1, S), 
           Nonce(~cv1), 'ret_TPM2_Commit_rand'>
   ),
   TPM_Commit_RCV1( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)), Nonce(~cv1), ~r_cv1
   )
   ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) Host_Generate_Message_for_Signing:
   [
   In_S( $PS, $AS, <K, L, E, Nonce(cv1), 'ret_TPM2_Commit_rand'> ),
   Fr( ~m ),
   Host_State_08( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)), BSN(basename),
                  multp(sl, multp(r, 'P1')), multp(sl, multp(y, multp(r, 'P1'))),
                  multp(sl,
                        plus(multp(x, multp(r, 'P1')), multp(multp(multp(r, x), y), Q))),
                  multp(sl, multp(multp(r, y), Q)), J
   )
   ]
  --[
  GeneratedMessageForSigning( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)) ),
  SignOnlyOnce( 'Host_Generate_Message_for_Signing' )
  ]->
   [
   Out_S( $AS, $PS,
          <pk(KDF_EK(~TPM_EK_Seed)), 
           H_k_9(Message(~m), multp(sl, multp(r, 'P1')),
                 multp(sl, multp(y, multp(r, 'P1'))),
                 multp(sl,
                       plus(multp(x, multp(r, 'P1')), multp(multp(multp(r, x), y), Q))),
                 multp(sl, multp(multp(r, y), Q)), J, K, L, E), 
           Nonce(cv1), 'TPM2_Hash_2'>
   ),
   Host_cv1( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)),
             H_k_9(Message(~m), multp(sl, multp(r, 'P1')),
                   multp(sl, multp(y, multp(r, 'P1'))),
                   multp(sl,
                         plus(multp(x, multp(r, 'P1')), multp(multp(multp(r, x), y), Q))),
                   multp(sl, multp(multp(r, y), Q)), J, K, L, E),
             Nonce(cv1)
   ),
   Host_State_09( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)), Message(~m),
                  BSN(basename), multp(sl, multp(r, 'P1')),
                  multp(sl, multp(y, multp(r, 'P1'))),
                  multp(sl,
                        plus(multp(x, multp(r, 'P1')), multp(multp(multp(r, x), y), Q))),
                  multp(sl, multp(multp(r, y), Q)), J, K, L, E
   )
   ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) TPM2_Hash_2:
   [
   In_S( $AS, $PS,
         <pk(KDF_EK(~TPM_EK_Seed)), H_k_9(msg, R, S, T, W, J, K, L, E), 
          cv1val_in, 'TPM2_Hash_2'>
   ),
   Fr( ~c_tkt ),
   TPM_Commit_RCV1( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)), cv1val, ~r_cv1 )
   ]
  --[
  TPM2_Created_C_TPM( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)) ),
  Eq( cv1val, cv1val_in ), SignOnlyOnce( 'TPM2_Hash_2' )
  ]->
   [
   Out_S( $PS, $AS,
          <H_k_1(H_k_9(msg, R, S, T, W, J, K, L, E)), Nonce(~c_tkt), 
           'ret_TPM2_Hash_2'>
   ),
   TPM_c_tkt( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)), Nonce(~c_tkt), ~r_cv1 )
   ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) Host_Receive_C_TPM_TKT:
   [
   In_S( $PS, $AS, <c_tpm, Nonce(c_tkt), 'ret_TPM2_Hash_2'> ),
   Host_cv1( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)), c, cv1 )
   ]
  --[
  Host_Received_C_TPM( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)) ),
  Eq( H_k_1(c), c_tpm ), SignOnlyOnce( 'Host_Receive_C_TPM_TKT' )
  ]->
   [
   Out_S( $AS, $PS, <c_tpm, Nonce(c_tkt), 'TPM2_Sign_2'> ),
   Host_Store_C_TPM( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)), c_tpm )
   ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) TPM2_Sign_2:
   [
   In_S( $AS, $PS, <c_tpm, c_ticket_in, 'TPM2_Sign_2'> ),
   !TPM_DAA_SK( $PS, pk(KDF_EK(~TPM_EK_Seed)), ~f ),
   TPM_c_tkt( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)), c_ticket, ~r_cv1 ),
   Fr( ~rnd_n_M )
   ]
  --[
  TPM2_Signed_C_TPM( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)) ),
  Eq( c_ticket, c_ticket_in ), SignOnlyOnce( 'TPM2_Sign_2' )
  ]->
   [
   Out_S( $PS, $AS,
          <Nonce(~rnd_n_M), 
           plus(~r_cv1, multp(H_n_2(Nonce(~rnd_n_M), c_tpm), ~f)), 'ret_TPM2_Sign_2'
          >
   )
   ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) Host_Receive_Signature_C_TPM:
   [
   In_S( $PS, $AS,
         <Nonce(~rnd_n_M), plus(r_cv1, multp(h2, f)), 'ret_TPM2_Sign_2'>
   ),
   Host_Store_C_TPM( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)), c_tpm ),
   Host_State_09( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)), Message(m),
                  BSN(basename), multp(sl, A), multp(sl, B), multp(sl, C), multp(sl, D),
                  PointG1(H_p(F1(BSN(basename))), F2(BSN(basename))),
                  multp(f, PointG1(H_p(F1(BSN(basename))), F2(BSN(basename)))),
                  L_J(r_cv1, PointG1(H_p(F1(BSN(basename))), F2(BSN(basename)))),
                  E_S(r_cv1, S)
   )
   ]
  --[
  Host_Received_Signed_C_TPM( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)),
                              Message(m)
  ),
  Host_Sends_Sigma( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)),
                    <BSN(basename), multp(sl, A), multp(sl, B), multp(sl, C), multp(sl, D), 
                     PointG1(H_p(F1(BSN(basename))), F2(BSN(basename))), 
                     multp(f, PointG1(H_p(F1(BSN(basename))), F2(BSN(basename)))), 
                     H_n_2(Nonce(~rnd_n_M), c_tpm), plus(r_cv1, multp(h2, f)), 
                     Nonce(~rnd_n_M), Message(m), 'TPM_Signature_Of_m'>
  ),
  Host_Sends_Sigma_With_BSN( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)),
                             BSN(basename),
                             <BSN(basename), multp(sl, A), multp(sl, B), multp(sl, C), multp(sl, D), 
                              PointG1(H_p(F1(BSN(basename))), F2(BSN(basename))), 
                              multp(f, PointG1(H_p(F1(BSN(basename))), F2(BSN(basename)))), 
                              H_n_2(Nonce(~rnd_n_M), c_tpm), plus(r_cv1, multp(h2, f)), 
                              Nonce(~rnd_n_M), Message(m), 'TPM_Signature_Of_m'>
  ),
  Host_Sends_Sigma_cred( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)), BSN(basename),
                         multp(sl, A), multp(sl, B), multp(sl, C), multp(sl, D),
                         <BSN(basename), multp(sl, A), multp(sl, B), multp(sl, C), multp(sl, D), 
                          PointG1(H_p(F1(BSN(basename))), F2(BSN(basename))), 
                          multp(f, PointG1(H_p(F1(BSN(basename))), F2(BSN(basename)))), 
                          H_n_2(Nonce(~rnd_n_M), c_tpm), plus(r_cv1, multp(h2, f)), 
                          Nonce(~rnd_n_M), Message(m), 'TPM_Signature_Of_m'>
  ),
  Honest( $PS ), Honest( $AS ), Honest( pk(KDF_EK(~TPM_EK_Seed)) ),
  SignOnlyOnce( 'Host_Receive_Signature_C_TPM' )
  ]->
   [
   Out( <BSN(basename), multp(sl, A), multp(sl, B), multp(sl, C), 
         multp(sl, D), PointG1(H_p(F1(BSN(basename))), F2(BSN(basename))), 
         multp(f, PointG1(H_p(F1(BSN(basename))), F2(BSN(basename)))), 
         H_n_2(Nonce(~rnd_n_M), c_tpm), plus(r_cv1, multp(h2, f)), 
         Nonce(~rnd_n_M), Message(m), 'TPM_Signature_Of_m'>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Verifier_Check_TPM_Message:
   [
   In( <BSN(basename), multp(sl, A), multp(sl, B), multp(sl, C), 
        multp(sl, D), PointG1(H_p(s_2_bar), y_2), 
        multp(f, PointG1(H_p(s_2_bar), y_2)), H_n_2(n_M, c_tpm), 
        plus(r_cv1, multp(h2, f)), Nonce(rnd_n_M), Message(m_in), 
        'TPM_Signature_Of_m'>
   ),
   !Pk( 'Issuer', pkX, pkY )
   ]
  --[
  Eq( PointG1(H_p(F1(BSN(basename))), F2(BSN(basename))),
      PointG1(H_p(s_2_bar), y_2)
  ),
  Eq( verifyCre3(multp(sl, A), pkY, multp(sl, B), 'P2'), accept ),
  Eq( verifyCre4(multp(sl, A), multp(sl, D), pkX, multp(sl, C), 'P2'),
      accept
  ),
  Eq( H_n_2(Nonce(rnd_n_M),
            H_k_1(H_k_9(Message(m_in), multp(sl, A), multp(sl, B), multp(sl, C),
                        multp(sl, D), PointG1(H_p(F1(BSN(basename))), F2(BSN(basename))),
                        multp(f, PointG1(H_p(s_2_bar), y_2)),
                        calcL_J(minus(multp(plus(r_cv1, multp(h2, f)),
                                            PointG1(H_p(s_2_bar), y_2)),
                                      multp(H_n_2(n_M, c_tpm), multp(f, PointG1(H_p(s_2_bar), y_2))))),
                        calcE_S(minus(multp(plus(r_cv1, multp(h2, f)), multp(sl, B)),
                                      multp(H_n_2(n_M, c_tpm), multp(sl, D))))))),
      H_n_2(n_M, c_tpm)
  ),
  VerifiedSignature( $V,
                     <BSN(basename), multp(sl, A), multp(sl, B), multp(sl, C), multp(sl, D), 
                      PointG1(H_p(s_2_bar), y_2), multp(f, PointG1(H_p(s_2_bar), y_2)), 
                      H_n_2(n_M, c_tpm), plus(r_cv1, multp(h2, f)), Nonce(rnd_n_M), 
                      Message(m_in), 'TPM_Signature_Of_m'>
  ),
  VerifiedSignatureDeAnonymised( BSN(basename),
                                 <BSN(basename), multp(sl, A), multp(sl, B), multp(sl, C), multp(sl, D), 
                                  PointG1(H_p(s_2_bar), y_2), multp(f, PointG1(H_p(s_2_bar), y_2)), 
                                  H_n_2(n_M, c_tpm), plus(r_cv1, multp(h2, f)), Nonce(rnd_n_M), 
                                  Message(m_in), 'TPM_Signature_Of_m'>,
                                 f
  ),
  SignOnlyOnce( 'Verifier_Check_TPM_Signature' )
  ]->
   [
   !SignatureVerified( $V,
                       <BSN(basename), multp(sl, A), multp(sl, B), multp(sl, C), multp(sl, D), 
                        PointG1(H_p(s_2_bar), y_2), multp(f, PointG1(H_p(s_2_bar), y_2)), 
                        H_n_2(n_M, c_tpm), plus(r_cv1, multp(h2, f)), Nonce(rnd_n_M), 
                        Message(m_in), 'TPM_Signature_Of_m'>
   )
   ]

