          multp(f, PointG1(H_p(s_2_bar), y_2)), H_n_2(n_M, c_tpm), 
          plus(r_cv1, multp(h2, f)), Nonce(rnd_n_M), Message(m_in), 
          'TPM_Signature_Of_m'>
