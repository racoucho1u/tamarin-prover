by sorry

lemma oracle_correctness_with_verify:
  exists-trace
  "∃ TPM Host pke qpd #t01 #t02 #t03 #t04 #t05 #t06 #t07 #t08 #t09 #t10
     #t11 #t12 #t13 #t14 #t15 #t16 #t17 #t18 #t19 #t20 #t21 #t22 #t23 bsn #t24
     #t25 #t26 #t27 #t28 #t29 sigma #t30 #t31 #t32 Verifier.
    (((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((Issuer_Init( 'Issuer'
                                                                     ) @ #t01) ∧
                                                                    (Host_Init( Host ) @ #t02)) ∧
                                                                   (TPM_Init( TPM ) @ #t03)) ∧
                                                                  (¬(∃ RevealEvent ENTITY #k1.
                                                                      KeyReveal( RevealEvent, ENTITY
                                                                      ) @ #k1))) ∧
                                                                 (Bind( TPM, Host, 'Issuer' ) @ #t04)) ∧
                                                                (TPM2_EK_Created( TPM, Host, pke ) @ #t05)) ∧
                                                               (Store_EK( TPM, Host ) @ #t06)) ∧
                                                              (TPM2_DAA_Created( TPM, Host ) @ #t07)) ∧
                                                             (Store_DAA( TPM, Host ) @ #t08)) ∧
                                                            (IssuerReceivedKeys( 'Issuer', pke, qpd
                                                             ) @ #t09)) ∧
                                                           (Passthrough_ActivateCred( TPM, Host ) @ #t10)) ∧
                                                          (CurlyK_recomputed( TPM, Host ) @ #t11)) ∧
                                                         (Received_CurlyK( TPM, Host ) @ #t12)) ∧
                                                        (TPM2_Commited( TPM, Host ) @ #t13)) ∧
                                                       (Host_Created_p( TPM, Host ) @ #t14)) ∧
                                                      (TPM2_Created_P_TPM( TPM, Host ) @ #t15)) ∧
                                                     (Host_Received_P_TPM( TPM, Host ) @ #t16)) ∧
                                                    (TPM2_Signed_P_TPM( TPM, Host ) @ #t17)) ∧
                                                   (Host_Received_Signed_P_TPM( TPM, Host ) @ #t18)) ∧
                                                  (Issuer_VerifyChallengeIssueCredentials( 'Issuer', pke
                                                   ) @ #t19)) ∧
                                                 (Passthrough_ActivateCred2( TPM, Host ) @ #t20)) ∧
                                                (CurlyK2_recomputed( TPM, Host ) @ #t21)) ∧
                                               (JoinCompleted( TPM, Host, pke ) @ #t22)) ∧
                                              (RandomisedCredentials( TPM, Host, pke ) @ #t23)) ∧
                                             (SetBasename( TPM, Host, pke, bsn ) @ #t24)) ∧
                                            (ProcessRandomisedCredentials( TPM, Host, pke, bsn ) @ #t25)) ∧
                                           (TPMCommitRandomised( TPM, Host, pke ) @ #t26)) ∧
                                          (GeneratedMessageForSigning( TPM, Host, pke ) @ #t27)) ∧
                                         (TPM2_Created_C_TPM( TPM, Host, pke ) @ #t28)) ∧
                                        (Host_Received_C_TPM( TPM, Host, pke ) @ #t29)) ∧
                                       (TPM2_Signed_C_TPM( TPM, Host, pke ) @ #t30)) ∧
                                      (Host_Sends_Sigma( TPM, Host, pke, sigma ) @ #t31)) ∧
                                     (VerifiedSignature( Verifier, sigma ) @ #t32)) ∧
                                    (#t01 < #t02)) ∧
                                   (#t02 < #t04)) ∧
                                  (#t03 < #t04)) ∧
                                 (#t04 < #t05)) ∧
                                (#t05 < #t06)) ∧
                               (#t06 < #t07)) ∧
                              (#t07 < #t08)) ∧
                             (#t08 < #t09)) ∧
                            (#t09 < #t10)) ∧
                           (#t10 < #t11)) ∧
                          (#t11 < #t12)) ∧
                         (#t12 < #t13)) ∧
                        (#t13 < #t14)) ∧
                       (#t14 < #t15)) ∧
                      (#t15 < #t16)) ∧
                     (#t16 < #t17)) ∧
                    (#t17 < #t18)) ∧
                   (#t18 < #t19)) ∧
                  (#t19 < #t20)) ∧
                 (#t20 < #t21)) ∧
                (#t21 < #t22)) ∧
               (#t22 < #t23)) ∧
              (#t23 < #t24)) ∧
             (#t24 < #t25)) ∧
            (#t25 < #t26)) ∧
           (#t26 < #t27)) ∧
          (#t27 < #t28)) ∧
         (#t28 < #t29)) ∧
        (#t29 < #t30)) ∧
       (#t30 < #t31)) ∧
      (#t31 < #t32)) ∧
     (∀ event #i #j.
       ((OnlyOnce( event ) @ #i) ∧ (OnlyOnce( event ) @ #j)) ⇒ (#i = #j))) ∧
    (∀ event #i #j.
      ((SignOnlyOnce( event ) @ #i) ∧ (SignOnlyOnce( event ) @ #j)) ⇒
      (#i = #j))"
/*
guarded formula characterizing all satisfying traces:
"∃ TPM Host pke qpd #t01 #t02 #t03 #t04 #t05 #t06 #t07 #t08 #t09 #t10
   #t11 #t12 #t13 #t14 #t15 #t16 #t17 #t18 #t19 #t20 #t21 #t22 #t23 bsn #t24
   #t25 #t26 #t27 #t28 #t29 sigma #t30 #t31 #t32 Verifier.
  (Issuer_Init( 'Issuer' ) @ #t01) ∧
  (Host_Init( Host ) @ #t02) ∧
  (TPM_Init( TPM ) @ #t03) ∧
  (Bind( TPM, Host, 'Issuer' ) @ #t04) ∧
  (TPM2_EK_Created( TPM, Host, pke ) @ #t05) ∧
  (Store_EK( TPM, Host ) @ #t06) ∧
  (TPM2_DAA_Created( TPM, Host ) @ #t07) ∧
  (Store_DAA( TPM, Host ) @ #t08) ∧
  (IssuerReceivedKeys( 'Issuer', pke, qpd ) @ #t09) ∧
  (Passthrough_ActivateCred( TPM, Host ) @ #t10) ∧
  (CurlyK_recomputed( TPM, Host ) @ #t11) ∧
  (Received_CurlyK( TPM, Host ) @ #t12) ∧
  (TPM2_Commited( TPM, Host ) @ #t13) ∧
  (Host_Created_p( TPM, Host ) @ #t14) ∧
  (TPM2_Created_P_TPM( TPM, Host ) @ #t15) ∧
  (Host_Received_P_TPM( TPM, Host ) @ #t16) ∧
  (TPM2_Signed_P_TPM( TPM, Host ) @ #t17) ∧
  (Host_Received_Signed_P_TPM( TPM, Host ) @ #t18) ∧
  (Issuer_VerifyChallengeIssueCredentials( 'Issuer', pke ) @ #t19) ∧
  (Passthrough_ActivateCred2( TPM, Host ) @ #t20) ∧
  (CurlyK2_recomputed( TPM, Host ) @ #t21) ∧
  (JoinCompleted( TPM, Host, pke ) @ #t22) ∧
  (RandomisedCredentials( TPM, Host, pke ) @ #t23) ∧
  (SetBasename( TPM, Host, pke, bsn ) @ #t24) ∧
  (ProcessRandomisedCredentials( TPM, Host, pke, bsn ) @ #t25) ∧
  (TPMCommitRandomised( TPM, Host, pke ) @ #t26) ∧
  (GeneratedMessageForSigning( TPM, Host, pke ) @ #t27) ∧
  (TPM2_Created_C_TPM( TPM, Host, pke ) @ #t28) ∧
  (Host_Received_C_TPM( TPM, Host, pke ) @ #t29) ∧
  (TPM2_Signed_C_TPM( TPM, Host, pke ) @ #t30) ∧
  (Host_Sends_Sigma( TPM, Host, pke, sigma ) @ #t31) ∧
  (VerifiedSignature( Verifier, sigma ) @ #t32)
 ∧
  (∀ RevealEvent ENTITY #k1.
    (KeyReveal( RevealEvent, ENTITY ) @ #k1) ⇒ ⊥) ∧
  (#t01 < #t02) ∧
  (#t02 < #t04) ∧
  (#t03 < #t04) ∧
  (#t04 < #t05) ∧
  (#t05 < #t06) ∧
  (#t06 < #t07) ∧
  (#t07 < #t08) ∧
  (#t08 < #t09) ∧
  (#t09 < #t10) ∧
  (#t10 < #t11) ∧
  (#t11 < #t12) ∧
  (#t12 < #t13) ∧
  (#t13 < #t14) ∧
  (#t14 < #t15) ∧
  (#t15 < #t16) ∧
  (#t16 < #t17) ∧
  (#t17 < #t18) ∧
  (#t18 < #t19) ∧
  (#t19 < #t20) ∧
  (#t20 < #t21) ∧
  (#t21 < #t22) ∧
  (#t22 < #t23) ∧
  (#t23 < #t24) ∧
  (#t24 < #t25) ∧
  (#t25 < #t26) ∧
  (#t26 < #t27) ∧
  (#t27 < #t28) ∧
  (#t28 < #t29) ∧
  (#t29 < #t30) ∧
  (#t30 < #t31) ∧
  (#t31 < #t32) ∧
  (∀ event #i #j.
    (OnlyOnce( event ) @ #i) ∧ (OnlyOnce( event ) @ #j) ⇒ #i = #j) ∧
  (∀ event #i #j.
    (SignOnlyOnce( event ) @ #i) ∧ (SignOnlyOnce( event ) @ #j) ⇒ #i = #j)"
*/
simplify
solve( TPM_Initialised( $PS ) ▶₀ #t04 )
  case TPM_INIT
  solve( Host_Initialised( $AS ) ▶₁ #t04 )
    case Host_Init
    solve( !Issuer_Initialised( 'Issuer' ) ▶₂ #t04 )
      case Issuer_Init
      solve( TPM_EK_SEED( $PS, ~TPM_EK_Seed.1 ) ▶₁ #t05 )
        case TPM_INIT
        solve( !TPM_AES_Key( $PS, aes_key ) ▶₁ #t07 )
          case TPM_INIT
          solve( Host_State_01( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed.3)) ) ▶₁ #t08 )
            case Host_Store_EK
            solve( !EK_FOR_ISSUER( pk(KDF_EK(~TPM_EK_Seed)) ) ▶₃ #t09 )
              case Host_Store_DAA_Key
              solve( Host_State_02( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed.2)), Q_PD, Q_SD
                     ) ▶₁ #t10 )
                case Host_Store_DAA_Key
                solve( !TPM_AES_Key( $PS, aes_key ) ▶₁ #t11 )
                  case TPM_INIT
                  solve( !TPM_ENDORSEMENT_SK( $PS, e, pk(KDF_EK(~TPM_EK_Seed.2))
                         ) ▶₂ #t11 )
                    case TPM2_CreatePrimary
                    solve( !Pk( 'Issuer', PkX(x.1, 'P2'), PkY(y.1, 'P2') ) ▶₁ #t12 )
                      case Issuer_Init
                      solve( Host_State_03( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed.2)), Q_PD, Q_SD
                             ) ▶₂ #t12 )
                        case Host_Passthrough_1
                        solve( Host_State_04( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed.2)),
                                              <'DAA_public_data', multp(~f.4, 'P1')>, Q_SD, str
                               ) ▶₁ #t14 )
                          case Host_ReceiveCurlyK
                          solve( Host_cv( $PS, $AS, Nonce(cv.2) ) ▶₁ #t16 )
                            case Host_ReceiveEAndCV
                            solve( TPM_tkt( $PS, ticket ) ▶₁ #t17 )
                              case TPM2_Hash
                              solve( !TPM_DAA_SK( $PS, pk(KDF_EK(~TPM_EK_Seed.2)), ~f.4 ) ▶₂ #t17 )
                                case TPM2_Create
                                solve( TPM_CV_E( $PS, cv1, ~r_cv.2 ) ▶₃ #t17 )
                                  case TPM2_Commit
                                  solve( In_S( $PS, $AS,
                                               <Nonce(n_J.1), 
                                                plus(r_cv.2, multp(H_n_2(Nonce(n_J.1), p_tpm.1), f.4)), 
                                                'ret_TPM2_Sign'>
                                         ) ▶₀ #t18 )
                                    case ChanIn_S
                                    solve( Host_Store_P_TPM( $AS, p_tpm ) ▶₁ #t18 )
                                      case Host_Receive_P_TPM_TKT
                                      solve( Host_CurlyK1( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed.2)), curlyK(K_1.3)
                                             ) ▶₂ #t18 )
                                        case Host_ReceiveCurlyK
                                        solve( Issuer_State_01( 'Issuer', curlyK(K_1.3),
                                                                pk(KDF_EK(~TPM_EK_Seed)),
                                                                <'DAA_public_data', multp(f.4, 'P1')>
                                               ) ▶₁ #t19 )
                                          case Issuer_Check_EK_Send_Challenge
                                          solve( !Pk( 'Issuer', PkX(~x.1, 'P2'), PkY(~y.1, 'P2') ) ▶₂ #t19 )
                                            case Issuer_Init
                                            solve( !Ltk( 'Issuer', ~x, ~y ) ▶₃ #t19 )
                                              case Issuer_Init
                                              solve( Host_State_05( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed.2)),
                                                                    Q_PD, Q_SD
                                                     ) ▶₁ #t20 )
                                                case Host_ReceiveEAndCV
                                                solve( !TPM_AES_Key( $PS, aes_key ) ▶₁ #t21 )
                                                  case TPM_INIT
                                                  solve( !TPM_ENDORSEMENT_SK( $PS, e,
                                                                              pk(KDF_EK(~TPM_EK_Seed.2))
                                                         ) ▶₂ #t21 )
                                                    case TPM2_CreatePrimary
                                                    solve( !Pk( 'Issuer', PkX(x.1, 'P2'), PkY(y.1, 'P2')
                                                           ) ▶₁ #t22 )
                                                      case Issuer_Init
                                                      solve( Host_State_06( $PS, $AS,
                                                                            pk(KDF_EK(~TPM_EK_Seed)),
                                                                            <'DAA_public_data', 
                                                                             multp(~f.5, 'P1')>,
                                                                            senc(<multp(~x.1, 'P1'), 
                                                                                  multp(~y,
                                                                                        multp(~x.1, 'P1')), 
                                                                                  plus(multp(~x,
                                                                                             multp(~x.1,
                                                                                                   'P1')),
                                                                                       multp(multp(multp(~x.1,
                                                                                                         ~x),
                                                                                                   ~y),
                                                                                             multp(~f.5,
                                                                                                   'P1'))), 
                                                                                  multp(multp(~x.1, ~y),
                                                                                        multp(~f.5, 'P1')), 
                                                                                  H_n_8('P1',
                                                                                        multp(~f.5, 'P1'),
                                                                                        RB(x.2, 'P1'),
                                                                                        RD(x.2,
                                                                                           multp(~f.5, 'P1')),
                                                                                        multp(~x.1, 'P1'),
                                                                                        multp(~y,
                                                                                              multp(~x.1,
                                                                                                    'P1')),
                                                                                        plus(multp(~x,
                                                                                                   multp(~x.1,
                                                                                                         'P1')),
                                                                                             multp(multp(multp(~x.1,
                                                                                                               ~x),
                                                                                                         ~y),
                                                                                                   multp(~f.5,
                                                                                                         'P1'))),
                                                                                        multp(multp(~x.1, ~y),
                                                                                              multp(~f.5,
                                                                                                    'P1'))), 
                                                                                  plus(x.2,
                                                                                       multp(multp(~y, ~x.1),
                                                                                             H_n_8('P1',
                                                                                                   multp(~f.5,
                                                                                                         'P1'),
                                                                                                   RB(x.2,
                                                                                                      'P1'),
                                                                                                   RD(x.2,
                                                                                                      multp(~f.5,
                                                                                                            'P1')),
                                                                                                   multp(~x.1,
                                                                                                         'P1'),
                                                                                                   multp(~y,
                                                                                                         multp(~x.1,
                                                                                                               'P1')),
                                                                                                   plus(multp(~x,
                                                                                                              multp(~x.1,
                                                                                                                    'P1')),
                                                                                                        multp(multp(multp(~x.1,
                                                                                                                          ~x),
                                                                                                                    ~y),
                                                                                                              multp(~f.5,
                                                                                                                    'P1'))),
                                                                                                   multp(multp(~x.1,
                                                                                                               ~y),
                                                                                                         multp(~f.5,
                                                                                                               'P1')))))
                                                                                 >,
                                                                                 curlyK(K_2_rec))
                                                             ) ▶₂ #t22 )
                                                        case Host_Passthrough_2
                                                        solve( !Host_State_RNDCreds( $PS, $AS,
                                                                                     pk(KDF_EK(~TPM_EK_Seed)),
                                                                                     A, B, C, D
                                                               ) ▶₀ #t23 )
                                                          case Host_JoinComplete
                                                          solve( !Host_Random_Credentials( $PS, $AS,
                                                                                           pk(KDF_EK(~TPM_EK_Seed)),
                                                                                           R, S, T, W
                                                                 ) ▶₀ #t24 )
                                                            case Host_Randomise_Credentials
                                                            solve( !Host_BaseName( $PS, $AS,
                                                                                   pk(KDF_EK(~TPM_EK_Seed)),
                                                                                   BSN(basename)
                                                                   ) ▶₁ #t24 )
                                                              case Generate_Basename
                                                              solve( !Host_State_07( $PS, $AS,
                                                                                     pk(KDF_EK(~TPM_EK_Seed)),
                                                                                     multp(~l.3,
                                                                                           multp(r.1, 'P1')),
                                                                                     multp(~l.3,
                                                                                           multp(y.1,
                                                                                                 multp(r.1,
                                                                                                       'P1'))),
                                                                                     multp(~l.3,
                                                                                           plus(multp(x.3,
