lemma auto_bind_restriction:
  all-traces
  "∀ Ent1 Ent2 Ent3 #i.
    (Bind( Ent1, Ent2, Ent3 ) @ #i) ⇒
    (((¬(Ent1 = Ent2)) ∧ (¬(Ent1 = Ent3))) ∧ (¬(Ent2 = Ent3)))"
/*
guarded formula characterizing all counter-examples:
"∃ Ent1 Ent2 Ent3 #i.
  (Bind( Ent1, Ent2, Ent3 ) @ #i)
 ∧
  ((Ent1 = Ent2) ∨ (Ent1 = Ent3) ∨ (Ent2 = Ent3))"
*/
by sorry

lemma auto_restriction_one_host_per_tpm:
  all-traces
  "∀ TPM Host1 Host2 #i #j.
    ((Bind( Host1, TPM, 'Issuer' ) @ #i) ∧
     (Bind( Host2, TPM, 'Issuer' ) @ #j)) ⇒
    (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ TPM Host1 Host2 #i #j.
  (Bind( Host1, TPM, 'Issuer' ) @ #i) ∧ (Bind( Host2, TPM, 'Issuer' ) @ #j)
 ∧
  ¬(#i = #j)"
*/
by sorry

lemma auto_restriction_one_tpm_per_host:
  all-traces
  "∀ TPM1 TPM2 Host #i #j.
    ((Bind( Host, TPM1, 'Issuer' ) @ #i) ∧
     (Bind( Host, TPM2, 'Issuer' ) @ #j)) ⇒
    (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ TPM1 TPM2 Host #i #j.
  (Bind( Host, TPM1, 'Issuer' ) @ #i) ∧ (Bind( Host, TPM2, 'Issuer' ) @ #j)
 ∧
  ¬(#i = #j)"
*/
by sorry

lemma auto_restricition_pke_comes_from_tpm:
  all-traces
  "∀ pke #i.
    (Check_Ek( pke ) @ #i) ⇒
    (∃ TPM Host #j. TPM2_EK_Created( TPM, Host, pke ) @ #j)"
/*
guarded formula characterizing all counter-examples:
"∃ pke #i.
  (Check_Ek( pke ) @ #i)
 ∧
  ∀ TPM Host #j. (TPM2_EK_Created( TPM, Host, pke ) @ #j) ⇒ ⊥"
*/
by sorry

lemma auto_restriction_single_issuer:
  all-traces
  "∀ I1 I2 #i #j.
    ((Issuer_Init( I1 ) @ #i) ∧ (Issuer_Init( I2 ) @ #j)) ⇒ (I1 = I2)"
/*
guarded formula characterizing all counter-examples:
"∃ I1 I2 #i #j.
  (Issuer_Init( I1 ) @ #i) ∧ (Issuer_Init( I2 ) @ #j) ∧ ¬(I1 = I2)"
*/
by sorry

lemma auto_verify_multiple_pkes:
  exists-trace
  "∃ TPM1 TPM2 Host1 Host2 pke1 qpd1 pke2 qpd2 #t1 #t2 #t3 #t4.
    ((((((((PlatformSendKeys( TPM1, Host1, pke1, qpd1, 'Issuer' ) @ #t1) ∧
           (PlatformSendKeys( TPM2, Host2, pke2, qpd2, 'Issuer' ) @ #t2)) ∧
          (IssuerReceivedKeys( 'Issuer', pke1, qpd1 ) @ #t3)) ∧
         (IssuerReceivedKeys( 'Issuer', pke2, qpd2 ) @ #t4)) ∧
        (¬(pke1 = pke2))) ∧
       (¬(qpd1 = qpd2))) ∧
      (¬(Host1 = Host2))) ∧
     (¬(TPM1 = TPM2))) ∧
    (¬(∃ RevealEvent ENTITY #k1. KeyReveal( RevealEvent, ENTITY ) @ #k1))"
/*
guarded formula characterizing all satisfying traces:
"∃ TPM1 TPM2 Host1 Host2 pke1 qpd1 pke2 qpd2 #t1 #t2 #t3 #t4.
  (PlatformSendKeys( TPM1, Host1, pke1, qpd1, 'Issuer' ) @ #t1) ∧
  (PlatformSendKeys( TPM2, Host2, pke2, qpd2, 'Issuer' ) @ #t2) ∧
  (IssuerReceivedKeys( 'Issuer', pke1, qpd1 ) @ #t3) ∧
  (IssuerReceivedKeys( 'Issuer', pke2, qpd2 ) @ #t4)
 ∧
  (¬(pke1 = pke2)) ∧
  (¬(qpd1 = qpd2)) ∧
  (¬(Host1 = Host2)) ∧
  (¬(TPM1 = TPM2)) ∧
  (∀ RevealEvent ENTITY #k1. (KeyReveal( RevealEvent, ENTITY ) @ #k1) ⇒ ⊥)"
*/
simplify
solve( Host_State_01( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)) ) ▶₁ #t1 )
  case Host_Store_EK
  solve( Host_State_01( $PS.1, $AS.1, pk(KDF_EK(~TPM_EK_Seed.1)) ) ▶₁ #t2 )
    case Host_Store_EK
    solve( !EK_FOR_ISSUER( pk(KDF_EK(~TPM_EK_Seed)) ) ▶₃ #t3 )
      case Host_Store_DAA_Key
      solve( !EK_FOR_ISSUER( pk(KDF_EK(~TPM_EK_Seed.1)) ) ▶₃ #t4 )
        case Host_Store_DAA_Key
        solve( In_S( $PS, $AS,
                     <senc(~f, KDF_AES(~TPM_AES_Seed)), <'DAA_public_data', multp(~f, 'P1')>, 
                      'returnDAAKey'>
               ) ▶₀ #t1 )
          case ChanIn_S
          solve( In_S( $PS.1, $AS.1,
                       <senc(~f.1, KDF_AES(~TPM_AES_Seed.1)), 
                        <'DAA_public_data', multp(~f.1, 'P1')>, 'returnDAAKey'>
                 ) ▶₀ #t2 )
            case ChanIn_S
            solve( In_S( $PS, $AS,
                         <<'EK_public_data', pk(KDF_EK(~TPM_EK_Seed))>, 'returnEK'>
                   ) ▶₀ #vr )
              case ChanIn_S
              solve( In_S( $PS.1, $AS.1,
                           <<'EK_public_data', pk(KDF_EK(~TPM_EK_Seed.1))>, 'returnEK'>
                     ) ▶₀ #vr.1 )
              /* in loop (dpth: 1, it: 0) */
                case ChanIn_S
                solve( In_S( $PS.2, $AS.2,
                             <senc(~f.2, KDF_AES(~TPM_AES_Seed.2)), 
                              <'DAA_public_data', multp(~f.2, 'P1')>, 'returnDAAKey'>
                       ) ▶₀ #vr.2 )
                  case ChanIn_S
                  solve( In_S( $PS.3, $AS.3,
                               <senc(~f.3, KDF_AES(~TPM_AES_Seed.3)), 
                                <'DAA_public_data', multp(~f.3, 'P1')>, 'returnDAAKey'>
                         ) ▶₀ #vr.4 )
                  /* in loop (dpth: 1, it: 0) */
                    case ChanIn_S
                    solve( In_S( $PS.2, $AS.2,
                                 <<'EK_public_data', pk(KDF_EK(~TPM_EK_Seed))>, 'returnEK'>
                           ) ▶₀ #vr.3 )
                      case ChanIn_S
                      solve( In_S( $PS.2, $AS.2,
                                   <<'EK_public_data', pk(KDF_EK(~TPM_EK_Seed.1))>, 'returnEK'>
                             ) ▶₀ #vr.3 )
                      /* in loop (dpth: 1, it: 0) */
                        case ChanIn_S
                        solve( In_S( $AS, $PS, <pk(KDF_EK(~TPM_EK_Seed.2)), 'createDAAKey'>
                               ) ▶₀ #vr.4 )
                          case ChanIn_S_case_1
                          solve( In_S( $AS.1, $PS.1, <pk(KDF_EK(~TPM_EK_Seed.3)), 'createDAAKey'>
                                 ) ▶₀ #vr.11 )
                          /* in loop (dpth: 1, it: 0) */
                            case ChanIn_S_case_1
                            solve( In_S( $AS, $PS, 'createPrimary' ) ▶₀ #vr.17 )
                              case ChanIn_S
                              solve( In_S( $AS.1, $PS.1, 'createPrimary' ) ▶₀ #vr.20 )
                              /* in loop (dpth: 1, it: 0) */
                                case ChanIn_S
                                solve( In_S( $PS, $AS,
                                             <<'EK_public_data', pk(KDF_EK(~TPM_EK_Seed.2))>, 'returnEK'>
                                       ) ▶₀ #vr.23 )
                                  case ChanIn_S
                                  solve( In_S( $PS.1, $AS.1,
                                               <<'EK_public_data', pk(KDF_EK(~TPM_EK_Seed.2))>, 'returnEK'>
                                         ) ▶₀ #vr.25 )
                                  /* in loop (dpth: 1, it: 0) */
                                    case ChanIn_S
                                    solve( !KU( pk(KDF_EK(~TPM_EK_Seed)) ) @ #vk.1 )
                                      case Host_Store_DAA_Key
                                      solve( !KU( pk(KDF_EK(~TPM_EK_Seed.1)) ) @ #vk.10 )
                                      /* in loop (dpth: 1, it: 0) */
                                        case Host_Store_DAA_Key
                                        solve( In_S( $PS.2, $AS.2,
                                                     <senc(~f.2, KDF_AES(~TPM_AES_Seed.2)), 
                                                      <'DAA_public_data', multp(~f.2, 'P1')>, 'returnDAAKey'>
                                               ) ▶₀ #vr.29 )
                                          case ChanIn_S
                                          solve( In_S( $PS.3, $AS.3,
                                                       <senc(~f.3, KDF_AES(~TPM_AES_Seed.3)), 
                                                        <'DAA_public_data', multp(~f.3, 'P1')>, 'returnDAAKey'
                                                       >
                                                 ) ▶₀ #vr.32 )
                                          /* in loop (dpth: 1, it: 0) */
                                            case ChanIn_S
                                            solve( In_S( $PS.2, $AS.2,
                                                         <<'EK_public_data', pk(KDF_EK(~TPM_EK_Seed))>, 
                                                          'returnEK'>
                                                   ) ▶₀ #vr.31 )
                                              case ChanIn_S
                                              solve( In_S( $PS.2, $AS.2,
                                                           <<'EK_public_data', pk(KDF_EK(~TPM_EK_Seed.1))>, 
                                                            'returnEK'>
                                                     ) ▶₀ #vr.32 )
                                              /* in loop (dpth: 1, it: 0) */
                                                case ChanIn_S
                                                solve( !KU( multp(~f, 'P1') ) @ #vk.9 )
                                                  case Host_Store_DAA_Key
                                                  solve( !KU( multp(~f.1, 'P1') ) @ #vk.11 )
                                                  /* in loop (dpth: 1, it: 0) */
                                                    case Host_Store_DAA_Key
                                                    solve( In_S( $PS.2, $AS.2,
                                                                 <senc(~f, KDF_AES(~TPM_AES_Seed.2)), 
                                                                  <'DAA_public_data', multp(~f, 'P1')>, 
                                                                  'returnDAAKey'>
                                                           ) ▶₀ #vr.31 )
                                                      case ChanIn_S
                                                      solve( In_S( $PS.2, $AS.2,
                                                                   <senc(~f.1, KDF_AES(~TPM_AES_Seed.2)), 
                                                                    <'DAA_public_data', multp(~f.1, 'P1')>, 
                                                                    'returnDAAKey'>
                                                             ) ▶₀ #vr.34 )
                                                      /* in loop (dpth: 1, it: 0) */
                                                        case ChanIn_S
                                                        SOLVED // trace found
                                                      qed
                                                    qed
                                                  qed
                                                qed
                                              qed
                                            qed
                                          qed
                                        qed
                                      qed
