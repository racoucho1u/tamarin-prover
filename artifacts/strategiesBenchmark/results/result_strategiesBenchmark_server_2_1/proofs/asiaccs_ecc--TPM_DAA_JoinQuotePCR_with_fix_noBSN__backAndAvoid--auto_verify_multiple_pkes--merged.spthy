lemma oracle_correctness_two_pcr_quotes_same_credentials:
  exists-trace
  "∃ TPM Host pke R S T W sigma1 sigma2 #t01 #t02.
    (((((Host_Sends_Quote_cred( TPM, Host, pke, R, S, T, W, sigma1
         ) @ #t01) ∧
        (Host_Sends_Quote_cred( TPM, Host, pke, R, S, T, W, sigma2 ) @ #t02)) ∧
       (¬(#t01 = #t02))) ∧
      (¬(sigma1 = sigma2))) ∧
     (¬(∃ RevealEvent ENTITY #k1. KeyReveal( RevealEvent, ENTITY ) @ #k1))) ∧
    (∀ event #i #j.
      ((OnlyOnce( event ) @ #i) ∧ (OnlyOnce( event ) @ #j)) ⇒ (#i = #j))"
/*
guarded formula characterizing all satisfying traces:
"∃ TPM Host pke R S T W sigma1 sigma2 #t01 #t02.
  (Host_Sends_Quote_cred( TPM, Host, pke, R, S, T, W, sigma1 ) @ #t01) ∧
  (Host_Sends_Quote_cred( TPM, Host, pke, R, S, T, W, sigma2 ) @ #t02)
 ∧
  (¬(#t01 = #t02)) ∧
  (¬(sigma1 = sigma2)) ∧
  (∀ RevealEvent ENTITY #k1.
    (KeyReveal( RevealEvent, ENTITY ) @ #k1) ⇒ ⊥) ∧
  (∀ event #i #j.
    (OnlyOnce( event ) @ #i) ∧ (OnlyOnce( event ) @ #j) ⇒ #i = #j)"
*/
by sorry

