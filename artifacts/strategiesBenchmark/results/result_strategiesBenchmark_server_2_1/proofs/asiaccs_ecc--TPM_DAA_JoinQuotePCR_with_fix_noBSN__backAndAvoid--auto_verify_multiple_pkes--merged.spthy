                      multp(multp(x.325, x.324), x.335))
        x     = x.179
        y     = y.180
        z     = RB(x.332, 'P1')
        z.1   = calcRD(minus(multp(plus(x.332,
                                        multp(multp(x.324, x.325),
                                              H_n_8('P1', multp(x.333, 'P1'), RB(x.332, 'P1'),
                                                    RD(x.332, multp(x.333, 'P1')), multp(x.325, 'P1'),
                                                    multp(x.324, multp(x.325, 'P1')),
                                                    plus(multp(x.334, multp(x.325, 'P1')),
                                                         multp(multp(multp(x.325, x.334), x.324), x.335)),
