theory KCL07_UK3 begin

// Function signature and definition of the equational theory E

builtins: multiset, xor
functions: fst/1, h/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2







rule (modulo E) Setup:
   [ Fr( ~k1 ), Fr( ~id1 ), Fr( ~k2 ), Fr( ~id2 ) ]
  --[ OnlyOnce( ) ]->
   [
   Reader( ('1'++
            diff((<~k1, ~id1>++<~k2, ~id2>), (<~k1, ~id1>++<~k1, ~id1>)))
   ),
   Tag( ('1'++diff((<~k1, ~id1>++<~k2, ~id2>), (<~k1, ~id1>++<~k1, ~id1>)))
   )
   ]

rule (modulo E) select_tag:
   [ Tag( (z++<~k, ~id>) ) ]
  --[ Tag( (z++<~k, ~id>) ) ]->
   [ TagRun( ~k, ~id ), Tag( z ) ]

rule (modulo E) select_reader:
   [ Reader( (z++<~k, ~id>) ) ]
  --[ Reader( (z++<~k, ~id>) ) ]->
   [ ReaderRun( ~k, ~id ), Reader( z ) ]

rule (modulo E) reader1:
   [ Fr( ~r1 ) ]
  --[ Challenge( ~r1, 'Reader' ) ]->
   [ Out( ~r1 ), Initiated( ~r1 ) ]

rule (modulo E) tag1:
   [ In( r1 ), Fr( ~r2 ), TagRun( ~k, ~id ) ]
  --[ Response( ~k, 'Tag' ) ]->
   [ Out( <(~id⊕~r2), (~r2⊕h(<r1, ~k>))> ) ]

rule (modulo E) reader2:
   [ Initiated( ~r1 ), ReaderRun( ~k, ~id ), In( xoredhash ) ]
  --[ Alive( ~k, 'Tag' ), Eq( xoredhash, (~id⊕h(<~r1, ~k>)) ) ]->
   [ ]

restriction equality [right]:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

restriction equality [left]:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

restriction unique [right]:
  "∀ #i #j. ((OnlyOnce( ) @ #i) ∧ (OnlyOnce( ) @ #j)) ⇒ (#i = #j)"
  // safety formula

restriction unique [left]:
  "∀ #i #j. ((OnlyOnce( ) @ #i) ∧ (OnlyOnce( ) @ #j)) ⇒ (#i = #j)"
  // safety formula

restriction max_number_of_tags_tag [right]:
  "∀ a b c d #i. (Tag( (a++b++c++d) ) @ #i) ⇒ (⊥)"
  // safety formula

restriction max_number_of_tags_tag [left]:
  "∀ a b c d #i. (Tag( (a++b++c++d) ) @ #i) ⇒ (⊥)"
  // safety formula

restriction max_number_of_tags_tag_reader [right]:
  "∀ a b c d #i. (Reader( (a++b++c++d) ) @ #i) ⇒ (⊥)"
  // safety formula

restriction max_number_of_tags_tag_reader [left]:
  "∀ a b c d #i. (Reader( (a++b++c++d) ) @ #i) ⇒ (⊥)"
  // safety formula

lemma recentalive_tag [right]:
  all-traces
  "∀ x #i.
    (Alive( x, 'Tag' ) @ #i) ⇒
    (∃ y #j #k.
      (((Challenge( y, 'Reader' ) @ #k) ∧ (Response( x, 'Tag' ) @ #j)) ∧
       (#k < #j)) ∧
      (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ x #i.
  (Alive( x, 'Tag' ) @ #i)
 ∧
  ∀ y #j #k.
   (Challenge( y, 'Reader' ) @ #k) ∧ (Response( x, 'Tag' ) @ #j)
  ⇒
   ((¬(#k < #j)) ∨ (¬(#j < #i)))"
*/
by sorry

lemma recentalive_tag [left]:
  all-traces
  "∀ x #i.
    (Alive( x, 'Tag' ) @ #i) ⇒
    (∃ y #j #k.
      (((Challenge( y, 'Reader' ) @ #k) ∧ (Response( x, 'Tag' ) @ #j)) ∧
       (#k < #j)) ∧
      (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ x #i.
  (Alive( x, 'Tag' ) @ #i)
 ∧
  ∀ y #j #k.
   (Challenge( y, 'Reader' ) @ #k) ∧ (Response( x, 'Tag' ) @ #j)
  ⇒
   ((¬(#k < #j)) ∨ (¬(#j < #i)))"
*/
by sorry

lemma executable [right]:
  exists-trace
  "∃ x #i #j.
    (((Alive( x, 'Tag' ) @ #i) ∧ (Response( x, 'Tag' ) @ #j)) ∧
     (∀ #k. (Alive( x, 'Tag' ) @ #k) ⇒ (#i = #k))) ∧
    (∀ #k. (Response( x, 'Tag' ) @ #k) ⇒ (#j = #k))"
/*
guarded formula characterizing all satisfying traces:
"∃ x #i #j.
  (Alive( x, 'Tag' ) @ #i) ∧ (Response( x, 'Tag' ) @ #j)
 ∧
  (∀ #k. (Alive( x, 'Tag' ) @ #k) ⇒ #i = #k) ∧
  (∀ #k. (Response( x, 'Tag' ) @ #k) ⇒ #j = #k)"
*/
simplify
solve( Initiated( ~r1 ) ▶₀ #i )
  case reader1
  solve( ReaderRun( ~k, ~id ) ▶₁ #i )
    case select_reader
    solve( TagRun( ~k, ~id.1 ) ▶₂ #j )
      case select_tag
      solve( !KU( (~id⊕h(<~r1, ~k>)) ) @ #vk )
        case c_xor
        solve( !KU( h(<~r1, ~k>) ) @ #vk.2 )
          case c_h
          solve( Reader( (z++<~k, ~id>) ) ▶₀ #vr.1 )
            case Setup
            solve( !KU( ~id ) @ #vk.3 )
              case tag1
              solve( !KU( ~k ) @ #vk.6 )
                case tag1
                solve( Tag( (z.2++<~k.2, ~k>) ) ▶₀ #vr.11 )
                  case select_tag
                  solve( Tag( (z.2++<~k.2, ~k>++<~k.3, ~id.2>) ) ▶₀ #vr.12 )
                    case select_tag
                    by contradiction /* from formulas */
                  qed
                qed
              qed
            qed
          next
            case select_reader
            solve( Reader( (z++<~k, ~id>++<~k.1, ~id.2>) ) ▶₀ #vr.3 )
              case Setup
              solve( !KU( ~id ) @ #vk.3 )
                case tag1
                solve( !KU( ~k ) @ #vk.6 )
                  case tag1
                  solve( Tag( (z.2++<~k.2, ~k>) ) ▶₀ #vr.12 )
                    case select_tag
                    solve( Tag( (z.2++<~k.2, ~k>++<~k.3, ~id.2>) ) ▶₀ #vr.13 )
                      case select_tag
                      by contradiction /* from formulas */
                    qed
                  qed
                qed
              qed
            next
              case select_reader
              by contradiction /* from formulas */
            qed
          qed
        next
          case tag1
          solve( Reader( (z++<~k, ~id>) ) ▶₀ #vr.1 )
            case Setup
            solve( !KU( ~id ) @ #vk.3 )
              case tag1
              solve( !KU( ~r1 ) @ #vk.3 )
                case reader1
                solve( !KU( ~r2 ) @ #vk.4 )
                  case tag1_case_1
                  solve( !KU( ~r2.1 ) @ #vk.6 ) /* in loop (dpth: 1, it: 0) */
                    case tag1_case_1
                    by solve( !KU( ~r2.2 ) @ #vk.8 ) /* in loop (dpth: 1, it: 0) */
                  next
                    case tag1_case_2
                    by contradiction /* cyclic */
                  next
                    case tag1_case_3
                    by solve( !KU( ~r2.2 ) @ #vk.8 ) /* in loop (dpth: 1, it: 0) */
                  qed
                next
                  case tag1_case_2
                  solve( !KU( ~r2.1 ) @ #vk.6 ) /* in loop (dpth: 1, it: 0) */
                    case tag1_case_1
                    by solve( !KU( ~id.1 ) @ #vk.7 ) /* in loop (dpth: 3, it: 0) */
                  next
                    case tag1_case_2
                    by contradiction /* cyclic */
                  next
                    case tag1_case_3
                    by solve( !KU( ~id.1 ) @ #vk.7 ) /* in loop (dpth: 3, it: 0) */
                  qed
                next
                  case tag1_case_3
                  by contradiction /* cyclic */
                qed
              next
                case tag1
                solve( Tag( (z.2++<~k.2, ~r1>) ) ▶₀ #vr.13 )
                  case select_tag
                  solve( Tag( (z.2++<~k.2, ~r1>++<~k.3, ~id.2>) ) ▶₀ #vr.14 )
                    case select_tag
                    by contradiction /* from formulas */
                  qed
                qed
              qed
            qed
          next
            case select_reader
            solve( Reader( (z++<~k, ~id>++<~k.1, ~id.2>) ) ▶₀ #vr.5 )
              case Setup
              solve( !KU( ~id ) @ #vk.3 )
                case tag1
                solve( !KU( ~r1 ) @ #vk.3 )
                  case reader1
                  solve( !KU( ~r2 ) @ #vk.4 )
                    case tag1_case_1
                    solve( !KU( ~r2.1 ) @ #vk.6 ) /* in loop (dpth: 1, it: 0) */
                      case tag1_case_1
                      by solve( !KU( ~r2.2 ) @ #vk.8 ) /* in loop (dpth: 1, it: 0) */
                    next
                      case tag1_case_2
                      by contradiction /* cyclic */
                    next
                      case tag1_case_3
                      by solve( !KU( ~r2.2 ) @ #vk.8 ) /* in loop (dpth: 1, it: 0) */
                    qed
                  next
                    case tag1_case_2
                    solve( !KU( ~r2.1 ) @ #vk.6 ) /* in loop (dpth: 1, it: 0) */
                      case tag1_case_1
                      by solve( !KU( ~id.1 ) @ #vk.7 ) /* in loop (dpth: 3, it: 0) */
                    next
                      case tag1_case_2
                      by contradiction /* cyclic */
                    next
                      case tag1_case_3
                      by solve( !KU( ~id.1 ) @ #vk.7 ) /* in loop (dpth: 3, it: 0) */
                    qed
                  next
                    case tag1_case_3
                    by contradiction /* cyclic */
                  qed
                next
                  case tag1
                  solve( Tag( (z.2++<~k.2, ~r1>) ) ▶₀ #vr.14 )
                    case select_tag
                    solve( Tag( (z.2++<~k.2, ~r1>++<~k.3, ~id.2>) ) ▶₀ #vr.15 )
                      case select_tag
                      by contradiction /* from formulas */
                    qed
                  qed
                qed
              qed
            next
              case select_reader
              by contradiction /* from formulas */
            qed
          qed
        qed
      next
        case coerce
        solve( !KD( (~id⊕h(<~r1, ~k>)) ) ▶₀ #vk )
          case reader1
          by contradiction /* impossible chain */
        next
          case tag1
          solve( (#vl, 0) ~~> (#vk, 0) )
            case d_0_fst
            solve( TagRun( ~k.1, ~id.2 ) ▶₂ #vr.3 )
              case select_tag
              solve( Reader( (z++<~k, ~id>) ) ▶₀ #vr.1 )
                case Setup
                solve( (#vr.4, 0) ~~> (#vk, 0) )
                  case d_xor_case_1
                  by solve( (#vr.7, 0) ~~> (#vk, 0) )
                next
                  case d_xor_case_2
                  solve( (#vr.7, 0) ~~> (#vk, 0) ) /* in loop (dpth: 1, it: 0) */
                    case Xor
                    by solve( !KU( (~r2.1⊕h(<~r1, ~k>)) ) @ #vk.3 )
                       /* in loop (dpth: 4, it: 0) */
                  qed
                next
                  case d_xor_case_3
                  by contradiction /* impossible chain */
                next
                  case d_xor_case_4
                  by contradiction /* impossible chain */
                qed
              next
                case select_reader
                solve( Reader( (z++<~k, ~id>++<~k.2, ~id.3>) ) ▶₀ #vr.6 )
                  case Setup
                  solve( (#vr.4, 0) ~~> (#vk, 0) )
                    case d_xor_case_1
                    by solve( (#vr.8, 0) ~~> (#vk, 0) )
                  next
                    case d_xor_case_2
                    solve( (#vr.8, 0) ~~> (#vk, 0) ) /* in loop (dpth: 1, it: 0) */
                      case Xor
                      by solve( !KU( (~r2.1⊕h(<~r1, ~k>)) ) @ #vk.3 )
                         /* in loop (dpth: 5, it: 0) */
                    qed
                  next
                    case d_xor_case_3
                    by contradiction /* impossible chain */
                  next
                    case d_xor_case_4
                    by contradiction /* impossible chain */
                  qed
                next
                  case select_reader
                  by contradiction /* from formulas */
                qed
              qed
            qed
          next
            case d_0_snd
            solve( TagRun( ~k.1, ~id.2 ) ▶₂ #vr.3 )
              case select_tag
              solve( Reader( (z++<~k, ~id>) ) ▶₀ #vr.1 )
                case Setup
                solve( (#vr.4, 0) ~~> (#vk, 0) )
                  case d_xor_case_1
                  by solve( (#vr.7, 0) ~~> (#vk, 0) )
                next
                  case d_xor_case_2
                  solve( (#vr.7, 0) ~~> (#vk, 0) ) /* in loop (dpth: 1, it: 0) */
                    case Xor
                    by solve( !KU( (~id⊕~r2) ) @ #vk.2 ) /* in loop (dpth: 4, it: 0) */
                  qed
                next
                  case d_xor_case_3
                  by contradiction /* impossible chain */
                next
                  case d_xor_case_4
                  by solve( (#vr.7, 0) ~~> (#vk, 0) )
                qed
              next
                case select_reader
                solve( Reader( (z++<~k, ~id>++<~k.2, ~id.3>) ) ▶₀ #vr.6 )
                  case Setup
                  solve( (#vr.4, 0) ~~> (#vk, 0) )
                    case d_xor_case_1
                    by solve( (#vr.8, 0) ~~> (#vk, 0) )
                  next
                    case d_xor_case_2
                    solve( (#vr.8, 0) ~~> (#vk, 0) ) /* in loop (dpth: 1, it: 0) */
                      case Xor
                      by solve( !KU( (~id⊕~r2) ) @ #vk.2 ) /* in loop (dpth: 5, it: 0) */
                    qed
                  next
                    case d_xor_case_3
                    by contradiction /* impossible chain */
                  next
                    case d_xor_case_4
                    by solve( (#vr.8, 0) ~~> (#vk, 0) )
                  qed
                next
                  case select_reader
                  by contradiction /* from formulas */
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma executable [left]:
  exists-trace
  "∃ x #i #j.
    (((Alive( x, 'Tag' ) @ #i) ∧ (Response( x, 'Tag' ) @ #j)) ∧
     (∀ #k. (Alive( x, 'Tag' ) @ #k) ⇒ (#i = #k))) ∧
    (∀ #k. (Response( x, 'Tag' ) @ #k) ⇒ (#j = #k))"
/*
guarded formula characterizing all satisfying traces:
"∃ x #i #j.
  (Alive( x, 'Tag' ) @ #i) ∧ (Response( x, 'Tag' ) @ #j)
 ∧
  (∀ #k. (Alive( x, 'Tag' ) @ #k) ⇒ #i = #k) ∧
  (∀ #k. (Response( x, 'Tag' ) @ #k) ⇒ #j = #k)"
*/
simplify
solve( Initiated( ~r1 ) ▶₀ #i )
  case reader1
  solve( ReaderRun( ~k, ~id ) ▶₁ #i )
    case select_reader
    solve( TagRun( ~k, ~id.1 ) ▶₂ #j )
      case select_tag
      solve( !KU( (~id⊕h(<~r1, ~k>)) ) @ #vk )
        case c_xor
        solve( !KU( h(<~r1, ~k>) ) @ #vk.2 )
          case c_h
          solve( Reader( (z++<~k, ~id>) ) ▶₀ #vr.1 )
            case Setup_case_1
            solve( !KU( ~id ) @ #vk.3 )
              case tag1
              solve( !KU( ~k ) @ #vk.6 )
                case tag1
                solve( Tag( (z.2++<~k.2, ~k>) ) ▶₀ #vr.11 )
                  case select_tag
                  solve( Tag( (z.2++<~k.2, ~k>++<~k.3, ~id.2>) ) ▶₀ #vr.12 )
                    case select_tag
                    by contradiction /* from formulas */
                  qed
                qed
              qed
            qed
          next
            case Setup_case_2
            solve( !KU( ~id ) @ #vk.3 )
              case tag1
              solve( !KU( ~k ) @ #vk.6 )
                case tag1
                solve( Tag( (z.2++<~k.2, ~k>) ) ▶₀ #vr.11 )
                  case select_tag
                  solve( Tag( (z.2++<~k.2, ~k>++<~k.3, ~id.2>) ) ▶₀ #vr.12 )
                    case select_tag
                    by contradiction /* from formulas */
                  qed
                qed
              qed
            qed
          next
            case select_reader
            solve( Reader( (z++<~k, ~id>++<~k.1, ~id.2>) ) ▶₀ #vr.3 )
              case Setup_case_1
              solve( !KU( ~id ) @ #vk.3 )
                case tag1
                solve( !KU( ~k ) @ #vk.6 )
                  case tag1
                  solve( Tag( (z.2++<~k.3, ~k>) ) ▶₀ #vr.12 )
                    case select_tag
                    solve( Tag( (z.2++<~k.2, ~k>++<~k.4, ~id.3>) ) ▶₀ #vr.13 )
                      case select_tag
                      by contradiction /* from formulas */
                    qed
                  qed
                qed
              qed
            next
              case Setup_case_2
              solve( !KU( ~id ) @ #vk.3 )
                case tag1
                solve( !KU( ~k ) @ #vk.6 )
                  case tag1
                  solve( Tag( (z.2++<~k.3, ~k>) ) ▶₀ #vr.12 )
                    case select_tag
                    solve( Tag( (z.2++<~k.2, ~k>++<~k.4, ~id.3>) ) ▶₀ #vr.13 )
                      case select_tag
                      by contradiction /* from formulas */
                    qed
                  qed
                qed
              qed
            next
              case select_reader
              by contradiction /* from formulas */
            qed
          qed
        next
          case tag1
          solve( Reader( (z++<~k, ~id>) ) ▶₀ #vr.1 )
            case Setup_case_1
            solve( !KU( ~id ) @ #vk.3 )
              case tag1
              solve( !KU( ~r1 ) @ #vk.3 )
                case reader1
                solve( !KU( ~r2 ) @ #vk.4 )
                  case tag1_case_1
                  solve( !KU( ~r2.1 ) @ #vk.6 ) /* in loop (dpth: 1, it: 0) */
                    case tag1_case_1
                    by solve( !KU( ~r2.2 ) @ #vk.8 ) /* in loop (dpth: 1, it: 0) */
                  next
                    case tag1_case_2
                    by contradiction /* cyclic */
                  next
                    case tag1_case_3
                    by solve( !KU( ~r2.2 ) @ #vk.8 ) /* in loop (dpth: 1, it: 0) */
                  qed
                next
                  case tag1_case_2
                  solve( !KU( ~r2.1 ) @ #vk.6 ) /* in loop (dpth: 1, it: 0) */
                    case tag1_case_1
                    by solve( !KU( ~id.1 ) @ #vk.7 ) /* in loop (dpth: 3, it: 0) */
                  next
                    case tag1_case_2
                    by contradiction /* cyclic */
                  next
                    case tag1_case_3
                    by solve( !KU( ~id.1 ) @ #vk.7 ) /* in loop (dpth: 3, it: 0) */
                  qed
                next
                  case tag1_case_3
                  by contradiction /* cyclic */
                qed
              next
                case tag1
                solve( Tag( (z.2++<~k.2, ~r1>) ) ▶₀ #vr.13 )
                  case select_tag
                  solve( Tag( (z.2++<~k.2, ~r1>++<~k.3, ~id.2>) ) ▶₀ #vr.14 )
                    case select_tag
                    by contradiction /* from formulas */
                  qed
                qed
              qed
            qed
          next
            case Setup_case_2
            solve( !KU( ~id ) @ #vk.3 )
              case tag1
              solve( !KU( ~r1 ) @ #vk.3 )
                case reader1
                solve( !KU( ~r2 ) @ #vk.4 )
                  case tag1_case_1
                  solve( !KU( ~r2.1 ) @ #vk.6 ) /* in loop (dpth: 1, it: 0) */
                    case tag1_case_1
                    by solve( !KU( ~r2.2 ) @ #vk.8 ) /* in loop (dpth: 1, it: 0) */
                  next
                    case tag1_case_2
                    by contradiction /* cyclic */
                  next
                    case tag1_case_3
                    by solve( !KU( ~r2.2 ) @ #vk.8 ) /* in loop (dpth: 1, it: 0) */
                  qed
                next
                  case tag1_case_2
                  solve( !KU( ~r2.1 ) @ #vk.6 ) /* in loop (dpth: 1, it: 0) */
                    case tag1_case_1
                    by solve( !KU( ~id.1 ) @ #vk.7 ) /* in loop (dpth: 3, it: 0) */
                  next
                    case tag1_case_2
                    by contradiction /* cyclic */
                  next
                    case tag1_case_3
                    by solve( !KU( ~id.1 ) @ #vk.7 ) /* in loop (dpth: 3, it: 0) */
                  qed
                next
                  case tag1_case_3
                  by contradiction /* cyclic */
                qed
              next
                case tag1
                solve( Tag( (z.2++<~k.2, ~r1>) ) ▶₀ #vr.13 )
                  case select_tag
                  solve( Tag( (z.2++<~k.2, ~r1>++<~k.3, ~id.2>) ) ▶₀ #vr.14 )
                    case select_tag
                    by contradiction /* from formulas */
                  qed
                qed
              qed
            qed
          next
            case select_reader
            solve( Reader( (z++<~k, ~id>++<~k.1, ~id.2>) ) ▶₀ #vr.5 )
              case Setup_case_1
              solve( !KU( ~id ) @ #vk.3 )
                case tag1
                solve( !KU( ~r1 ) @ #vk.3 )
                  case reader1
                  solve( !KU( ~r2 ) @ #vk.4 )
                    case tag1_case_1
                    solve( !KU( ~r2.1 ) @ #vk.6 ) /* in loop (dpth: 1, it: 0) */
                      case tag1_case_1
                      by solve( !KU( ~r2.2 ) @ #vk.8 ) /* in loop (dpth: 1, it: 0) */
                    next
                      case tag1_case_2
                      by contradiction /* cyclic */
                    next
                      case tag1_case_3
                      by solve( !KU( ~r2.2 ) @ #vk.8 ) /* in loop (dpth: 1, it: 0) */
                    qed
                  next
                    case tag1_case_2
                    solve( !KU( ~r2.1 ) @ #vk.6 ) /* in loop (dpth: 1, it: 0) */
                      case tag1_case_1
                      by solve( !KU( ~id.1 ) @ #vk.7 ) /* in loop (dpth: 3, it: 0) */
                    next
                      case tag1_case_2
                      by contradiction /* cyclic */
                    next
                      case tag1_case_3
                      by solve( !KU( ~id.1 ) @ #vk.7 ) /* in loop (dpth: 3, it: 0) */
                    qed
                  next
                    case tag1_case_3
                    by contradiction /* cyclic */
                  qed
                next
                  case tag1
                  solve( Tag( (z.2++<~k.3, ~r1>) ) ▶₀ #vr.14 )
                    case select_tag
                    solve( Tag( (z.2++<~k.2, ~r1>++<~k.4, ~id.3>) ) ▶₀ #vr.15 )
                      case select_tag
                      by contradiction /* from formulas */
                    qed
                  qed
                qed
              qed
            next
              case Setup_case_2
              solve( !KU( ~id ) @ #vk.3 )
                case tag1
                solve( !KU( ~r1 ) @ #vk.3 )
                  case reader1
