theory STR begin

// Function signature and definition of the equational theory E

builtins: diffie-hellman, multiset
functions: fst/1, pair/2, snd/1, te/1, te_inv/1
equations:
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    te_inv(te(x)) = x











restriction Unique:
  "∀ x #i #j. ((Uniq( x ) @ #i) ∧ (Uniq( x ) @ #j)) ⇒ (#i = #j)"
  // safety formula

restriction Less:
  "∀ x y #i. (Less( x, y ) @ #i) ⇒ (∃ z. (x++z) = y)"

restriction Leq:
  "∀ x y #i. (Leq( x, y ) @ #i) ⇒ ((∃ z. (x++z) = y) ∨ (x = y))"

restriction InEq:
  "¬(∃ x #i. InEq( x, x ) @ #i)"
  // safety formula

rule (modulo E) AuthOut:
   [ !AO( A, x ) ] --> [ Out( x ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) CreateGroup:
   [ In( <'CreateGroup', $gid, k, pM> ) ]
  --[ Uniq( <'CreateGroup', $gid> ), CreateGroup( $gid, k, pM ) ]->
   [ !Group( $gid, k, pM ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) StartLeader:
   [
   In( <'StartLeader', $gid> ),
   !Group( $gid, k, (pM_rest++<'1', $A>++<('1'++'1'), $B>) ), Fr( ~x ),
   !AO( $B, <'EpkOf', $gid, ('1'++'1'), Y> )
   ]
  --[
  Accept( $gid, $A, '1', ('1'++'1'), k, Y^~x ),
  Uniq( <'StartLeader', $gid> )
  ]->
   [
   LoopLeader( $gid, $A, ('1'++'1'++'1'), Y^~x ),
   !AO( $A, <'GpkFor', $gid, ('1'++'1'), 'g'^~x> )
   ]

  /*
  rule (modulo AC) StartLeader:
     [
     In( <'StartLeader', $gid> ),
     !Group( $gid, k, (pM_rest++<'1', $A>++<('1'++'1'), $B>) ), Fr( ~x ),
     !AO( $B, <'EpkOf', $gid, ('1'++'1'), Y> )
     ]
    --[
    Accept( $gid, $A, '1', ('1'++'1'), k, z ), Uniq( <'StartLeader', $gid> )
    ]->
     [
     LoopLeader( $gid, $A, ('1'++'1'++'1'), z ),
     !AO( $A, <'GpkFor', $gid, ('1'++'1'), 'g'^~x> )
     ]
    variants (modulo AC)
    1. ~x    = ~x.14
       Y     = Y.15
       z     = Y.15^~x.14
    
    2. ~x    = ~x.97
       Y     = x.188^x.189
       z     = x.188^(~x.97*x.189)
    
    3. Y     = DH_neutral
       z     = DH_neutral
  */

rule (modulo E) StepLeader:
   [
   In( <'StepLeader', $gid, j> ), LoopLeader( $gid, $A, j, key ),
   !Group( $gid, k, (pM_rest++<j, $B>) ), !AO( $B, <'EpkOf', $gid, j, Y> )
   ]
  --[
  Accept( $gid, $A, '1', j, k, Y^te(key) ),
  Uniq( <'StepLeader', $gid, j> ), Leq( j, k )
  ]->
   [
   LoopLeader( $gid, $A, ('1'++j), Y^te(key) ),
   !AO( $A, <'GpkFor', $gid, j, 'g'^te(key)> )
   ]

  // loop breaker: [1]
  /*
  rule (modulo AC) StepLeader:
     [
     In( <'StepLeader', $gid, j> ), LoopLeader( $gid, $A, j, key ),
     !Group( $gid, k, (pM_rest++<j, $B>) ), !AO( $B, <'EpkOf', $gid, j, Y> )
     ]
    --[
    Accept( $gid, $A, '1', j, k, z ), Uniq( <'StepLeader', $gid, j> ),
    Leq( j, k )
    ]->
     [
     LoopLeader( $gid, $A, ('1'++j), z ),
     !AO( $A, <'GpkFor', $gid, j, 'g'^te(key)> )
     ]
    variants (modulo AC)
    1. Y     = Y.17
       key   = key.20
       z     = Y.17^te(key.20)
    
    2. Y     = DH_neutral
       z     = DH_neutral
    
    3. Y     = z.24^inv(te(key.19))
       key   = key.19
       z     = z.24
    
    4. Y     = x.163^x.164
       key   = key.86
       z     = x.163^(x.164*te(key.86))
    
    5. Y     = x.163^inv((x.164*te(key.86)))
       key   = key.86
       z     = x.163^inv(x.164)
    
    6. Y     = x.163^(x.164*inv(te(key.86)))
       key   = key.86
       z     = x.163^x.164
    
    7. Y     = x.164^(x.165*inv((x.166*te(key.87))))
       key   = key.87
       z     = x.164^(x.165*inv(x.166))
    // loop breaker: [1]
  */

rule (modulo E) StartOther:
   [
   In( <'StartOther', $gid, i> ), !Group( $gid, k, (pM_rest++<i, $A>) ),
   Fr( ~x )
   ]
  --[ Uniq( <'StartOther', $gid, i> ), InEq( i, '1' ) ]->
   [ RecvOther( $gid, $A, i, ~x ), !AO( $A, <'EpkOf', $gid, i, 'g'^~x> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) RecvOther:
   [
   In( <'RecvOther', $gid, i> ), !Group( $gid, k, (pM_rest++<'1', $B>) ),
   RecvOther( $gid, $A, i, ~x ), !AO( $B, <'GpkFor', $gid, i, Y> )
   ]
  --[
  Accept( $gid, $A, i, i, k, Y^~x ), Uniq( <'RecvOther', $gid, i> ),
  InEq( i, '1' )
  ]->
   [ LoopOther( $gid, $A, i, ('1'++i), Y^~x ) ]

  /*
  rule (modulo AC) RecvOther:
     [
     In( <'RecvOther', $gid, i> ), !Group( $gid, k, (pM_rest++<'1', $B>) ),
     RecvOther( $gid, $A, i, ~x ), !AO( $B, <'GpkFor', $gid, i, Y> )
     ]
    --[
    Accept( $gid, $A, i, i, k, z ), Uniq( <'RecvOther', $gid, i> ),
    InEq( i, '1' )
    ]->
     [ LoopOther( $gid, $A, i, ('1'++i), z ) ]
    variants (modulo AC)
    1. ~x    = ~x.15
       Y     = Y.16
       z     = Y.16^~x.15
    
    2. ~x    = ~x.22
       Y     = z.30^inv(~x.22)
       z     = z.30
    
    3. ~x    = ~x.33
       Y     = x.60^x.61
       z     = x.60^(~x.33*x.61)
    
    4. ~x    = ~x.34
       Y     = x.62^inv((~x.34*x.63))
       z     = x.62^inv(x.63)
    
    5. ~x    = ~x.34
       Y     = x.62^(x.63*inv(~x.34))
       z     = x.62^x.63
    
    6. ~x    = ~x.35
       Y     = x.63^(x.64*inv((~x.35*x.65)))
       z     = x.63^(x.64*inv(x.65))
    
    7. Y     = DH_neutral
       z     = DH_neutral
  */

rule (modulo E) StepOther:
   [
   In( <'StepOther', $gid, i, j> ), LoopOther( $gid, $A, i, j, key ),
   !Group( $gid, k, (pM_rest++<j, $B>) ), !AO( $B, <'EpkOf', $gid, j, Y> )
   ]
  --[ Accept( $gid, $A, i, j, k, Y^te(key) ), Less( i, j ), InEq( i, '1' )
  ]->
   [ LoopOther( $gid, $A, i, ('1'++j), Y^te(key) ) ]

  // loop breaker: [1]
  /*
  rule (modulo AC) StepOther:
     [
     In( <'StepOther', $gid, i, j> ), LoopOther( $gid, $A, i, j, key ),
     !Group( $gid, k, (pM_rest++<j, $B>) ), !AO( $B, <'EpkOf', $gid, j, Y> )
     ]
    --[ Accept( $gid, $A, i, j, k, z ), Less( i, j ), InEq( i, '1' ) ]->
     [ LoopOther( $gid, $A, i, ('1'++j), z ) ]
    variants (modulo AC)
    1. Y     = Y.19
       key   = key.23
       z     = Y.19^te(key.23)
    
    2. Y     = DH_neutral
       z     = DH_neutral
    
    3. Y     = z.25^inv(te(key.20))
       key   = key.20
       z     = z.25
    
    4. Y     = x.46^x.47
       key   = key.28
       z     = x.46^(x.47*te(key.28))
    
    5. Y     = x.46^inv((x.47*te(key.28)))
       key   = key.28
       z     = x.46^inv(x.47)
    
    6. Y     = x.46^(x.47*inv(te(key.28)))
       key   = key.28
       z     = x.46^x.47
    
    7. Y     = x.47^(x.48*inv((x.49*te(key.29))))
       key   = key.29
       z     = x.47^(x.48*inv(x.49))
    // loop breaker: [1]
  */

lemma key_secret [use_induction]:
  all-traces
  "¬(∃ gid A i j k key #i1 #i2.
      (Accept( gid, A, i, j, k, key ) @ #i1) ∧ (!KU( key ) @ #i2))"
/*
guarded formula characterizing all counter-examples:
"∃ gid A i j k key #i1 #i2.
  (Accept( gid, A, i, j, k, key ) @ #i1) ∧ (!KU( key ) @ #i2)"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  solve( (∀ gid A i j k key #i1 #i2.
           (Accept( gid, A, i, j, k, key ) @ #i1) ∧ (!KU( key ) @ #i2)
          ⇒
           ((last(#i2)) ∨ (last(#i1))))  ∥
         (∃ x y #i.
           (Less( x, y ) @ #i) ∧ (¬(last(#i))) ∧ (∀ z. ((x++z) = y) ⇒ ⊥))  ∥
         (∃ x y #i.
           (Leq( x, y ) @ #i)
          ∧
           (¬(last(#i))) ∧ (∀ z. ((x++z) = y) ⇒ ⊥) ∧ (¬(x = y))) )
    case case_1
    solve( (last(#i2))  ∥ (last(#i1)) )
      case case_1
      solve( Accept( gid, A, i, j, k, key ) @ #i1 )
        case RecvOther
        solve( !Group( $gid, k, (pM_rest++<'1', $B>) ) ▶₁ #i1 )
          case CreateGroup
          solve( RecvOther( $gid, $A, i, ~x ) ▶₂ #i1 )
            case StartOther
            solve( !AO( $B, <'GpkFor', $gid, i, Y> ) ▶₃ #i1 )
              case StartLeader
              solve( !KU( 'g'^(~x*~x.1) ) @ #i2 )
                case AuthOut_case_1
                by solve( !KU( ~x ) @ #vk.23 )
              next
                case AuthOut_case_2
                by solve( !KU( ~x.1 ) @ #vk.23 )
              next
                case c_exp
                by solve( !KU( ~x ) @ #vk.25 )
              qed
            next
              case StepLeader
              solve( (∃ z. ((i++z) = k))  ∥ (i = k) )
                case case_1
                solve( splitEqs(1) )
                  case split_case_1
                  by contradiction /* from formulas */
                next
                  case split_case_2
                  solve( !KU( 'g'^(~x*te(key)) ) @ #i2 )
                    case AuthOut_case_1
                    solve( (∃ z. ((j++z) = k))  ∥ (j = k) )
                      case case_1
                      by solve( !KU( ~x ) @ #vk.32 )
                    next
                      case case_2
                      by solve( !KU( ~x ) @ #vk.31 )
                    qed
                  next
                    case AuthOut_case_2
                    solve( !KU( te(key) ) @ #vk.21 )
                      case c_te
                      solve( LoopLeader( $gid, $B, i, key ) ▶₁ #vr.2 )
                        case StepLeader
                        by contradiction /* from formulas */
                      qed
                    qed
                  next
                    case c_exp
                    by solve( !KU( ~x ) @ #vk.23 )
                  qed
                next
                  case split_case_3
                  solve( !KU( 'g'^(~x.1*te(key)) ) @ #i2 )
                    case AuthOut_case_1
                    solve( (∃ z. ((j++z) = k))  ∥ (j = k) )
                      case case_1
                      by solve( !KU( ~x.1 ) @ #vk.35 )
                    next
                      case case_2
                      by solve( !KU( ~x.1 ) @ #vk.34 )
                    qed
                  next
                    case AuthOut_case_2
                    solve( !KU( te(key) ) @ #vk.24 )
                      case c_te
                      solve( LoopLeader( $gid, $B, i, key ) ▶₁ #vr.2 )
                        case StartLeader
                        by contradiction /* from formulas */
                      next
                        case StepLeader
                        by contradiction /* from formulas */
                      qed
                    qed
                  next
                    case c_exp
                    by solve( !KU( ~x.1 ) @ #vk.26 )
                  qed
                qed
              next
                case case_2
                solve( splitEqs(1) )
                  case split_case_1
                  by contradiction /* from formulas */
                next
                  case split_case_2
                  solve( !KU( 'g'^(~x*te(key)) ) @ #i2 )
                    case AuthOut_case_1
                    solve( (∃ z. ((j++z) = k))  ∥ (j = k) )
                      case case_1
                      by solve( !KU( ~x ) @ #vk.30 )
                    next
                      case case_2
                      by solve( !KU( ~x ) @ #vk.29 )
                    qed
                  next
                    case AuthOut_case_2
                    solve( !KU( te(key) ) @ #vk.19 )
                      case c_te
                      solve( LoopLeader( $gid, $B, i, key ) ▶₁ #vr.2 )
                        case StepLeader
                        by contradiction /* from formulas */
                      qed
                    qed
                  next
                    case c_exp
                    by solve( !KU( ~x ) @ #vk.21 )
                  qed
                next
                  case split_case_3
                  solve( !KU( 'g'^(~x.1*te(key)) ) @ #i2 )
                    case AuthOut_case_1
                    solve( (∃ z. ((j++z) = k))  ∥ (j = k) )
                      case case_1
                      by solve( !KU( ~x.1 ) @ #vk.33 )
                    next
                      case case_2
                      by solve( !KU( ~x.1 ) @ #vk.32 )
                    qed
                  next
                    case AuthOut_case_2
                    solve( !KU( te(key) ) @ #vk.22 )
                      case c_te
                      solve( LoopLeader( $gid, $B, i, key ) ▶₁ #vr.2 )
                        case StartLeader
                        by contradiction /* from formulas */
                      next
                        case StepLeader
                        by contradiction /* from formulas */
                      qed
                    qed
                  next
                    case c_exp
                    by solve( !KU( ~x.1 ) @ #vk.24 )
                  qed
                qed
              qed
            qed
          qed
        qed
      next
        case StartLeader
        solve( !Group( $gid, k, (pM_rest++<'1', $A>++<('1'++'1'), $B>) ) ▶₁ #i1 )
          case CreateGroup
          solve( !AO( $B, <'EpkOf', $gid, ('1'++'1'), Y> ) ▶₃ #i1 )
            case StartOther
            solve( !KU( 'g'^(~x*~x.1) ) @ #i2 )
              case AuthOut_case_1
              by solve( !KU( ~x.1 ) @ #vk.20 )
            next
              case AuthOut_case_2
              by solve( !KU( ~x ) @ #vk.20 )
            next
              case c_exp
              by solve( !KU( ~x ) @ #vk.22 )
            qed
          qed
        qed
      next
        case StepLeader
        solve( (∃ z. ((j++z) = k))  ∥ (j = k) )
          case case_1
          solve( !Group( $gid, (j++z), (pM_rest++<j, $B>) ) ▶₂ #i1 )
            case CreateGroup
            solve( !AO( $B, <'EpkOf', $gid, j, Y> ) ▶₃ #i1 )
              case StartOther
              solve( !KU( 'g'^(~x*te(key)) ) @ #i2 )
                case AuthOut_case_1
                by solve( !KU( ~x ) @ #vk.26 )
              next
                case AuthOut_case_2
                solve( !KU( te(key) ) @ #vk.17 )
                  case c_te
                  solve( LoopLeader( $gid, $A, j, key ) ▶₁ #i1 )
                    case StartLeader
                    by contradiction /* from formulas */
                  next
                    case StepLeader
                    by contradiction /* from formulas */
                  qed
                qed
              next
                case c_exp
                by solve( !KU( ~x ) @ #vk.19 )
              qed
            qed
          qed
        next
          case case_2
          solve( !Group( $gid, j, (pM_rest++<j, $B>) ) ▶₂ #i1 )
            case CreateGroup
            solve( !AO( $B, <'EpkOf', $gid, j, Y> ) ▶₃ #i1 )
              case StartOther
              solve( !KU( 'g'^(~x*te(key)) ) @ #i2 )
                case AuthOut_case_1
                by solve( !KU( ~x ) @ #vk.24 )
              next
                case AuthOut_case_2
                solve( !KU( te(key) ) @ #vk.15 )
                  case c_te
                  solve( LoopLeader( $gid, $A, j, key ) ▶₁ #i1 )
                    case StartLeader
                    by contradiction /* from formulas */
                  next
                    case StepLeader
                    by contradiction /* from formulas */
                  qed
                qed
              next
                case c_exp
                by solve( !KU( ~x ) @ #vk.17 )
              qed
            qed
          qed
        qed
      next
        case StepOther
        solve( !Group( $gid, k, (pM_rest++<(i++z), $B>) ) ▶₂ #i1 )
          case CreateGroup
          solve( !AO( $B, <'EpkOf', $gid, (i++z), Y> ) ▶₃ #i1 )
            case StartOther
            solve( !KU( 'g'^(~x*te(key)) ) @ #i2 )
              case AuthOut_case_1
              solve( (∃ z. ((j++z) = k.1))  ∥ (j = k.1) )
                case case_1
                by solve( !KU( ~x ) @ #vk.32 )
              next
                case case_2
                by solve( !KU( ~x ) @ #vk.31 )
              qed
            next
              case AuthOut_case_2
              solve( !KU( te(key) ) @ #vk.20 )
                case c_te
                solve( LoopOther( $gid, $A, i, (i++z), key ) ▶₁ #i1 )
                  case RecvOther_case_1
                  by contradiction /* from formulas */
                next
                  case RecvOther_case_2
                  by contradiction /* from formulas */
                next
                  case StepOther_case_1
                  by contradiction /* from formulas */
                next
                  case StepOther_case_2
                  by contradiction /* from formulas */
                next
                  case StepOther_case_3
                  by contradiction /* from formulas */
                qed
              qed
            next
              case c_exp
              by solve( !KU( ~x ) @ #vk.22 )
            qed
          qed
        qed
      qed
    next
      case case_2
      solve( Accept( gid, A, i, j, k, key ) @ #i1 )
        case RecvOther
        solve( !Group( $gid, k, (pM_rest++<'1', $B>) ) ▶₁ #i1 )
          case CreateGroup
          solve( RecvOther( $gid, $A, i, ~x ) ▶₂ #i1 )
            case StartOther
            solve( !AO( $B, <'GpkFor', $gid, i, Y> ) ▶₃ #i1 )
              case StartLeader
              by solve( !KU( 'g'^(~x*~x.1) ) @ #i1 )
            next
              case StepLeader
              solve( (∃ z. ((i++z) = k))  ∥ (i = k) )
                case case_1
                solve( splitEqs(1) )
                  case split_case_1
                  by contradiction /* from formulas */
                next
                  case split_case_2
                  by solve( !KU( 'g'^(~x*te(key)) ) @ #i1 )
                next
                  case split_case_3
                  by solve( !KU( 'g'^(~x.1*te(key)) ) @ #i1 )
                qed
              next
                case case_2
                solve( splitEqs(1) )
                  case split_case_1
                  by contradiction /* from formulas */
                next
                  case split_case_2
                  by solve( !KU( 'g'^(~x*te(key)) ) @ #i1 )
                next
                  case split_case_3
                  by solve( !KU( 'g'^(~x.1*te(key)) ) @ #i1 )
                qed
              qed
            qed
          qed
        qed
      next
        case StartLeader
        solve( !Group( $gid, k, (pM_rest++<'1', $A>++<('1'++'1'), $B>) ) ▶₁ #i1 )
          case CreateGroup
          solve( !AO( $B, <'EpkOf', $gid, ('1'++'1'), Y> ) ▶₃ #i1 )
            case StartOther
            solve( !KU( 'g'^(~x*~x.1) ) @ #i2 )
              case AuthOut_case_1
              by contradiction /* node #i2 after last node #i1 */
            next
              case AuthOut_case_2
              by contradiction /* node #i2 after last node #i1 */
            next
              case c_exp
              by solve( !KU( ~x ) @ #vk.22 )
            qed
          qed
        qed
      next
        case StepLeader
        solve( (∃ z. ((j++z) = k))  ∥ (j = k) )
          case case_1
          solve( !Group( $gid, (j++z), (pM_rest++<j, $B>) ) ▶₂ #i1 )
            case CreateGroup
            solve( !AO( $B, <'EpkOf', $gid, j, Y> ) ▶₃ #i1 )
              case StartOther
              solve( !KU( 'g'^(~x*te(key)) ) @ #i2 )
                case AuthOut_case_1
                by solve( !KU( ~x ) @ #vk.26 )
              next
                case AuthOut_case_2
                solve( !KU( te(key) ) @ #vk.17 )
                  case c_te
                  solve( LoopLeader( $gid, $A, j, key ) ▶₁ #i1 )
                    case StartLeader
                    by contradiction /* from formulas */
                  next
                    case StepLeader
                    by contradiction /* from formulas */
                  qed
                qed
              next
                case c_exp
                by solve( !KU( ~x ) @ #vk.19 )
              qed
            qed
          qed
        next
          case case_2
          solve( !Group( $gid, j, (pM_rest++<j, $B>) ) ▶₂ #i1 )
            case CreateGroup
            solve( !AO( $B, <'EpkOf', $gid, j, Y> ) ▶₃ #i1 )
              case StartOther
              solve( !KU( 'g'^(~x*te(key)) ) @ #i2 )
                case AuthOut_case_1
                by solve( !KU( ~x ) @ #vk.24 )
              next
                case AuthOut_case_2
                solve( !KU( te(key) ) @ #vk.15 )
                  case c_te
                  solve( LoopLeader( $gid, $A, j, key ) ▶₁ #i1 )
                    case StartLeader
                    by contradiction /* from formulas */
                  next
                    case StepLeader
                    by contradiction /* from formulas */
                  qed
                qed
              next
                case c_exp
                by solve( !KU( ~x ) @ #vk.17 )
              qed
            qed
          qed
        qed
      next
        case StepOther
        solve( !Group( $gid, k, (pM_rest++<(i++z), $B>) ) ▶₂ #i1 )
          case CreateGroup
          solve( !AO( $B, <'EpkOf', $gid, (i++z), Y> ) ▶₃ #i1 )
            case StartOther
            solve( !KU( 'g'^(~x*te(key)) ) @ #i2 )
              case AuthOut_case_1
