                next
                  case RecvOther_case_2
                  by contradiction /* from formulas */
                next
                  case StepOther_case_1
                  by contradiction /* from formulas */
                next
                  case StepOther_case_2
                  by contradiction /* from formulas */
                next
                  case StepOther_case_3
                  by contradiction /* from formulas */
                qed
              qed
            next
              case c_exp
              by solve( !KU( ~x ) @ #vk.22 )
            qed
          qed
        qed
      qed
    qed
  next
    case case_2
    by contradiction /* from formulas */
  next
    case case_3
    solve( (∃ z. ((x++z) = y))  ∥ (x = y) )
