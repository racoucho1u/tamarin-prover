  (∀ a b #k. (NoRekeyingUE( a, b ) @ #k) ⇒ ⊥) ∧
  (∀ a b #k. (NoIdentityRequests( a, b ) @ #k) ⇒ ⊥) ∧
  (¬(x0 = x1)) ∧
  (∀ a #k. (Init( 'K_AMF', a ) @ #k) ⇒ #k = #i1) ∧
  (∀ a #k. (RadioAccessNetwork( a ) @ #k) ⇒ ((#k = #i2) ∨ (#k = #i3))) ∧
  (∀ a1 a2 a3 a4 #k. (SessionHandover( a1, a2, a3, a4 ) @ #k) ⇒ #k = #i4) ∧
  (∀ a b #k. (RekeyingCN( a, b ) @ #k) ⇒ #k = #j1) ∧
  (∀ a b #k. (HandoverPreparationDone( a, b ) @ #k) ⇒ #k = #j2) ∧
  (∀ a b #k. (RekeyingUE( a, b ) @ #k) ⇒ #k = #j3) ∧
  (∀ a b #k. (HandoverExecutionDone( '1', a, b ) @ #k) ⇒ #k = #j4) ∧
  (∀ a b #k. (IdentityRequestSUCI( a, b ) @ #k) ⇒ #k = #j5) ∧
  (∀ a b #k. (IdentityResponseSUCI( a, b ) @ #k) ⇒ #k = #j6) ∧
  (∀ a b #k. (IdentityRequestPEI( a, b ) @ #k) ⇒ #k = #j7) ∧
  (∀ a b #k. (IdentityResponsePEI( a, b ) @ #k) ⇒ #k = #j8) ∧
  (∀ a b #k. (IdentityRequestsDone( a, b ) @ #k) ⇒ #k = #j9) ∧
  (∀ a b #k. (MobilityRegistrationUpdateDone( a, b ) @ #k) ⇒ #k = #j10) ∧
  (∀ a b #k. (HandoverExecutionDone( '2', a, b ) @ #k) ⇒ #k = #j11) ∧
  (∀ a1 a2 #k1 #k2.
    (CoreNetwork( a1 ) @ #k1) ∧ (CoreNetwork( a2 ) @ #k2) ⇒ #k1 = #k2) ∧
  (∀ a1 a2 #k1 #k2.
    (HomeNetwork( a1 ) @ #k1) ∧ (HomeNetwork( a2 ) @ #k2) ⇒ #k1 = #k2) ∧
  (∀ a1 a2 #k1 #k2.
    (UserEquipment( a1 ) @ #k1) ∧ (UserEquipment( a2 ) @ #k2) ⇒ #k1 = #k2) ∧
  (∀ a1 a2 a3 a4 #k1 #k2.
    (Subscribe( a1, a2 ) @ #k1) ∧ (Subscribe( a3, a4 ) @ #k2) ⇒ #k1 = #k2)"
*/
by sorry

lemma executability_old_kamf_old_kamf_no_id_req:
  exists-trace
  "∃ x1 x2 y1 y2 s t #i1 #i2 #i3 #i4 #i5 #i6 #j1 #j2 #j3 #j4 #j5 #j6 #j7
     #l1 #l2 #l3 #l4 #l5 #l6 #l7.
    ((((((((((((((((((((((((((((((((((((((((((((((((((((Init( 'K_AMF', x1
                                                        ) @ #i1) ∧
                                                       (RadioAccessNetwork( s ) @ #i2)) ∧
                                                      (RadioAccessNetwork( t ) @ #i3)) ∧
                                                     (SessionHandover( <s, t>, x1, x1, y1 ) @ #i4)) ∧
                                                    (HandoverInit( <s, t>, x1, x2 ) @ #i5)) ∧
                                                   (SessionHandover( <t, s>, x2, x2, y2 ) @ #i6)) ∧
                                                  (NoRekeyingCN( x1, y1 ) @ #j1)) ∧
                                                 (HandoverPreparationDone( x1, y1 ) @ #j2)) ∧
                                                (NoRekeyingUE( x1, y1 ) @ #j3)) ∧
                                               (HandoverExecutionDone( '1', x1, y1 ) @ #j4)) ∧
                                              (NoIdentityRequests( x1, y1 ) @ #j5)) ∧
                                             (MobilityRegistrationUpdateDone( x1, y1 ) @ #j6)) ∧
                                            (HandoverExecutionDone( '2', x1, y1 ) @ #j7)) ∧
                                           (NoRekeyingCN( x2, y2 ) @ #l1)) ∧
                                          (HandoverPreparationDone( x2, y2 ) @ #l2)) ∧
                                         (NoRekeyingUE( x2, y2 ) @ #l3)) ∧
                                        (HandoverExecutionDone( '1', x2, y2 ) @ #l4)) ∧
                                       (NoIdentityRequests( x2, y2 ) @ #l5)) ∧
                                      (MobilityRegistrationUpdateDone( x2, y2 ) @ #l6)) ∧
                                     (HandoverExecutionDone( '2', x2, y2 ) @ #l7)) ∧
                                    (¬(∃ X data #r. Rev( X, data ) @ #r))) ∧
                                   (¬(y1 = y2))) ∧
                                  (¬(∃ a b #k. IdentityRequestSUCI( a, b ) @ #k))) ∧
                                 (¬(∃ a b #k. IdentityResponseSUCI( a, b ) @ #k))) ∧
                                (¬(∃ a b #k. IdentityRequestPEI( a, b ) @ #k))) ∧
                               (¬(∃ a b #k. IdentityResponsePEI( a, b ) @ #k))) ∧
                              (¬(∃ a b #k. RekeyingCN( a, b ) @ #k))) ∧
                             (¬(∃ a b #k. RekeyingUE( a, b ) @ #k))) ∧
                            (¬(∃ a b #k. IdentityRequestsDone( a, b ) @ #k))) ∧
                           (#i4 < #i5)) ∧
                          (#i5 < #i6)) ∧
                         (#j1 < #l1)) ∧
                        (#j2 < #l2)) ∧
                       (#j3 < #l3)) ∧
                      (#j4 < #l4)) ∧
                     (#j5 < #l5)) ∧
                    (#j6 < #l6)) ∧
                   (#j7 < #l7)) ∧
                  (∀ a #k. (Init( 'K_AMF', a ) @ #k) ⇒ (#k = #i1))) ∧
                 (∀ a #k. (RadioAccessNetwork( a ) @ #k) ⇒ ((#k = #i2) ∨ (#k = #i3)))) ∧
                (∀ a b c #k. (HandoverInit( a, b, c ) @ #k) ⇒ (#k = #i5))) ∧
               (∀ a b c d #k.
                 (SessionHandover( a, b, c, d ) @ #k) ⇒ ((#k = #i4) ∨ (#k = #i6)))) ∧
              (∀ a b #k. (NoRekeyingCN( a, b ) @ #k) ⇒ ((#k = #j1) ∨ (#k = #l1)))) ∧
             (∀ a b #k.
               (HandoverPreparationDone( a, b ) @ #k) ⇒ ((#k = #j2) ∨ (#k = #l2)))) ∧
            (∀ a b #k. (NoRekeyingUE( a, b ) @ #k) ⇒ ((#k = #j3) ∨ (#k = #l3)))) ∧
           (∀ a b #k.
             (HandoverExecutionDone( '1', a, b ) @ #k) ⇒ ((#k = #j4) ∨ (#k = #l4)))) ∧
          (∀ a b #k.
            (NoIdentityRequests( a, b ) @ #k) ⇒ ((#k = #j5) ∨ (#k = #l5)))) ∧
         (∀ a b #k.
           (MobilityRegistrationUpdateDone( a, b ) @ #k) ⇒
           ((#k = #j6) ∨ (#k = #l6)))) ∧
        (∀ a b #k.
          (HandoverExecutionDone( '2', a, b ) @ #k) ⇒ ((#k = #j7) ∨ (#k = #l7)))) ∧
       (∀ a b #k1 #k2.
         ((CoreNetwork( a ) @ #k1) ∧ (CoreNetwork( b ) @ #k2)) ⇒ (#k1 = #k2))) ∧
      (∀ a b #k1 #k2.
        ((HomeNetwork( a ) @ #k1) ∧ (HomeNetwork( b ) @ #k2)) ⇒ (#k1 = #k2))) ∧
     (∀ a b #k1 #k2.
       ((UserEquipment( a ) @ #k1) ∧ (UserEquipment( b ) @ #k2)) ⇒
       (#k1 = #k2))) ∧
    (∀ a b c d #k1 #k2.
      ((Subscribe( a, b ) @ #k1) ∧ (Subscribe( c, d ) @ #k2)) ⇒ (#k1 = #k2))"
/*
guarded formula characterizing all satisfying traces:
"∃ x1 x2 y1 y2 s t #i1 #i2 #i3 #i4 #i5 #i6 #j1 #j2 #j3 #j4 #j5 #j6 #j7
   #l1 #l2 #l3 #l4 #l5 #l6 #l7.
  (Init( 'K_AMF', x1 ) @ #i1) ∧
  (RadioAccessNetwork( s ) @ #i2) ∧
  (RadioAccessNetwork( t ) @ #i3) ∧
  (SessionHandover( <s, t>, x1, x1, y1 ) @ #i4) ∧
  (HandoverInit( <s, t>, x1, x2 ) @ #i5) ∧
  (SessionHandover( <t, s>, x2, x2, y2 ) @ #i6) ∧
  (NoRekeyingCN( x1, y1 ) @ #j1) ∧
  (HandoverPreparationDone( x1, y1 ) @ #j2) ∧
  (NoRekeyingUE( x1, y1 ) @ #j3) ∧
  (HandoverExecutionDone( '1', x1, y1 ) @ #j4) ∧
  (NoIdentityRequests( x1, y1 ) @ #j5) ∧
  (MobilityRegistrationUpdateDone( x1, y1 ) @ #j6) ∧
  (HandoverExecutionDone( '2', x1, y1 ) @ #j7) ∧
  (NoRekeyingCN( x2, y2 ) @ #l1) ∧
  (HandoverPreparationDone( x2, y2 ) @ #l2) ∧
  (NoRekeyingUE( x2, y2 ) @ #l3) ∧
  (HandoverExecutionDone( '1', x2, y2 ) @ #l4) ∧
  (NoIdentityRequests( x2, y2 ) @ #l5) ∧
  (MobilityRegistrationUpdateDone( x2, y2 ) @ #l6) ∧
  (HandoverExecutionDone( '2', x2, y2 ) @ #l7)
 ∧
  (∀ X data #r. (Rev( X, data ) @ #r) ⇒ ⊥) ∧
  (¬(y1 = y2)) ∧
  (∀ a b #k. (IdentityRequestSUCI( a, b ) @ #k) ⇒ ⊥) ∧
  (∀ a b #k. (IdentityResponseSUCI( a, b ) @ #k) ⇒ ⊥) ∧
  (∀ a b #k. (IdentityRequestPEI( a, b ) @ #k) ⇒ ⊥) ∧
  (∀ a b #k. (IdentityResponsePEI( a, b ) @ #k) ⇒ ⊥) ∧
  (∀ a b #k. (RekeyingCN( a, b ) @ #k) ⇒ ⊥) ∧
  (∀ a b #k. (RekeyingUE( a, b ) @ #k) ⇒ ⊥) ∧
  (∀ a b #k. (IdentityRequestsDone( a, b ) @ #k) ⇒ ⊥) ∧
  (#i4 < #i5) ∧
  (#i5 < #i6) ∧
  (#j1 < #l1) ∧
  (#j2 < #l2) ∧
  (#j3 < #l3) ∧
  (#j4 < #l4) ∧
  (#j5 < #l5) ∧
  (#j6 < #l6) ∧
  (#j7 < #l7) ∧
  (∀ a #k. (Init( 'K_AMF', a ) @ #k) ⇒ #k = #i1) ∧
  (∀ a #k. (RadioAccessNetwork( a ) @ #k) ⇒ ((#k = #i2) ∨ (#k = #i3))) ∧
  (∀ a b c #k. (HandoverInit( a, b, c ) @ #k) ⇒ #k = #i5) ∧
  (∀ a b c d #k.
    (SessionHandover( a, b, c, d ) @ #k) ⇒ ((#k = #i4) ∨ (#k = #i6))) ∧
  (∀ a b #k. (NoRekeyingCN( a, b ) @ #k) ⇒ ((#k = #j1) ∨ (#k = #l1))) ∧
  (∀ a b #k.
    (HandoverPreparationDone( a, b ) @ #k) ⇒ ((#k = #j2) ∨ (#k = #l2))) ∧
  (∀ a b #k. (NoRekeyingUE( a, b ) @ #k) ⇒ ((#k = #j3) ∨ (#k = #l3))) ∧
  (∀ a b #k.
    (HandoverExecutionDone( '1', a, b ) @ #k) ⇒ ((#k = #j4) ∨ (#k = #l4))) ∧
  (∀ a b #k.
    (NoIdentityRequests( a, b ) @ #k) ⇒ ((#k = #j5) ∨ (#k = #l5))) ∧
  (∀ a b #k.
    (MobilityRegistrationUpdateDone( a, b ) @ #k)
   ⇒
    ((#k = #j6) ∨ (#k = #l6))) ∧
  (∀ a b #k.
    (HandoverExecutionDone( '2', a, b ) @ #k) ⇒ ((#k = #j7) ∨ (#k = #l7))) ∧
  (∀ a b #k1 #k2.
    (CoreNetwork( a ) @ #k1) ∧ (CoreNetwork( b ) @ #k2) ⇒ #k1 = #k2) ∧
  (∀ a b #k1 #k2.
    (HomeNetwork( a ) @ #k1) ∧ (HomeNetwork( b ) @ #k2) ⇒ #k1 = #k2) ∧
  (∀ a b #k1 #k2.
    (UserEquipment( a ) @ #k1) ∧ (UserEquipment( b ) @ #k2) ⇒ #k1 = #k2) ∧
  (∀ a b c d #k1 #k2.
    (Subscribe( a, b ) @ #k1) ∧ (Subscribe( c, d ) @ #k2) ⇒ #k1 = #k2)"
*/
by sorry

lemma executability_old_kamf_new_kamf_no_id_req:
  exists-trace
  "∃ x1 x2 x3 y1 y2 s t #i1 #i2 #i3 #i4 #i5 #i6 #j1 #j2 #j3 #j4 #j5 #j6 #j7
     #l1 #l2 #l3 #l4 #l5 #l6 #l7.
    ((((((((((((((((((((((((((((((((((((((((((((((((((((Init( 'K_AMF', x1
                                                        ) @ #i1) ∧
                                                       (RadioAccessNetwork( s ) @ #i2)) ∧
                                                      (RadioAccessNetwork( t ) @ #i3)) ∧
                                                     (SessionHandover( <s, t>, x1, x1, y1 ) @ #i4)) ∧
                                                    (HandoverInit( <s, t>, x1, x2 ) @ #i5)) ∧
                                                   (SessionHandover( <t, s>, x2, x3, y2 ) @ #i6)) ∧
                                                  (NoRekeyingCN( x1, y1 ) @ #j1)) ∧
                                                 (HandoverPreparationDone( x1, y1 ) @ #j2)) ∧
                                                (NoRekeyingUE( x1, y1 ) @ #j3)) ∧
                                               (HandoverExecutionDone( '1', x1, y1 ) @ #j4)) ∧
                                              (NoIdentityRequests( x1, y1 ) @ #j5)) ∧
                                             (MobilityRegistrationUpdateDone( x1, y1 ) @ #j6)) ∧
                                            (HandoverExecutionDone( '2', x1, y1 ) @ #j7)) ∧
                                           (RekeyingCN( x3, y2 ) @ #l1)) ∧
                                          (HandoverPreparationDone( x3, y2 ) @ #l2)) ∧
                                         (RekeyingUE( x3, y2 ) @ #l3)) ∧
                                        (HandoverExecutionDone( '1', x3, y2 ) @ #l4)) ∧
                                       (NoIdentityRequests( x3, y2 ) @ #l5)) ∧
                                      (MobilityRegistrationUpdateDone( x3, y2 ) @ #l6)) ∧
                                     (HandoverExecutionDone( '2', x3, y2 ) @ #l7)) ∧
                                    (¬(∃ X data #r. Rev( X, data ) @ #r))) ∧
                                   (¬(y1 = y2))) ∧
                                  (¬(∃ a b #k. IdentityRequestSUCI( a, b ) @ #k))) ∧
                                 (¬(∃ a b #k. IdentityResponseSUCI( a, b ) @ #k))) ∧
                                (¬(∃ a b #k. IdentityRequestPEI( a, b ) @ #k))) ∧
                               (¬(∃ a b #k. IdentityResponsePEI( a, b ) @ #k))) ∧
                              (¬(∃ a b #k. IdentityRequestsDone( a, b ) @ #k))) ∧
                             (#i4 < #i5)) ∧
                            (#i5 < #i6)) ∧
                           (#j1 < #l1)) ∧
                          (#j2 < #l2)) ∧
                         (#j3 < #l3)) ∧
                        (#j4 < #l4)) ∧
                       (#j5 < #l5)) ∧
                      (#j6 < #l6)) ∧
                     (#j7 < #l7)) ∧
                    (∀ a #k. (Init( 'K_AMF', a ) @ #k) ⇒ (#k = #i1))) ∧
                   (∀ a #k. (RadioAccessNetwork( a ) @ #k) ⇒ ((#k = #i2) ∨ (#k = #i3)))) ∧
                  (∀ a b c #k. (HandoverInit( a, b, c ) @ #k) ⇒ (#k = #i5))) ∧
                 (∀ a b c d #k.
                   (SessionHandover( a, b, c, d ) @ #k) ⇒ ((#k = #i4) ∨ (#k = #i6)))) ∧
                (∀ a b #k. (NoRekeyingCN( a, b ) @ #k) ⇒ (#k = #j1))) ∧
               (∀ a b #k. (RekeyingCN( a, b ) @ #k) ⇒ (#k = #l1))) ∧
              (∀ a b #k.
                (HandoverPreparationDone( a, b ) @ #k) ⇒ ((#k = #j2) ∨ (#k = #l2)))) ∧
             (∀ a b #k. (NoRekeyingUE( a, b ) @ #k) ⇒ (#k = #j3))) ∧
            (∀ a b #k. (RekeyingUE( a, b ) @ #k) ⇒ (#k = #l3))) ∧
           (∀ a b #k.
             (HandoverExecutionDone( '1', a, b ) @ #k) ⇒ ((#k = #j4) ∨ (#k = #l4)))) ∧
          (∀ a b #k.
            (NoIdentityRequests( a, b ) @ #k) ⇒ ((#k = #j5) ∨ (#k = #l5)))) ∧
         (∀ a b #k.
           (MobilityRegistrationUpdateDone( a, b ) @ #k) ⇒
           ((#k = #j6) ∨ (#k = #l6)))) ∧
        (∀ a b #k.
          (HandoverExecutionDone( '2', a, b ) @ #k) ⇒ ((#k = #j7) ∨ (#k = #l7)))) ∧
       (∀ a b #k1 #k2.
         ((CoreNetwork( a ) @ #k1) ∧ (CoreNetwork( b ) @ #k2)) ⇒ (#k1 = #k2))) ∧
      (∀ a b #k1 #k2.
        ((HomeNetwork( a ) @ #k1) ∧ (HomeNetwork( b ) @ #k2)) ⇒ (#k1 = #k2))) ∧
     (∀ a b #k1 #k2.
       ((UserEquipment( a ) @ #k1) ∧ (UserEquipment( b ) @ #k2)) ⇒
       (#k1 = #k2))) ∧
    (∀ a b c d #k1 #k2.
      ((Subscribe( a, b ) @ #k1) ∧ (Subscribe( c, d ) @ #k2)) ⇒ (#k1 = #k2))"
