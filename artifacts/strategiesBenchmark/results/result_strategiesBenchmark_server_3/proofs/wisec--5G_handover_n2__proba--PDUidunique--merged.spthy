  (∀ a b #k. (IdentityRequestsDone( a, b ) @ #k) ⇒ ⊥) ∧
  (∀ a #k. (Init( 'K_AMF', a ) @ #k) ⇒ #k = #i1) ∧
  (∀ a #k. (RadioAccessNetwork( a ) @ #k) ⇒ ((#k = #i2) ∨ (#k = #i3))) ∧
  (∀ a b c d #k. (SessionHandover( a, b, c, d ) @ #k) ⇒ #k = #i4) ∧
  (∀ a b #k. (NoRekeyingCN( a, b ) @ #k) ⇒ #k = #j1) ∧
  (∀ a b #k. (HandoverPreparationDone( a, b ) @ #k) ⇒ #k = #j2) ∧
  (∀ a b #k. (NoRekeyingUE( a, b ) @ #k) ⇒ #k = #j3) ∧
  (∀ a b #k. (HandoverExecutionDone( '1', a, b ) @ #k) ⇒ #k = #j4) ∧
  (∀ a b #k. (NoIdentityRequests( a, b ) @ #k) ⇒ #k = #j5) ∧
  (∀ a b #k. (MobilityRegistrationUpdateDone( a, b ) @ #k) ⇒ #k = #j6) ∧
  (∀ a b #k. (HandoverExecutionDone( '2', a, b ) @ #k) ⇒ #k = #j7) ∧
  (∀ a b #k1 #k2.
    (CoreNetwork( a ) @ #k1) ∧ (CoreNetwork( b ) @ #k2) ⇒ #k1 = #k2) ∧
  (∀ a b #k1 #k2.
    (HomeNetwork( a ) @ #k1) ∧ (HomeNetwork( b ) @ #k2) ⇒ #k1 = #k2) ∧
  (∀ a b #k1 #k2.
    (UserEquipment( a ) @ #k1) ∧ (UserEquipment( b ) @ #k2) ⇒ #k1 = #k2) ∧
  (∀ a b c d #k1 #k2.
    (Subscribe( a, b ) @ #k1) ∧ (Subscribe( c, d ) @ #k2) ⇒ #k1 = #k2)"
*/
by sorry

