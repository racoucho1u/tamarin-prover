lemma executability_new_kamf_no_id_req:
  exists-trace
  "∃ x0 x1 y1 s t #i1 #i2 #i3 #i4 #j1 #j2 #j3 #j4 #j5 #j6 #j7.
    (((((((((((((((((((((((((((((((((Init( 'K_AMF', x0 ) @ #i1) ∧
                                    (RadioAccessNetwork( s ) @ #i2)) ∧
                                   (RadioAccessNetwork( t ) @ #i3)) ∧
                                  (SessionHandover( <s, t>, x0, x1, y1 ) @ #i4)) ∧
                                 (RekeyingCN( x1, y1 ) @ #j1)) ∧
                                (HandoverPreparationDone( x1, y1 ) @ #j2)) ∧
                               (RekeyingUE( x1, y1 ) @ #j3)) ∧
                              (HandoverExecutionDone( '1', x1, y1 ) @ #j4)) ∧
                             (NoIdentityRequests( x1, y1 ) @ #j5)) ∧
                            (MobilityRegistrationUpdateDone( x1, y1 ) @ #j6)) ∧
                           (HandoverExecutionDone( '2', x1, y1 ) @ #j7)) ∧
                          (¬(∃ X data #r. Rev( X, data ) @ #r))) ∧
                         (¬(∃ a b #k. IdentityRequestSUCI( a, b ) @ #k))) ∧
                        (¬(∃ a b #k. IdentityResponseSUCI( a, b ) @ #k))) ∧
                       (¬(∃ a b #k. IdentityRequestPEI( a, b ) @ #k))) ∧
                      (¬(∃ a b #k. IdentityResponsePEI( a, b ) @ #k))) ∧
                     (¬(∃ a b #k. NoRekeyingCN( a, b ) @ #k))) ∧
                    (¬(∃ a b #k. NoRekeyingUE( a, b ) @ #k))) ∧
                   (¬(∃ a b #k. IdentityRequestsDone( a, b ) @ #k))) ∧
                  (¬(x0 = x1))) ∧
                 (∀ a #k. (Init( 'K_AMF', a ) @ #k) ⇒ (#k = #i1))) ∧
                (∀ a #k. (RadioAccessNetwork( a ) @ #k) ⇒ ((#k = #i2) ∨ (#k = #i3)))) ∧
               (∀ a1 a2 a3 a4 #k.
                 (SessionHandover( a1, a2, a3, a4 ) @ #k) ⇒ (#k = #i4))) ∧
              (∀ a b #k. (RekeyingCN( a, b ) @ #k) ⇒ (#k = #j1))) ∧
             (∀ a b #k. (HandoverPreparationDone( a, b ) @ #k) ⇒ (#k = #j2))) ∧
            (∀ a b #k. (RekeyingUE( a, b ) @ #k) ⇒ (#k = #j3))) ∧
           (∀ a b #k. (HandoverExecutionDone( '1', a, b ) @ #k) ⇒ (#k = #j4))) ∧
          (∀ a b #k. (NoIdentityRequests( a, b ) @ #k) ⇒ (#k = #j5))) ∧
         (∀ a b #k. (MobilityRegistrationUpdateDone( a, b ) @ #k) ⇒ (#k = #j6))) ∧
        (∀ a b #k. (HandoverExecutionDone( '2', a, b ) @ #k) ⇒ (#k = #j7))) ∧
       (∀ a1 a2 #k1 #k2.
         ((CoreNetwork( a1 ) @ #k1) ∧ (CoreNetwork( a2 ) @ #k2)) ⇒ (#k1 = #k2))) ∧
      (∀ a1 a2 #k1 #k2.
        ((HomeNetwork( a1 ) @ #k1) ∧ (HomeNetwork( a2 ) @ #k2)) ⇒ (#k1 = #k2))) ∧
     (∀ a1 a2 #k1 #k2.
       ((UserEquipment( a1 ) @ #k1) ∧ (UserEquipment( a2 ) @ #k2)) ⇒
       (#k1 = #k2))) ∧
    (∀ a1 a2 a3 a4 #k1 #k2.
      ((Subscribe( a1, a2 ) @ #k1) ∧ (Subscribe( a3, a4 ) @ #k2)) ⇒
      (#k1 = #k2))"
/*
guarded formula characterizing all satisfying traces:
"∃ x0 x1 y1 s t #i1 #i2 #i3 #i4 #j1 #j2 #j3 #j4 #j5 #j6 #j7.
  (Init( 'K_AMF', x0 ) @ #i1) ∧
  (RadioAccessNetwork( s ) @ #i2) ∧
  (RadioAccessNetwork( t ) @ #i3) ∧
  (SessionHandover( <s, t>, x0, x1, y1 ) @ #i4) ∧
  (RekeyingCN( x1, y1 ) @ #j1) ∧
  (HandoverPreparationDone( x1, y1 ) @ #j2) ∧
  (RekeyingUE( x1, y1 ) @ #j3) ∧
  (HandoverExecutionDone( '1', x1, y1 ) @ #j4) ∧
  (NoIdentityRequests( x1, y1 ) @ #j5) ∧
  (MobilityRegistrationUpdateDone( x1, y1 ) @ #j6) ∧
  (HandoverExecutionDone( '2', x1, y1 ) @ #j7)
 ∧
  (∀ X data #r. (Rev( X, data ) @ #r) ⇒ ⊥) ∧
  (∀ a b #k. (IdentityRequestSUCI( a, b ) @ #k) ⇒ ⊥) ∧
  (∀ a b #k. (IdentityResponseSUCI( a, b ) @ #k) ⇒ ⊥) ∧
  (∀ a b #k. (IdentityRequestPEI( a, b ) @ #k) ⇒ ⊥) ∧
  (∀ a b #k. (IdentityResponsePEI( a, b ) @ #k) ⇒ ⊥) ∧
  (∀ a b #k. (NoRekeyingCN( a, b ) @ #k) ⇒ ⊥) ∧
  (∀ a b #k. (NoRekeyingUE( a, b ) @ #k) ⇒ ⊥) ∧
  (∀ a b #k. (IdentityRequestsDone( a, b ) @ #k) ⇒ ⊥) ∧
  (¬(x0 = x1)) ∧
  (∀ a #k. (Init( 'K_AMF', a ) @ #k) ⇒ #k = #i1) ∧
  (∀ a #k. (RadioAccessNetwork( a ) @ #k) ⇒ ((#k = #i2) ∨ (#k = #i3))) ∧
  (∀ a1 a2 a3 a4 #k. (SessionHandover( a1, a2, a3, a4 ) @ #k) ⇒ #k = #i4) ∧
  (∀ a b #k. (RekeyingCN( a, b ) @ #k) ⇒ #k = #j1) ∧
  (∀ a b #k. (HandoverPreparationDone( a, b ) @ #k) ⇒ #k = #j2) ∧
  (∀ a b #k. (RekeyingUE( a, b ) @ #k) ⇒ #k = #j3) ∧
  (∀ a b #k. (HandoverExecutionDone( '1', a, b ) @ #k) ⇒ #k = #j4) ∧
  (∀ a b #k. (NoIdentityRequests( a, b ) @ #k) ⇒ #k = #j5) ∧
  (∀ a b #k. (MobilityRegistrationUpdateDone( a, b ) @ #k) ⇒ #k = #j6) ∧
  (∀ a b #k. (HandoverExecutionDone( '2', a, b ) @ #k) ⇒ #k = #j7) ∧
  (∀ a1 a2 #k1 #k2.
    (CoreNetwork( a1 ) @ #k1) ∧ (CoreNetwork( a2 ) @ #k2) ⇒ #k1 = #k2) ∧
  (∀ a1 a2 #k1 #k2.
    (HomeNetwork( a1 ) @ #k1) ∧ (HomeNetwork( a2 ) @ #k2) ⇒ #k1 = #k2) ∧
  (∀ a1 a2 #k1 #k2.
    (UserEquipment( a1 ) @ #k1) ∧ (UserEquipment( a2 ) @ #k2) ⇒ #k1 = #k2) ∧
  (∀ a1 a2 a3 a4 #k1 #k2.
    (Subscribe( a1, a2 ) @ #k1) ∧ (Subscribe( a3, a4 ) @ #k2) ⇒ #k1 = #k2)"
*/
by sorry

lemma executability_new_kamf_id_req:
  exists-trace
  "∃ x0 x1 y1 s t #i1 #i2 #i3 #i4 #j1 #j2 #j3 #j4 #j5 #j6 #j7 #j8 #j9 #j10
     #j11.
    (((((((((((((((((((((((((((((((((((((Init( 'K_AMF', x0 ) @ #i1) ∧
                                        (RadioAccessNetwork( s ) @ #i2)) ∧
                                       (RadioAccessNetwork( t ) @ #i3)) ∧
                                      (SessionHandover( <s, t>, x0, x1, y1 ) @ #i4)) ∧
                                     (RekeyingCN( x1, y1 ) @ #j1)) ∧
                                    (HandoverPreparationDone( x1, y1 ) @ #j2)) ∧
                                   (RekeyingUE( x1, y1 ) @ #j3)) ∧
                                  (HandoverExecutionDone( '1', x1, y1 ) @ #j4)) ∧
                                 (IdentityRequestSUCI( x1, y1 ) @ #j5)) ∧
                                (IdentityResponseSUCI( x1, y1 ) @ #j6)) ∧
                               (IdentityRequestPEI( x1, y1 ) @ #j7)) ∧
                              (IdentityResponsePEI( x1, y1 ) @ #j8)) ∧
                             (IdentityRequestsDone( x1, y1 ) @ #j9)) ∧
                            (MobilityRegistrationUpdateDone( x1, y1 ) @ #j10)) ∧
                           (HandoverExecutionDone( '2', x1, y1 ) @ #j11)) ∧
                          (¬(∃ X data #r. Rev( X, data ) @ #r))) ∧
                         (¬(∃ a b #k. NoRekeyingCN( a, b ) @ #k))) ∧
                        (¬(∃ a b #k. NoRekeyingUE( a, b ) @ #k))) ∧
                       (¬(∃ a b #k. NoIdentityRequests( a, b ) @ #k))) ∧
                      (¬(x0 = x1))) ∧
                     (∀ a #k. (Init( 'K_AMF', a ) @ #k) ⇒ (#k = #i1))) ∧
                    (∀ a #k. (RadioAccessNetwork( a ) @ #k) ⇒ ((#k = #i2) ∨ (#k = #i3)))) ∧
                   (∀ a1 a2 a3 a4 #k.
                     (SessionHandover( a1, a2, a3, a4 ) @ #k) ⇒ (#k = #i4))) ∧
                  (∀ a b #k. (RekeyingCN( a, b ) @ #k) ⇒ (#k = #j1))) ∧
                 (∀ a b #k. (HandoverPreparationDone( a, b ) @ #k) ⇒ (#k = #j2))) ∧
                (∀ a b #k. (RekeyingUE( a, b ) @ #k) ⇒ (#k = #j3))) ∧
               (∀ a b #k. (HandoverExecutionDone( '1', a, b ) @ #k) ⇒ (#k = #j4))) ∧
              (∀ a b #k. (IdentityRequestSUCI( a, b ) @ #k) ⇒ (#k = #j5))) ∧
             (∀ a b #k. (IdentityResponseSUCI( a, b ) @ #k) ⇒ (#k = #j6))) ∧
            (∀ a b #k. (IdentityRequestPEI( a, b ) @ #k) ⇒ (#k = #j7))) ∧
           (∀ a b #k. (IdentityResponsePEI( a, b ) @ #k) ⇒ (#k = #j8))) ∧
          (∀ a b #k. (IdentityRequestsDone( a, b ) @ #k) ⇒ (#k = #j9))) ∧
         (∀ a b #k.
           (MobilityRegistrationUpdateDone( a, b ) @ #k) ⇒ (#k = #j10))) ∧
        (∀ a b #k. (HandoverExecutionDone( '2', a, b ) @ #k) ⇒ (#k = #j11))) ∧
       (∀ a1 a2 #k1 #k2.
         ((CoreNetwork( a1 ) @ #k1) ∧ (CoreNetwork( a2 ) @ #k2)) ⇒ (#k1 = #k2))) ∧
      (∀ a1 a2 #k1 #k2.
        ((HomeNetwork( a1 ) @ #k1) ∧ (HomeNetwork( a2 ) @ #k2)) ⇒ (#k1 = #k2))) ∧
     (∀ a1 a2 #k1 #k2.
       ((UserEquipment( a1 ) @ #k1) ∧ (UserEquipment( a2 ) @ #k2)) ⇒
       (#k1 = #k2))) ∧
    (∀ a1 a2 a3 a4 #k1 #k2.
      ((Subscribe( a1, a2 ) @ #k1) ∧ (Subscribe( a3, a4 ) @ #k2)) ⇒
      (#k1 = #k2))"
/*
guarded formula characterizing all satisfying traces:
"∃ x0 x1 y1 s t #i1 #i2 #i3 #i4 #j1 #j2 #j3 #j4 #j5 #j6 #j7 #j8 #j9 #j10
   #j11.
  (Init( 'K_AMF', x0 ) @ #i1) ∧
  (RadioAccessNetwork( s ) @ #i2) ∧
  (RadioAccessNetwork( t ) @ #i3) ∧
  (SessionHandover( <s, t>, x0, x1, y1 ) @ #i4) ∧
