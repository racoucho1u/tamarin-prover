rule (modulo E) init_next_handover:
   [
   St_4_TRAN( ~TRAN_ID, ~SRAN_ID ),
   St_5_UE( ~SUPI, ~5G_GUTI, ~K_SEAF_initial, ~TRAN_ID, ~CN_ID, ~HN_ID ),
   St_10_CN( ~CN_ID, K_AMF_OLD, ~SRAN_ID, ~TRAN_ID, ~PDU_SESSION_ID, ~HN_ID
   ),
   !NG_RAN( ~RAN_ID ), !UE( ~SUPI, ~PEI, ~CN_ID ),
   PDU_Session( ~PDU_SESSION_ID, ~CN_ID, ~SUPI, ~TRAN_ID ), Fr( ~K_SEAF )
   ]
  --[
  HandoverInit( <~SRAN_ID, ~TRAN_ID>, K_AMF_OLD, KDF(~K_SEAF, ~SUPI) ),
  ResetValues( <~SUPI, ~K_SEAF, KDF(~K_SEAF, ~SUPI)> ),
  Reset( ~K_SEAF_initial, ~SUPI ),
  UsePDUSession( ~PDU_SESSION_ID, <~CN_ID, ~SUPI, ~TRAN_ID> ),
  KeyDerived( <'K_AMF', KDF(~K_SEAF, ~SUPI)>, ~K_SEAF, KDF(~K_SEAF, ~SUPI),
              ~SUPI
  ),
  KeyDerived( <'K_gNB', KDF(KDF(~K_SEAF, ~SUPI), 'MAX_NAS_COUNT')>,
              ~K_SEAF, KDF(~K_SEAF, ~SUPI), ~SUPI
  ),
  GUTI( ~5G_GUTI ), SEAF( ~K_SEAF ), SUPI( ~SUPI )
  ]->
   [
   !Ltk_sym( ~SUPI, ~CN_ID, <'K_SEAF', ~K_SEAF> ),
   Session_key( ~SUPI, ~CN_ID, <'K_AMF', KDF(~K_SEAF, ~SUPI)> ),
   Session_key( ~SUPI, ~TRAN_ID,
                <'K_gNB', KDF(KDF(~K_SEAF, ~SUPI), 'MAX_NAS_COUNT')>
   ),
   Intermediate_key( ~SUPI, ~TRAN_ID, ~CN_ID,
                     <'NH', 
                      KDF(KDF(~K_SEAF, ~SUPI), KDF(KDF(~K_SEAF, ~SUPI), 'MAX_NAS_COUNT'))>
   ),
   PDU_Session( ~PDU_SESSION_ID, ~CN_ID, ~SUPI, ~TRAN_ID ),
   St_1_SRAN( ~TRAN_ID, KDF(KDF(~K_SEAF, ~SUPI), 'MAX_NAS_COUNT'),
              ~PDU_SESSION_ID, ~RAN_ID
   ),
   St_1_UE( ~SUPI, ~5G_GUTI, ~K_SEAF_initial, ~K_SEAF, KDF(~K_SEAF, ~SUPI),
            KDF(KDF(~K_SEAF, ~SUPI), 'MAX_NAS_COUNT'),
            KDF(KDF(~K_SEAF, ~SUPI), 'MAX_NAS_COUNT'), '0', ~TRAN_ID, ~CN_ID, ~HN_ID
   ),
   St_1_CN( ~CN_ID, ~K_SEAF, KDF(~K_SEAF, ~SUPI), ~TRAN_ID, ~RAN_ID,
            ~PDU_SESSION_ID,
            KDF(KDF(~K_SEAF, ~SUPI), KDF(KDF(~K_SEAF, ~SUPI), 'MAX_NAS_COUNT')), '0',
            ~HN_ID
   )
   ]

  // loop breaker: [5]
  /* has exactly the trivial AC variant */

lemma GUTI_SRC [sources]:
  all-traces
  "∀ g #i.
    (GUTI_RCV( g ) @ #i) ⇒
    ((∃ #j. (GUTI_SND( g ) @ #j) ∧ (#j < #i)) ∨
     (∃ #k. (!KU( g ) @ #k) ∧ (#k < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ g #i.
  (GUTI_RCV( g ) @ #i)
 ∧
  (∀ #j. (GUTI_SND( g ) @ #j) ⇒ ¬(#j < #i)) ∧
  (∀ #k. (!KU( g ) @ #k) ⇒ ¬(#k < #i))"
*/
by sorry

restriction OnlyOnce:
  "∀ p q #i #j.
    ((OnlyOnce( p, q ) @ #i) ∧ (OnlyOnce( p, q ) @ #j)) ⇒ (#i = #j)"
  // safety formula

restriction GUTInotSEAF:
  "∀ p #i #j. ((GUTI( p ) @ #i) ∧ (SEAF( p ) @ #j)) ⇒ (⊥)"
  // safety formula

restriction GUTInotSUPI:
  "∀ p #i #j. ((GUTI( p ) @ #i) ∧ (SUPI( p ) @ #j)) ⇒ (⊥)"
  // safety formula

restriction GUTInotSKHN:
  "∀ p #i #j. ((GUTI( p ) @ #i) ∧ (SKHN( p ) @ #j)) ⇒ (⊥)"
  // safety formula

restriction SEAFnotSUPI:
  "∀ p #i #j. ((SEAF( p ) @ #i) ∧ (SUPI( p ) @ #j)) ⇒ (⊥)"
  // safety formula

restriction SEAFnotHN:
  "∀ p #i #j. ((SEAF( p ) @ #i) ∧ (HN( p ) @ #j)) ⇒ (⊥)"
  // safety formula

restriction CIDnotSUPI:
  "∀ p #i #j. ((CID( p ) @ #i) ∧ (SUPI( p ) @ #j)) ⇒ (⊥)"
  // safety formula

restriction PDUnotSUPI:
  "∀ p #i #j. ((PDU( p ) @ #i) ∧ (SUPI( p ) @ #j)) ⇒ (⊥)"
  // safety formula

restriction SKHNnotSUPI:
  "∀ p #i #j. ((SKHN( p ) @ #i) ∧ (SUPI( p ) @ #j)) ⇒ (⊥)"
  // safety formula

lemma PDUorigin [use_induction, reuse]:
  all-traces
  "∀ p q #i.
    (UsePDUSession( p, q ) @ #i) ⇒ (∃ #j. CreatePDUSession( p, q ) @ #j)"
/*
guarded formula characterizing all counter-examples:
"∃ p q #i.
  (UsePDUSession( p, q ) @ #i) ∧ ∀ #j. (CreatePDUSession( p, q ) @ #j) ⇒ ⊥"
*/
by sorry

lemma PDUargsconstant [use_induction, reuse]:
  all-traces
  "∀ p q r #i #j.
    ((UsePDUSession( p, q ) @ #i) ∧ (UsePDUSession( p, r ) @ #j)) ⇒ (q = r)"
/*
guarded formula characterizing all counter-examples:
"∃ p q r #i #j.
  (UsePDUSession( p, q ) @ #i) ∧ (UsePDUSession( p, r ) @ #j) ∧ ¬(q = r)"
*/
by sorry

lemma PDUidunique [use_induction, reuse]:
  all-traces
  "∀ p q r #i #j.
    ((CreatePDUSession( p, q ) @ #i) ∧ (CreatePDUSession( p, r ) @ #j)) ⇒
    (q = r)"
/*
guarded formula characterizing all counter-examples:
"∃ p q r #i #j.
  (CreatePDUSession( p, q ) @ #i) ∧ (CreatePDUSession( p, r ) @ #j)
 ∧
  ¬(q = r)"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  solve( (last(#j))  ∥ (last(#i))  ∥ (q = r) )
    case case_1
    solve( CreatePDUSession( p, q ) @ #i )
      case cn_fwd_ho_req_hkd_new_kamf
      solve( !UE( ~SUPI, ~PEI, ~CN_ID ) ▶₁ #i )
        case create_UE
        solve( !N2( ~cid_N2_SRAN, ~SRAN_ID, ~CN_ID ) ▶₂ #i )
          case connect_networks_N2
          solve( !N2( ~cid_N2_TRAN, ~TRAN_ID, ~CN_ID ) ▶₃ #i )
            case connect_networks_N2
            solve( CreatePDUSession( ~PDU_SESSION_ID_TRAN, r ) @ #j )
              case cn_fwd_ho_req_hkd_new_kamf
              by contradiction /* from formulas */
            qed
          qed
        qed
      qed
    next
      case cn_fwd_ho_req_hkd_old_kamf
      solve( !N2( ~cid_N2_SRAN, ~SRAN_ID, ~CN_ID ) ▶₁ #i )
        case connect_networks_N2
        solve( !N2( ~cid_N2_TRAN, ~TRAN_ID, ~CN_ID ) ▶₂ #i )
          case connect_networks_N2
          solve( CreatePDUSession( ~PDU_SESSION_ID_TRAN, r ) @ #j )
            case cn_fwd_ho_req_hkd_old_kamf
            by contradiction /* from formulas */
          qed
        qed
      qed
    next
      case init_UE
      solve( !UE( ~SUPI, ~PEI, ~CN_ID ) ▶₀ #i )
        case create_UE
        solve( !CN( ~CN_ID ) ▶₁ #i )
          case init_CN
          solve( !HSS( ~HN_ID, ~sk_HN ) ▶₂ #i )
            case init_HN
            solve( !NG_RAN( ~SRAN_ID ) ▶₃ #i )
              case init_RAN
              solve( !NG_RAN( ~TRAN_ID ) ▶₄ #i )
                case init_RAN
                solve( CreatePDUSession( ~PDU_SESSION_ID, r ) @ #j )
                  case init_UE
                  by contradiction /* from formulas */
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  next
    case case_2
    solve( CreatePDUSession( p, q ) @ #i )
      case cn_fwd_ho_req_hkd_new_kamf
      solve( !UE( ~SUPI, ~PEI, ~CN_ID ) ▶₁ #i )
        case create_UE
        solve( !N2( ~cid_N2_SRAN, ~SRAN_ID, ~CN_ID ) ▶₂ #i )
          case connect_networks_N2
          solve( !N2( ~cid_N2_TRAN, ~TRAN_ID, ~CN_ID ) ▶₃ #i )
            case connect_networks_N2
            solve( CreatePDUSession( ~PDU_SESSION_ID_TRAN, r ) @ #j )
              case cn_fwd_ho_req_hkd_new_kamf
              by contradiction /* from formulas */
            qed
          qed
        qed
      qed
    next
      case cn_fwd_ho_req_hkd_old_kamf
      solve( !N2( ~cid_N2_SRAN, ~SRAN_ID, ~CN_ID ) ▶₁ #i )
        case connect_networks_N2
        solve( !N2( ~cid_N2_TRAN, ~TRAN_ID, ~CN_ID ) ▶₂ #i )
          case connect_networks_N2
          solve( CreatePDUSession( ~PDU_SESSION_ID_TRAN, r ) @ #j )
            case cn_fwd_ho_req_hkd_old_kamf
            by contradiction /* from formulas */
          qed
        qed
      qed
    next
      case init_UE
      solve( !UE( ~SUPI, ~PEI, ~CN_ID ) ▶₀ #i )
        case create_UE
        solve( !CN( ~CN_ID ) ▶₁ #i )
          case init_CN
          solve( !HSS( ~HN_ID, ~sk_HN ) ▶₂ #i )
            case init_HN
            solve( !NG_RAN( ~SRAN_ID ) ▶₃ #i )
              case init_RAN
              solve( !NG_RAN( ~TRAN_ID ) ▶₄ #i )
                case init_RAN
                solve( CreatePDUSession( ~PDU_SESSION_ID, r ) @ #j )
                  case init_UE
                  by contradiction /* from formulas */
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  next
    case case_3
    by contradiction /* from formulas */
  qed
qed

lemma ValueOrigin [use_induction, reuse]:
  all-traces
  "∀ p #i.
    (UseValues( p ) @ #i) ⇒
    ((∃ #j. CreateValues( p ) @ #j) ∨ (∃ #j. ResetValues( p ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ p #i.
  (UseValues( p ) @ #i)
 ∧
  (∀ #j. (CreateValues( p ) @ #j) ⇒ ⊥) ∧
  (∀ #j. (ResetValues( p ) @ #j) ⇒ ⊥)"
*/
by sorry

lemma ValueReset [use_induction, reuse]:
  all-traces
  "∀ p s #i.
    (Reset( p, s ) @ #i) ⇒
    (∃ #j. (Init( 'K_SEAF', p ) @ #j) ∧ (Init( 'SUPI', s ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ p s #i.
  (Reset( p, s ) @ #i)
 ∧
  ∀ #j. (Init( 'K_SEAF', p ) @ #j) ∧ (Init( 'SUPI', s ) @ #j) ⇒ ⊥"
*/
by sorry

lemma executability_old_kamf_no_id_req:
  exists-trace
  "∃ x y s t #i1 #i2 #i3 #i4 #j1 #j2 #j3 #j4 #j5 #j6 #j7.
    ((((((((((((((((((((((((((((((((Init( 'K_AMF', x ) @ #i1) ∧
                                   (RadioAccessNetwork( s ) @ #i2)) ∧
                                  (RadioAccessNetwork( t ) @ #i3)) ∧
                                 (SessionHandover( <s, t>, x, x, y ) @ #i4)) ∧
                                (NoRekeyingCN( x, y ) @ #j1)) ∧
                               (HandoverPreparationDone( x, y ) @ #j2)) ∧
                              (NoRekeyingUE( x, y ) @ #j3)) ∧
                             (HandoverExecutionDone( '1', x, y ) @ #j4)) ∧
                            (NoIdentityRequests( x, y ) @ #j5)) ∧
                           (MobilityRegistrationUpdateDone( x, y ) @ #j6)) ∧
                          (HandoverExecutionDone( '2', x, y ) @ #j7)) ∧
                         (¬(∃ X data #r. Rev( X, data ) @ #r))) ∧
                        (¬(∃ a b #k. IdentityRequestSUCI( a, b ) @ #k))) ∧
                       (¬(∃ a b #k. IdentityResponseSUCI( a, b ) @ #k))) ∧
                      (¬(∃ a b #k. IdentityRequestPEI( a, b ) @ #k))) ∧
                     (¬(∃ a b #k. IdentityResponsePEI( a, b ) @ #k))) ∧
                    (¬(∃ a b #k. RekeyingCN( a, b ) @ #k))) ∧
                   (¬(∃ a b #k. RekeyingUE( a, b ) @ #k))) ∧
                  (¬(∃ a b #k. IdentityRequestsDone( a, b ) @ #k))) ∧
                 (∀ a #k. (Init( 'K_AMF', a ) @ #k) ⇒ (#k = #i1))) ∧
                (∀ a #k. (RadioAccessNetwork( a ) @ #k) ⇒ ((#k = #i2) ∨ (#k = #i3)))) ∧
               (∀ a b c d #k. (SessionHandover( a, b, c, d ) @ #k) ⇒ (#k = #i4))) ∧
              (∀ a b #k. (NoRekeyingCN( a, b ) @ #k) ⇒ (#k = #j1))) ∧
             (∀ a b #k. (HandoverPreparationDone( a, b ) @ #k) ⇒ (#k = #j2))) ∧
            (∀ a b #k. (NoRekeyingUE( a, b ) @ #k) ⇒ (#k = #j3))) ∧
           (∀ a b #k. (HandoverExecutionDone( '1', a, b ) @ #k) ⇒ (#k = #j4))) ∧
          (∀ a b #k. (NoIdentityRequests( a, b ) @ #k) ⇒ (#k = #j5))) ∧
         (∀ a b #k. (MobilityRegistrationUpdateDone( a, b ) @ #k) ⇒ (#k = #j6))) ∧
        (∀ a b #k. (HandoverExecutionDone( '2', a, b ) @ #k) ⇒ (#k = #j7))) ∧
       (∀ a b #k1 #k2.
         ((CoreNetwork( a ) @ #k1) ∧ (CoreNetwork( b ) @ #k2)) ⇒ (#k1 = #k2))) ∧
      (∀ a b #k1 #k2.
        ((HomeNetwork( a ) @ #k1) ∧ (HomeNetwork( b ) @ #k2)) ⇒ (#k1 = #k2))) ∧
     (∀ a b #k1 #k2.
       ((UserEquipment( a ) @ #k1) ∧ (UserEquipment( b ) @ #k2)) ⇒
       (#k1 = #k2))) ∧
    (∀ a b c d #k1 #k2.
      ((Subscribe( a, b ) @ #k1) ∧ (Subscribe( c, d ) @ #k2)) ⇒ (#k1 = #k2))"
/*
guarded formula characterizing all satisfying traces:
"∃ x y s t #i1 #i2 #i3 #i4 #j1 #j2 #j3 #j4 #j5 #j6 #j7.
  (Init( 'K_AMF', x ) @ #i1) ∧
  (RadioAccessNetwork( s ) @ #i2) ∧
  (RadioAccessNetwork( t ) @ #i3) ∧
  (SessionHandover( <s, t>, x, x, y ) @ #i4) ∧
  (NoRekeyingCN( x, y ) @ #j1) ∧
  (HandoverPreparationDone( x, y ) @ #j2) ∧
  (NoRekeyingUE( x, y ) @ #j3) ∧
  (HandoverExecutionDone( '1', x, y ) @ #j4) ∧
  (NoIdentityRequests( x, y ) @ #j5) ∧
  (MobilityRegistrationUpdateDone( x, y ) @ #j6) ∧
  (HandoverExecutionDone( '2', x, y ) @ #j7)
 ∧
  (∀ X data #r. (Rev( X, data ) @ #r) ⇒ ⊥) ∧
  (∀ a b #k. (IdentityRequestSUCI( a, b ) @ #k) ⇒ ⊥) ∧
  (∀ a b #k. (IdentityResponseSUCI( a, b ) @ #k) ⇒ ⊥) ∧
  (∀ a b #k. (IdentityRequestPEI( a, b ) @ #k) ⇒ ⊥) ∧
  (∀ a b #k. (IdentityResponsePEI( a, b ) @ #k) ⇒ ⊥) ∧
  (∀ a b #k. (RekeyingCN( a, b ) @ #k) ⇒ ⊥) ∧
