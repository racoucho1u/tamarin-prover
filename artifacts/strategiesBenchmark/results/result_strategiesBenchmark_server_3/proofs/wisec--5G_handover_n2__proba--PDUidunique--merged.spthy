theory 5G_n2_handover begin

// Function signature and definition of the equational theory E

builtins: multiset
functions: KDF/2, adec/2, aenc/2, fst/1, pair/2, pk/1, sdec/2, senc/2,
           snd/1
equations:
    adec(aenc(x.1, pk(x.2)), x.2) = x.1,
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2







/* looping facts with injective instances: PDU_Session/4 */







rule (modulo E) send_secure:
   [ SndS( ~cid, A, B, m ) ] --> [ Sec( ~cid, A, B, m ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) receive_secure:
   [ Sec( ~cid, A, B, m ) ] --> [ RcvS( ~cid, A, B, m ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) secureChannel_compromised_in:
   [ In( <~cid, A, B, x> ) ]
  --[ Rev( A, 'secureChannel' ), Rev( B, 'secureChannel' ), Injected( x )
  ]->
   [ Sec( ~cid, A, B, x ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) secureChannel_compromised_out:
   [ Sec( ~cid, A, B, m ) ]
  --[ Rev( B, 'secureChannel' ), Rev( A, 'secureChannel' ) ]->
   [ Out( <~cid, m> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) init_CN:
   [ Fr( ~CN_ID ) ]
  --[ CoreNetwork( ~CN_ID ) ]->
   [ !CN( ~CN_ID ), Out( ~CN_ID ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) init_HN:
   [ Fr( ~sk_HN ), Fr( ~HN_ID ) ]
  --[ HomeNetwork( ~HN_ID ), SKHN( ~sk_HN ) ]->
   [
   !HSS( ~HN_ID, ~sk_HN ), !Pk( ~HN_ID, pk(~sk_HN) ),
   Out( <~HN_ID, pk(~sk_HN)> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) init_RAN:
   [ Fr( ~RAN_ID ) ]
  --[ RadioAccessNetwork( ~RAN_ID ) ]->
   [ !NG_RAN( ~RAN_ID ), Out( ~RAN_ID ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) create_UE:
   [ Fr( ~SUPI ), Fr( ~PEI ), !CN( ~CN_ID ) ]
  --[ UserEquipment( ~SUPI ) ]->
   [ !UE( ~SUPI, ~PEI, ~CN_ID ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) init_UE:
   [
   !UE( ~SUPI, ~PEI, ~CN_ID ), !CN( ~CN_ID ), !HSS( ~HN_ID, ~sk_HN ),
   !NG_RAN( ~SRAN_ID ), !NG_RAN( ~TRAN_ID ), Fr( ~K_SEAF ), Fr( ~5G_GUTI ),
   Fr( ~PDU_SESSION_ID )
   ]
  --[
  Subscribe( ~SUPI, ~SRAN_ID ), HomeNet( ~SUPI, ~HN_ID ),
  CreateValues( <~SUPI, ~K_SEAF, KDF(~K_SEAF, ~SUPI)> ),
  CreatePDUSession( ~PDU_SESSION_ID, <~CN_ID, ~SUPI, ~SRAN_ID> ),
  KeyDerived( <'K_AMF', KDF(~K_SEAF, ~SUPI)>, ~K_SEAF, KDF(~K_SEAF, ~SUPI),
              ~SUPI
  ),
  KeyDerived( <'K_gNB', KDF(KDF(~K_SEAF, ~SUPI), 'MAX_NAS_COUNT')>,
              ~K_SEAF, KDF(~K_SEAF, ~SUPI), ~SUPI
  ),
  Init( 'K_SEAF', ~K_SEAF ), Init( 'K_AMF', KDF(~K_SEAF, ~SUPI) ),
  Init( 'SUPI', ~SUPI ), GUTI( ~5G_GUTI ), HN( ~HN_ID ), SEAF( ~K_SEAF ),
  SUPI( ~SUPI ), PDU( ~PDU_SESSION_ID )
  ]->
   [
   !Ltk_sym( ~SUPI, ~CN_ID, <'K_SEAF', ~K_SEAF> ),
   Session_key( ~SUPI, ~CN_ID, <'K_AMF', KDF(~K_SEAF, ~SUPI)> ),
   Session_key( ~SUPI, ~SRAN_ID,
                <'K_gNB', KDF(KDF(~K_SEAF, ~SUPI), 'MAX_NAS_COUNT')>
   ),
   Intermediate_key( ~SUPI, ~SRAN_ID, ~CN_ID,
                     <'NH', 
                      KDF(KDF(~K_SEAF, ~SUPI), KDF(KDF(~K_SEAF, ~SUPI), 'MAX_NAS_COUNT'))>
   ),
   PDU_Session( ~PDU_SESSION_ID, ~CN_ID, ~SUPI, ~SRAN_ID ),
   St_1_SRAN( ~SRAN_ID, KDF(KDF(~K_SEAF, ~SUPI), 'MAX_NAS_COUNT'),
              ~PDU_SESSION_ID, ~TRAN_ID
   ),
   St_1_UE( ~SUPI, ~5G_GUTI, ~K_SEAF, ~K_SEAF, KDF(~K_SEAF, ~SUPI),
            KDF(KDF(~K_SEAF, ~SUPI), 'MAX_NAS_COUNT'),
            KDF(KDF(~K_SEAF, ~SUPI), 'MAX_NAS_COUNT'), '0', ~SRAN_ID, ~CN_ID, ~HN_ID
   ),
   St_1_CN( ~CN_ID, ~K_SEAF, KDF(~K_SEAF, ~SUPI), ~SRAN_ID, ~TRAN_ID,
            ~PDU_SESSION_ID,
            KDF(KDF(~K_SEAF, ~SUPI), KDF(KDF(~K_SEAF, ~SUPI), 'MAX_NAS_COUNT')), '0',
            ~HN_ID
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) connect_networks_N2:
   [ !NG_RAN( ~RAN_ID ), !CN( ~CN_ID ), Fr( ~cid_N2 ) ]
  --[ OnlyOnce( ~RAN_ID, ~CN_ID ), CID( ~cid_N2 ) ]->
   [ !N2( ~cid_N2, ~RAN_ID, ~CN_ID ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) reveal_sk_HN:
   [ !HSS( ~HN_ID, ~sk_HN ) ]
  --[ Rev( ~HN_ID, <'SK_HN', ~sk_HN> ) ]->
   [ Out( ~sk_HN ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) reveal_supi:
   [ !Ltk_sym( ~SUPI, ~CN_ID, <'K_SEAF', ~K_SEAF> ) ]
  --[ Rev( ~SUPI, <'SUPI', ~SUPI> ), Rev( ~CN_ID, <'SUPI', ~SUPI> ) ]->
   [ Out( ~SUPI ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) reveal_ltk_k_seaf:
   [ !Ltk_sym( ~SUPI, ~CN_ID, <'K_SEAF', ~K_SEAF> ) ]
  --[ Rev( ~SUPI, <'K_SEAF', ~K_SEAF> ), Rev( ~CN_ID, <'K_SEAF', ~K_SEAF> )
  ]->
   [ Out( ~K_SEAF ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) reveal_session_key_k_amf:
   [ Session_key( ~SUPI, ~CN_ID, <'K_AMF', K_AMF> ) ]
  --[ Rev( ~SUPI, <'K_AMF', K_AMF> ), Rev( ~CN_ID, <'K_AMF', K_AMF> ) ]->
   [ Out( K_AMF ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) reveal_session_key_k_gnb:
   [ Session_key( ~SUPI, ~RAN_ID, <'K_gNB', K_gNB> ) ]
  --[ Rev( ~SUPI, <'K_gNB', K_gNB> ), Rev( ~RAN_ID, <'K_gNB', K_gNB> ) ]->
   [ Out( K_gNB ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) reveal_intermediate_key_nh:
   [ Intermediate_key( ~SUPI, ~RAN_ID, ~CN_ID, <'NH', NH> ) ]
  --[
  Rev( ~SUPI, <'NH', NH> ), Rev( ~RAN_ID, <'NH', NH> ),
  Rev( ~CN_ID, <'NH', NH> )
  ]->
   [ Out( NH ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) sran_snd_ho_req:
   [
   St_1_SRAN( ~SRAN_ID, K_gNB, ~PDU_SESSION_ID, ~TRAN_ID ),
   !N2( ~cid_N2, ~SRAN_ID, ~CN_ID )
   ]
  -->
   [
   St_2_SRAN( ~SRAN_ID, K_gNB, ~TRAN_ID, ~PDU_SESSION_ID ),
   SndS( ~cid_N2, ~SRAN_ID, ~CN_ID,
         <'ho_req', ~TRAN_ID, <'SRAN', ~SRAN_ID>, ~PDU_SESSION_ID>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) cn_fwd_ho_req_hkd_old_kamf:
   [
   St_1_CN( ~CN_ID, ~K_SEAF, K_AMF, ~SRAN_ID, ~TRAN_ID,
            ~PDU_SESSION_ID_SRAN, NH, NCC, ~HN_ID
   ),
   !N2( ~cid_N2_SRAN, ~SRAN_ID, ~CN_ID ),
   !N2( ~cid_N2_TRAN, ~TRAN_ID, ~CN_ID ),
   PDU_Session( ~PDU_SESSION_ID_SRAN, ~CN_ID, ~SUPI, ~SRAN_ID ),
   Fr( ~PDU_SESSION_ID_TRAN ),
   RcvS( ~cid_N2_SRAN, ~SRAN_ID, ~CN_ID,
         <'ho_req', ~TRAN_ID, <'SRAN', ~SRAN_ID>, ~PDU_SESSION_ID_SRAN>
   ),
   In( NCC )
   ]
  --[
  SessionHandover( <~SRAN_ID, ~TRAN_ID>, K_AMF, K_AMF,
                   KDF(KDF(K_AMF, NH), ~TRAN_ID)
  ),
  NoRekeyingCN( K_AMF, KDF(KDF(K_AMF, NH), ~TRAN_ID) ),
  Running( ~CN_ID, ~SUPI, <'UE', 'CN', 'K_AMF', K_AMF> ),
  UsePDUSession( ~PDU_SESSION_ID_SRAN, <~CN_ID, ~SUPI, ~SRAN_ID> ),
  CreatePDUSession( ~PDU_SESSION_ID_TRAN, <~CN_ID, ~SUPI, ~TRAN_ID> ),
  PDU( ~PDU_SESSION_ID_TRAN )
  ]->
   [
   St_2_CN( ~CN_ID, ~K_SEAF, K_AMF, KDF(KDF(K_AMF, NH), ~TRAN_ID), ~SRAN_ID,
            ~TRAN_ID, <'NASC', '0'>, ~PDU_SESSION_ID_SRAN, ~PDU_SESSION_ID_TRAN,
            KDF(K_AMF, NH), ('1'++NCC), ~HN_ID
   ),
   Intermediate_key( ~SUPI, ~TRAN_ID, ~CN_ID, <'NH', KDF(K_AMF, NH)> ),
   Session_key( ~SUPI, ~TRAN_ID, <'K_gNB', KDF(KDF(K_AMF, NH), ~TRAN_ID)> ),
   PDU_Session( ~PDU_SESSION_ID_SRAN, ~CN_ID, ~SUPI, ~SRAN_ID ),
   PDU_Session( ~PDU_SESSION_ID_TRAN, ~CN_ID, ~SUPI, ~TRAN_ID ),
   SndS( ~cid_N2_TRAN, ~CN_ID, ~TRAN_ID,
         <'ho_req', KDF(K_AMF, NH), ('1'++NCC), <'NASC', '0'>, 
          <'SRAN', ~SRAN_ID>, ~PDU_SESSION_ID_SRAN>
   )
   ]

  // loop breakers: [0,3,5]
  /* has exactly the trivial AC variant */

rule (modulo E) cn_fwd_ho_req_hkd_new_kamf:
   [
   St_1_CN( ~CN_ID, ~K_SEAF, K_AMF, ~SRAN_ID, ~TRAN_ID,
            ~PDU_SESSION_ID_SRAN, NH, NCC, ~HN_ID
   ),
   !UE( ~SUPI, ~PEI, ~CN_ID ), !N2( ~cid_N2_SRAN, ~SRAN_ID, ~CN_ID ),
   !N2( ~cid_N2_TRAN, ~TRAN_ID, ~CN_ID ),
   PDU_Session( ~PDU_SESSION_ID_SRAN, ~CN_ID, ~SUPI, ~SRAN_ID ),
   Fr( ~PDU_SESSION_ID_TRAN ),
   RcvS( ~cid_N2_SRAN, ~SRAN_ID, ~CN_ID,
         <'ho_req', ~TRAN_ID, <'SRAN', ~SRAN_ID>, ~PDU_SESSION_ID_SRAN>
   ),
   In( NCC )
   ]
  --[
  SessionHandover( <~SRAN_ID, ~TRAN_ID>, K_AMF, KDF(K_AMF, '0x01'),
                   KDF(KDF(KDF(K_AMF, '0x01'), 'MAX_NAS_COUNT'), ~TRAN_ID)
  ),
  RekeyingCN( KDF(K_AMF, '0x01'),
              KDF(KDF(KDF(K_AMF, '0x01'), 'MAX_NAS_COUNT'), ~TRAN_ID)
  ),
  KeyDerived( <'K_AMF', KDF(K_AMF, '0x01')>, ~K_SEAF, K_AMF, ~SUPI ),
  Running( ~CN_ID, ~SUPI, <'UE', 'CN', 'K_AMF', KDF(K_AMF, '0x01')> ),
  UsePDUSession( ~PDU_SESSION_ID_SRAN, <~CN_ID, ~SUPI, ~SRAN_ID> ),
  CreatePDUSession( ~PDU_SESSION_ID_TRAN, <~CN_ID, ~SUPI, ~TRAN_ID> ),
  CreateValues( <~SUPI, ~K_SEAF, KDF(K_AMF, '0x01')> )
  ]->
   [
   St_2_CN( ~CN_ID, ~K_SEAF, KDF(K_AMF, '0x01'),
            KDF(KDF(KDF(K_AMF, '0x01'), 'MAX_NAS_COUNT'), ~TRAN_ID), ~SRAN_ID,
            ~TRAN_ID, <'NASC', '1'>, ~PDU_SESSION_ID_SRAN, ~PDU_SESSION_ID_TRAN,
            KDF(KDF(K_AMF, '0x01'), KDF(KDF(K_AMF, '0x01'), 'MAX_NAS_COUNT')), '0',
            ~HN_ID
   ),
   Intermediate_key( ~SUPI, ~TRAN_ID, ~CN_ID,
                     <'NH', KDF(KDF(K_AMF, '0x01'), KDF(KDF(K_AMF, '0x01'), 'MAX_NAS_COUNT'))>
   ),
   Intermediate_key( ~SUPI, ~TRAN_ID, ~CN_ID,
                     <'NH', KDF(KDF(K_AMF, '0x01'), 'MAX_NAS_COUNT')>
   ),
   Session_key( ~SUPI, ~CN_ID, <'K_AMF', KDF(K_AMF, '0x01')> ),
   Session_key( ~SUPI, ~TRAN_ID,
                <'K_gNB', KDF(KDF(KDF(K_AMF, '0x01'), 'MAX_NAS_COUNT'), ~TRAN_ID)>
   ),
   PDU_Session( ~PDU_SESSION_ID_SRAN, ~CN_ID, ~SUPI, ~SRAN_ID ),
   PDU_Session( ~PDU_SESSION_ID_TRAN, ~CN_ID, ~SUPI, ~TRAN_ID ),
   SndS( ~cid_N2_TRAN, ~CN_ID, ~TRAN_ID,
         <'ho_req', KDF(KDF(K_AMF, '0x01'), 'MAX_NAS_COUNT'), '0', <'NASC', '1'>, 
          <'SRAN', ~SRAN_ID>, ~PDU_SESSION_ID_SRAN>
   )
   ]

  // loop breakers: [0,4,6]
  /* has exactly the trivial AC variant */

rule (modulo E) tran_rcv_ho_req_snd_ack:
   [
   PDU_Session( ~PDU_SESSION_ID, ~CN_ID, ~SUPI, ~SRAN_ID ),
   !N2( ~cid_N2, ~TRAN_ID, ~CN_ID ),
   RcvS( ~cid_N2, ~CN_ID, ~TRAN_ID,
         <'ho_req', NH, NCC, <'NASC', K_AMF_change_flag>, S2TTC, ~PDU_SESSION_ID>
   ),
   In( K_AMF_change_flag ), In( NCC )
   ]
  --[
  Running( ~TRAN_ID, ~SUPI, <'UE', 'TRAN', 'K_gNB_star', KDF(NH, ~TRAN_ID)>
  ),
  UsePDUSession( ~PDU_SESSION_ID, <~CN_ID, ~SUPI, ~SRAN_ID> )
  ]->
   [
   St_1_TRAN( ~TRAN_ID, KDF(NH, ~TRAN_ID), ~SRAN_ID, ~PDU_SESSION_ID ),
   PDU_Session( ~PDU_SESSION_ID, ~CN_ID, ~SUPI, ~SRAN_ID ),
   SndS( ~cid_N2, ~TRAN_ID, ~CN_ID,
         <'ho_req_ack', NCC, <'NASC', K_AMF_change_flag>, <'TRAN', ~TRAN_ID>, 
          ~PDU_SESSION_ID>
   )
   ]

  // loop breakers: [0,2]
  /* has exactly the trivial AC variant */

rule (modulo E) cn_rcv_ho_req_ack:
   [
   St_2_CN( ~CN_ID, ~K_SEAF, K_AMF, K_gNB_star, ~SRAN_ID, ~TRAN_ID, NASC,
            ~PDU_SESSION_ID_SRAN, ~PDU_SESSION_ID_TRAN, NH, NCC, ~HN_ID
   ),
   !N2( ~cid_N2, ~TRAN_ID, ~CN_ID ),
   RcvS( ~cid_N2, ~TRAN_ID, ~CN_ID,
         <'ho_req_ack', NCC, NASC, T2STC, ~PDU_SESSION_ID_SRAN>
   )
   ]
  --[ HandoverPreparationDone( K_AMF, K_gNB_star ) ]->
   [
   St_3_CN( ~CN_ID, ~K_SEAF, K_AMF, K_gNB_star, ~SRAN_ID, ~TRAN_ID, T2STC,
            NASC, ~PDU_SESSION_ID_SRAN, ~PDU_SESSION_ID_TRAN, NH, NCC, ~HN_ID
   )
   ]

  // loop breaker: [2]
  /* has exactly the trivial AC variant */

rule (modulo E) cn_snd_ho_cmd:
   [
   St_3_CN( ~CN_ID, ~K_SEAF, K_AMF, K_gNB_star, ~SRAN_ID, ~TRAN_ID,
            <'TRAN', ~TRAN_ID>, <'NASC', K_AMF_change_flag>, ~PDU_SESSION_ID_SRAN,
            ~PDU_SESSION_ID_TRAN, NH, NCC, ~HN_ID
   ),
   PDU_Session( ~PDU_SESSION_ID_SRAN, ~CN_ID, ~SUPI, ~SRAN_ID ),
   !N2( ~cid_N2, ~SRAN_ID, ~CN_ID ), In( K_AMF_change_flag ), In( NCC )
   ]
  --[ UsePDUSession( ~PDU_SESSION_ID_SRAN, <~CN_ID, ~SUPI, ~SRAN_ID> ) ]->
   [
   St_4_CN( ~CN_ID, ~K_SEAF, K_AMF, K_gNB_star, ~SRAN_ID, ~TRAN_ID,
            ~PDU_SESSION_ID_SRAN, ~PDU_SESSION_ID_TRAN, NH, NCC, ~HN_ID
   ),
   PDU_Session( ~PDU_SESSION_ID_SRAN, ~CN_ID, ~SUPI, ~SRAN_ID ),
   SndS( ~cid_N2, ~CN_ID, ~SRAN_ID,
         <'ho_cmd', NCC, <'NASC', K_AMF_change_flag>, <'TRAN', ~TRAN_ID>, 
          ~PDU_SESSION_ID_SRAN>
   )
   ]

  // loop breaker: [1]
  /* has exactly the trivial AC variant */

rule (modulo E) sran_fwd_ho_cmd_snd_uplink_ran_status_transfer:
   [
   St_2_SRAN( ~SRAN_ID, K_gNB, ~TRAN_ID, ~PDU_SESSION_ID ),
   !N2( ~cid_N2, ~SRAN_ID, ~CN_ID ),
   RcvS( ~cid_N2, ~CN_ID, ~SRAN_ID,
         <'ho_cmd', NCC, <'NASC', K_AMF_change_flag>, T2STC, ~PDU_SESSION_ID>
   ),
   In( K_AMF_change_flag ), In( NCC )
   ]
  -->
   [
   St_3_SRAN( ~SRAN_ID, K_gNB ),
   Out( senc(<'ho_cmd', NCC, <'NASC', K_AMF_change_flag>, 'TRAN', ~TRAN_ID>,
             K_gNB)
   ),
   SndS( ~cid_N2, ~SRAN_ID, ~CN_ID, 'uplink_ran_status_transfer' )
   ]

  // loop breaker: [2]
  /* has exactly the trivial AC variant */

rule (modulo E) ue_rcv_ho_cmd_old_kamf:
   [
   St_1_UE( ~SUPI, ~5G_GUTI, ~K_SEAF_initial, ~K_SEAF, K_AMF, K_gNB, NH,
            NCC, ~SRAN_ID, ~CN_ID, ~HN_ID
   ),
   !UE( ~SUPI, ~PEI, ~CN_ID ),
   In( senc(<'ho_cmd', ('1'++NCC), <'NASC', '0'>, 'TRAN', ~TRAN_ID>, K_gNB)
   )
   ]
  --[
  NoRekeyingUE( K_AMF, KDF(KDF(K_AMF, KDF(K_AMF, NH)), ~TRAN_ID) ),
  KeyDerived( <'K_gNB_star', KDF(KDF(K_AMF, KDF(K_AMF, NH)), ~TRAN_ID)>,
              ~K_SEAF, K_AMF, ~SUPI
  ),
  Bind( <'K_gNB_star', KDF(KDF(K_AMF, KDF(K_AMF, NH)), ~TRAN_ID)>,
        KDF(K_AMF, KDF(K_AMF, NH))
  ),
  Running( ~SUPI, ~CN_ID, <'CN', 'UE', 'K_AMF', K_AMF> ),
  Commit( ~SUPI, ~CN_ID, <'UE', 'CN', 'K_AMF', K_AMF> ),
  Running( ~SUPI, ~TRAN_ID,
           <'TRAN', 'UE', 'K_gNB_star', KDF(KDF(K_AMF, KDF(K_AMF, NH)), ~TRAN_ID)>
  ),
  Commit( ~SUPI, ~TRAN_ID,
          <'UE', 'TRAN', 'K_gNB_star', KDF(KDF(K_AMF, KDF(K_AMF, NH)), ~TRAN_ID)>
  ),
  Honest( ~TRAN_ID ), Honest( ~SRAN_ID ), Honest( ~SUPI ),
  Honest( ~CN_ID ), Secret( <'K_gNB', K_gNB> ), GUTI( ~5G_GUTI ),
  HN( ~HN_ID ), SEAF( ~K_SEAF ), SUPI( ~SUPI ),
  UseValues( <~SUPI, ~K_SEAF, K_AMF> )
  ]->
   [
   St_2_UE( ~SUPI, ~5G_GUTI, ~K_SEAF_initial, ~K_SEAF, K_AMF,
            KDF(KDF(K_AMF, KDF(K_AMF, NH)), ~TRAN_ID), KDF(K_AMF, KDF(K_AMF, NH)),
            ('1'++NCC), ~TRAN_ID, ~CN_ID, ~HN_ID
   )
   ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) ue_rcv_ho_cmd_new_kamf:
   [
   St_1_UE( ~SUPI, ~5G_GUTI, ~K_SEAF_initial, ~K_SEAF, K_AMF, K_gNB, NH,
            NCC, ~SRAN_ID, ~CN_ID, ~HN_ID
   ),
   !UE( ~SUPI, ~PEI, ~CN_ID ),
   In( senc(<'ho_cmd', '0', <'NASC', '1'>, 'TRAN', ~TRAN_ID>, K_gNB) )
   ]
  --[
  RekeyingUE( KDF(K_AMF, '0x01'),
              KDF(KDF(KDF(K_AMF, '0x01'), 'MAX_NAS_COUNT'), ~TRAN_ID)
  ),
  KeyDerived( <'K_AMF', KDF(K_AMF, '0x01')>, ~K_SEAF, K_AMF, ~SUPI ),
  KeyDerived( <'K_gNB_star', 
               KDF(KDF(KDF(K_AMF, '0x01'), 'MAX_NAS_COUNT'), ~TRAN_ID)>,
              ~K_SEAF, KDF(K_AMF, '0x01'), ~SUPI
  ),
  Bind( <'K_gNB_star', 
         KDF(KDF(KDF(K_AMF, '0x01'), 'MAX_NAS_COUNT'), ~TRAN_ID)>,
        KDF(KDF(K_AMF, '0x01'), 'MAX_NAS_COUNT')
  ),
  Running( ~SUPI, ~CN_ID, <'CN', 'UE', 'K_AMF', KDF(K_AMF, '0x01')> ),
  Commit( ~SUPI, ~CN_ID, <'UE', 'CN', 'K_AMF', KDF(K_AMF, '0x01')> ),
  Running( ~SUPI, ~TRAN_ID,
           <'TRAN', 'UE', 'K_gNB_star', 
            KDF(KDF(KDF(K_AMF, '0x01'), 'MAX_NAS_COUNT'), ~TRAN_ID)>
  ),
  Commit( ~SUPI, ~TRAN_ID,
          <'UE', 'TRAN', 'K_gNB_star', 
           KDF(KDF(KDF(K_AMF, '0x01'), 'MAX_NAS_COUNT'), ~TRAN_ID)>
  ),
  Honest( ~TRAN_ID ), Honest( ~SRAN_ID ), Honest( ~SUPI ),
  Honest( ~CN_ID ), Secret( <'K_gNB', K_gNB> ), GUTI( ~5G_GUTI ),
  HN( ~HN_ID ), SEAF( ~K_SEAF ), SUPI( ~SUPI ),
  UseValues( <~SUPI, ~K_SEAF, K_AMF> )
  ]->
   [
   St_2_UE( ~SUPI, ~5G_GUTI, ~K_SEAF_initial, ~K_SEAF, KDF(K_AMF, '0x01'),
            KDF(KDF(KDF(K_AMF, '0x01'), 'MAX_NAS_COUNT'), ~TRAN_ID),
