                              next
                                case split_case_19
                                by contradiction /* from formulas */
                              qed
                            qed
                          next
                            case split_case_3
                            solve( splitEqs(4) )
                              case split_case_01
                              by contradiction /* from formulas */
                            next
                              case split_case_02
                              by contradiction /* from formulas */
                            next
