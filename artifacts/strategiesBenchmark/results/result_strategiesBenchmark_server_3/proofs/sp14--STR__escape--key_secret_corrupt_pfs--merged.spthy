                              by contradiction /* from formulas */
                            next
                              case split_case_09
                              by contradiction /* from formulas */
                            next
                              case split_case_10
                              by contradiction /* from formulas */
                            next
                              case split_case_11
                              by contradiction /* from formulas */
                            next
                              case split_case_12
                              by contradiction /* from formulas */
                            next
                              case split_case_13
                              by contradiction /* from formulas */
                            next
