            by contradiction /* cyclic */
          next
            case H_2_case_1
            by contradiction /* cyclic */
          next
            case H_2_case_2
            by contradiction /* cyclic */
          qed
        next
          case c_sg
          solve( !KU( ~sskD1 ) @ #vk.3 )
            case ChanOut_A_case_1
            by contradiction /* cyclic */
          next
            case ChanOut_A_case_2
            by contradiction /* cyclic */
          next
            case ChanOut_A_case_3
            by contradiction /* cyclic */
          next
            case ChanOut_A_case_4
            by contradiction /* cyclic */
          next
            case H_2_case_1
            solve( !KU( ~skS ) @ #vk.5 )
              case ChanOut_A_case_1
              by contradiction /* cyclic */
            next
              case ChanOut_A_case_2
              by contradiction /* cyclic */
            next
              case ChanOut_A_case_3
              by contradiction /* cyclic */
            next
              case ChanOut_A_case_4
              by contradiction /* cyclic */
            next
              case H_2_case_1
              by contradiction /* cyclic */
            next
