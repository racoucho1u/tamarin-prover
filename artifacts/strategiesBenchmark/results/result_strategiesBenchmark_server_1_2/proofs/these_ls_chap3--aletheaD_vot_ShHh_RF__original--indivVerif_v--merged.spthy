    case H_3_case_2
    solve( AgSt_H2( 'H2', <$D, $BB, $v.1, b> ) ▶₀ #j )
      case H_2
      by solve( In_A( 'BB', <'b', (ba++x++sg(encp(v.1, ~r, pk(~skS)), ~sskD2))>
                ) ▶₁ #j )
    qed
  next
    case H_3_case_3
