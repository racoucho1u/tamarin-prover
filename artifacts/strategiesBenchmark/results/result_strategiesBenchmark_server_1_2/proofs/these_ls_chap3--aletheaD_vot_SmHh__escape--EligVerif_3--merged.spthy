lemma EligVerif_4:
  all-traces
  "∀ A #a votes spkDSG sk xa ra xb rb.
    (((Learn_A_spkDSG( A, <'spkDSG', spkDSG> ) @ #a) ∧
      (Learn_A_Vs( A, <'v', votes> ) @ #a)) ∧
     (VerifyA2( A,
                verzkp(zkp(<encp(xa, ra, pk(sk)), encp(xb, rb, pk(sk))>, <xa, xb>, sk),
                       <encp(xb, rb, pk(sk)), encp(xa, ra, pk(sk))>, <xb, xa>, pk(sk))
      ) @ #a)) ⇒
    (∃ #b #b2 BB v1 v2 H1 H2 A1 A2 pkD1 pkD2 #h1 #h2 #s1 #s2.
      ((((((((BB_tal( BB, <'v', votes> ) @ #b) ∧
             (BB_pskDs( BB, <'spkDSG', spkDSG> ) @ #b2)) ∧
            (votes = (v1++v2))) ∧
           (Send( H1, A1, v1 ) @ #h1)) ∧
          (Send( H2, A2, v2 ) @ #h2)) ∧
         (¬(H1 = H2))) ∧
        (spkDSG = (pkD1++pkD2))) ∧
       (Pseudonym( H1, pkD1 ) @ #s1)) ∧
      (Pseudonym( H2, pkD2 ) @ #s2))"
/*
guarded formula characterizing all counter-examples:
"∃ A #a votes spkDSG sk xa ra xb rb.
  (Learn_A_spkDSG( A, <'spkDSG', spkDSG> ) @ #a) ∧
  (Learn_A_Vs( A, <'v', votes> ) @ #a) ∧
  (VerifyA2( A,
             verzkp(zkp(<encp(xa, ra, pk(sk)), encp(xb, rb, pk(sk))>, <xa, xb>, sk),
                    <encp(xb, rb, pk(sk)), encp(xa, ra, pk(sk))>, <xb, xa>, pk(sk))
   ) @ #a)
 ∧
  ∀ #b #b2 BB v1 v2 H1 H2 A1 A2 pkD1 pkD2 #h1 #h2 #s1 #s2.
   (BB_tal( BB, <'v', votes> ) @ #b) ∧
   (BB_pskDs( BB, <'spkDSG', spkDSG> ) @ #b2) ∧
   (votes = (v1++v2)) ∧
   (Send( H1, A1, v1 ) @ #h1) ∧
   (Send( H2, A2, v2 ) @ #h2) ∧
   (spkDSG = (pkD1++pkD2)) ∧
   (Pseudonym( H1, pkD1 ) @ #s1) ∧
   (Pseudonym( H2, pkD2 ) @ #s2)
  ⇒
   H1 = H2"
*/
by sorry

