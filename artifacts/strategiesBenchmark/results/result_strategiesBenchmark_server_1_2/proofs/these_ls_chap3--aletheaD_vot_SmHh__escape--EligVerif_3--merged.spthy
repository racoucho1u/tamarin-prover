"∃ A #a votes spkDSG sk xa ra xb rb.
  (Learn_A_spkDSG( A, <'spkDSG', spkDSG> ) @ #a) ∧
  (Learn_A_Vs( A, <'v', votes> ) @ #a) ∧
  (VerifyA2( A,
             verzkp(zkp(<encp(xa, ra, pk(sk)), encp(xb, rb, pk(sk))>, <xa, xb>, sk),
                    <encp(xb, rb, pk(sk)), encp(xa, ra, pk(sk))>, <xa, xb>, pk(sk))
   ) @ #a)
 ∧
  ∀ #b #b2 BB v1 v2 H1 H2 A1 A2 pkD1 pkD2 #h1 #h2 #s1 #s2.
   (BB_tal( BB, <'v', votes> ) @ #b) ∧
   (BB_pskDs( BB, <'spkDSG', spkDSG> ) @ #b2) ∧
   (votes = (v1++v2)) ∧
   (Send( H1, A1, v1 ) @ #h1) ∧
   (Send( H2, A2, v2 ) @ #h2) ∧
   (spkDSG = (pkD1++pkD2)) ∧
   (Pseudonym( H1, pkD1 ) @ #s1) ∧
   (Pseudonym( H2, pkD2 ) @ #s2)
  ⇒
   H1 = H2"
*/
simplify
  case 1
  solve( (∃ H #h1.
           (Ballot( H, sg(encp($va, ra, pk(sk)), sskDb) ) @ #h1))  ∥
         (∃ #j1 #j4.
           (!KU( encp($va, ra, pk(sk)) ) @ #j1) ∧ (!KU( sskDb ) @ #j4))  ∥
         (∃ #j1 #j2 #j3 #j4.
           (!KU( $va ) @ #j1) ∧
           (!KU( ra ) @ #j2) ∧
           (!KU( pk(sk) ) @ #j3) ∧
           (!KU( sskDb ) @ #j4))  ∥
         (∃ H skD2 #j1 #j4.
           (Ballot( H, sg(encp($va, ra, pk(sk)), skD2) ) @ #j1) ∧
           (!KU( sskDb ) @ #j4)) )
    case case_1
    solve( (∃ H #h1.
             (Ballot( H, sg(encp($vb, rb, pk(sk)), sskDa) ) @ #h1))  ∥
           (∃ #j1 #j4.
             (!KU( encp($vb, rb, pk(sk)) ) @ #j1) ∧ (!KU( sskDa ) @ #j4))  ∥
           (∃ #j1 #j2 #j3 #j4.
             (!KU( $vb ) @ #j1) ∧
             (!KU( rb ) @ #j2) ∧
             (!KU( pk(sk) ) @ #j3) ∧
             (!KU( sskDa ) @ #j4))  ∥
           (∃ H skD2 #j1 #j4.
             (Ballot( H, sg(encp($vb, rb, pk(sk)), skD2) ) @ #j1) ∧
             (!KU( sskDa ) @ #j4)) )
      case case_1
