theory Phoolproof_MA begin

// Function signature and definition of the equational theory E

functions: adec/2, aenc/2, fst/1, h/1, pair/2, pk/1, pw/1, sdec/2,
           senc/2, sign/2, snd/1, true/0, verify/3
equations:
    adec(aenc(x.1, pk(x.2)), x.2) = x.1,
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true















rule (modulo E) H_fresh:
   [ Fr( ~x ) ]
  --[ Fresh( $H, $x.1, ~x ), !HK( $H, $x.1, ~x ), H( $H ) ]->
   [ !HK( $H, $x.1, ~x ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) H_send:
   [ !HK( $H, $x.1, x.2 ) ]
  --[ Send( $H, $x.1, x.2 ), H( $H ) ]->
   [ Out( <$x.1, x.2> ) ]

  /*
  rule (modulo AC) H_send:
     [ !HK( $H, $x, x.1 ) ]
    --[ Send( $H, $x, x.1 ), H( $H ) ]->
     [ Out( <$x, x.1> ) ]
  */

rule (modulo E) H_receive:
   [ In( <$x.1, x.2> ) ]
  --[ Receive( $H, $x.1, x.2 ), !HK( $H, $x.1, x.2 ), H( $H ) ]->
   [ !HK( $H, $x.1, x.2 ) ]

  /*
  rule (modulo AC) H_receive:
     [ In( <$x, x.1> ) ]
    --[ Receive( $H, $x, x.1 ), !HK( $H, $x, x.1 ), H( $H ) ]->
     [ !HK( $H, $x, x.1 ) ]
  */

rule (modulo E) H_send_S:
   [ !HK( $H, $x.1, x.2 ) ]
  --[ Send( $H, $x.1, x.2 ), H( $H ), To( $A ) ]->
   [ Out_S( $H, $A, $x.1, x.2 ) ]

  // loop breaker: [0]
  /*
  rule (modulo AC) H_send_S:
     [ !HK( $H, $x, x.1 ) ]
    --[ Send( $H, $x, x.1 ), H( $H ), To( $A ) ]->
     [ Out_S( $H, $A, $x, x.1 ) ]
    // loop breaker: [0]
  */

rule (modulo E) H_receive_S:
   [ In_S( $A, $H, $x.1, x.2 ) ]
  --[ Receive( $H, $x.1, x.2 ), !HK( $H, $x.1, x.2 ), H( $H ), From( $A )
  ]->
   [ !HK( $H, $x.1, x.2 ) ]

  /*
  rule (modulo AC) H_receive_S:
     [ In_S( $A, $H, $x, x.1 ) ]
    --[ Receive( $H, $x, x.1 ), !HK( $H, $x, x.1 ), H( $H ), From( $A ) ]->
     [ !HK( $H, $x, x.1 ) ]
  */

rule (modulo E) H_send_S2:
   [ !HK( $H, $x.1, x.2 ), !HK( $H, $y.1, y.2 ) ]
  --[ Send( $H, $x.1, x.2 ), Send( $H, $y.1, y.2 ), H( $H ), To( $A ) ]->
   [ Out_S( $H, $A, <$x.1, $y.1>, <x.2, y.2> ) ]

  // loop breakers: [0,1]
  /*
  rule (modulo AC) H_send_S2:
     [ !HK( $H, $x, x.1 ), !HK( $H, $y, y.1 ) ]
    --[ Send( $H, $x, x.1 ), Send( $H, $y, y.1 ), H( $H ), To( $A ) ]->
     [ Out_S( $H, $A, <$x, $y>, <x.1, y.1> ) ]
    // loop breakers: [0,1]
  */

rule (modulo E) H_send_S3:
   [ !HK( $H, $x.1, x.2 ), !HK( $H, $y.1, y.2 ), !HK( $H, $z.1, z.2 ) ]
  --[
  Send( $H, $x.1, x.2 ), Send( $H, $y.1, y.2 ), Send( $H, $z.1, z.2 ),
  H( $H ), To( $A )
  ]->
   [ Out_S( $H, $A, <$x.1, $y.1, $z.1>, <x.2, y.2, z.2> ) ]

  // loop breakers: [0,1,2]
  /*
  rule (modulo AC) H_send_S3:
     [ !HK( $H, $x, x.1 ), !HK( $H, $y, y.1 ), !HK( $H, $z, z.1 ) ]
    --[
    Send( $H, $x, x.1 ), Send( $H, $y, y.1 ), Send( $H, $z, z.1 ), H( $H ),
    To( $A )
    ]->
     [ Out_S( $H, $A, <$x, $y, $z>, <x.1, y.1, z.1> ) ]
    // loop breakers: [0,1,2]
  */

rule (modulo E) H_send_S4:
   [
   !HK( $H, $x.1, x.2 ), !HK( $H, $y.1, y.2 ), !HK( $H, $z.1, z.2 ),
   !HK( $H, $w.1, w.2 )
   ]
  --[
  Send( $H, $x.1, x.2 ), Send( $H, $y.1, y.2 ), Send( $H, $z.1, z.2 ),
  Send( $H, $w.1, w.2 ), H( $H ), To( $A )
  ]->
   [ Out_S( $H, $A, <$x.1, $y.1, $z.1, $w.1>, <x.2, y.2, z.2, w.2> ) ]

  // loop breakers: [0,1,2,3]
  /*
  rule (modulo AC) H_send_S4:
     [
     !HK( $H, $x, x.1 ), !HK( $H, $y, y.1 ), !HK( $H, $z, z.1 ),
     !HK( $H, $w, w.1 )
     ]
    --[
    Send( $H, $x, x.1 ), Send( $H, $y, y.1 ), Send( $H, $z, z.1 ),
    Send( $H, $w, w.1 ), H( $H ), To( $A )
    ]->
     [ Out_S( $H, $A, <$x, $y, $z, $w>, <x.1, y.1, z.1, w.1> ) ]
    // loop breakers: [0,1,2,3]
  */

rule (modulo E) H_receive_S2:
   [ In_S( $A, $H, <$x.1, $y.1>, <x.2, y.2> ) ]
  --[
  Receive( $H, $x.1, x.2 ), Receive( $H, $y.1, y.2 ), !HK( $H, $x.1, x.2 ),
  !HK( $H, $y.1, y.2 ), H( $H ), From( $A )
  ]->
   [ !HK( $H, $x.1, x.2 ), !HK( $H, $y.1, y.2 ) ]

  /*
  rule (modulo AC) H_receive_S2:
     [ In_S( $A, $H, <$x, $y>, <x.1, y.1> ) ]
    --[
    Receive( $H, $x, x.1 ), Receive( $H, $y, y.1 ), !HK( $H, $x, x.1 ),
    !HK( $H, $y, y.1 ), H( $H ), From( $A )
    ]->
     [ !HK( $H, $x, x.1 ), !HK( $H, $y, y.1 ) ]
  */

rule (modulo E) H_receive_S4:
   [ In_S( $A, $H, <$x.1, $y.1, $z.1, $v.1>, <x.2, y.2, z.2, v.2> ) ]
  --[
  Receive( $H, $x.1, x.2 ), Receive( $H, $y.1, y.2 ),
  Receive( $H, $z.1, z.2 ), Receive( $H, $v.1, v.2 ), !HK( $H, $x.1, x.2 ),
  !HK( $H, $y.1, y.2 ), !HK( $H, $z.1, z.2 ), !HK( $H, $v.1, v.2 ),
  H( $H ), From( $A )
  ]->
   [
   !HK( $H, $x.1, x.2 ), !HK( $H, $y.1, y.2 ), !HK( $H, $z.1, z.2 ),
   !HK( $H, $v.1, v.2 )
   ]

  /*
  rule (modulo AC) H_receive_S4:
     [ In_S( $A, $H, <$x, $y, $z, $v>, <x.1, y.1, z.1, v.1> ) ]
    --[
    Receive( $H, $x, x.1 ), Receive( $H, $y, y.1 ), Receive( $H, $z, z.1 ),
    Receive( $H, $v, v.1 ), !HK( $H, $x, x.1 ), !HK( $H, $y, y.1 ),
    !HK( $H, $z, z.1 ), !HK( $H, $v, v.1 ), H( $H ), From( $A )
    ]->
     [
     !HK( $H, $x, x.1 ), !HK( $H, $y, y.1 ), !HK( $H, $z, z.1 ),
     !HK( $H, $v, v.1 )
     ]
  */

rule (modulo E) ChanOut_S:
   [ Out_S( $A, $B, xn, x ) ]
  --[ ChanOut_S( $A, $B, xn, x ) ]->
   [ !Sec( $A, $B, xn, x ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) ChanIn_S:
   [ !Sec( $A, $B, xn, x ) ]
  --[ ChanIn_S( $A, $B, xn, x ) ]->
   [ In_S( $A, $B, xn, x ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) ChanOut_C:
   [ Out_C( $A, $B, xn, x ) ]
  --[ ChanOut_C( $A, $B, xn, x ) ]->
   [ !Conf( $B, xn, x ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) ChanIn_C:
   [ !Conf( $B, xn, x ), In( $A ) ]
  --[ ChanIn_C( $A, $B, xn, x ) ]->
   [ In_C( $A, $B, xn, x ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) ChanIn_CAdv:
   [ In( <$A, $B, xn, x> ) ] --> [ In_C( $A, $B, xn, x ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) ChanOut_A:
   [ Out_A( $A, $B, xn, x ) ]
  --[ ChanOut_A( $A, $B, xn, x ) ]->
   [ !Auth( $A, xn, x ), Out( <$A, $B, xn, x> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) ChanIn_A:
   [ !Auth( $A, xn, x ), In( $B ) ]
  --[ ChanIn_A( $A, $B, xn, x ) ]->
   [ In_A( $A, $B, xn, x ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) passworddistribution:
   [ Fr( ~pw ) ]
  --[ PasswordHS( $X, $Y, ~pw ) ]->
   [ !Password( $X, $Y, ~pw ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) publickeyinfrastructure:
   [ Fr( ~skX ) ]
  --[ LontermKey( $X, ~skX ) ]->
   [ !Ltk( $X, ~skX ), !Pk( $X, pk(~skX) ), Out( pk(~skX) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Setup:
   [ Fr( ~m ), !Password( $H, $S, ~pw ), !Ltk( $S, ~skS ), !Ltk( $D, ~skD )
   ]
  --[
  Setup( $H ), Roles( $H, $D, $P, $S ), Device( $H, $D ), User( $idH, $H ),
  InitK( $H, 'D', $D ), InitK( $H, 'P', $P ), InitK( $H, 'S', $S ),
  InitK( $H, 'm', ~m ), InitK( $H, 'pw', pw(~pw) ),
  InitK( $H, 'idH', $idH )
  ]->
   [
   AgSt_D0( $D, 'D_0', <$H, $S, ~skD, $idH, pk(~skS)> ),
   AgSt_S0( $S, 'S_0', <$H, $D, pk(~skD), ~skS, pw(~pw), $idH> ),
   !HK( $H, 'D', $D ), !HK( $H, 'P', $P ), !HK( $H, 'S', $S ),
   !HK( $H, 'm', ~m ), !HK( $H, 'pw', pw(~pw) ), !HK( $H, 'idH', $idH ),
   AgSt_H0( $H, 'H_0', <$D, $P, $S, ~m, pw(~pw), $idH> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) D_1:
   [
   AgSt_D0( $D, 'D_0', <$H, $S, ~skD, $idH, pk(~skS)> ),
   In_S( $H, $D, <'S', 'm'>, <$S, ~m> )
   ]
  -->
   [
   AgSt_D2( $D, 'D_2', <$H, $S, ~skD, $idH, pk(~skS), ~m> ),
   Out( <'S', $S> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) D_5:
   [
   AgSt_D2( $D, 'D_2', <$H, $S, ~skD, $idH, pk(~skS), ~m> ),
   In( <~chall, sign(~chall, ~skS)> )
   ]
  --[ Dfin( ) ]->
   [ Out( <$idH, ~m, sign(<$idH, ~chall, ~m>, ~skD)> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) S_3:
   [
   AgSt_S0( $S, 'S_0', <$H, $D, pk(~skD), ~skS, pw(~pw), $idH> ),
   In( 'hello' ), Fr( ~chall )
   ]
  -->
   [
   AgSt_S4( $S, 'S_4', <$H, $D, pk(~skD), ~skS, pw(~pw), $idH, ~chall> ),
   Out( <~chall, sign(~chall, ~skS)> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) S_7:
   [
   AgSt_S4( $S, 'S_4', <$H, $D, pk(~skD), ~skS, pw(~pw), $idH, ~chall> ),
   In( <$idH, ~m, sign(<$idH, ~chall, ~m>, ~skD)> )
   ]
  -->
   [
   AgSt_S7( $S, 'S_7', <$H, $D, pk(~skD), ~skS, pw(~pw), $idH, ~chall, ~m> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) S_9:
   [
   AgSt_S7( $S, 'S_7', <$H, $D, pk(~skD), ~skS, pw(~pw), $idH, ~chall, ~m>
   ),
   In( <$idH, ~m, pw(~pw)> )
   ]
  --[ Commit( $S, $H, ~m ) ]->
   [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) H_1:
   [ AgSt_H0( $H, 'H_0', <$D, $P, $S, ~m, pw(~pw), $idH> ) ]
  --[ H_role( $H, '1' ), Send( $H, 'S', $S ), Send( $H, 'm', ~m ) ]->
   [
   AgSt_H1( $H, 'H_1', <$D, $P, $S, ~m, pw(~pw), $idH> ),
   Out_S( $H, $D, <'S', 'm'>, <$S, ~m> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) H_8:
   [ AgSt_H1( $H, 'H_1', <$D, $P, $S, ~m, pw(~pw), $idH> ) ]
  --[ H_role( $H, '5' ), Send( $H, 'pw', pw(~pw) ), Send( $H, 'idH', $idH )
  ]->
   [ Out( <<'pw', 'idH'>, pw(~pw), $idH> ) ]

  /* has exactly the trivial AC variant */

restriction setup_for_IK:
  "∀ H #i. (H( H ) @ #i) ⇒ (∃ #j. (Setup( H ) @ #j) ∧ (#j < #i))"

restriction not_Chan_S_human_to_human:
  "∀ A B mn m #i #j #k.
    (((ChanOut_S( A, B, mn, m ) @ #i) ∧ (H( A ) @ #j)) ∧ (H( B ) @ #k)) ⇒
    (⊥)"
  // safety formula

restriction notSameRole:
  "∀ H1 H2 D1 D2 P1 P2 S1 S2 #i #j.
    ((Roles( H1, D1, P1, S1 ) @ #i) ∧ (Roles( H2, D2, P2, S2 ) @ #j)) ⇒
    ((((((((((((¬(H1 = D1)) ∧ (¬(H1 = D2))) ∧ (¬(H1 = P1))) ∧ (¬(H1 = P2))) ∧
            (¬(H1 = S1))) ∧
           (¬(H1 = S2))) ∧
          (¬(D1 = P1))) ∧
         (¬(D1 = P2))) ∧
        (¬(D1 = S1))) ∧
       (¬(D1 = S2))) ∧
      (¬(P1 = S1))) ∧
     (¬(P1 = S2)))"
  // safety formula

restriction Device:
  "∀ H1 H2 D #i #j.
    ((Device( H1, D ) @ #i) ∧ (Device( H2, D ) @ #j)) ⇒ (H1 = H2)"
  // safety formula

lemma functional:
  exists-trace
  "(∀ H1 H2 #i #j. ((Setup( H1 ) @ #i) ∧ (Setup( H2 ) @ #j)) ⇒ (#i = #j)) ∧
   (∃ #k #n S m. (Dfin( ) @ #k) ∧ (Commit( S, 'Human', m ) @ #n))"
/*
guarded formula characterizing all satisfying traces:
"(∀ H1 H2 #i #j. (Setup( H1 ) @ #i) ∧ (Setup( H2 ) @ #j) ⇒ #i = #j) ∧
 (∃ #k #n S m. (Dfin( ) @ #k) ∧ (Commit( S, 'Human', m ) @ #n))"
*/
by sorry

lemma message_authentication:
  all-traces
  "∀ S m #k.
    (Commit( S, 'Human', m ) @ #k) ⇒
    (∃ mn #i. (Send( 'Human', mn, m ) @ #i) ∧ (#i < #k))"
/*
guarded formula characterizing all counter-examples:
"∃ S m #k.
  (Commit( S, 'Human', m ) @ #k)
 ∧
  ∀ mn #i. (Send( 'Human', mn, m ) @ #i) ⇒ ¬(#i < #k)"
*/
simplify
solve( AgSt_S7( $S, 'S_7',
                <'Human', $D, pk(~skD), ~skS, pw(~pw), $idH, ~chall, ~m>
       ) ▶₀ #k )
  case S_7
  solve( !KU( ~m ) @ #vk.4 )
    case D_5_case_1
    solve( !Password( $H, $S.2, ~pw.2 ) ▶₁ #j )
      case passworddistribution
      solve( !Ltk( $S, ~skS ) ▶₂ #j )
        case publickeyinfrastructure
        solve( !Ltk( $D, ~skD ) ▶₃ #j )
          case publickeyinfrastructure
          solve( !KU( ~chall.1 ) @ #vk.10 )
            case D_5_case_1
            solve( !KU( sign(<$idH.1, ~chall, ~m.1>, ~skD.1) ) @ #vk.8 )
              case D_5_case_1
              by contradiction /* from formulas */
            next
              case D_5_case_2
              by contradiction /* from formulas */
            next
              case c_sign
              solve( !KU( ~skD.1 ) @ #vk.17 )
                case D_5
                solve( !KU( sign(~chall.1, ~skS.3) ) @ #vk.14 )
                  case S_3
                  solve( !KU( pw(~pw.1) ) @ #vk.13 )
                    case H_8
                    solve( !HK( $H, 'S', $S.4 ) ▶₀ #vr.16 )
                      case H_receive
                      solve( !HK( $H, 'm', ~m.1 ) ▶₁ #vr.16 )
                        case H_fresh
                        solve( !HK( $H.1, 'm', ~chall.1 ) ▶₁ #vr.30 )
                          case H_receive
                          by contradiction /* cyclic */
                        qed
                      next
                        case H_receive
                        by contradiction /* cyclic */
                      next
                        case H_receive_S2
                        by contradiction /* from formulas */
                      next
                        case Setup
                        solve( !HK( $H.1, 'm', ~chall.1 ) ▶₁ #vr.30 )
                          case H_receive
                          by contradiction /* cyclic */
                        qed
                      qed
                    next
                      case H_receive_S2
                      by contradiction /* from formulas */
                    next
                      case Setup
                      solve( !HK( $H, 'm', ~m.1 ) ▶₁ #vr.16 )
                        case H_fresh
                        solve( !HK( $H.1, 'm', ~chall.1 ) ▶₁ #vr.30 )
                          case H_receive
                          by contradiction /* cyclic */
                        qed
                      next
                        case H_receive
                        by contradiction /* cyclic */
                      next
                        case H_receive_S2
                        by contradiction /* from formulas */
                      next
                        case Setup
                        solve( !HK( $H.1, 'm', ~chall.1 ) ▶₁ #vr.30 )
                          case H_receive
                          by contradiction /* cyclic */
                        qed
                      qed
                    qed
                  next
                    case H_send
                    solve( !Password( 'Human', $S.7, ~pw.8 ) ▶₁ #j.3 )
                      case passworddistribution
                      solve( !HK( $H, 'S', $S.5 ) ▶₀ #vr.16 )
                        case H_receive
                        solve( !HK( $H, 'm', ~m.1 ) ▶₁ #vr.16 )
                          case H_fresh
                          solve( !HK( $H.1, 'm', ~chall.1 ) ▶₁ #vr.30 )
                            case H_receive
                            by contradiction /* cyclic */
                          qed
                        next
                          case H_receive
                          by contradiction /* cyclic */
                        next
                          case H_receive_S2
                          by contradiction /* from formulas */
                        next
                          case Setup
                          solve( !HK( $H.1, 'm', ~chall.1 ) ▶₁ #vr.30 )
                            case H_receive
                            by contradiction /* cyclic */
                          qed
                        qed
                      next
                        case H_receive_S2
                        by contradiction /* from formulas */
                      next
                        case Setup
                        solve( !HK( $H, 'm', ~m.1 ) ▶₁ #vr.16 )
                          case H_fresh
                          solve( !HK( $H.1, 'm', ~chall.1 ) ▶₁ #vr.30 )
                            case H_receive
                            by contradiction /* cyclic */
                          qed
                        next
                          case H_receive
                          by contradiction /* cyclic */
                        next
                          case H_receive_S2
                          by contradiction /* from formulas */
                        next
                          case Setup
                          solve( !HK( $H.1, 'm', ~chall.1 ) ▶₁ #vr.30 )
                            case H_receive
                            by contradiction /* cyclic */
                          qed
                        qed
                      qed
                    qed
                  next
                    case c_pw
                    solve( !KU( ~pw.1 ) @ #vk.22 )
                      case D_5
                      solve( !HK( $H, 'S', $S.4 ) ▶₀ #vr.16 )
                        case H_receive
                        solve( !HK( $H, 'm', ~m.1 ) ▶₁ #vr.16 )
                          case H_fresh
                          solve( !HK( $H.1, 'm', ~chall.1 ) ▶₁ #vr.30 )
                            case H_receive
                            by contradiction /* cyclic */
                          qed
                        next
                          case H_receive
                          by contradiction /* cyclic */
                        next
                          case H_receive_S2
                          by contradiction /* from formulas */
                        next
                          case Setup
                          solve( !HK( $H.1, 'm', ~chall.1 ) ▶₁ #vr.30 )
                            case H_receive
                            by contradiction /* cyclic */
                          qed
                        qed
                      next
                        case H_receive_S2
                        by contradiction /* from formulas */
                      next
                        case Setup
                        solve( !HK( $H, 'm', ~m.1 ) ▶₁ #vr.16 )
                          case H_fresh
                          solve( !HK( $H.1, 'm', ~chall.1 ) ▶₁ #vr.30 )
                            case H_receive
                            by contradiction /* cyclic */
                          qed
                        next
                          case H_receive
                          by contradiction /* cyclic */
                        next
                          case H_receive_S2
                          by contradiction /* from formulas */
                        next
                          case Setup
                          solve( !HK( $H.1, 'm', ~chall.1 ) ▶₁ #vr.30 )
                            case H_receive
                            by contradiction /* cyclic */
                          qed
                        qed
                      qed
                    qed
                  qed
