theory SetAbst begin

// Function signature and definition of the equational theory E

functions: adec/2, aenc/2, fst/1, pair/2, pk/1, sign/2, snd/1, true/0,
           verify/3
equations:
    adec(aenc(x.1, pk(x.2)), x.2) = x.1,
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true







section{* The PKI-example *}

rule (modulo E) 0:
   [ ] --[ Init( ) ]-> [ S_0( ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Rep0:
   [ S_0( ) ] --> [ !S_01( ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Par01:
   [ !S_01( ) ] --> [ S_011( ), S_012( ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) new_pki011:
   [ S_011( ), Fr( pki ) ] --> [ S_0111( pki ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Rep0111:
   [ S_0111( pki ) ] --> [ !S_01111( pki ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Par01111:
   [ !S_01111( pki ) ] --> [ S_011111( pki ), S_011112( pki ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) in___new___user_011111:
   [ S_011111( pki ), In( <'new', user> ) ]
  -->
   [ S_0111111( pki, user, 'new' ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) new__sk0111111:
   [ S_0111111( pki, user, 'new' ), Fr( ~sk ) ]
  -->
   [ S_01111111( ~sk, pki, user, 'new' ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) lock_user01111111:
   [ S_01111111( ~sk, pki, user, 'new' ), Fr( ~lock7 ) ]
  --[ Lock( ~lock7, user ) ]->
   [ S_011111111( ~lock7, ~sk, pki, user, 'new' ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) event_HonestKey__sk_011111111:
   [ S_011111111( ~lock7, ~sk, pki, user, 'new' ) ]
  --[ Event( ), HonestKey( ~sk ) ]->
   [ S_0111111111( ~lock7, ~sk, pki, user, 'new' ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) insert___SERVER___pki__user__pk__sk_0111111111:
   [ S_0111111111( ~lock7, ~sk, pki, user, 'new' ) ]
  --[ Insert( <'SERVER', pki, user>, pk(~sk) ) ]->
   [ S_01111111111( ~lock7, ~sk, pki, user, 'new' ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) insert___USER___user___sk01111111111:
   [ S_01111111111( ~lock7, ~sk, pki, user, 'new' ) ]
  --[ Insert( <'USER', user>, ~sk ) ]->
   [ S_011111111111( ~lock7, ~sk, pki, user, 'new' ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) event_HonestKey__sk_011111111111:
   [ S_011111111111( ~lock7, ~sk, pki, user, 'new' ) ]
  --[ Event( ), HonestKey( ~sk ) ]->
   [ S_0111111111111( ~lock7, ~sk, pki, user, 'new' ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) unlock_user0111111111111:
   [ S_0111111111111( ~lock7, ~sk, pki, user, 'new' ) ]
  --[ Unlock( ~lock7, user ) ]->
   [ S_01111111111111( ~lock7, ~sk, pki, user, 'new' ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) out_pk__sk_01111111111111:
   [ S_01111111111111( ~lock7, ~sk, pki, user, 'new' ) ]
  -->
   [ Out( pk(~sk) ), S_011111111111111( ~lock7, ~sk, pki, user, 'new' ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) in___renew___user__pk_nsk__011112:
   [ S_011112( pki ), In( <'renew', user, pk(nsk)> ) ]
  -->
