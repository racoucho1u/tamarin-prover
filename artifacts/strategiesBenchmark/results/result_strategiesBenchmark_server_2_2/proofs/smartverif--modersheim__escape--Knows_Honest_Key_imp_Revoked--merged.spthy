  /* has exactly the trivial AC variant */

rule (modulo E) Zero01111211112:
   [ S_01111211112( pksk, ~lock7, sk, pki, nsk, user, 'renew' ) ] --> [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) new_user012:
   [ S_012( ), Fr( user ) ] --> [ S_0121( user ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Rep0121:
