  /* has exactly the trivial AC variant */

rule (modulo E) event_HonestKey__nsk_01211111:
   [ S_01211111( ~sk, ~lock11, ~nsk, user ) ]
  --[ Event( ), HonestKey( ~nsk ) ]->
   [ S_012111111( ~sk, ~lock11, ~nsk, user ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) delete___USER___user_012111111:
   [ S_012111111( ~sk, ~lock11, ~nsk, user ) ]
  --[ Delete( <'USER', user> ) ]->
   [ S_0121111111( ~sk, ~lock11, ~nsk, user ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) insert___USER___user___nsk0121111111:
   [ S_0121111111( ~sk, ~lock11, ~nsk, user ) ]
  --[ Insert( <'USER', user>, ~nsk ) ]->
