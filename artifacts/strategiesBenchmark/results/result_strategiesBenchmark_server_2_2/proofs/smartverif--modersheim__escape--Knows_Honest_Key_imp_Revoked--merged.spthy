  /* has exactly the trivial AC variant */

rule (modulo E) if_pksk_pk_sk_0111121111:
   [ S_0111121111( pksk, ~lock7, sk, pki, nsk, user, 'renew' ) ]
  --[ Eq( pksk, pk(sk) ) ]->
