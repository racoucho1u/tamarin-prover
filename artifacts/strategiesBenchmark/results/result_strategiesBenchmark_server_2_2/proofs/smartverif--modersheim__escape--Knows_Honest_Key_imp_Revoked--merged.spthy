rule (modulo E) out__sk0121111111111111:
   [
   S_0121111111111111( pki, 'confirm', ~sk, ~nsk, user, 'renew', ~sk,
                       ~lock11, ~nsk, user
   )
   ]
  -->
   [
   Out( ~sk ),
   S_01211111111111111( pki, 'confirm', ~sk, ~nsk, user, 'renew', ~sk,
                        ~lock11, ~nsk, user
   )
   ]

  /* has exactly the trivial AC variant */

restriction single_session:
  "∀ #i #j. ((Init( ) @ #i) ∧ (Init( ) @ #j)) ⇒ (#i = #j)"
  // safety formula

restriction conditional1:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

restriction conditional2:
  "∀ x y #i. (NotEq( x, y ) @ #i) ⇒ (¬(x = y))"
  // safety formula

restriction set_in:
  "∀ x y #t3.
    (IsIn( x, y ) @ #t3) ⇒
    (∃ #t2.
      (((Insert( x, y ) @ #t2) ∧ (#t2 < #t3)) ∧
       (∀ #t1. (Delete( x ) @ #t1) ⇒ ((#t1 < #t2) ∨ (#t3 < #t1)))) ∧
      (∀ #t1 yp.
        (Insert( x, yp ) @ #t1) ⇒ (((#t1 < #t2) ∨ (#t1 = #t2)) ∨ (#t3 < #t1))))"

restriction set_notin:
  "∀ x #t3.
    (IsNotSet( x ) @ #t3) ⇒
    ((∀ #t1 y. (Insert( x, y ) @ #t1) ⇒ (#t3 < #t1)) ∨
     (∃ #t1.
       ((Delete( x ) @ #t1) ∧ (#t1 < #t3)) ∧
       (∀ #t2 y. ((Insert( x, y ) @ #t2) ∧ (#t2 < #t3)) ⇒ (#t2 < #t1))))"

restriction immeadiate_in:
  "∀ t #i.
    (ChannelInEvent( t ) @ #i) ⇒
    (∃ #j.
      (((K( t ) @ #j) ∧ (#j < #i)) ∧
       (∀ #k. (Event( ) @ #k) ⇒ ((#k < #j) ∨ (#i < #k)))) ∧
      (∀ #k t2. (K( t2 ) @ #k) ⇒ (((#k < #j) ∨ (#i < #k)) ∨ (#k = #j))))"

restriction locking:
  "∀ n x np #i #j.
    ((Lock( n, x ) @ #i) ∧ (Lock( np, x ) @ #j)) ⇒
    ((((#i < #j) ∧
       (∃ #k.
         ((((Unlock( n, x ) @ #k) ∧ (#i < #k)) ∧ (#k < #j)) ∧
          (∀ np.1 #l. (Lock( np.1, x ) @ #l) ⇒ (¬((#i < #l) ∧ (#l < #k))))) ∧
         (∀ np.1 #l. (Unlock( np.1, x ) @ #l) ⇒ (¬((#i < #l) ∧ (#l < #k)))))) ∨
      (#j < #i)) ∨
     (#i = #j))"

lemma Knows_Honest_Key_imp_Revoked:
  all-traces
  "∀ sk #i #d.
    ((HonestKey( sk ) @ #i) ∧ (K( sk ) @ #d)) ⇒ (∃ #r. Revoked( sk ) @ #r)"
/*
guarded formula characterizing all counter-examples:
"∃ sk #i #d.
  (HonestKey( sk ) @ #i) ∧ (K( sk ) @ #d) ∧ ∀ #r. (Revoked( sk ) @ #r) ⇒ ⊥"
*/
simplify
solve( HonestKey( sk ) @ #i )
  case event_HonestKey__nsk_01211111
  solve( S_01211111( ~sk, ~lock11, ~nsk, user ) ▶₀ #i )
    case lookup___USER___user__as__sk0121111
    solve( Insert( <'USER', ~n>, ~sk ) @ #t2 )
      case insert___USER___user___nsk0121111111
      solve( S_0121111111( ~sk.1, ~lock11.1, ~sk, ~n ) ▶₀ #t2 )
        case delete___USER___user_012111111
        solve( ((#vr.1 < #vr.11) ∧
                (∃ #k.
                  (Unlock( ~lock11, ~n ) @ #k)
                 ∧
                  (#vr.1 < #k) ∧
                  (#k < #vr.11) ∧
                  (∀ np #l. (Lock( np, ~n ) @ #l) ⇒ ((¬(#vr.1 < #l)) ∨ (¬(#l < #k)))) ∧
                  (∀ np #l.
                    (Unlock( np, ~n ) @ #l) ⇒ ((¬(#vr.1 < #l)) ∨ (¬(#l < #k))))))  ∥
               (#vr.11 < #vr.1)  ∥ (#vr.1 = #vr.11) )
          case case_1
          solve( Unlock( ~lock11, ~n ) @ #k )
            case unlock_user0111111111111
            by contradiction /* cyclic */
          next
            case unlock_user0111121111111
            by contradiction /* cyclic */
          next
            case unlock_user01211111111
            by contradiction /* cyclic */
          qed
        next
          case case_2
          solve( Unlock( ~lock11.1, ~n ) @ #k )
            case unlock_user0111111111111
            by solve( S_0111111111111( ~lock11.1, ~sk.1, pki, ~n, 'new' ) ▶₀ #k )
          next
            case unlock_user0111121111111
            by solve( S_0111121111111( pksk, ~lock11.1, sk.1, pki, nsk.1, ~n, 'renew'
                      ) ▶₀ #k )
          next
            case unlock_user01211111111
            solve( S_01211111111( ~sk.1, ~lock11.1, ~nsk.1, ~n ) ▶₀ #k )
              case insert___USER___user___nsk0121111111
              solve( (#k = #k.1)  ∥ (#k.1 < #k) )
                case case_1
                solve( (#t2.1 < #t2.2)  ∥ (#t2.1 = #t2.2) )
                  case case_1
                  by contradiction /* from formulas */
                next
                  case case_2
                  solve( !KU( ~nsk ) @ #vk )
                    case out__sk0121111111111111
                    by contradiction /* from formulas */
                  qed
                qed
              next
                case case_2
                by contradiction /* from formulas */
              qed
            qed
          qed
        next
          case case_3
          by contradiction /* cyclic */
        qed
      qed
    next
      case insert___USER___user___sk01111111111
      solve( S_01111111111( ~lock7, ~sk, pki, ~n, 'new' ) ▶₀ #t2 )
        case insert___SERVER___pki__user__pk__sk_0111111111
        solve( ((#vr.1 < #vr.10) ∧
                (∃ #k.
                  (Unlock( ~lock11, ~n ) @ #k)
                 ∧
                  (#vr.1 < #k) ∧
                  (#k < #vr.10) ∧
                  (∀ np #l. (Lock( np, ~n ) @ #l) ⇒ ((¬(#vr.1 < #l)) ∨ (¬(#l < #k)))) ∧
                  (∀ np #l.
                    (Unlock( np, ~n ) @ #l) ⇒ ((¬(#vr.1 < #l)) ∨ (¬(#l < #k))))))  ∥
               (#vr.10 < #vr.1) )
          case case_1
          solve( Unlock( ~lock11, ~n ) @ #k )
            case unlock_user0111111111111
            by contradiction /* cyclic */
          next
            case unlock_user0111121111111
            by contradiction /* cyclic */
          next
            case unlock_user01211111111
            by contradiction /* cyclic */
          qed
        next
          case case_2
          solve( Unlock( ~lock7, ~n ) @ #k )
            case unlock_user0111111111111
            solve( S_0111111111111( ~lock7, ~sk.1, pki, ~n, 'new' ) ▶₀ #k )
              case event_HonestKey__sk_011111111111
              solve( (#k = #k.1)  ∥ (#k.1 < #k) )
                case case_1
                solve( !KU( ~nsk ) @ #vk )
                  case out__sk0121111111111111
                  by contradiction /* from formulas */
                qed
              next
                case case_2
                by contradiction /* from formulas */
              qed
            qed
          next
            case unlock_user0111121111111
            by solve( S_0111121111111( pksk, ~lock7, sk.1, pki, nsk.1, ~n, 'renew'
                      ) ▶₀ #k )
          next
            case unlock_user01211111111
            by solve( S_01211111111( ~sk.1, ~lock7, ~nsk.1, ~n ) ▶₀ #k )
          qed
        qed
      qed
    qed
  qed
next
  case event_HonestKey__sk_011111111
  solve( S_011111111( ~lock7, ~sk, pki, user, 'new' ) ▶₀ #i )
    case lock_user01111111
    solve( !KU( ~sk ) @ #vk )
      case out__sk0121111111111111
      by contradiction /* from formulas */
    qed
  qed
next
  case event_HonestKey__sk_011111111111
  solve( S_011111111111( ~lock7, ~sk, pki, user, 'new' ) ▶₀ #i )
    case insert___USER___user___sk01111111111
    solve( !KU( ~sk ) @ #vk )
      case out__sk0121111111111111
      by contradiction /* from formulas */
    qed
  qed
qed



















