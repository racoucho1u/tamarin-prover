  /* has exactly the trivial AC variant */

rule (modulo E) event_Revoked__sk_012111111111111:
   [
   S_012111111111111( pki, 'confirm', ~sk, ~nsk, user, 'renew', ~sk,
                      ~lock11, ~nsk, user
   )
   ]
  --[ Event( ), Revoked( ~sk ) ]->
