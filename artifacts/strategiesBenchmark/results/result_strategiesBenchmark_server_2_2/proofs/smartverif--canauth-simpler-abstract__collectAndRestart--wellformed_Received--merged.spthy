   [ State_11111121111111( ~lock12, ~lock6, i, j, msg, sk ) ]
  --[ Insert( 'cellB', j ) ]->
   [ State_111111211111111( ~lock12, ~lock6, i, j, msg, sk ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) insert_cellB_j_true__111111211111111[color=#45d1e2]:
   [ State_111111211111111( ~lock12, ~lock6, i, j, msg, sk ) ]
  --[ Insert( <'cellB', j>, 'true' ) ]->
   [ State_1111112111111111( ~lock12, ~lock6, i, j, msg, sk ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) unlock_cellB_j__1111112111111111[color=#45d1e2]:
   [ State_1111112111111111( ~lock12, ~lock6, i, j, msg, sk ) ]
  --[
  Unlock( $6, ~lock6, <'cellB', j> ), Unlock_6( $6, ~lock6, <'cellB', j> )
  ]->
   [ State_11111121111111111( ~lock12, ~lock6, i, j, msg, sk ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) unlock_cellB__11111121111111111[color=#45d1e2]:
   [ State_11111121111111111( ~lock12, ~lock6, i, j, msg, sk ) ]
  --[ Unlock( $12, ~lock12, 'cellB' ), Unlock_12( $12, ~lock12, 'cellB' )
  ]->
   [ State_111111211111111111( ~lock12, ~lock6, i, j, msg, sk ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Zero_111111211111111111[color=#45d1e2]:
   [ State_111111211111111111( ~lock12, ~lock6, i, j, msg, sk ) ] --> [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Zero_111111212[color=#45d1e2]:
   [ State_111111212( ~lock12, sk ) ] --> [ ]

  /* has exactly the trivial AC variant */

restriction set_in:
  "∀ x y #t3.
    (IsIn( x, y ) @ #t3) ⇒
    (∃ #t2.
      (((Insert( x, y ) @ #t2) ∧ (#t2 < #t3)) ∧
       (∀ #t1. (Delete( x ) @ #t1) ⇒ ((#t1 < #t2) ∨ (#t3 < #t1)))) ∧
      (∀ #t1 yp.
        (Insert( x, yp ) @ #t1) ⇒ (((#t1 < #t2) ∨ (#t1 = #t2)) ∨ (#t3 < #t1))))"

restriction set_notin:
  "∀ x #t3.
    (IsNotSet( x ) @ #t3) ⇒
    ((∀ #t1 y. (Insert( x, y ) @ #t1) ⇒ (#t3 < #t1)) ∨
     (∃ #t1.
       ((Delete( x ) @ #t1) ∧ (#t1 < #t3)) ∧
       (∀ #t2 y. ((Insert( x, y ) @ #t2) ∧ (#t2 < #t3)) ⇒ (#t2 < #t1))))"

restriction predicate_eq:
  "∀ #i a b. (Pred_eq( a, b ) @ #i) ⇒ (a = b)"
  // safety formula

restriction predicate_not_eq:
  "∀ #i a b. (Pred_not_eq( a, b ) @ #i) ⇒ (¬(a = b))"
  // safety formula

restriction single_session:
  "∀ #i #j. ((Init( ) @ #i) ∧ (Init( ) @ #j)) ⇒ (#i = #j)"
  // safety formula

restriction locking_12:
  "∀ p pp l x lp #t1 #t3.
    ((Lock_12( p, l, x ) @ #t1) ∧ (Lock( pp, lp, x ) @ #t3)) ⇒
    ((((#t1 < #t3) ∧
       (∃ #t2.
         (((((Unlock_12( p, l, x ) @ #t2) ∧ (#t1 < #t2)) ∧ (#t2 < #t3)) ∧
           (∀ #t0 pp.1. (Unlock( pp.1, l, x ) @ #t0) ⇒ (#t0 = #t2))) ∧
          (∀ pp.1 lpp #t0.
            (Lock( pp.1, lpp, x ) @ #t0) ⇒
            (((#t0 < #t1) ∨ (#t0 = #t1)) ∨ (#t2 < #t0)))) ∧
         (∀ pp.1 lpp #t0.
           (Unlock( pp.1, lpp, x ) @ #t0) ⇒
           (((#t0 < #t1) ∨ (#t2 < #t0)) ∨ (#t2 = #t0))))) ∨
      (#t3 < #t1)) ∨
     (#t1 = #t3))"

restriction locking_9:
  "∀ p pp l x lp #t1 #t3.
    ((Lock_9( p, l, x ) @ #t1) ∧ (Lock( pp, lp, x ) @ #t3)) ⇒
    ((((#t1 < #t3) ∧
       (∃ #t2.
         (((((Unlock_9( p, l, x ) @ #t2) ∧ (#t1 < #t2)) ∧ (#t2 < #t3)) ∧
           (∀ #t0 pp.1. (Unlock( pp.1, l, x ) @ #t0) ⇒ (#t0 = #t2))) ∧
          (∀ pp.1 lpp #t0.
            (Lock( pp.1, lpp, x ) @ #t0) ⇒
            (((#t0 < #t1) ∨ (#t0 = #t1)) ∨ (#t2 < #t0)))) ∧
         (∀ pp.1 lpp #t0.
           (Unlock( pp.1, lpp, x ) @ #t0) ⇒
           (((#t0 < #t1) ∨ (#t2 < #t0)) ∨ (#t2 = #t0))))) ∨
      (#t3 < #t1)) ∨
     (#t1 = #t3))"

restriction locking_6:
  "∀ p pp l x lp #t1 #t3.
    ((Lock_6( p, l, x ) @ #t1) ∧ (Lock( pp, lp, x ) @ #t3)) ⇒
    ((((#t1 < #t3) ∧
       (∃ #t2.
         (((((Unlock_6( p, l, x ) @ #t2) ∧ (#t1 < #t2)) ∧ (#t2 < #t3)) ∧
           (∀ #t0 pp.1. (Unlock( pp.1, l, x ) @ #t0) ⇒ (#t0 = #t2))) ∧
          (∀ pp.1 lpp #t0.
            (Lock( pp.1, lpp, x ) @ #t0) ⇒
            (((#t0 < #t1) ∨ (#t0 = #t1)) ∨ (#t2 < #t0)))) ∧
         (∀ pp.1 lpp #t0.
           (Unlock( pp.1, lpp, x ) @ #t0) ⇒
           (((#t0 < #t1) ∨ (#t2 < #t0)) ∨ (#t2 = #t0))))) ∨
      (#t3 < #t1)) ∨
     (#t1 = #t3))"

lemma Received_only_if_Sent:
  all-traces
  "∀ sk msg i #u.
    (Received( sk, msg, i ) @ #u) ⇒
    (∃ #v. (#v < #u) ∧ (Sent( sk, msg, i ) @ #v))"
/*
guarded formula characterizing all counter-examples:
"∃ sk msg i #u.
  (Received( sk, msg, i ) @ #u)
 ∧
  ∀ #v. (Sent( sk, msg, i ) @ #v) ⇒ ¬(#v < #u)"
*/
by sorry

lemma wellformed_Received:
  all-traces
  "∀ sk msg1 i1 msg2 i2 #u #v.
    ((Received( sk, msg1, i1 ) @ #u) ∧ (Received( sk, msg2, i2 ) @ #v)) ⇒
    (((msg1 = msg2) ∧ (i1 = i2)) ∨ ((¬(msg1 = msg2)) ∧ (¬(i1 = i2))))"
/*
guarded formula characterizing all counter-examples:
"∃ sk msg1 i1 msg2 i2 #u #v.
  (Received( sk, msg1, i1 ) @ #u) ∧ (Received( sk, msg2, i2 ) @ #v)
 ∧
  (((¬(msg1 = msg2)) ∨ (¬(i1 = i2)))) ∧ (((msg1 = msg2) ∨ (i1 = i2)))"
*/
simplify
solve( (¬(msg1 = msg2))  ∥ (¬(i1 = i2)) )
  case case_1
  solve( (msg1 = msg2)  ∥ (i1 = i2) )
    case case_1
    by contradiction /* from formulas */
  next
    case case_2
    solve( Received( sk, msg1, i1 ) @ #u )
      case event_Receivedsk_msg_j_111111111111121
      solve( State_111111111111121( ~lock12, ~lock9, h, i, i1, msg1, sk
             ) ▶₀ #u )
        case if_eqh_hmacsk_j_msg__0_11111111111112
        solve( !KU( hmac(~n, <i1, msg1>) ) @ #vk.6 )
          case c_hmac
          by solve( !KU( ~n ) @ #vk.8 )
        next
          case out_msg_SIGN_j_hmacsk_j_msg___11111111211111
          solve( Received( ~n, msg2, ~n.1 ) @ #v )
            case event_Receivedsk_msg_j_111111111111121
            solve( State_111111111111121( ~lock12.1, ~lock9.1, h, i.1, ~n.1, msg2, ~n
                   ) ▶₀ #v )
              case if_eqh_hmacsk_j_msg__0_11111111111112
              solve( !KU( hmac(~n, <~n.1, msg2>) ) @ #vk.11 )
                case c_hmac
                by solve( !KU( ~n ) @ #vk.13 )
              next
                case out_msg_SIGN_j_hmacsk_j_msg___11111111211111
                by contradiction /* from formulas */
              qed
            qed
          next
            case event_Receivedsk_msg_j_11111112111121
            solve( State_11111112111121( ~lock12.1, ~lock9.1, h, i.1, ~n.1, msg2, ~n
                   ) ▶₀ #v )
              case if_eqh_hmacsk_j_msg__0_1111111211112
              solve( !KU( hmac(~n, <~n.1, msg2>) ) @ #vk.11 )
                case c_hmac
                by solve( !KU( ~n ) @ #vk.13 )
              next
                case out_msg_SIGN_j_hmacsk_j_msg___11111111211111
                by contradiction /* from formulas */
              qed
            qed
          qed
        next
          case out_msg_SIGN_j_hmacsk_j_msg___111111211111
          solve( Received( ~n, msg2, ~n.1 ) @ #v )
            case event_Receivedsk_msg_j_111111111111121
            solve( State_111111111111121( ~lock12.1, ~lock9.1, h, i.1, ~n.1, msg2, ~n
                   ) ▶₀ #v )
              case if_eqh_hmacsk_j_msg__0_11111111111112
              solve( !KU( hmac(~n, <~n.1, msg2>) ) @ #vk.11 )
                case c_hmac
                by solve( !KU( ~n ) @ #vk.13 )
              next
                case out_msg_SIGN_j_hmacsk_j_msg___111111211111
                by contradiction /* from formulas */
              qed
            qed
          next
            case event_Receivedsk_msg_j_11111112111121
            solve( State_11111112111121( ~lock12.1, ~lock9.1, h, i.1, ~n.1, msg2, ~n
                   ) ▶₀ #v )
              case if_eqh_hmacsk_j_msg__0_1111111211112
              solve( ((#vr.25 < #vr.33) ∧
                      (∃ #t2.
                        (Unlock_12( $12.1, ~lock12.2, 'cellB' ) @ #t2)
                       ∧
                        (#vr.25 < #t2) ∧
                        (#t2 < #vr.33) ∧
                        (∀ #t0 pp. (Unlock( pp, ~lock12.2, 'cellB' ) @ #t0) ⇒ #t0 = #t2) ∧
                        (∀ pp lpp #t0.
                          (Lock( pp, lpp, 'cellB' ) @ #t0)
                         ⇒
                          ((#t0 < #vr.25) ∨ (#t0 = #vr.25) ∨ (#t2 < #t0))) ∧
                        (∀ pp lpp #t0.
                          (Unlock( pp, lpp, 'cellB' ) @ #t0)
                         ⇒
                          ((#t0 < #vr.25) ∨ (#t2 < #t0) ∨ (#t2 = #t0)))))  ∥
                     (#vr.33 < #vr.25) )
                case case_1
                solve( Unlock_12( $12.1, ~lock12.2, 'cellB' ) @ #t2.3 )
                  case unlock_cellB__11111112111111
                  by solve( State_11111112111111( ~lock12.2, ~lock9.2, h, i.2, j, msg, sk,
                                                  x
                            ) ▶₀ #t2 )
                next
                  case unlock_cellB__111111121111211111
                  by solve( State_111111121111211111( ~lock12.2, ~lock9.2, h, i.2, j, msg,
                                                      sk
                            ) ▶₀ #t2 )
                next
                  case unlock_cellB__111111121111221
                  by solve( State_111111121111221( ~lock12.2, ~lock9.2, h, i.2, j, msg, sk
                            ) ▶₀ #t2 )
                next
                  case unlock_cellB__11111121111111111
                  solve( State_11111121111111111( ~lock12.2, ~lock6, i.2, j, msg, sk
                         ) ▶₀ #t2 )
                    case unlock_cellB_j__1111112111111111
                    solve( Unlock_6( $6.1, ~lock6, <'cellB', ~n> ) @ #vr.37 )
                      case unlock_cellB_j__1111112111111111
                      solve( !KU( hmac(~n.2, <~n, msg2>) ) @ #vk.11 )
                        case c_hmac
                        by solve( !KU( ~n.2 ) @ #vk.13 )
                      next
                        case out_msg_SIGN_j_hmacsk_j_msg___111111211111
                        by contradiction /* from formulas */
                      qed
                    qed
                  qed
                qed
              next
                case case_2
                solve( Unlock_12( $12.2, ~lock12.1, 'cellB' ) @ #t2.3 )
                  case unlock_cellB__11111112111111
                  by contradiction /* cyclic */
                next
                  case unlock_cellB__111111121111211111
                  by contradiction /* cyclic */
                next
                  case unlock_cellB__111111121111221
                  by contradiction /* cyclic */
                next
                  case unlock_cellB__11111121111111111
                  by contradiction /* cyclic */
                qed
              qed
            qed
          qed
        qed
      qed
    next
      case event_Receivedsk_msg_j_11111112111121
      solve( State_11111112111121( ~lock12, ~lock9, h, i, i1, msg1, sk
             ) ▶₀ #u )
        case if_eqh_hmacsk_j_msg__0_1111111211112
        solve( (∀ #t1 y. (Insert( <'cellB', i1>, y ) @ #t1) ⇒ #vr.1 < #t1)  ∥
               (∃ #t1.
                 (Delete( <'cellB', i1> ) @ #t1)
                ∧
                 (#t1 < #vr.1) ∧
                 (∀ #t2 y.
                   (Insert( <'cellB', i1>, y ) @ #t2) ⇒ ((¬(#t2 < #vr.1)) ∨ (#t2 < #t1)))) )
          case case_1
          solve( !KU( hmac(~n, <i1, msg1>) ) @ #vk.6 )
            case c_hmac
            by solve( !KU( ~n ) @ #vk.8 )
          next
            case out_msg_SIGN_j_hmacsk_j_msg___11111111211111
            solve( Received( ~n, msg2, ~n.1 ) @ #v )
              case event_Receivedsk_msg_j_111111111111121
              solve( State_111111111111121( ~lock12.1, ~lock9.1, h, i.1, ~n.1, msg2, ~n
                     ) ▶₀ #v )
                case if_eqh_hmacsk_j_msg__0_11111111111112
                solve( !KU( hmac(~n, <~n.1, msg2>) ) @ #vk.11 )
                  case c_hmac
                  by solve( !KU( ~n ) @ #vk.13 )
                next
                  case out_msg_SIGN_j_hmacsk_j_msg___11111111211111
                  by contradiction /* from formulas */
                qed
              qed
            next
              case event_Receivedsk_msg_j_11111112111121
              solve( State_11111112111121( ~lock12.1, ~lock9.1, h, i.1, ~n.1, msg2, ~n
                     ) ▶₀ #v )
                case if_eqh_hmacsk_j_msg__0_1111111211112
                solve( ((#vr.2 < #vr.31) ∧
                        (∃ #t2.
                          (Unlock_9( $9, ~lock9, <'cellB', ~n.1> ) @ #t2)
                         ∧
                          (#vr.2 < #t2) ∧
                          (#t2 < #vr.31) ∧
                          (∀ #t0 pp. (Unlock( pp, ~lock9, <'cellB', ~n.1> ) @ #t0) ⇒ #t0 = #t2) ∧
                          (∀ pp lpp #t0.
                            (Lock( pp, lpp, <'cellB', ~n.1> ) @ #t0)
                           ⇒
                            ((#t0 < #vr.2) ∨ (#t0 = #vr.2) ∨ (#t2 < #t0))) ∧
                          (∀ pp lpp #t0.
                            (Unlock( pp, lpp, <'cellB', ~n.1> ) @ #t0)
                           ⇒
                            ((#t0 < #vr.2) ∨ (#t2 < #t0) ∨ (#t2 = #t0)))))  ∥
                       (#vr.31 < #vr.2)  ∥ (#vr.2 = #vr.31) )
                  case case_1
                  solve( Unlock_9( $9, ~lock9, <'cellB', ~n.1> ) @ #t2.3 )
                    case unlock_cellB_j__1111111211111
                    by solve( State_1111111211111( ~lock12.2, ~lock9, h, i.2, ~n.1, msg, sk,
                                                   x
                              ) ▶₀ #t2 )
                  next
                    case unlock_cellB_j__11111112111121111
                    solve( State_11111112111121111( ~lock12.2, ~lock9, h, i.2, ~n.1, msg, sk
                           ) ▶₀ #t2 )
                      case insert_cellB_j_true__1111111211112111
                      solve( (#vr.39 < #t2.3)  ∥ (#vr.39 = #t2.3)  ∥ (#vr.33 < #vr.39) )
                        case case_1
                        solve( !KU( hmac(~n, <~n.1, msg2>) ) @ #vk.11 )
                          case c_hmac
