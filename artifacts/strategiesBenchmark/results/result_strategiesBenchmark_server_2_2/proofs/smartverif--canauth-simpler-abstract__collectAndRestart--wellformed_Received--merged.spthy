                    case unlock_cellB__111111121111211111
                    by contradiction /* cyclic */
                  next
                    case unlock_cellB__111111121111221
                    by contradiction /* cyclic */
                  next
                    case unlock_cellB__11111121111111111
                    by contradiction /* cyclic */
