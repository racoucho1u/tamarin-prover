                solve( State_111111111111121( ~lock12.1, ~lock9.1, h, i.1, ~n.1, msg2, ~n
                       ) ▶₀ #v )
                  case if_eqh_hmacsk_j_msg__0_11111111111112
                  solve( Unlock_12( $12, ~lock12, 'cellB' ) @ #t2.2 )
                    case unlock_cellB__11111112111111
                    by contradiction /* cyclic */
