                qed
              next
                case event_Receivedsk_msg_j_11111112111121
                solve( State_11111112111121( ~lock12.1, ~lock9.1, h, i.1, ~n.1, msg2, ~n
                       ) ▶₀ #v )
                  case if_eqh_hmacsk_j_msg__0_1111111211112
                  solve( ((#vr.2 < #vr.29) ∧
                          (∃ #t2.
                            (Unlock_9( $9, ~lock9, <'cellB', ~n.1> ) @ #t2)
                           ∧
                            (#vr.2 < #t2) ∧
                            (#t2 < #vr.29) ∧
                            (∀ #t0 pp. (Unlock( pp, ~lock9, <'cellB', ~n.1> ) @ #t0) ⇒ #t0 = #t2) ∧
                            (∀ pp lpp #t0.
                              (Lock( pp, lpp, <'cellB', ~n.1> ) @ #t0)
                             ⇒
                              ((#t0 < #vr.2) ∨ (#t0 = #vr.2) ∨ (#t2 < #t0))) ∧
                            (∀ pp lpp #t0.
                              (Unlock( pp, lpp, <'cellB', ~n.1> ) @ #t0)
                             ⇒
                              ((#t0 < #vr.2) ∨ (#t2 < #t0) ∨ (#t2 = #t0)))))  ∥
                         (#vr.29 < #vr.2)  ∥ (#vr.2 = #vr.29) )
                    case case_1
                    solve( (#vr.32 < #vr.5)  ∥ (#vr.32 = #vr.5)  ∥ (#t2.2 < #vr.32) )
                      case case_1
                      solve( Unlock_12( $12, ~lock12, 'cellB' ) @ #t2.2 )
                        case unlock_cellB__11111112111111
                        by contradiction /* cyclic */
                      next
                        case unlock_cellB__111111121111211111
                        by contradiction /* cyclic */
                      next
                        case unlock_cellB__111111121111221
                        by contradiction /* cyclic */
                      next
                        case unlock_cellB__11111121111111111
                        by contradiction /* cyclic */
                      qed
                    next
                      case case_2
                      by contradiction /* cyclic */
                    next
                      case case_3
                      solve( ((#vr.24 < #vr.32) ∧
                              (∃ #t2.
                                (Unlock_12( $12.1, ~lock12.2, 'cellB' ) @ #t2)
                               ∧
                                (#vr.24 < #t2) ∧
                                (#t2 < #vr.32) ∧
                                (∀ #t0 pp. (Unlock( pp, ~lock12.2, 'cellB' ) @ #t0) ⇒ #t0 = #t2) ∧
