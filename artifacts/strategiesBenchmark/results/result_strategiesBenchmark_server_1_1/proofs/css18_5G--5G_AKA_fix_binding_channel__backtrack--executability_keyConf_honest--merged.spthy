    (Out_Src( RAND, AUTN ) @ #i) ⇒
    ((∃ #j. (Src( RAND, AUTN ) @ #j) ∧ (#j < #i)) ∨
     (∃ #j x1 x2.
       (Injected( <'aia', RAND, x1, x2, AUTN> ) @ #j) ∧ (#j < #i)))"
