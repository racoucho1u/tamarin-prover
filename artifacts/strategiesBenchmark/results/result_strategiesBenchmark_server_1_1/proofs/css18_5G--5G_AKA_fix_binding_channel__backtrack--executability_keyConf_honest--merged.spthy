solve( St_4_SEAF( ~tid, ~idSN, SNID, conc_supi, idHN, ~RAND, RES_star,
                  K_seaf, supi, ~cid
       ) ▶₀ #i )
  case seaf_receive_aca_case_1
  solve( RcvS( ~cid, ~idHN, ~idSN,
               <'aia', ~RAND, SHA256(RES_star, ~RAND), K_seaf, AUTN>
         ) ▶₁ #vr.3 )
    case receive_secure_case_1
    solve( !KU( f1(KDF(KDF(<f3(~k, ~RAND), f4(~k, ~RAND)>,
                           <<'5G', ~idSN>, (f5(~k, ~RAND)⊕('1'++~sqn_root++count))>),
                       <'5G', ~idSN>),
                   'UE')
           ) @ #vk )
      case c_f1
      solve( !KU( KDF(<f3(~k, ~RAND), f4(~k, ~RAND)>,
                      <<'5G', ~idSN>, f2(~k, ~RAND), ~RAND>)
             ) @ #vk.1 )
        case c_KDF
        solve( !KU( f3(~k, ~RAND) ) @ #vk.10 )
          case c_f3
          solve( !KU( ~k ) @ #vk.18 )
            case reveal_Ltk_Sym
            by contradiction /* from formulas */
          qed
        qed
      next
        case ue_receive_authReq_freshness_success_send_authResp
        solve( !KU( KDF(KDF(<f3(~k, ~RAND), f4(~k, ~RAND)>,
                            <<'5G', ~idSN>, (f5(~k, ~RAND)⊕('1'++~sqn_root++count))>),
                        <'5G', ~idSN>)
               ) @ #vk.6 )
          case c_KDF
          solve( !KU( (f5(~k, ~RAND)⊕(~sqn_root++dif++count.1)) ) @ #vk.12 )
            case c_xor
            solve( !KU( ~sqn_root ) @ #vk.19 )
              case reveal_Ltk_Sqn
              by contradiction /* from formulas */
            next
              case seaf_receive_aia_send_authReq
              solve( !KU( f1(~k, <(~sqn_root++dif++count.1), ~RAND, '5G', ~idSN>)
                     ) @ #vk.14 )
                case c_f1
                solve( !KU( ~k ) @ #vk.25 )
                  case reveal_Ltk_Sym
                  by contradiction /* from formulas */
                qed
              next
                case seaf_receive_aia_send_authReq_case_01
                by contradiction /* cyclic */
              next
                case seaf_receive_aia_send_authReq_case_02
                by contradiction /* cyclic */
              next
                case seaf_receive_aia_send_authReq_case_03
                solve( !KU( KDF(<f3(~k, ~RAND), f4(~k, ~RAND)>,
                                <<'5G', ~idSN>, (f5(~k, ~RAND)⊕('1'++~sqn_root++count))>)
                       ) @ #vk.19 )
                  case c_KDF
                  solve( !KU( f3(~k, ~RAND) ) @ #vk.24 )
                    case c_f3
                    solve( !KU( ~k ) @ #vk.26 )
                      case reveal_Ltk_Sym
                      by contradiction /* from formulas */
                    qed
                  qed
                qed
              next
                case seaf_receive_aia_send_authReq_case_04
                by contradiction /* cyclic */
              next
                case seaf_receive_aia_send_authReq_case_05
                solve( !KU( KDF(<f3(~k, ~RAND), f4(~k, ~RAND)>,
                                <<'5G', ~idSN>, (f5(~k, ~RAND)⊕('1'++~sqn_root++count))>)
                       ) @ #vk.19 )
                  case c_KDF
                  solve( !KU( f3(~k, ~RAND) ) @ #vk.24 )
                    case c_f3
                    solve( !KU( ~k ) @ #vk.26 )
                      case reveal_Ltk_Sym
                      by contradiction /* from formulas */
                    qed
                  qed
                qed
              next
                case seaf_receive_aia_send_authReq_case_06
                by contradiction /* cyclic */
              next
                case seaf_receive_aia_send_authReq_case_07
                by contradiction /* cyclic */
              next
                case seaf_receive_aia_send_authReq_case_08
                by contradiction /* cyclic */
              next
                case seaf_receive_aia_send_authReq_case_09
                by contradiction /* cyclic */
              next
                case seaf_receive_aia_send_authReq_case_10
                by contradiction /* cyclic */
              next
                case seaf_receive_aia_send_authReq_case_11
                solve( !KU( KDF(<f3(~k, ~RAND), f4(~k, ~RAND)>,
                                <<'5G', ~idSN>, (f5(~k, ~RAND)⊕('1'++~sqn_root++dif++x))>)
                       ) @ #vk.19 )
                  case c_KDF
