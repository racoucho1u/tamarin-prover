lemma executability_resync:
  exists-trace
  "∃ #i1 #i2 #i3 #i4 X.
    ((((((((((((((((((Start_HSS_Session( X ) @ #i1) ∧
                     (HSS_Resync_End( ('1'++'1'++'1'++'1') ) @ #i2)) ∧
                    (Start_HSS_Session( X ) @ #i3)) ∧
