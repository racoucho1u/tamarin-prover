lemma functional:
  exists-trace
  "∃ H1 v #i #d #h b P #p S #s c #p2 #i2 #k #l BB #m A bPrimea skS #o.
    ((((((((((((Vote( H1, v ) @ #i) ∧ (D1( ) @ #d)) ∧
              (Ballot( H1, b ) @ #h)) ∧
             (Receive_R_HP( H1, P, b ) @ #p)) ∧
            (Receive_R_PS( P, S, b ) @ #s)) ∧
           (Send_R_SP( S, P, c ) @ #s)) ∧
          (Receive_R_SP( S, P, c ) @ #p2)) ∧
         (Send_R_PH( P, H1, c ) @ #p2)) ∧
        (Evidence( b, c ) @ #i2)) ∧
       (BB_rec( BB, <'b', b> ) @ #k)) ∧
      (BB_tal( BB, <'v', v> ) @ #l)) ∧
     (Verify( H1, b, b ) @ #m)) ∧
    (VerifyA2( A, verzkp(zkp(bPrimea, v, skS), bPrimea, v, pk(skS)) ) @ #o)"
/*
guarded formula characterizing all satisfying traces:
"∃ H1 v #i #d #h b P #p S #s c #p2 #i2 #k #l BB #m A bPrimea skS #o.
  (Vote( H1, v ) @ #i) ∧
  (D1( ) @ #d) ∧
  (Ballot( H1, b ) @ #h) ∧
  (Receive_R_HP( H1, P, b ) @ #p) ∧
  (Receive_R_PS( P, S, b ) @ #s) ∧
  (Send_R_SP( S, P, c ) @ #s) ∧
  (Receive_R_SP( S, P, c ) @ #p2) ∧
  (Send_R_PH( P, H1, c ) @ #p2) ∧
  (Evidence( b, c ) @ #i2) ∧
  (BB_rec( BB, <'b', b> ) @ #k) ∧
  (BB_tal( BB, <'v', v> ) @ #l) ∧
  (Verify( H1, b, b ) @ #m) ∧
  (VerifyA2( A, verzkp(zkp(bPrimea, v, skS), bPrimea, v, pk(skS)) ) @ #o)"
*/
by sorry

lemma indivVerif:
  all-traces
  "∀ H v #i b #j.
    ((Vote( H, v ) @ #i) ∧ (Verify( H, b, b ) @ #j)) ⇒
    (∃ BB #l r pkS sskD.
      (BB_rec( BB, <'b', b> ) @ #l) ∧ (b = sg(encp(v, r, pkS), sskD)))"
/*
guarded formula characterizing all counter-examples:
"∃ H v #i b #j.
  (Vote( H, v ) @ #i) ∧ (Verify( H, b, b ) @ #j)
 ∧
  ∀ BB #l r pkS sskD.
   (BB_rec( BB, <'b', b> ) @ #l) ∧ (b = sg(encp(v, r, pkS), sskD)) ⇒ ⊥"
*/
by sorry

lemma VoterC:
  all-traces
  "∀ H b #j b1.
    (Verify( H, b, b1 ) @ #j) ⇒
    (((∃ BB #k. BB_rec( BB, <'b', b> ) @ #k) ∨
      (∃ BB skS #k #l #m ba.
        (((BB_rec( BB, <'b', ba> ) @ #k) ∧ (¬(b = ba))) ∧
         (Evidence( b, sg(b, skS) ) @ #l)) ∧
        (BB_pkS( BB, <'spkS', pk(skS)> ) @ #m))) ∨
     (∃ BB ba bPrimea sskDa #k #l #m.
       (((BB_rec( BB, <'b', ba> ) @ #k) ∧
         (BB_woS( BB, <'bPrime', bPrimea> ) @ #l)) ∧
        (BB_pskDs( BB, <'spkD', pk(sskDa)> ) @ #m)) ∧
       (¬(ba = sg(bPrimea, sskDa)))))"
/*
guarded formula characterizing all counter-examples:
"∃ H b #j b1.
  (Verify( H, b, b1 ) @ #j)
 ∧
  (∀ BB #k. (BB_rec( BB, <'b', b> ) @ #k) ⇒ ⊥) ∧
  (∀ BB skS #k #l #m ba.
    (BB_rec( BB, <'b', ba> ) @ #k) ∧
    (Evidence( b, sg(b, skS) ) @ #l) ∧
    (BB_pkS( BB, <'spkS', pk(skS)> ) @ #m)
   ⇒
    b = ba) ∧
  (∀ BB ba bPrimea sskDa #k #l #m.
    (BB_rec( BB, <'b', ba> ) @ #k) ∧
    (BB_woS( BB, <'bPrime', bPrimea> ) @ #l) ∧
    (BB_pskDs( BB, <'spkD', pk(sskDa)> ) @ #m)
   ⇒
    ba = sg(bPrimea, sskDa))"
*/
by sorry

lemma TimelyP:
  all-traces
  "∀ H b #i #j.
    (((Ballot( H, b ) @ #i) ∧ (End( ) @ #j)) ∧ (#i < #j)) ⇒
    (((∃ BB #k. BB_rec( BB, <'b', b> ) @ #k) ∨
      (∃ BB skS #k #l #m ba.
        (((BB_rec( BB, <'b', ba> ) @ #k) ∧ (¬(b = ba))) ∧
         (Evidence( b, sg(b, skS) ) @ #l)) ∧
        (BB_pkS( BB, <'spkS', pk(skS)> ) @ #m))) ∨
     (∃ BB ba bPrimea sskDa #k #l #m.
       (((BB_rec( BB, <'b', ba> ) @ #k) ∧
         (BB_woS( BB, <'bPrime', bPrimea> ) @ #l)) ∧
        (BB_pskDs( BB, <'spkD', pk(sskDa)> ) @ #m)) ∧
       (¬(ba = sg(bPrimea, sskDa)))))"
/*
guarded formula characterizing all counter-examples:
"∃ H b #i #j.
  (Ballot( H, b ) @ #i) ∧ (End( ) @ #j)
 ∧
  (#i < #j) ∧
  (∀ BB #k. (BB_rec( BB, <'b', b> ) @ #k) ⇒ ⊥) ∧
  (∀ BB skS #k #l #m ba.
    (BB_rec( BB, <'b', ba> ) @ #k) ∧
    (Evidence( b, sg(b, skS) ) @ #l) ∧
    (BB_pkS( BB, <'spkS', pk(skS)> ) @ #m)
   ⇒
    b = ba) ∧
  (∀ BB ba bPrimea sskDa #k #l #m.
    (BB_rec( BB, <'b', ba> ) @ #k) ∧
    (BB_woS( BB, <'bPrime', bPrimea> ) @ #l) ∧
    (BB_pskDs( BB, <'spkD', pk(sskDa)> ) @ #m)
   ⇒
    ba = sg(bPrimea, sskDa))"
*/
by sorry

lemma Uniqueness:
  all-traces
  "∀ #i bs BB.
    (((¬(∃ b BB.1 skS #k #l #m ba.
          (((BB_rec( BB.1, <'b', ba> ) @ #k) ∧ (¬(b = ba))) ∧
           (Evidence( b, sg(b, skS) ) @ #l)) ∧
          (BB_pkS( BB.1, <'spkS', pk(skS)> ) @ #m))) ∧
      (¬(∃ BB.1 ba bPrimea sskDa #k #l #m.
          (((BB_rec( BB.1, <'b', ba> ) @ #k) ∧
            (BB_woS( BB.1, <'bPrime', bPrimea> ) @ #l)) ∧
           (BB_pskDs( BB.1, <'spkD', pk(sskDa)> ) @ #m)) ∧
          (¬(ba = sg(bPrimea, sskDa)))))) ∧
     (BB_rec( BB, <'b', bs> ) @ #i)) ⇒
    (∃ BB.1 H1 bPrime1 sskD1 #bb #s #h1 P.
      (((BB_H( BB.1, <'H', H1> ) @ #bb) ∧ (bs = sg(bPrime1, sskD1))) ∧
       (CastByCorresp( H1, pk(sskD1) ) @ #s)) ∧
      (Send( H1, P, bs ) @ #h1))"
/*
guarded formula characterizing all counter-examples:
"∃ #i bs BB.
  (BB_rec( BB, <'b', bs> ) @ #i)
 ∧
  (∀ b BB.1 skS #k #l #m ba.
    (BB_rec( BB.1, <'b', ba> ) @ #k) ∧
    (Evidence( b, sg(b, skS) ) @ #l) ∧
    (BB_pkS( BB.1, <'spkS', pk(skS)> ) @ #m)
   ⇒
    b = ba) ∧
  (∀ BB.1 ba bPrimea sskDa #k #l #m.
    (BB_rec( BB.1, <'b', ba> ) @ #k) ∧
    (BB_woS( BB.1, <'bPrime', bPrimea> ) @ #l) ∧
