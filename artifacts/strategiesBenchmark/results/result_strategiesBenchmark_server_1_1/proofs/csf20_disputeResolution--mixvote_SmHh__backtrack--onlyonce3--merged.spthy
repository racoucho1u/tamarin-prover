theory mixvote_SmHh begin

// Function signature and definition of the equational theory E

functions: adec/2, aenc/2, decp/2, encp/3, fst/1, h/1, pair/2, pk/1,
           sg/2, snd/1, ver/2, verzkp/4, zkp/3
equations:
    adec(aenc(x.1, pk(x.2)), x.2) = x.1,
    decp(encp(x, r, pk(sk)), sk) = x,
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    ver(sg(m, sk), pk(sk)) = m











rule (modulo E) ChanOut_S:
   [ Out_S( $A, $B, x ) ]
  --[ ChanOut_S( $A, $B, x ) ]->
   [ !Sec( $A, $B, x ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) ChanIn_S:
   [ !Sec( $A, $B, x ) ] --[ ChanIn_S( $A, $B, x ) ]-> [ In_S( $A, $B, x ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) ChanOut_A:
   [ Out_A( $A, x ) ]
  --[ ChanOut_A( $A, x ) ]->
   [ !Auth( $A, x ), Out( <$A, x> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) ChanIn_A:
   [ !Auth( $A, x ) ] --[ ChanIn_A( $A, x ) ]-> [ In_A( $A, x ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) ChanOut_IR_HP:
   [ Out_IR_HP( $A, $B, m ) ]
  --[ ChanOut_IR_HP( $A, $B, m ) ]->
   [ Out( <$A, $B, m> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) ChanIn_IR_HP:
   [ In( <$A, $B, m> ) ]
  --[ ChanIn_IR_HP( $A, $B, m ) ]->
   [ In_IR_HP( $A, $B, m ) ]

  /* has exactly the trivial AC variant */

restriction Chan_R_HP:
  "∀ A B m #i.
    (Send_R_HP( A, B, m ) @ #i) ⇒ (∃ #j. Receive_R_HP( A, B, m ) @ #j)"

rule (modulo E) ChanOut_IR_PS:
   [ Out_IR_PS( $A, $B, m ) ]
  --[ ChanOut_IR_PS( $A, $B, m ) ]->
   [ Out( <$A, $B, m> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) ChanIn_IR_PS:
   [ In( <$A, $B, m> ) ]
  --[ ChanIn_IR_PS( $A, $B, m ) ]->
   [ In_IR_PS( $A, $B, m ) ]

  /* has exactly the trivial AC variant */

restriction Chan_R_PS:
  "∀ A B m #i.
    (Send_R_PS( A, B, m ) @ #i) ⇒ (∃ #j. Receive_R_PS( A, B, m ) @ #j)"

rule (modulo E) ChanOut_IR_SP:
   [ Out_IR_SP( $A, $B, m ) ]
  --[ ChanOut_IR_SP( $A, $B, m ) ]->
   [ Out( <$A, $B, m> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) ChanIn_IR_SP:
   [ In( <$A, $B, m> ) ]
  --[ ChanIn_IR_SP( $A, $B, m ) ]->
   [ In_IR_SP( $A, $B, m ) ]

  /* has exactly the trivial AC variant */

restriction Chan_R_SP:
  "∀ A B m #i.
    (Send_R_SP( A, B, m ) @ #i) ⇒ (∃ #j. Receive_R_SP( A, B, m ) @ #j)"

rule (modulo E) ChanOut_IR_PH:
   [ Out_IR_PH( $A, $B, m ) ]
  --[ ChanOut_IR_PH( $A, $B, m ) ]->
   [ Out( <$A, $B, m> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) ChanIn_IR_PH:
   [ In( <$A, $B, m> ) ]
  --[ ChanIn_IR_PH( $A, $B, m ) ]->
   [ In_IR_PH( $A, $B, m ) ]

  /* has exactly the trivial AC variant */

restriction Chan_R_PH:
  "∀ A B m #i.
    (Send_R_PH( A, B, m ) @ #i) ⇒ (∃ #j. Receive_R_PH( A, B, m ) @ #j)"

rule (modulo E) fakeEvidence:
   [ In( <ballot, evidence> ) ] --[ Evidence( ballot, evidence ) ]-> [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) publickeyinfrastructure:
   [ Fr( ~skX ) ]
  --[ LongtermKey( $X, ~skX ) ]->
   [ !Ltk( $X, ~skX ), !Pk( $X, pk(~skX) ), Out( pk(~skX) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Setup:
   [ !Ltk( 'S', ~skS ), !Ltk( 'D1', ~sskD1 ) ]
  --[
  Setup( ), BB_pskDs( 'BB', <'spkD', pk(~sskD1)> ),
  BB_pkS( 'BB', <'spkS', pk(~skS)> ), BB_H( 'BB', <'H', 'H1'> ),
  CastByCorresp( 'H1', pk(~sskD1) ), Voter( 'H1' ), SecretKeyD( ~sskD1 ),
  Server( 'S' )
  ]->
   [
   AgSt_H0( 'H1', <'D1', 'P', 'BB', $v1> ),
   AgSt_D0( 'D1', <'H1', 'S', pk(~skS), ~sskD1> ),
   AgSt_A0( 'A', <'S', 'BB', pk(~skS)> ), AgSt_P0( 'P', 'S' ),
   AgSt_P1( 'P', 'H1' ),
   AgSt_BB0( 'BB', <'S', pk(~sskD1), pk(~skS), 'H1'> ),
   Out_A( 'BB', <'spkD', pk(~sskD1)> ), Out_A( 'BB', <'spkS', pk(~skS)> ),
   Out_A( 'BB', <'H', 'H1'> ), AgSt_S0( 'S', <~skS, pk(~sskD1)> ),
   Out( <'S', ~skS, pk(~sskD1)> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) H_1:
   [ AgSt_H0( $H, <$D, $P, $BB, $v> ) ]
  --[ Vote( $H, $v ), Send( $H, $D, $v ), H1( ) ]->
   [ AgSt_H1( $H, <$D, $P, $BB, $v> ), Out_S( $H, $D, $v ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) D_1:
   [ AgSt_D0( $D, <$H, $S, pkS, ~sskD> ), In_S( $H, $D, v ), Fr( ~r ) ]
  --[ D1( ) ]->
   [ Out_S( $D, $H, sg(encp(v, ~r, pkS), ~sskD) ) ]

  // loop breaker: [1]
  /* has exactly the trivial AC variant */

rule (modulo E) H_2:
   [ AgSt_H1( $H, <$D, $P, $BB, $v> ), In_S( $D, $H, b ) ]
  --[
  Ballot( $H, b ), Send( $H, $P, b ), Comm_H_vote( $H, $S, $v ),
  Comm_H_ballot( $H, $S, b ), Send_R_HP( $H, $P, b ), H2( )
  ]->
   [ AgSt_H2( $H, <$D, $P, $BB, $v, b> ), Out_IR_HP( $H, $P, b ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) P:
   [ AgSt_P0( $P, $S ), In_IR_HP( $H, $P, b ) ]
  --[ Receive_R_HP( $H, $P, b ), Send_R_PS( $P, $S, b ), P1( ) ]->
   [ Out_IR_PS( $P, $S, b ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) S_1a:
   [
   AgSt_S0( $S, <~skS, pk(~sskDa)> ),
   In_IR_PS( $P, $S, sg(encp(va, ra, pk(~skS)), ~sskDa) )
   ]
  --[
  Learn_S_ballot( $S, sg(encp(va, ra, pk(~skS)), ~sskDa) ),
  Receive_R_PS( $P, $S, sg(encp(va, ra, pk(~skS)), ~sskDa) ),
  Send_R_SP( $S, $P, sg(sg(encp(va, ra, pk(~skS)), ~sskDa), ~skS) ), S1( )
  ]->
   [ Out_IR_SP( $S, $P, sg(sg(encp(va, ra, pk(~skS)), ~sskDa), ~skS) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) P_2:
   [ AgSt_P1( $P, $H ), In_IR_SP( $S, $P, c ) ]
  --[ Receive_R_SP( $S, $P, c ), Send_R_PH( $P, $H, c ), P2( ) ]->
   [ Out_IR_PH( $P, $H, c ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) H_3:
   [ AgSt_H2( $H, <$D, $P, $BB, $v, b> ), In_IR_PH( $P, $H, c ) ]
  --[ Receive_R_PH( $P, $H, c ), Evidence( b, c ), H3( ) ]->
   [ AgSt_H3( $H, <$D, $P, $BB, $v, b, c> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) BB:
   [
   AgSt_BB0( $BB, <$S, spkDa, pkS, Ha> ), In( <$S, 'b', ba> ),
   In( <$S, 'bPrime', bPrimea> ), In( <$S, 'v', va> ), In( <$S, 'zkp', p> )
   ]
  --[
  BB_rec( $BB, <'b', ba> ), BB_woS( $BB, <'bPrime', bPrimea> ),
  BB_tal( $BB, <'v', va> ), BB_zkp( $BB, <'zkp', p> ), End( )
  ]->
   [
   Out_A( $BB, <'b', ba> ), Out_A( $BB, <'bPrime', bPrimea> ),
   Out_A( $BB, <'v', va> ), Out_A( $BB, <'zkp', p> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) A_1:
   [
   AgSt_A0( $A, <$S, $BB, pkS> ), In_A( $BB, <'b', sg(bPrimea, sskDa)> ),
   In_A( $BB, <'bPrime', bPrimea> ), In_A( $BB, <'v', va> ),
   In_A( $BB, <'zkp', p> ), In_A( $BB, <'spkD', pk(sskDa)> )
   ]
  --[
  Learn_A_proof( $A, <'zkp', p> ),
  Learn_A_spkDSG( $A, <'spkD', pk(sskDa)> ), Learn_A_Vs( $A, <'v', va> ),
  Learn_A_Bs( $A, <'b', sg(bPrimea, sskDa)> ),
  Learn_A_bPrimes( $A, <'bPrime', bPrimea> ),
  VerifyA2( $A, verzkp(p, bPrimea, va, pkS) ), A1( )
  ]->
   [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) H_4:
   [ AgSt_H3( $H, <$D, $P, $BB, $v, b, c> ), In_A( $BB, <'b', ba> ) ]
  --[ Verify( $H, b, ba ), H4( ) ]->
   [ ]

  /* has exactly the trivial AC variant */

restriction OneSetup:
  "∀ #i #j. ((Setup( ) @ #i) ∧ (Setup( ) @ #j)) ⇒ (#i = #j)"
  // safety formula

lemma onlyonce1 [reuse]:
  all-traces "∀ #i #j. ((H1( ) @ #i) ∧ (H1( ) @ #j)) ⇒ (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ #i #j. (H1( ) @ #i) ∧ (H1( ) @ #j) ∧ ¬(#i = #j)"
*/
by sorry

lemma onlyonce2 [reuse]:
  all-traces "∀ #i #j. ((H2( ) @ #i) ∧ (H2( ) @ #j)) ⇒ (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ #i #j. (H2( ) @ #i) ∧ (H2( ) @ #j) ∧ ¬(#i = #j)"
*/
by sorry

lemma onlyonce3 [reuse]:
  all-traces "∀ #i #j. ((H3( ) @ #i) ∧ (H3( ) @ #j)) ⇒ (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ #i #j. (H3( ) @ #i) ∧ (H3( ) @ #j) ∧ ¬(#i = #j)"
*/
simplify
solve( (#i < #j)  ∥ (#j < #i) )
  case case_1
  solve( AgSt_H2( $H, <$D, $P, $BB, $v, b> ) ▶₀ #i )
    case H_2
    solve( In_IR_PH( 'P', 'H1', c ) ▶₁ #i )
      case ChanIn_IR_PH
      solve( AgSt_H2( $H, <$D, $P, $BB, $v.2, b> ) ▶₀ #j )
        case H_2
        by contradiction /* cyclic */
      qed
    qed
  qed
next
  case case_2
  solve( AgSt_H2( $H, <$D, $P, $BB, $v, b> ) ▶₀ #i )
    case H_2
    solve( In_IR_PH( 'P', 'H1', c ) ▶₁ #i )
      case ChanIn_IR_PH
      solve( AgSt_H2( $H, <$D, $P, $BB, $v.2, b> ) ▶₀ #j )
        case H_2
        by contradiction /* cyclic */
      qed
    qed
  qed
qed

