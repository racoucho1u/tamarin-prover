lemma injectiveagreement_enb_ue_k_enb:
  all-traces
  "∀ a b r #i.
    (Commit( a, b, <'eNB', 'UE', 'K_eNB_star', r> ) @ #i) ⇒
    ((∃ #j.
       (Running( b, a, <'eNB', 'UE', 'K_eNB_star', r> ) @ #j) ∧
       (¬(∃ a2 b2 #i2.
           (Commit( a2, b2, <'eNB', 'UE', 'K_eNB_star', r> ) @ #i2) ∧
           (¬(#i2 = #i))))) ∨
     (∃ X data #k. (Rev( X, data ) @ #k) ∧ (Honest( X ) @ #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ a b r #i.
  (Commit( a, b, <'eNB', 'UE', 'K_eNB_star', r> ) @ #i)
 ∧
  (∀ #j.
    (Running( b, a, <'eNB', 'UE', 'K_eNB_star', r> ) @ #j)
   ⇒
    ∃ a2 b2 #i2.
     (Commit( a2, b2, <'eNB', 'UE', 'K_eNB_star', r> ) @ #i2) ∧ ¬(#i2 = #i)) ∧
  (∀ X data #k. (Rev( X, data ) @ #k) ∧ (Honest( X ) @ #i) ⇒ ⊥)"
*/
by sorry

