theory 5gs_to_eps_over_n26_handover begin

// Function signature and definition of the equational theory E

builtins: multiset
functions: KDF/2, fst/1, pair/2, sdec/2, senc/2, snd/1
equations:
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2











rule (modulo E) send_secure:
   [ SndS( ~cid, A, B, m ) ] --> [ Sec( ~cid, A, B, m ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) receive_secure:
   [ Sec( ~cid, A, B, m ) ] --> [ RcvS( ~cid, A, B, m ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) secureChannel_compromised_in:
   [ In( <~cid, A, B, x> ) ]
  --[ Rev( A, 'secureChannel' ), Rev( B, 'secureChannel' ), Injected( x )
  ]->
   [ Sec( ~cid, A, B, x ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) secureChannel_compromised_out:
   [ Sec( ~cid, A, B, m ) ]
  --[ Rev( B, 'secureChannel' ), Rev( A, 'secureChannel' ) ]->
   [ Out( <~cid, m> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) init_AMF:
   [ Fr( ~AMF_ID ) ]
  --[ AMF_initialized( ~AMF_ID ) ]->
   [ !AMF( ~AMF_ID ), Out( ~AMF_ID ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) init_MME:
   [ Fr( ~MME_ID ) ]
  --[ MME_initialized( ~MME_ID ) ]->
   [ !MME( ~MME_ID ), Out( ~MME_ID ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) init_eNB:
   [ Fr( ~eNB_ID ) ]
  --[ ENB_initialized( ~eNB_ID ) ]->
   [ !ENB( ~eNB_ID ), Out( ~eNB_ID ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) init_gNB:
   [ Fr( ~gNB_ID ) ]
  --[ GNB_initialized( ~gNB_ID ) ]->
   [ !GNB( ~gNB_ID ), Out( ~gNB_ID ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) create_UE:
   [ Fr( ~SUPI ) ] --[ UserEquipment( ~SUPI ) ]-> [ !UE( ~SUPI ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) init_UE:
   [
   !AMF( ~AMF_ID ), !GNB( ~gNB_ID ), !ENB( ~eNB_ID ), !UE( ~SUPI ),
   Fr( ~gNB_UE_ID ), Fr( ~K_AMF ), In( '0' )
   ]
  --[
  Subscribe( ~SUPI, ~gNB_ID ),
  KeyDerived( <'K_gNB', KDF(~K_AMF, 'MAX_NAS_COUNT')>, ~K_AMF )
  ]->
   [
   !Ltk_sym_amf( ~AMF_ID, ~SUPI, <'K_AMF', ~K_AMF> ),
   Session_key( ~SUPI, ~gNB_ID, <'K_gNB', KDF(~K_AMF, 'MAX_NAS_COUNT')> ),
   St_1_UE( ~SUPI, ~K_AMF, KDF(~K_AMF, 'MAX_NAS_COUNT'), ~AMF_ID, ~gNB_ID,
            ~eNB_ID
   ),
   St_1_gNB( ~gNB_ID, KDF(~K_AMF, 'MAX_NAS_COUNT'), ~AMF_ID, ~gNB_UE_ID,
             ~eNB_ID
   ),
   St_1_AMF( ~AMF_ID, ~K_AMF, '0', ~SUPI, ~gNB_UE_ID )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) connect_networks_N26:
   [ !AMF( ~AMF_ID ), !MME( ~MME_ID ), Fr( ~cid_N26 ) ]
  --[ OnlyOnce( ~AMF_ID, ~MME_ID ) ]->
   [ !N26( ~cid_N26, ~AMF_ID, ~MME_ID ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) connect_networks_N2:
   [ !GNB( ~gNB_ID ), !AMF( ~AMF_ID ), Fr( ~cid_N2 ) ]
  --[ OnlyOnce( ~gNB_ID, ~AMF_ID ) ]->
   [ !N2( ~cid_N2, ~gNB_ID, ~AMF_ID ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) connect_networks_S1:
   [ !ENB( ~eNB_ID ), !MME( ~MME_ID ), Fr( ~cid_S1 ) ]
  --[ OnlyOnce( ~eNB_ID, ~MME_ID ) ]->
   [ !S1( ~cid_S1, ~eNB_ID, ~MME_ID ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) reveal_k_amf:
   [ !Ltk_sym_amf( AMF_ID, SUPI, <'K_AMF', K_AMF> ) ]
  --[ Rev( AMF_ID, <'K_AMF', K_AMF> ), Rev( SUPI, <'K_AMF', K_AMF> ) ]->
   [ Out( K_AMF ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) reveal_k_asme:
   [ !Ltk_sym_amse( AMF_ID, MME_ID, SUPI, <'K_ASME', K_ASME> ) ]
  --[
  Rev( AMF_ID, <'K_ASME', K_ASME> ), Rev( SUPI, <'K_ASME', K_ASME> ),
  Rev( MME_ID, <'K_ASME', K_ASME> )
  ]->
   [ Out( K_ASME ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) reveal_k_gnb:
   [ Session_key( SUPI, gNB_ID, <'K_gNB', K_gNB> ) ]
  --[ Rev( SUPI, <'K_gNB', K_gNB> ), Rev( gNB_ID, <'K_gNB', K_gNB> ) ]->
   [ Out( K_gNB ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) reveal_k_enb_star:
   [ Session_key( SUPI, eNB_ID, <'K_eNB_star', K_eNB_star> ) ]
  --[
  Rev( SUPI, <'K_eNB_star', K_eNB_star> ),
  Rev( eNB_ID, <'K_eNB_star', K_eNB_star> )
  ]->
   [ Out( K_eNB_star ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) reveal_nh:
   [ Intermediate_key( AMF_ID, MME_ID, eNB_ID, <'NH', NH> ) ]
  --[
  Rev( AMF_ID, <'NH', NH> ), Rev( MME_ID, <'NH', NH> ),
  Rev( eNB_ID, <'NH', NH> )
  ]->
   [ Out( NH ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) gnb_snd_ho_req:
   [
   St_1_gNB( ~gNB_ID, K_gNB, ~AMF_ID, ~gNB_UE_ID, ~eNB_ID ),
   !N2( ~cid_N2, ~gNB_ID, ~AMF_ID )
   ]
  -->
   [
   St_2_gNB( ~gNB_ID, K_gNB, ~AMF_ID, ~gNB_UE_ID, ~eNB_ID ),
   SndS( ~cid_N2, ~gNB_ID, ~AMF_ID, <'ho_req', ~gNB_UE_ID, ~eNB_ID> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) amf_rcv_ho_req_snd_fr_req:
   [
   St_1_AMF( ~AMF_ID, ~K_AMF, NAS_COUNT, ~SUPI, ~gNB_UE_ID ),
   !N2( ~cid_N2, ~gNB_ID, ~AMF_ID ), !N26( ~cid_N26, ~AMF_ID, ~MME_ID ),
   RcvS( ~cid_N2, ~gNB_ID, ~AMF_ID, <'ho_req', ~gNB_UE_ID, ~eNB_ID> )
   ]
  --[
  NH_SND( KDF(KDF(~K_AMF, NAS_COUNT),
              KDF(KDF(~K_AMF, NAS_COUNT),
                  KDF(KDF(~K_AMF, NAS_COUNT), 'MAX_NAS_COUNT'))),
          <~AMF_ID, ~MME_ID>
  ),
  KeyDerived( <'K_ASME', KDF(~K_AMF, NAS_COUNT)>, ~K_AMF ),
  KeyDerived( <'NH', 
               KDF(KDF(~K_AMF, NAS_COUNT),
                   KDF(KDF(~K_AMF, NAS_COUNT),
                       KDF(KDF(~K_AMF, NAS_COUNT), 'MAX_NAS_COUNT')))
              >,
              KDF(~K_AMF, NAS_COUNT)
  )
  ]->
   [
   St_2_AMF( ~AMF_ID, KDF(~K_AMF, NAS_COUNT), ~K_AMF, NAS_COUNT,
             KDF(KDF(~K_AMF, NAS_COUNT),
                 KDF(KDF(~K_AMF, NAS_COUNT),
                     KDF(KDF(~K_AMF, NAS_COUNT), 'MAX_NAS_COUNT'))),
             ('1'++'1'), ~MME_ID, ~eNB_ID, ~gNB_ID, ~SUPI, ~gNB_UE_ID
   ),
   !Handover_Session( KDF(KDF(~K_AMF, NAS_COUNT),
                          KDF(KDF(~K_AMF, NAS_COUNT),
                              KDF(KDF(~K_AMF, NAS_COUNT), 'MAX_NAS_COUNT'))),
                      <~AMF_ID, ~MME_ID, ~gNB_ID, ~eNB_ID, ~SUPI>
   ),
   !Ltk_sym_amse( ~AMF_ID, ~MME_ID, ~SUPI,
                  <'K_ASME', KDF(~K_AMF, NAS_COUNT)>
   ),
   Intermediate_key( ~AMF_ID, ~MME_ID, ~eNB_ID,
                     <'NH', 
                      KDF(KDF(~K_AMF, NAS_COUNT),
                          KDF(KDF(~K_AMF, NAS_COUNT),
                              KDF(KDF(~K_AMF, NAS_COUNT), 'MAX_NAS_COUNT')))
                     >
   ),
   SndS( ~cid_N26, ~AMF_ID, ~MME_ID,
         <'fr_req', KDF(~K_AMF, NAS_COUNT), ~gNB_UE_ID, ~eNB_ID, 
          KDF(KDF(~K_AMF, NAS_COUNT),
              KDF(KDF(~K_AMF, NAS_COUNT),
                  KDF(KDF(~K_AMF, NAS_COUNT), 'MAX_NAS_COUNT'))), 
          ('1'++'1')>
   )
   ]

  // loop breaker: [3]
  /* has exactly the trivial AC variant */

rule (modulo E) mme_rcv_fr_req_snd_s1_ho_req:
   [
   !MME( ~MME_ID ), !N26( ~cid_N26, ~AMF_ID, ~MME_ID ),
   !S1( ~cid_S1, ~eNB_ID, ~MME_ID ),
   RcvS( ~cid_N26, ~AMF_ID, ~MME_ID,
         <'fr_req', K_ASME, ~gNB_UE_ID, ~eNB_ID, NH, NCC>
   ),
   Fr( ~MME_UE_S1AP_ID ), In( NCC )
   ]
  --[ NH_RCV( NH, <~AMF_ID, ~MME_ID> ), NH_SND( NH, <~MME_ID, ~eNB_ID> )
  ]->
   [
   St_1_MME( ~MME_ID, K_ASME, NH, NCC, ~AMF_ID, ~gNB_UE_ID, ~eNB_ID,
             ~MME_UE_S1AP_ID
   ),
   Out( ~MME_UE_S1AP_ID ),
   SndS( ~cid_S1, ~MME_ID, ~eNB_ID, <'s1_ho_req', ~MME_UE_S1AP_ID, NH, NCC>
   )
   ]

  // loop breaker: [3]
  /* has exactly the trivial AC variant */

rule (modulo E) enb_rcv_s1_ho_req_snd_ack:
   [
   !ENB( ~eNB_ID ), !S1( ~cid_S1, ~eNB_ID, ~MME_ID ),
   !Handover_Session( NH, <~AMF_ID, ~MME_ID, ~gNB_ID, ~eNB_ID, ~SUPI> ),
   RcvS( ~cid_S1, ~MME_ID, ~eNB_ID, <'s1_ho_req', ~MME_UE_S1AP_ID, NH, NCC>
   ),
   Fr( ~eNB_UE_S1AP_ID ), In( NCC )
   ]
  --[
  Running( ~eNB_ID, ~SUPI, <'UE', 'eNB', 'K_eNB_star', KDF(NH, ~eNB_ID)> ),
  NH_RCV( NH, <~MME_ID, ~eNB_ID> ),
  KeyDerived( <'K_eNB_star', KDF(NH, ~eNB_ID)>, NH )
  ]->
   [
   St_1_eNB( ~eNB_ID, KDF(NH, ~eNB_ID), NH, ~MME_ID, ~MME_UE_S1AP_ID,
             ~eNB_UE_S1AP_ID
   ),
   Session_key( ~MME_UE_S1AP_ID, ~eNB_ID, <'K_eNB_star', KDF(NH, ~eNB_ID)>
   ),
   Out( ~eNB_UE_S1AP_ID ),
   SndS( ~cid_S1, ~eNB_ID, ~MME_ID,
         <'s1_ho_req_ack', ~MME_UE_S1AP_ID, ~eNB_UE_S1AP_ID, NCC>
   )
   ]

  // loop breaker: [3]
  /* has exactly the trivial AC variant */

rule (modulo E) mme_rcv_ack_snd_fr_res:
   [
   St_1_MME( ~MME_ID, K_ASME, NH, NCC, ~AMF_ID, ~gNB_UE_ID, ~eNB_ID,
             ~MME_UE_S1AP_ID
   ),
   !N26( ~cid_N26, ~AMF_ID, ~MME_ID ), !S1( ~cid_S1, ~eNB_ID, ~MME_ID ),
   RcvS( ~cid_S1, ~eNB_ID, ~MME_ID,
         <'s1_ho_req_ack', ~MME_UE_S1AP_ID, ~eNB_UE_S1AP_ID, NCC>
   )
   ]
  -->
   [
   St_2_MME( ~MME_ID, K_ASME, NH, NCC, ~AMF_ID, ~gNB_UE_ID, ~eNB_ID,
             ~MME_UE_S1AP_ID
   ),
   SndS( ~cid_N26, ~MME_ID, ~AMF_ID, <'ffr_res', ~gNB_UE_ID, NCC> )
   ]

  // loop breaker: [3]
  /* has exactly the trivial AC variant */

rule (modulo E) amf_rcv_fr_res_snd_ho_cmd:
   [
   St_2_AMF( ~AMF_ID, K_ASME, ~K_AMF, NAS_COUNT, NH, NCC, ~MME_ID, ~eNB_ID,
             ~gNB_ID, ~SUPI, ~gNB_UE_ID
   ),
   !N2( ~cid_N2, ~gNB_ID, ~AMF_ID ), !N26( ~cid_N26, ~AMF_ID, ~MME_ID ),
   RcvS( ~cid_N26, ~MME_ID, ~AMF_ID, <'ffr_res', ~gNB_UE_ID, NCC> )
   ]
  -->
   [
   St_3_AMF( ~AMF_ID, K_ASME, ~K_AMF, NH, ~SUPI ),
   SndS( ~cid_N2, ~AMF_ID, ~gNB_ID, <'ho_cmd', ~gNB_UE_ID, NCC, NAS_COUNT> )
   ]

  // loop breaker: [3]
  /* has exactly the trivial AC variant */

rule (modulo E) gnb_fwd_ho_cm:
   [
   St_2_gNB( ~gNB_ID, K_gNB, ~AMF_ID, ~gNB_UE_ID, ~eNB_ID ),
   !N2( ~cid_N2, ~gNB_ID, ~AMF_ID ),
   RcvS( ~cid_N2, ~AMF_ID, ~gNB_ID, <'ho_cmd', ~gNB_UE_ID, NCC, NAS_COUNT> )
   ]
  -->
   [
   St_3_gNB( ~gNB_ID, K_gNB, ~AMF_ID, ~gNB_UE_ID, ~eNB_ID ),
   Out( senc(<'ho_cmd', ~eNB_ID, NCC, NAS_COUNT>, K_gNB) )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) ue_rcv_ho_cmd_snd_ho_complete:
   [
   St_1_UE( ~SUPI, ~K_AMF, K_gNB, ~AMF_ID, ~gNB_ID, ~eNB_ID ),
   !Handover_Session( KDF(KDF(~K_AMF, NAS_COUNT),
                          KDF(KDF(~K_AMF, NAS_COUNT),
                              KDF(KDF(~K_AMF, NAS_COUNT), 'MAX_NAS_COUNT'))),
                      <~AMF_ID, ~MME_ID, ~gNB_ID, ~eNB_ID, ~SUPI>
   ),
   In( senc(<'ho_cmd', ~eNB_ID, NCC, NAS_COUNT>, K_gNB) )
   ]
  --[
  Commit( ~SUPI, ~eNB_ID,
          <'UE', 'eNB', 'K_eNB_star', 
           KDF(KDF(KDF(~K_AMF, NAS_COUNT),
                   KDF(KDF(~K_AMF, NAS_COUNT),
                       KDF(KDF(~K_AMF, NAS_COUNT), 'MAX_NAS_COUNT'))),
               ~eNB_ID)
          >
  ),
  Running( ~SUPI, ~eNB_ID,
           <'eNB', 'UE', 'K_eNB_star', 
            KDF(KDF(KDF(~K_AMF, NAS_COUNT),
                    KDF(KDF(~K_AMF, NAS_COUNT),
                        KDF(KDF(~K_AMF, NAS_COUNT), 'MAX_NAS_COUNT'))),
                ~eNB_ID)
           >
  ),
  Honest( ~AMF_ID ), Honest( ~MME_ID ), Honest( ~eNB_ID ),
  Honest( ~gNB_ID ), Honest( ~SUPI ),
  KeyDerived( <'K_eNB_star', 
               KDF(KDF(KDF(~K_AMF, NAS_COUNT),
                       KDF(KDF(~K_AMF, NAS_COUNT),
                           KDF(KDF(~K_AMF, NAS_COUNT), 'MAX_NAS_COUNT'))),
                   ~eNB_ID)
              >,
              KDF(KDF(~K_AMF, NAS_COUNT),
                  KDF(KDF(~K_AMF, NAS_COUNT),
                      KDF(KDF(~K_AMF, NAS_COUNT), 'MAX_NAS_COUNT')))
  )
  ]->
   [
   St_2_UE( ~SUPI, ~K_AMF, K_gNB, KDF(~K_AMF, NAS_COUNT),
            KDF(KDF(KDF(~K_AMF, NAS_COUNT),
                    KDF(KDF(~K_AMF, NAS_COUNT),
                        KDF(KDF(~K_AMF, NAS_COUNT), 'MAX_NAS_COUNT'))),
                ~eNB_ID),
            ~AMF_ID
   ),
   Out( senc('handover_complete',
             KDF(KDF(KDF(~K_AMF, NAS_COUNT),
                     KDF(KDF(~K_AMF, NAS_COUNT),
                         KDF(KDF(~K_AMF, NAS_COUNT), 'MAX_NAS_COUNT'))),
                 ~eNB_ID))
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) enb_rcv_ho_complete_snd_ho_notify:
   [
   St_1_eNB( ~eNB_ID, K_eNB_star, NH, ~MME_ID, ~MME_UE_S1AP_ID,
             ~eNB_UE_S1AP_ID
   ),
   !Handover_Session( NH, <~AMF_ID, ~MME_ID, ~gNB_ID, ~eNB_ID, ~SUPI> ),
   !S1( ~cid_S1, ~eNB_ID, ~MME_ID ),
   In( senc('handover_complete', K_eNB_star) )
   ]
  --[
  Commit( ~eNB_ID, ~SUPI, <'eNB', 'UE', 'K_eNB_star', K_eNB_star> ),
  Honest( ~AMF_ID ), Honest( ~MME_ID ), Honest( ~eNB_ID ),
  Honest( ~gNB_ID ), Honest( ~SUPI )
  ]->
   [
   St_2_eNB( ~eNB_ID, K_eNB_star ),
   SndS( ~cid_S1, ~eNB_ID, ~MME_ID, 'handover_notify' )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) mme_rcv_ho_notify:
   [
   St_2_MME( ~MME_ID, K_ASME, NH, NCC, ~AMF_ID, ~gNB_UE_ID, ~eNB_ID,
             ~MME_UE_S1AP_ID
   ),
   !S1( ~cid_S1, ~eNB_ID, ~MME_ID ),
   RcvS( ~cid_S1, ~eNB_ID, ~MME_ID, 'handover_notify' )
   ]
  --[ HandoverDone( K_ASME ) ]->
   [ St_3_MME( ~MME_ID, K_ASME, NH ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) handover_done:
   [
   St_3_AMF( ~AMF_ID, K_ASME, ~K_AMF, NH, ~SUPI ),
   St_3_MME( ~MME_ID, K_ASME, NH ), St_2_eNB( ~eNB_ID, K_eNB_star ),
   St_3_gNB( ~gNB_ID, K_gNB, ~AMF_ID, ~gNB_UE_ID, ~eNB_ID ),
   St_2_UE( ~SUPI, ~K_AMF, K_gNB, K_ASME, K_eNB_star, ~AMF_ID )
   ]
  --[
  Honest( ~AMF_ID ), Honest( ~MME_ID ), Honest( ~eNB_ID ),
  Honest( ~gNB_ID ), Honest( ~SUPI ), Secret( <'K_AMF', ~K_AMF> ),
  Secret( <'K_ASME', K_ASME> ), Secret( <'K_gNB', K_gNB> ),
  Secret( <'K_eNB_star', K_eNB_star> )
  ]->
   [ ]

  /* has exactly the trivial AC variant */

lemma NH_SRC [sources]:
  all-traces
  "∀ a b n #i.
    (NH_RCV( n, <a, b> ) @ #i) ⇒
    ((∃ #j. (NH_SND( n, <a, b> ) @ #j) ∧ (#j < #i)) ∨
     (∃ #k. (!KU( n ) @ #k) ∧ (#k < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ a b n #i.
  (NH_RCV( n, <a, b> ) @ #i)
 ∧
  (∀ #j. (NH_SND( n, <a, b> ) @ #j) ⇒ ¬(#j < #i)) ∧
  (∀ #k. (!KU( n ) @ #k) ⇒ ¬(#k < #i))"
*/
by sorry

restriction OnlyOnce:
  "∀ p q #i #j.
    ((OnlyOnce( p, q ) @ #i) ∧ (OnlyOnce( p, q ) @ #j)) ⇒ (#i = #j)"
  // safety formula

lemma executability:
  exists-trace
  "∃ x #i.
    ((((((((HandoverDone( x ) @ #i) ∧
           (¬(∃ X data #r. Rev( X, data ) @ #r))) ∧
          (∀ a #k. (HandoverDone( a ) @ #k) ⇒ (#k = #i))) ∧
         (∀ a b #k1 #k2.
           ((UserEquipment( a ) @ #k1) ∧ (UserEquipment( b ) @ #k2)) ⇒
           (#k1 = #k2))) ∧
        (∀ a b #k1 #k2.
          ((GNB_initialized( a ) @ #k1) ∧ (GNB_initialized( b ) @ #k2)) ⇒
          (#k1 = #k2))) ∧
       (∀ a b #k1 #k2.
         ((AMF_initialized( a ) @ #k1) ∧ (AMF_initialized( b ) @ #k2)) ⇒
         (#k1 = #k2))) ∧
      (∀ a b #k1 #k2.
        ((MME_initialized( a ) @ #k1) ∧ (MME_initialized( b ) @ #k2)) ⇒
        (#k1 = #k2))) ∧
     (∀ a b #k1 #k2.
       ((ENB_initialized( a ) @ #k1) ∧ (ENB_initialized( b ) @ #k2)) ⇒
       (#k1 = #k2))) ∧
    (∀ a b c d #k1 #k2.
      ((Subscribe( a, b ) @ #k1) ∧ (Subscribe( c, d ) @ #k2)) ⇒ (#k1 = #k2))"
/*
guarded formula characterizing all satisfying traces:
"∃ x #i.
  (HandoverDone( x ) @ #i)
 ∧
  (∀ X data #r. (Rev( X, data ) @ #r) ⇒ ⊥) ∧
  (∀ a #k. (HandoverDone( a ) @ #k) ⇒ #k = #i) ∧
  (∀ a b #k1 #k2.
    (UserEquipment( a ) @ #k1) ∧ (UserEquipment( b ) @ #k2) ⇒ #k1 = #k2) ∧
  (∀ a b #k1 #k2.
    (GNB_initialized( a ) @ #k1) ∧ (GNB_initialized( b ) @ #k2)
   ⇒
    #k1 = #k2) ∧
  (∀ a b #k1 #k2.
    (AMF_initialized( a ) @ #k1) ∧ (AMF_initialized( b ) @ #k2)
   ⇒
    #k1 = #k2) ∧
  (∀ a b #k1 #k2.
    (MME_initialized( a ) @ #k1) ∧ (MME_initialized( b ) @ #k2)
   ⇒
    #k1 = #k2) ∧
  (∀ a b #k1 #k2.
    (ENB_initialized( a ) @ #k1) ∧ (ENB_initialized( b ) @ #k2)
   ⇒
