restriction set_in:
  "∀ x y #t3.
    (IsIn( x, y ) @ #t3) ⇒
    (∃ #t2.
      (((Insert( x, y ) @ #t2) ∧ (#t2 < #t3)) ∧
       (∀ #t1. (Delete( x ) @ #t1) ⇒ ((#t1 < #t2) ∨ (#t3 < #t1)))) ∧
      (∀ #t1 yp.
        (Insert( x, yp ) @ #t1) ⇒ (((#t1 < #t2) ∨ (#t1 = #t2)) ∨ (#t3 < #t1))))"

restriction set_notin:
  "∀ x #t3.
    (IsNotSet( x ) @ #t3) ⇒
    ((∀ #t1 y. (Insert( x, y ) @ #t1) ⇒ (#t3 < #t1)) ∨
     (∃ #t1.
       ((Delete( x ) @ #t1) ∧ (#t1 < #t3)) ∧
       (∀ #t2 y. ((Insert( x, y ) @ #t2) ∧ (#t2 < #t3)) ⇒ (#t2 < #t1))))"

restriction predicate_eq:
  "∀ #i a b. (Pred_eq( a, b ) @ #i) ⇒ (a = b)"
  // safety formula

restriction predicate_not_eq:
  "∀ #i a b. (Pred_not_eq( a, b ) @ #i) ⇒ (¬(a = b))"
  // safety formula

restriction single_session:
  "∀ #i #j. ((Init( ) @ #i) ∧ (Init( ) @ #j)) ⇒ (#i = #j)"
  // safety formula

restriction locking_9:
  "∀ p pp l x lp #t1 #t3.
    ((Lock_9( p, l, x ) @ #t1) ∧ (Lock( pp, lp, x ) @ #t3)) ⇒
    ((((#t1 < #t3) ∧
       (∃ #t2.
         (((((Unlock_9( p, l, x ) @ #t2) ∧ (#t1 < #t2)) ∧ (#t2 < #t3)) ∧
           (∀ #t0 pp.1. (Unlock( pp.1, l, x ) @ #t0) ⇒ (#t0 = #t2))) ∧
          (∀ pp.1 lpp #t0.
            (Lock( pp.1, lpp, x ) @ #t0) ⇒
            (((#t0 < #t1) ∨ (#t0 = #t1)) ∨ (#t2 < #t0)))) ∧
         (∀ pp.1 lpp #t0.
           (Unlock( pp.1, lpp, x ) @ #t0) ⇒
           (((#t0 < #t1) ∨ (#t2 < #t0)) ∨ (#t2 = #t0))))) ∨
      (#t3 < #t1)) ∨
     (#t1 = #t3))"

restriction locking_8:
  "∀ p pp l x lp #t1 #t3.
    ((Lock_8( p, l, x ) @ #t1) ∧ (Lock( pp, lp, x ) @ #t3)) ⇒
    ((((#t1 < #t3) ∧
       (∃ #t2.
         (((((Unlock_8( p, l, x ) @ #t2) ∧ (#t1 < #t2)) ∧ (#t2 < #t3)) ∧
           (∀ #t0 pp.1. (Unlock( pp.1, l, x ) @ #t0) ⇒ (#t0 = #t2))) ∧
          (∀ pp.1 lpp #t0.
            (Lock( pp.1, lpp, x ) @ #t0) ⇒
            (((#t0 < #t1) ∨ (#t0 = #t1)) ∨ (#t2 < #t0)))) ∧
         (∀ pp.1 lpp #t0.
           (Unlock( pp.1, lpp, x ) @ #t0) ⇒
           (((#t0 < #t1) ∨ (#t2 < #t0)) ∨ (#t2 = #t0))))) ∨
      (#t3 < #t1)) ∨
     (#t1 = #t3))"

lemma Received_only_if_Sent:
  all-traces
  "∀ sk msg i #u.
    (Received( sk, msg, i ) @ #u) ⇒
    (∃ #v. (#v < #u) ∧ (Sent( sk, msg, i ) @ #v))"
/*
guarded formula characterizing all counter-examples:
"∃ sk msg i #u.
  (Received( sk, msg, i ) @ #u)
 ∧
  ∀ #v. (Sent( sk, msg, i ) @ #v) ⇒ ¬(#v < #u)"
*/
simplify
solve( Received( sk, msg, i ) @ #u )
  case event_Receivedsk_msg_j_111111111111
  solve( State_111111111111( ~lock9, h, i, i.1, msg, sk ) ▶₀ #u )
    case if_eqh_hmacsk_j_msg__0_11111111111
    solve( !KU( hmac(~n, <('one'++i), msg>) ) @ #vk.6 )
      case c_hmac
      solve( !KU( ~n ) @ #vk.10 )
        case out_msg_SIGN_i__one__hmacsk_i__one__msg___11111121111
        solve( (#vr.12 < #t2)  ∥ (#vr.12 = #t2) )
          case case_1
          solve( ((#vr.4 < #vr.22) ∧
                  (∃ #t2.
                    (Unlock_9( $9, ~lock9, 'cellA' ) @ #t2)
                   ∧
                    (#vr.4 < #t2) ∧
                    (#t2 < #vr.22) ∧
                    (∀ #t0 pp. (Unlock( pp, ~lock9, 'cellA' ) @ #t0) ⇒ #t0 = #t2) ∧
                    (∀ pp lpp #t0.
                      (Lock( pp, lpp, 'cellA' ) @ #t0)
                     ⇒
                      ((#t0 < #vr.4) ∨ (#t0 = #vr.4) ∨ (#t2 < #t0))) ∧
                    (∀ pp lpp #t0.
                      (Unlock( pp, lpp, 'cellA' ) @ #t0)
                     ⇒
                      ((#t0 < #vr.4) ∨ (#t2 < #t0) ∨ (#t2 = #t0)))))  ∥
                 (#vr.22 < #vr.4) )
          /* in loop (dpth: 1, it: 0) */
            case case_1
            solve( (#t2.1 < #t2)  ∥ (#t2.1 = #t2)  ∥ (#vr.3 < #t2.1) )
            /* in loop (dpth: 2, it: 0) */
              case case_1
              solve( (#vr.12 < #t2.1)  ∥ (#vr.12 = #t2.1) )
              /* in loop (dpth: 3, it: 0) */
                case case_1
                by solve( Insert( 'cellA', i ) @ #t2 ) /* in loop (dpth: 1, it: 0) */
              next
                case case_2
                by solve( Insert( 'cellA', i ) @ #t2.1 ) /* in loop (dpth: 1, it: 0) */
              qed
            next
              case case_2
              solve( Insert( 'cellA', i ) @ #t2 ) /* in loop (dpth: 3, it: 0) */
                case insert_cellA_i__one__1111111111111
                solve( State_1111111111111( ~lock9, h, i, j, msg, sk ) ▶₀ #t2 )
                /* in loop (dpth: 4, it: 0) */
                  case event_Receivedsk_msg_j_111111111111
                  solve( ((#vr.4 < #vr.32) ∧
                          (∃ #t2.
                            (Unlock_9( $9, ~lock9.1, 'cellA' ) @ #t2)
                           ∧
                            (#vr.4 < #t2) ∧
