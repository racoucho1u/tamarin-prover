   [ State_11111121111111( ~lock12, ~lock6, i, j, msg, sk ) ]
  --[ Insert( 'cellB', j ) ]->
   [ State_111111211111111( ~lock12, ~lock6, i, j, msg, sk ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) insert_cellB_j_true__111111211111111[color=#45d1e2]:
   [ State_111111211111111( ~lock12, ~lock6, i, j, msg, sk ) ]
  --[ Insert( <'cellB', j>, 'true' ) ]->
   [ State_1111112111111111( ~lock12, ~lock6, i, j, msg, sk ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) unlock_cellB_j__1111112111111111[color=#45d1e2]:
   [ State_1111112111111111( ~lock12, ~lock6, i, j, msg, sk ) ]
  --[
  Unlock( $6, ~lock6, <'cellB', j> ), Unlock_6( $6, ~lock6, <'cellB', j> )
  ]->
   [ State_11111121111111111( ~lock12, ~lock6, i, j, msg, sk ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) unlock_cellB__11111121111111111[color=#45d1e2]:
   [ State_11111121111111111( ~lock12, ~lock6, i, j, msg, sk ) ]
  --[ Unlock( $12, ~lock12, 'cellB' ), Unlock_12( $12, ~lock12, 'cellB' )
  ]->
   [ State_111111211111111111( ~lock12, ~lock6, i, j, msg, sk ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Zero_111111211111111111[color=#45d1e2]:
   [ State_111111211111111111( ~lock12, ~lock6, i, j, msg, sk ) ] --> [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Zero_111111212[color=#45d1e2]:
   [ State_111111212( ~lock12, sk ) ] --> [ ]

  /* has exactly the trivial AC variant */

restriction set_in:
  "∀ x y #t3.
    (IsIn( x, y ) @ #t3) ⇒
    (∃ #t2.
      (((Insert( x, y ) @ #t2) ∧ (#t2 < #t3)) ∧
       (∀ #t1. (Delete( x ) @ #t1) ⇒ ((#t1 < #t2) ∨ (#t3 < #t1)))) ∧
      (∀ #t1 yp.
        (Insert( x, yp ) @ #t1) ⇒ (((#t1 < #t2) ∨ (#t1 = #t2)) ∨ (#t3 < #t1))))"

restriction set_notin:
  "∀ x #t3.
    (IsNotSet( x ) @ #t3) ⇒
    ((∀ #t1 y. (Insert( x, y ) @ #t1) ⇒ (#t3 < #t1)) ∨
     (∃ #t1.
       ((Delete( x ) @ #t1) ∧ (#t1 < #t3)) ∧
       (∀ #t2 y. ((Insert( x, y ) @ #t2) ∧ (#t2 < #t3)) ⇒ (#t2 < #t1))))"

restriction predicate_eq:
  "∀ #i a b. (Pred_eq( a, b ) @ #i) ⇒ (a = b)"
  // safety formula

restriction predicate_not_eq:
  "∀ #i a b. (Pred_not_eq( a, b ) @ #i) ⇒ (¬(a = b))"
  // safety formula

restriction single_session:
  "∀ #i #j. ((Init( ) @ #i) ∧ (Init( ) @ #j)) ⇒ (#i = #j)"
  // safety formula

restriction locking_12:
  "∀ p pp l x lp #t1 #t3.
    ((Lock_12( p, l, x ) @ #t1) ∧ (Lock( pp, lp, x ) @ #t3)) ⇒
    ((((#t1 < #t3) ∧
       (∃ #t2.
         (((((Unlock_12( p, l, x ) @ #t2) ∧ (#t1 < #t2)) ∧ (#t2 < #t3)) ∧
           (∀ #t0 pp.1. (Unlock( pp.1, l, x ) @ #t0) ⇒ (#t0 = #t2))) ∧
          (∀ pp.1 lpp #t0.
            (Lock( pp.1, lpp, x ) @ #t0) ⇒
            (((#t0 < #t1) ∨ (#t0 = #t1)) ∨ (#t2 < #t0)))) ∧
         (∀ pp.1 lpp #t0.
           (Unlock( pp.1, lpp, x ) @ #t0) ⇒
           (((#t0 < #t1) ∨ (#t2 < #t0)) ∨ (#t2 = #t0))))) ∨
      (#t3 < #t1)) ∨
     (#t1 = #t3))"

restriction locking_9:
  "∀ p pp l x lp #t1 #t3.
    ((Lock_9( p, l, x ) @ #t1) ∧ (Lock( pp, lp, x ) @ #t3)) ⇒
    ((((#t1 < #t3) ∧
       (∃ #t2.
         (((((Unlock_9( p, l, x ) @ #t2) ∧ (#t1 < #t2)) ∧ (#t2 < #t3)) ∧
           (∀ #t0 pp.1. (Unlock( pp.1, l, x ) @ #t0) ⇒ (#t0 = #t2))) ∧
          (∀ pp.1 lpp #t0.
            (Lock( pp.1, lpp, x ) @ #t0) ⇒
            (((#t0 < #t1) ∨ (#t0 = #t1)) ∨ (#t2 < #t0)))) ∧
         (∀ pp.1 lpp #t0.
           (Unlock( pp.1, lpp, x ) @ #t0) ⇒
           (((#t0 < #t1) ∨ (#t2 < #t0)) ∨ (#t2 = #t0))))) ∨
      (#t3 < #t1)) ∨
     (#t1 = #t3))"

restriction locking_6:
  "∀ p pp l x lp #t1 #t3.
    ((Lock_6( p, l, x ) @ #t1) ∧ (Lock( pp, lp, x ) @ #t3)) ⇒
    ((((#t1 < #t3) ∧
       (∃ #t2.
         (((((Unlock_6( p, l, x ) @ #t2) ∧ (#t1 < #t2)) ∧ (#t2 < #t3)) ∧
           (∀ #t0 pp.1. (Unlock( pp.1, l, x ) @ #t0) ⇒ (#t0 = #t2))) ∧
          (∀ pp.1 lpp #t0.
            (Lock( pp.1, lpp, x ) @ #t0) ⇒
            (((#t0 < #t1) ∨ (#t0 = #t1)) ∨ (#t2 < #t0)))) ∧
         (∀ pp.1 lpp #t0.
           (Unlock( pp.1, lpp, x ) @ #t0) ⇒
           (((#t0 < #t1) ∨ (#t2 < #t0)) ∨ (#t2 = #t0))))) ∨
      (#t3 < #t1)) ∨
     (#t1 = #t3))"

lemma Received_only_if_Sent:
  all-traces
  "∀ sk msg i #u.
    (Received( sk, msg, i ) @ #u) ⇒
    (∃ #v. (#v < #u) ∧ (Sent( sk, msg, i ) @ #v))"
/*
guarded formula characterizing all counter-examples:
"∃ sk msg i #u.
  (Received( sk, msg, i ) @ #u)
 ∧
  ∀ #v. (Sent( sk, msg, i ) @ #v) ⇒ ¬(#v < #u)"
*/
simplify
solve( Received( sk, msg, i ) @ #u )
  case event_Receivedsk_msg_j_111111111111121
  solve( State_111111111111121( ~lock12, ~lock9, h, i, i.1, msg, sk
         ) ▶₀ #u )
    case if_eqh_hmacsk_j_msg__0_11111111111112
    solve( (∀ #t1 y. (Insert( <'cellA', i>, y ) @ #t1) ⇒ #vr.1 < #t1)  ∥
           (∃ #t1.
             (Delete( <'cellA', i> ) @ #t1)
            ∧
             (#t1 < #vr.1) ∧
             (∀ #t2 y.
               (Insert( <'cellA', i>, y ) @ #t2) ⇒ ((¬(#t2 < #vr.1)) ∨ (#t2 < #t1)))) )
      case case_1
      solve( (#vr.15 < #t2)  ∥ (#vr.15 = #t2) )
        case case_1
        solve( Insert( 'cellA', i.1 ) @ #t2 )
          case insert_cellA_j_1111111111111211
          solve( State_1111111111111211( ~lock12, ~lock9, h, i, i.1, msg, sk
                 ) ▶₀ #t2 )
            case event_Receivedsk_msg_j_111111111111121
            solve( ((#vr.5 < #vr.23) ∧
                    (∃ #t2.
                      (Unlock_12( $12, ~lock12.1, 'cellA' ) @ #t2)
                     ∧
                      (#vr.5 < #t2) ∧
                      (#t2 < #vr.23) ∧
                      (∀ #t0 pp. (Unlock( pp, ~lock12.1, 'cellA' ) @ #t0) ⇒ #t0 = #t2) ∧
                      (∀ pp lpp #t0.
                        (Lock( pp, lpp, 'cellA' ) @ #t0)
                       ⇒
                        ((#t0 < #vr.5) ∨ (#t0 = #vr.5) ∨ (#t2 < #t0))) ∧
                      (∀ pp lpp #t0.
                        (Unlock( pp, lpp, 'cellA' ) @ #t0)
                       ⇒
                        ((#t0 < #vr.5) ∨ (#t2 < #t0) ∨ (#t2 = #t0)))))  ∥
                   (#vr.23 < #vr.5)  ∥ (#vr.5 = #vr.23) )
              case case_1
              solve( Unlock_12( $12, ~lock12.1, 'cellA' ) @ #t2.2 )
                case unlock_cellA__111111111111111
                by contradiction /* cyclic */
              next
                case unlock_cellA__1111111111111211111
                by contradiction /* cyclic */
              next
                case unlock_cellA__1111111111111221
                by contradiction /* cyclic */
              next
                case unlock_cellA__1111111121111111111
                by contradiction /* cyclic */
              qed
            next
              case case_2
              solve( Unlock_12( $12.1, ~lock12, 'cellA' ) @ #t2.2 )
                case unlock_cellA__111111111111111
                by solve( State_111111111111111( ~lock12, ~lock9.2, h, i.3, j, msg.2, sk,
                                                 x
                          ) ▶₀ #t2.1 )
              next
                case unlock_cellA__1111111111111211111
                solve( State_1111111111111211111( ~lock12, ~lock9.2, h, i.3, j, msg.2, sk
                       ) ▶₀ #t2.1 )
                  case unlock_cellA_j__111111111111121111
                  solve( (#t2.2 < #t2.3)  ∥ (#t2.2 = #t2.3) )
                    case case_1
                    by contradiction /* from formulas */
                  next
                    case case_2
                    solve( !KU( hmac(~n, <i.2, msg.1>) ) @ #vk.8 )
                      case c_hmac
                      by solve( !KU( ~n ) @ #vk.14 )
                    next
                      case out_msg_SIGN_j_hmacsk_j_msg___11111111211111
                      by contradiction /* from formulas */
                    next
                      case out_msg_SIGN_j_hmacsk_j_msg___111111211111
                      by contradiction /* from formulas */
                    qed
                  qed
                qed
              next
                case unlock_cellA__1111111111111221
                by solve( State_1111111111111221( ~lock12, ~lock9.2, h, i.3, j, msg.2, sk
                          ) ▶₀ #t2.1 )
              next
                case unlock_cellA__1111111121111111111
                by solve( State_1111111121111111111( ~lock12, ~lock6, i.3, j, msg.2, sk
                          ) ▶₀ #t2.1 )
              qed
            next
              case case_3
              by contradiction /* cyclic */
            qed
          qed
        next
          case insert_cellA_j_1111111121111111
          solve( State_1111111121111111( ~lock12, ~lock6, i, i.1, msg, sk
                 ) ▶₀ #t2 )
            case lock_cellA_j__111111112111111
            solve( ((#vr.5 < #vr.23) ∧
                    (∃ #t2.
                      (Unlock_12( $12, ~lock12.1, 'cellA' ) @ #t2)
                     ∧
                      (#vr.5 < #t2) ∧
                      (#t2 < #vr.23) ∧
                      (∀ #t0 pp. (Unlock( pp, ~lock12.1, 'cellA' ) @ #t0) ⇒ #t0 = #t2) ∧
                      (∀ pp lpp #t0.
                        (Lock( pp, lpp, 'cellA' ) @ #t0)
                       ⇒
                        ((#t0 < #vr.5) ∨ (#t0 = #vr.5) ∨ (#t2 < #t0))) ∧
                      (∀ pp lpp #t0.
                        (Unlock( pp, lpp, 'cellA' ) @ #t0)
                       ⇒
                        ((#t0 < #vr.5) ∨ (#t2 < #t0) ∨ (#t2 = #t0)))))  ∥
                   (#vr.23 < #vr.5) )
              case case_1
              solve( Unlock_12( $12, ~lock12.1, 'cellA' ) @ #t2.2 )
                case unlock_cellA__111111111111111
                by contradiction /* cyclic */
              next
                case unlock_cellA__1111111111111211111
                by contradiction /* cyclic */
              next
                case unlock_cellA__1111111111111221
                by contradiction /* cyclic */
              next
                case unlock_cellA__1111111121111111111
                by contradiction /* cyclic */
              qed
            next
              case case_2
              solve( Unlock_12( $12.1, ~lock12, 'cellA' ) @ #t2.2 )
                case unlock_cellA__111111111111111
                by solve( State_111111111111111( ~lock12, ~lock9.1, h, i.2, j, msg.1, sk,
                                                 x
                          ) ▶₀ #t2.1 )
              next
                case unlock_cellA__1111111111111211111
                by solve( State_1111111111111211111( ~lock12, ~lock9.1, h, i.2, j, msg.1,
                                                     sk
                          ) ▶₀ #t2.1 )
              next
                case unlock_cellA__1111111111111221
                by solve( State_1111111111111221( ~lock12, ~lock9.1, h, i.2, j, msg.1, sk
                          ) ▶₀ #t2.1 )
              next
                case unlock_cellA__1111111121111111111
                solve( State_1111111121111111111( ~lock12, ~lock6.1, i.2, j, msg.1, sk
                       ) ▶₀ #t2.1 )
                  case unlock_cellA_j__111111112111111111
                  solve( (#t2.2 < #t2.3)  ∥ (#t2.2 = #t2.3) )
                    case case_1
                    by contradiction /* from formulas */
                  next
                    case case_2
                    solve( !KU( hmac(~n.2, <i.1, msg>) ) @ #vk.6 )
                      case c_hmac
                      by solve( !KU( ~n.2 ) @ #vk.8 )
                    next
                      case out_msg_SIGN_j_hmacsk_j_msg___11111111211111
                      by contradiction /* from formulas */
                    next
                      case out_msg_SIGN_j_hmacsk_j_msg___111111211111
                      by contradiction /* from formulas */
                    qed
                  qed
                qed
              qed
            qed
          qed
        next
          case insert_cellA_zero__
          solve( State_( ) ▶₀ #t2 )
            case Init_
            by contradiction /* cyclic */
          qed
        qed
      next
        case case_2
        solve( Insert( 'cellA', i.1 ) @ #t2 )
          case insert_cellA_zero__
          solve( !KU( hmac(~n, <i, msg>) ) @ #vk.6 )
            case c_hmac
            by solve( !KU( ~n ) @ #vk.8 )
          next
            case out_msg_SIGN_j_hmacsk_j_msg___11111111211111
            by contradiction /* from formulas */
          next
            case out_msg_SIGN_j_hmacsk_j_msg___111111211111
            by contradiction /* from formulas */
          qed
        qed
      qed
    next
      case case_2
      solve( (#vr.15 < #t2)  ∥ (#vr.15 = #t2) )
        case case_1
        solve( Insert( 'cellA', i.1 ) @ #t2 )
          case insert_cellA_j_1111111111111211
          solve( State_1111111111111211( ~lock12, ~lock9, h, i, i.1, msg, sk
                 ) ▶₀ #t2 )
            case event_Receivedsk_msg_j_111111111111121
            solve( ((#vr.5 < #vr.23) ∧
                    (∃ #t2.
                      (Unlock_12( $12, ~lock12.1, 'cellA' ) @ #t2)
                     ∧
                      (#vr.5 < #t2) ∧
                      (#t2 < #vr.23) ∧
                      (∀ #t0 pp. (Unlock( pp, ~lock12.1, 'cellA' ) @ #t0) ⇒ #t0 = #t2) ∧
                      (∀ pp lpp #t0.
                        (Lock( pp, lpp, 'cellA' ) @ #t0)
                       ⇒
                        ((#t0 < #vr.5) ∨ (#t0 = #vr.5) ∨ (#t2 < #t0))) ∧
                      (∀ pp lpp #t0.
                        (Unlock( pp, lpp, 'cellA' ) @ #t0)
                       ⇒
                        ((#t0 < #vr.5) ∨ (#t2 < #t0) ∨ (#t2 = #t0)))))  ∥
                   (#vr.23 < #vr.5)  ∥ (#vr.5 = #vr.23) )
              case case_1
              by solve( Delete( <'cellA', i.2> ) @ #t1 )
            next
              case case_2
              by solve( Delete( <'cellA', i.2> ) @ #t1 )
            next
              case case_3
              by contradiction /* cyclic */
            qed
          qed
        next
          case insert_cellA_j_1111111121111111
          solve( State_1111111121111111( ~lock12, ~lock6, i, i.1, msg, sk
                 ) ▶₀ #t2 )
            case lock_cellA_j__111111112111111
            solve( ((#vr.5 < #vr.23) ∧
                    (∃ #t2.
                      (Unlock_12( $12, ~lock12.1, 'cellA' ) @ #t2)
                     ∧
                      (#vr.5 < #t2) ∧
                      (#t2 < #vr.23) ∧
                      (∀ #t0 pp. (Unlock( pp, ~lock12.1, 'cellA' ) @ #t0) ⇒ #t0 = #t2) ∧
                      (∀ pp lpp #t0.
                        (Lock( pp, lpp, 'cellA' ) @ #t0)
                       ⇒
                        ((#t0 < #vr.5) ∨ (#t0 = #vr.5) ∨ (#t2 < #t0))) ∧
                      (∀ pp lpp #t0.
                        (Unlock( pp, lpp, 'cellA' ) @ #t0)
                       ⇒
                        ((#t0 < #vr.5) ∨ (#t2 < #t0) ∨ (#t2 = #t0)))))  ∥
                   (#vr.23 < #vr.5) )
              case case_1
              by solve( Delete( <'cellA', i.1> ) @ #t1 )
            next
              case case_2
              by solve( Delete( <'cellA', i.1> ) @ #t1 )
            qed
          qed
        next
          case insert_cellA_zero__
          solve( State_( ) ▶₀ #t2 )
            case Init_
            by contradiction /* cyclic */
          qed
        qed
      next
        case case_2
        solve( Insert( 'cellA', i.1 ) @ #t2 )
          case insert_cellA_zero__
          by solve( Delete( <'cellA', i> ) @ #t1 )
        qed
      qed
    qed
  qed
next
  case event_Receivedsk_msg_j_11111112111121
  solve( State_11111112111121( ~lock12, ~lock9, h, i, i.1, msg, sk
         ) ▶₀ #u )
    case if_eqh_hmacsk_j_msg__0_1111111211112
    solve( (∀ #t1 y. (Insert( <'cellB', i>, y ) @ #t1) ⇒ #vr.1 < #t1)  ∥
           (∃ #t1.
             (Delete( <'cellB', i> ) @ #t1)
            ∧
             (#t1 < #vr.1) ∧
