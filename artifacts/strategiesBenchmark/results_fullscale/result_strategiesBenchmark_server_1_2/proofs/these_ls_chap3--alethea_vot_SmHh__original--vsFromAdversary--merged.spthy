   ) @ #a)
 ∧
  ∀ #b BB v1 v2 r1 r2 sskD1 sskD2 #b2.
   (BB_rec( BB, <'b', ballots> ) @ #b) ∧
   (BB_tal( BB, <'v', votes> ) @ #b) ∧
   (BB_pskDs( BB, <'spkDSG', spkDSG> ) @ #b2) ∧
