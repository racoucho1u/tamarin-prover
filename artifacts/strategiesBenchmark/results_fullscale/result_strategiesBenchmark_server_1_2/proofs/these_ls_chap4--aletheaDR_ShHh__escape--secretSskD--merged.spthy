lemma DRauth:
  all-traces
  "∀ S #i.
    (Honest( S ) @ #i) ⇒
    ((¬(∃ b BB skS #k #l #m ba.
         (((BB_rec( BB, <'b', ba> ) @ #k) ∧ (¬(b = ba))) ∧
          (Evidence( b, sg(b, skS) ) @ #l)) ∧
         (BB_pkS( BB, <'spkS', pk(skS)> ) @ #m))) ∧
     (¬(∃ BB ba bPrimea sskDa #k #l #m.
         (((BB_rec( BB, <'b', ba> ) @ #k) ∧
           (BB_woS( BB, <'bPrime', bPrimea> ) @ #l)) ∧
          (BB_pskDs( BB, <'spkD', pk(sskDa)> ) @ #m)) ∧
         (¬(ba = sg(bPrimea, sskDa))))))"
/*
guarded formula characterizing all counter-examples:
"∃ S #i.
  (Honest( S ) @ #i)
 ∧
  ((∃ b BB skS #k #l #m ba.
     (BB_rec( BB, <'b', ba> ) @ #k) ∧
     (Evidence( b, sg(b, skS) ) @ #l) ∧
     (BB_pkS( BB, <'spkS', pk(skS)> ) @ #m)
    ∧
     ¬(b = ba)) ∨
   (∃ BB ba bPrimea sskDa #k #l #m.
     (BB_rec( BB, <'b', ba> ) @ #k) ∧
     (BB_woS( BB, <'bPrime', bPrimea> ) @ #l) ∧
     (BB_pskDs( BB, <'spkD', pk(sskDa)> ) @ #m)
    ∧
     ¬(ba = sg(bPrimea, sskDa))))"
*/
by sorry

lemma Uniqueness:
  all-traces
  "∀ #i bs BB.
    (((¬(∃ b BB.1 skS #k #l #m ba.
          (((BB_rec( BB.1, <'b', ba> ) @ #k) ∧ (¬(b = ba))) ∧
           (Evidence( b, sg(b, skS) ) @ #l)) ∧
          (BB_pkS( BB.1, <'spkS', pk(skS)> ) @ #m))) ∧
      (¬(∃ BB.1 ba bPrimea sskDa #k #l #m.
          (((BB_rec( BB.1, <'b', ba> ) @ #k) ∧
            (BB_woS( BB.1, <'bPrime', bPrimea> ) @ #l)) ∧
           (BB_pskDs( BB.1, <'spkD', pk(sskDa)> ) @ #m)) ∧
          (¬(ba = sg(bPrimea, sskDa)))))) ∧
     (BB_rec( BB, <'b', bs> ) @ #i)) ⇒
    (∃ BB.1 H1 bPrime1 sskD1 #bb #s #h1 P.
      (((BB_H( BB.1, <'H', H1> ) @ #bb) ∧ (bs = sg(bPrime1, sskD1))) ∧
       (CastByCorresp( H1, pk(sskD1) ) @ #s)) ∧
      (Send( H1, P, bs ) @ #h1))"
/*
guarded formula characterizing all counter-examples:
"∃ #i bs BB.
  (BB_rec( BB, <'b', bs> ) @ #i)
 ∧
  (∀ b BB.1 skS #k #l #m ba.
    (BB_rec( BB.1, <'b', ba> ) @ #k) ∧
    (Evidence( b, sg(b, skS) ) @ #l) ∧
    (BB_pkS( BB.1, <'spkS', pk(skS)> ) @ #m)
   ⇒
    b = ba) ∧
  (∀ BB.1 ba bPrimea sskDa #k #l #m.
    (BB_rec( BB.1, <'b', ba> ) @ #k) ∧
    (BB_woS( BB.1, <'bPrime', bPrimea> ) @ #l) ∧
    (BB_pskDs( BB.1, <'spkD', pk(sskDa)> ) @ #m)
   ⇒
    ba = sg(bPrimea, sskDa)) ∧
  (∀ BB.1 H1 bPrime1 sskD1 #bb #s #h1 P.
    (BB_H( BB.1, <'H', H1> ) @ #bb) ∧
    (bs = sg(bPrime1, sskD1)) ∧
    (CastByCorresp( H1, pk(sskD1) ) @ #s) ∧
    (Send( H1, P, bs ) @ #h1)
   ⇒
    ⊥)"
*/
by sorry

lemma secretSskD [reuse]:
  all-traces
  "∀ sskD #i. (SecretKeyD( sskD ) @ #i) ⇒ (¬(∃ #j. K( sskD ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ sskD #i. (SecretKeyD( sskD ) @ #i) ∧ ∃ #j. (K( sskD ) @ #j)"
*/
simplify
