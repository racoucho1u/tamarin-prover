lemma onlyonce8 [reuse]:
  all-traces "∀ #i #j. ((S1( ) @ #i) ∧ (S1( ) @ #j)) ⇒ (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ #i #j. (S1( ) @ #i) ∧ (S1( ) @ #j) ∧ ¬(#i = #j)"
*/
simplify
solve( (#i < #j)  ∥ (#j < #i) )
  case case_1
  solve( AgSt_S0( $S, <~skS, pk(~sskDa)> ) ▶₀ #i )
    case Setup
    solve( In_IR_PS( $P, 'S', sg(encp(va, ra, pk(~skS)), ~sskDa) ) ▶₁ #i )
      case ChanIn_IR_PS
      solve( AgSt_S0( 'S', <~skS, pk(~sskDa)> ) ▶₀ #j )
        case Setup
        by contradiction /* cyclic */
      qed
    qed
  qed
next
  case case_2
  solve( AgSt_S0( $S, <~skS, pk(~sskDa)> ) ▶₀ #i )
    case Setup
    solve( In_IR_PS( $P, 'S', sg(encp(va, ra, pk(~skS)), ~sskDa) ) ▶₁ #i )
      case ChanIn_IR_PS
      solve( AgSt_S0( 'S', <~skS, pk(~sskDa)> ) ▶₀ #j )
        case Setup
        by contradiction /* cyclic */
      qed
    qed
  qed
qed

