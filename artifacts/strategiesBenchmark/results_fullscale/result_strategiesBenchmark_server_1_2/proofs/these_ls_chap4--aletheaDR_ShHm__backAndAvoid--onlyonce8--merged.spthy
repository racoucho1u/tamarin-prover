theory aletheaDR_ShHm begin

// Function signature and definition of the equational theory E

functions: adec/2, aenc/2, decp/2, encp/3, fst/1, h/1, pair/2, pk/1,
           sg/2, snd/1, ver/2, verzkp/4, zkp/3
equations:
    adec(aenc(x.1, pk(x.2)), x.2) = x.1,
    decp(encp(x, r, pk(sk)), sk) = x,
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    ver(sg(m, sk), pk(sk)) = m











rule (modulo E) ChanOut_S:
   [ Out_S( $A, $B, x ) ]
  --[ ChanOut_S( $A, $B, x ) ]->
   [ !Sec( $A, $B, x ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) ChanIn_S:
   [ !Sec( $A, $B, x ) ] --[ ChanIn_S( $A, $B, x ) ]-> [ In_S( $A, $B, x ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) ChanOut_A:
   [ Out_A( $A, x ) ]
  --[ ChanOut_A( $A, x ) ]->
   [ !Auth( $A, x ), Out( <$A, x> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) ChanIn_A:
   [ !Auth( $A, x ) ] --[ ChanIn_A( $A, x ) ]-> [ In_A( $A, x ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) ChanOut_IR_HP:
   [ Out_IR_HP( $A, $B, m ) ]
  --[ ChanOut_IR_HP( $A, $B, m ) ]->
   [ Out( <$A, $B, m> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) ChanIn_IR_HP:
   [ In( <$A, $B, m> ) ]
  --[ ChanIn_IR_HP( $A, $B, m ) ]->
   [ In_IR_HP( $A, $B, m ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) ChanOut_IR_PS:
   [ Out_IR_PS( $A, $B, m ) ]
  --[ ChanOut_IR_PS( $A, $B, m ) ]->
   [ Out( <$A, $B, m> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) ChanIn_IR_PS:
   [ In( <$A, $B, m> ) ]
  --[ ChanIn_IR_PS( $A, $B, m ) ]->
   [ In_IR_PS( $A, $B, m ) ]

  /* has exactly the trivial AC variant */

restriction Chan_R_PS:
  "∀ A B m #i.
    (Send_R_PS( A, B, m ) @ #i) ⇒ (∃ #j. Receive_R_PS( A, B, m ) @ #j)"

rule (modulo E) ChanOut_IR_SP:
   [ Out_IR_SP( $A, $B, m ) ]
  --[ ChanOut_IR_SP( $A, $B, m ) ]->
   [ Out( <$A, $B, m> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) ChanIn_IR_SP:
   [ In( <$A, $B, m> ) ]
  --[ ChanIn_IR_SP( $A, $B, m ) ]->
   [ In_IR_SP( $A, $B, m ) ]

  /* has exactly the trivial AC variant */

restriction Chan_R_SP:
  "∀ A B m #i.
    (Send_R_SP( A, B, m ) @ #i) ⇒ (∃ #j. Receive_R_SP( A, B, m ) @ #j)"

rule (modulo E) ChanOut_IR_PH:
   [ Out_IR_PH( $A, $B, m ) ]
  --[ ChanOut_IR_PH( $A, $B, m ) ]->
