rule (modulo E) fakeEvidence:
   [ In( <ballot, evidence> ) ] --[ Evidence( ballot, evidence ) ]-> [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) publickeyinfrastructure:
   [ Fr( ~skX ) ]
  --[ LongtermKey( $X, ~skX ) ]->
   [ !Ltk( $X, ~skX ), !Pk( $X, pk(~skX) ), Out( pk(~skX) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Setup:
   [ !Ltk( 'S', ~skS ), !Ltk( 'D1', ~sskD1 ) ]
  --[
  Setup( ), BB_pskDs( 'BB', <'spkD', pk(~sskD1)> ),
  BB_pkS( 'BB', <'spkS', pk(~skS)> ), BB_H( 'BB', <'H', 'H1'> ),
  CastByCorresp( 'H1', pk(~sskD1) ), Voter( 'H1' ), SecretKeyD( ~sskD1 ),
  Server( 'S' ), Honest( 'S' )
  ]->
   [
   Out( <'H1', 'D1', 'P', 'BB', $v1> ),
   AgSt_D0( 'D1', <'H1', 'S', pk(~skS), ~sskD1> ),
   AgSt_A0( 'A', <'S', 'BB', pk(~skS)> ), AgSt_P0( 'P', 'S' ),
   AgSt_P1( 'P', 'H1' ),
   AgSt_BB0( 'BB', <'S', pk(~sskD1), pk(~skS), 'H1'> ),
   Out_A( 'BB', <'spkD', pk(~sskD1)> ), Out_A( 'BB', <'spkS', pk(~skS)> ),
   Out_A( 'BB', <'H', 'H1'> ), AgSt_S0( 'S', <~skS, pk(~sskD1)> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) D_1:
   [ AgSt_D0( $D, <$H, $S, pkS, ~sskD> ), In( <$H, $D, v> ), Fr( ~r ) ]
  --[ D1( ) ]->
   [ Out( <$D, $H, sg(encp(v, ~r, pkS), ~sskD)> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) P:
   [ AgSt_P0( $P, $S ), In_IR_HP( $H, $P, b ) ]
  --[ Receive_R_HP( $H, $P, b ), Send_R_PS( $P, $S, b ), P1( ) ]->
   [ Out_IR_PS( $P, $S, b ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) S_1a:
   [
   AgSt_S0( $S, <~skS, pk(~sskDa)> ),
   In_IR_PS( $P, $S, sg(encp(va, ra, pk(~skS)), ~sskDa) )
   ]
  --[
  Learn_S_ballot( $S, sg(encp(va, ra, pk(~skS)), ~sskDa) ),
  Receive_R_PS( $P, $S, sg(encp(va, ra, pk(~skS)), ~sskDa) ),
  Send_R_SP( $S, $P, sg(sg(encp(va, ra, pk(~skS)), ~sskDa), ~skS) ), S1( )
  ]->
   [
   AgSt_S1a( $S, <~skS, sg(encp(va, ra, pk(~skS)), ~sskDa)> ),
   Out_IR_SP( $S, $P, sg(sg(encp(va, ra, pk(~skS)), ~sskDa), ~skS) ),
   Out_A( $S, <'b', sg(encp(va, ra, pk(~skS)), ~sskDa)> ),
   Out_A( $S, <'bPrime', encp(va, ra, pk(~skS))> ), Out_A( $S, <'v', va> ),
   Out_A( $S, <'zkp', zkp(encp(va, ra, pk(~skS)), va, ~skS)> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) P_2:
   [ AgSt_P1( $P, $H ), In_IR_SP( $S, $P, c ) ]
  --[ Receive_R_SP( $S, $P, c ), Send_R_PH( $P, $H, c ), P2( ) ]->
   [ Out_IR_PH( $P, $H, c ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) BB:
   [
   AgSt_BB0( $BB, <$S, spkDa, pkS, Ha> ), In_A( $S, <'b', ba> ),
   In_A( $S, <'bPrime', bPrimea> ), In_A( $S, <'v', va> ),
   In_A( $S, <'zkp', p> )
   ]
  --[
  BB_rec( $BB, <'b', ba> ), BB_woS( $BB, <'bPrime', bPrimea> ),
  BB_tal( $BB, <'v', va> ), BB_zkp( $BB, <'zkp', p> ), End( )
  ]->
   [
   Out_A( $BB, <'b', ba> ), Out_A( $BB, <'bPrime', bPrimea> ),
   Out_A( $BB, <'v', va> ), Out_A( $BB, <'zkp', p> )
   ]

  // loop breakers: [1,2,3,4]
  /* has exactly the trivial AC variant */

rule (modulo E) A_1:
   [
   AgSt_A0( $A, <$S, $BB, pkS> ), In_A( $BB, <'b', sg(bPrimea, sskDa)> ),
   In_A( $BB, <'bPrime', bPrimea> ), In_A( $BB, <'v', va> ),
   In_A( $BB, <'zkp', p> ), In_A( $BB, <'spkD', pk(sskDa)> )
   ]
  --[
  Learn_A_proof( $A, <'zkp', p> ),
  Learn_A_spkDSG( $A, <'spkD', pk(sskDa)> ), Learn_A_Vs( $A, <'v', va> ),
  Learn_A_Bs( $A, <'b', sg(bPrimea, sskDa)> ),
  Learn_A_bPrimes( $A, <'bPrime', bPrimea> ),
  VerifyA2( $A, verzkp(p, bPrimea, va, pkS) ), A1( )
  ]->
   [ ]

  /* has exactly the trivial AC variant */

restriction OneSetup:
  "∀ #i #j. ((Setup( ) @ #i) ∧ (Setup( ) @ #j)) ⇒ (#i = #j)"
  // safety formula

