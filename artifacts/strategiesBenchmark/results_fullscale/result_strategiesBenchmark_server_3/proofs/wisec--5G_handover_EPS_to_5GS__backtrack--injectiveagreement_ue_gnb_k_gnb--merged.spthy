lemma injectiveagreement_gnb_ue_k_gnb:
  all-traces
  "∀ a b r #i.
    (Commit( a, b, <'gNB', 'UE', 'K_gNB_star', r> ) @ #i) ⇒
    ((∃ #j.
       (Running( b, a, <'gNB', 'UE', 'K_gNB_star', r> ) @ #j) ∧
       (¬(∃ a2 b2 #i2.
           (Commit( a2, b2, <'gNB', 'UE', 'K_gNB_star', r> ) @ #i2) ∧
           (¬(#i2 = #i))))) ∨
     (∃ X data #k. (Rev( X, data ) @ #k) ∧ (Honest( X ) @ #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ a b r #i.
  (Commit( a, b, <'gNB', 'UE', 'K_gNB_star', r> ) @ #i)
 ∧
  (∀ #j.
    (Running( b, a, <'gNB', 'UE', 'K_gNB_star', r> ) @ #j)
   ⇒
    ∃ a2 b2 #i2.
     (Commit( a2, b2, <'gNB', 'UE', 'K_gNB_star', r> ) @ #i2) ∧ ¬(#i2 = #i)) ∧
  (∀ X data #k. (Rev( X, data ) @ #k) ∧ (Honest( X ) @ #i) ⇒ ⊥)"
*/
by sorry

