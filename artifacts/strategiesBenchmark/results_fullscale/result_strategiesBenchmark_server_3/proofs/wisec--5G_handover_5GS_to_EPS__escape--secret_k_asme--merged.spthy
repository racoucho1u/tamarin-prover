                                                  case secureChannel_compromised_out_case_1
                                                  solve( RcvS( ~cid_N2.2, ~gNB_ID.4, ~AMF_ID.2,
                                                               <'ho_req', ~gNB_UE_ID.1, ~K_AMF>
