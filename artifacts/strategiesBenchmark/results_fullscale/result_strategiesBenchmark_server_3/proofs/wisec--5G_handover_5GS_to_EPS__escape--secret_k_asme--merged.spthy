                            case c_KDF
                            solve( !KU( KDF(KDF(~K_AMF.2, '0'),
                                            KDF(KDF(~K_AMF.2, '0'), KDF(KDF(~K_AMF.2, '0'), 'MAX_NAS_COUNT')))
                                   ) @ #vk.18 )
                              case c_KDF
                              solve( !KU( KDF(KDF(~K_AMF.2, '0'),
                                              KDF(KDF(~K_AMF.2, '0'), 'MAX_NAS_COUNT'))
                                     ) @ #vk.22 )
                                case c_KDF
                                solve( !KU( KDF(KDF(~K_AMF.2, '0'), 'MAX_NAS_COUNT') ) @ #vk.23 )
                                  case c_KDF
                                  solve( RcvS( ~cid_N26, ~MME_ID.1, ~AMF_ID,
                                               <'ffr_res', ~gNB_UE_ID, ('1'++'1')>
                                         ) ▶₃ #vr )
                                    case receive_secure_case_1
