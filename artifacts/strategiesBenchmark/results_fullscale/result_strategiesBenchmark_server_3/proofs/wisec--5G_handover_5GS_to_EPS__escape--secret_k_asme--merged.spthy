                                          solve( RcvS( ~cid_S1, ~MME_ID, ~eNB_ID,
                                                       <'s1_ho_req', ~MME_UE_S1AP_ID.1, 
                                                        KDF(KDF(~K_AMF.2, '0'),
                                                            KDF(KDF(~K_AMF.2, '0'),
                                                                KDF(KDF(~K_AMF.2, '0'), 'MAX_NAS_COUNT'))), 
                                                        NCC.1>
                                                 ) ▶₃ #vr.16 )
                                            case receive_secure_case_1
                                            solve( RcvS( ~cid_N2.1, ~gNB_ID.1, ~AMF_ID.1,
                                                         <'ho_req', ~gNB_UE_ID.2, ~eNB_ID>
                                                   ) ▶₃ #vr.17 )
                                              case receive_secure_case_1
                                              solve( RcvS( ~cid_N2.2, ~gNB_ID.3, ~AMF_ID.2,
                                                           <'ho_req', ~gNB_UE_ID.1, ~K_AMF>
