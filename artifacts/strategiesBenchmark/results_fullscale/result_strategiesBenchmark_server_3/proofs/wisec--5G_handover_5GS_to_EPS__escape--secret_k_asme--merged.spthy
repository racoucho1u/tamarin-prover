lemma secret_k_amf:
  all-traces
  "∀ p #i.
    (Secret( <'K_AMF', p> ) @ #i) ⇒
    ((¬(∃ #k. K( p ) @ #k)) ∨
     (∃ X #k. (Rev( X, <'K_AMF', p> ) @ #k) ∧ (Honest( X ) @ #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ p #i.
  (Secret( <'K_AMF', p> ) @ #i)
 ∧
  (∃ #k. (K( p ) @ #k)) ∧
  (∀ X #k. (Rev( X, <'K_AMF', p> ) @ #k) ∧ (Honest( X ) @ #i) ⇒ ⊥)"
*/
by sorry

lemma secret_k_asme:
  all-traces
  "∀ p q #i #j.
    ((Secret( <'K_ASME', q> ) @ #i) ∧
     (KeyDerived( <'K_ASME', q>, p ) @ #j)) ⇒
    ((((¬(∃ #k. K( q ) @ #k)) ∨
       (∃ X #k. (Rev( X, <'K_ASME', q> ) @ #k) ∧ (Honest( X ) @ #i))) ∨
      (∃ X #k. (Rev( X, <'K_AMF', p> ) @ #k) ∧ (Honest( X ) @ #i))) ∨
     (∃ X #k. (Rev( X, 'secureChannel' ) @ #k) ∧ (Honest( X ) @ #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ p q #i #j.
  (Secret( <'K_ASME', q> ) @ #i) ∧ (KeyDerived( <'K_ASME', q>, p ) @ #j)
 ∧
  (∃ #k. (K( q ) @ #k)) ∧
  (∀ X #k. (Rev( X, <'K_ASME', q> ) @ #k) ∧ (Honest( X ) @ #i) ⇒ ⊥) ∧
  (∀ X #k. (Rev( X, <'K_AMF', p> ) @ #k) ∧ (Honest( X ) @ #i) ⇒ ⊥) ∧
  (∀ X #k. (Rev( X, 'secureChannel' ) @ #k) ∧ (Honest( X ) @ #i) ⇒ ⊥)"
*/
simplify
solve( Secret( <'K_ASME', q> ) @ #i )
  case handover_done
  solve( St_3_AMF( ~AMF_ID, q, ~K_AMF, NH, ~SUPI ) ▶₀ #i )
    case amf_rcv_fr_res_snd_ho_cmd
    solve( St_3_MME( ~MME_ID, KDF(~K_AMF, '0'),
                     KDF(KDF(~K_AMF, '0'),
                         KDF(KDF(~K_AMF, '0'), KDF(KDF(~K_AMF, '0'), 'MAX_NAS_COUNT')))
           ) ▶₁ #i )
      case mme_rcv_ho_notify_case_1
      solve( St_2_eNB( ~eNB_ID, K_eNB_star ) ▶₂ #i )
        case enb_rcv_ho_complete_snd_ho_notify
        solve( St_3_gNB( ~gNB_ID, K_gNB, ~AMF_ID, ~gNB_UE_ID, ~eNB_ID ) ▶₃ #i )
          case gnb_fwd_ho_cm_case_1
          solve( St_2_UE( ~SUPI, ~K_AMF, KDF(~K_AMF.2, 'MAX_NAS_COUNT'),
                          KDF(~K_AMF, '0'),
                          KDF(KDF(KDF(~K_AMF.1, '0'),
                                  KDF(KDF(~K_AMF.1, '0'), KDF(KDF(~K_AMF.1, '0'), 'MAX_NAS_COUNT'))),
                              ~eNB_ID),
                          ~AMF_ID
                 ) ▶₄ #i )
            case ue_rcv_ho_cmd_snd_ho_complete
            solve( KeyDerived( <'K_ASME', KDF(~K_AMF, '0')>, p ) @ #j )
              case amf_rcv_ho_req_snd_fr_req
              solve( St_1_AMF( ~AMF_ID.1, ~K_AMF, '0', ~SUPI.1, ~gNB_UE_ID.1 ) ▶₀ #j )
                case init_UE
                solve( !KU( KDF(~K_AMF, '0') ) @ #vk )
                  case c_KDF
                  solve( !KU( ~K_AMF ) @ #vk.8 )
                    case reveal_k_amf
                    by contradiction /* from formulas */
                  next
                    case secureChannel_compromised_out_case_1
                    solve( !KU( senc('handover_complete',
                                     KDF(KDF(KDF(~K_AMF.1, '0'),
                                             KDF(KDF(~K_AMF.1, '0'),
                                                 KDF(KDF(~K_AMF.1, '0'), 'MAX_NAS_COUNT'))),
                                         ~eNB_ID.1))
                           ) @ #vk.4 )
                      case c_senc
                      solve( !KU( senc(<'ho_cmd', ~eNB_ID, NCC.3, '0'>,
                                       KDF(~K_AMF, 'MAX_NAS_COUNT'))
                             ) @ #vk.8 )
                        case c_senc
                        solve( !KU( KDF(KDF(KDF(~K_AMF.2, '0'),
                                            KDF(KDF(~K_AMF.2, '0'),
                                                KDF(KDF(~K_AMF.2, '0'), 'MAX_NAS_COUNT'))),
                                        ~eNB_ID.1)
