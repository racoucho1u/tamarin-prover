    (MobilityRegistrationUpdateDone( a ) @ #k) ⇒ ((#k = #j6) ∨ (#k = #l6))) ∧
  (∀ a b #k1 #k2.
    (CoreNetwork( a ) @ #k1) ∧ (CoreNetwork( b ) @ #k2) ⇒ #k1 = #k2) ∧
  (∀ a b #k1 #k2.
    (UserEquipment( a ) @ #k1) ∧ (UserEquipment( b ) @ #k2) ⇒ #k1 = #k2) ∧
  (∀ a b c d #k1 #k2.
    (Subscribe( a, b ) @ #k1) ∧ (Subscribe( c, d ) @ #k2) ⇒ #k1 = #k2)"
