lemma executability_hkd_hkd:
  exists-trace
  "∃ x0 x1 x2 x3 s t #i1 #i2 #i3 #i4 #i5 #j1 #j2 #j3 #j4 #j5 #j6 #l1 #l2
     #l3 #l4 #l5 #l6.
    (((((((((((((((((((((((((((((((((((((((((((Init( 'K_gNB', x0 ) @ #i1) ∧
