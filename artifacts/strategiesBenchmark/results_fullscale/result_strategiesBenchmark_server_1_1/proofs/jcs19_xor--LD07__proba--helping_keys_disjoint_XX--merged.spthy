  all-traces
  "((∀ #t1 #t2 #t3.
      (((Tag1rule( ) @ #t1) ∧ (Tag1rule( ) @ #t2)) ∧ (Tag1rule( ) @ #t3)) ⇒
      (((#t1 = #t2) ∨ (#t1 = #t3)) ∨ (#t2 = #t3))) ∧
    (∀ #t1 #t2 #t3.
      (((Reader2rule( ) @ #t1) ∧ (Reader2rule( ) @ #t2)) ∧
       (Reader2rule( ) @ #t3)) ⇒
      (((#t1 = #t2) ∨ (#t1 = #t3)) ∨ (#t2 = #t3)))) ⇒
   (∀ k1 kp r kpr #i.
     (AliveTag( k1, kp, r, kpr ) @ #i) ⇒
     (∃ #j #k.
       (((ChallengeReader( r ) @ #k) ∧ (Response( k1, 'Tag' ) @ #j)) ∧
        (#k < #j)) ∧
       (#j < #i)))"
