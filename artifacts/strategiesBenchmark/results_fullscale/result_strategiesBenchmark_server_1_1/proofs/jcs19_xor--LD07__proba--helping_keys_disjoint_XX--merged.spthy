lemma helping_keys_disjoint_XS [reuse, use_induction]:
  all-traces
  "∀ x y #i #j. ((KeyX( x ) @ #i) ∧ (KeyS( y ) @ #j)) ⇒ (¬(x = y))"
/*
guarded formula characterizing all counter-examples:
"∃ x y #i #j. (KeyX( x ) @ #i) ∧ (KeyS( y ) @ #j) ∧ x = y"
*/
by sorry

