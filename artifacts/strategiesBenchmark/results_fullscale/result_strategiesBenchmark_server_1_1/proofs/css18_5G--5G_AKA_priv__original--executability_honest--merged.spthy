lemma executability_honest [right]:
  exists-trace
  "∃ #i.
    ((((((SEAF_End( ) @ #i) ∧
         (∀ supi HN sqn_root #i.1.
           (Sqn_Create( supi, HN, sqn_root ) @ #i.1) ⇒
           (¬(∃ #j. K( sqn_root ) @ #j)))) ∧
        (∀ HN1 HN2 #j #k.
          ((HomeNet( HN1 ) @ #j) ∧ (HomeNet( HN2 ) @ #k)) ⇒ (#j = #k))) ∧
       (∀ S1 S2 HN1 HN2 #j #k.
         ((Subscribe( S1, HN1 ) @ #j) ∧ (Subscribe( S2, HN2 ) @ #k)) ⇒
         (#j = #k))) ∧
      (∀ SNID1 SNID2 #j #k.
        ((Start_SEAF_Session( SNID1 ) @ #j) ∧
         (Start_SEAF_Session( SNID2 ) @ #k)) ⇒
        (#j = #k))) ∧
     (∀ UE1 UE2 #j #k.
       ((Start_UE_Session( UE1 ) @ #j) ∧ (Start_UE_Session( UE2 ) @ #k)) ⇒
       (#j = #k))) ∧
    (∀ HN1 HN2 #j #k.
      ((Start_HSS_Session( HN1 ) @ #j) ∧ (Start_HSS_Session( HN2 ) @ #k)) ⇒
      (#j = #k))"
/*
guarded formula characterizing all satisfying traces:
"∃ #i.
  (SEAF_End( ) @ #i)
 ∧
  (∀ supi HN sqn_root #i.1.
    (Sqn_Create( supi, HN, sqn_root ) @ #i.1)
   ⇒
    ∀ #j. (K( sqn_root ) @ #j) ⇒ ⊥) ∧
  (∀ HN1 HN2 #j #k.
    (HomeNet( HN1 ) @ #j) ∧ (HomeNet( HN2 ) @ #k) ⇒ #j = #k) ∧
  (∀ S1 S2 HN1 HN2 #j #k.
    (Subscribe( S1, HN1 ) @ #j) ∧ (Subscribe( S2, HN2 ) @ #k) ⇒ #j = #k) ∧
  (∀ SNID1 SNID2 #j #k.
    (Start_SEAF_Session( SNID1 ) @ #j) ∧ (Start_SEAF_Session( SNID2 ) @ #k)
   ⇒
    #j = #k) ∧
  (∀ UE1 UE2 #j #k.
    (Start_UE_Session( UE1 ) @ #j) ∧ (Start_UE_Session( UE2 ) @ #k)
   ⇒
    #j = #k) ∧
  (∀ HN1 HN2 #j #k.
    (Start_HSS_Session( HN1 ) @ #j) ∧ (Start_HSS_Session( HN2 ) @ #k)
   ⇒
    #j = #k)"
*/
simplify
solve( St_3_SEAF( ~tid, ~idSN, <'5G', ~idSN>, conc_supi, idHN, ~RAND,
                  RES_star, K_seaf
       ) ▶₀ #i )
  case seaf_receive_authResp_send_ac_case_1
  solve( RcvS( idHN, ~idSN, <'aca', 'confirm', supi> ) ▶₁ #i )
    case receive_secure
    solve( RcvS( ~idHN, ~idSN,
                 <'aia', ~RAND, SHA256(RES_star, ~RAND), K_seaf, 
                  (f5(~k, ~RAND)⊕('1'++~sqn_root++count)), 
                  f1(~k, <('1'++~sqn_root++count), ~RAND>)>
           ) ▶₁ #vr.1 )
      case receive_secure_case_2
      solve( !KU( KDF(<f3(~k, ~RAND), f4(~k, ~RAND)>,
                      <<'5G', ~idSN>, f2(~k, ~RAND), ~RAND>)
             ) @ #vk )
        case ue_receive_authReq_freshness_success_send_authResp
        solve( !KU( (f5(~k, ~RAND)⊕(~sqn_root++dif++count.1)) ) @ #vk.9 )
          case coerce
          solve( !KD( (f5(~k, ~RAND)⊕(~sqn_root++dif++count.1)) ) ▶₀ #vk.1 )
            case seaf_receive_aia_send_authReq
            solve( (#vl.1, 0) ~~> (#vk.1, 0) )
              case d_0_snd
              solve( (#vr.15, 0) ~~> (#vk.1, 0) )
                case d_0_fst
                solve( St_1_SEAF( ~tid.3, ~idSN.1, SNID, conc_supi.1, idHN.1
                       ) ▶₀ #vr.14 )
                  case seaf_receive_attachReq_send_air
                  solve( (#vr.15, 0) ~~> (#vk.1, 0) )
                    case d_0_fst
                    solve( (#vr.16, 0) ~~> (#vk.1, 0) )
                      case Xor_case_1
                      solve( RcvS( ~idSN, ~idHN,
                                   <'air', <aenc(<~supi, ~R>, pk(~sk_HN)), ~idHN>, '5G', ~idSN>
                             ) ▶₁ #j )
                        case receive_secure
                        solve( !KU( aenc(<~supi, ~R>, pk(~sk_HN)) ) @ #vk.6 )
                          case ue_send_attachReq
                          solve( Sqn_HSS( ~supi, ~idHN, (~sqn_root++count), ~sqn_root, count
                                 ) ▶₃ #j )
                            case add_subscription
                            solve( RcvS( ~idSN, ~idHN,
                                         <'ac', 
                                          KDF(<f3(~k, ~RAND), f4(~k, ~RAND)>,
                                              <<'5G', ~idSN>, f2(~k, ~RAND), ~RAND>), 
                                          <aenc(<~supi, ~R>, pk(~sk_HN)), ~idHN>, '5G', ~idSN>
                                   ) ▶₁ #vr.9 )
                              case receive_secure
                              solve( Sqn_UE( ~supi, ~idHN, ('1'++~sqn_root), ~sqn_root, '1'
                                     ) ▶₁ #vr.12 )
                                case add_subscription
                                solve( !KU( ~idHN ) @ #vk.7 )
                                  case init_homeNet
                                  solve( !KU( ~RAND ) @ #vk.9 )
                                    case seaf_receive_aia_send_authReq
                                    solve( !KU( ~idSN ) @ #vk.13 )
                                      case init_servNet
                                      solve( !KU( f1(~k, <('1'++'1'++~sqn_root), ~RAND>) ) @ #vk.11 )
                                        case seaf_receive_aia_send_authReq
                                        SOLVED // trace found
                                      qed
                                    qed
                                  qed
                                qed
                              qed
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

