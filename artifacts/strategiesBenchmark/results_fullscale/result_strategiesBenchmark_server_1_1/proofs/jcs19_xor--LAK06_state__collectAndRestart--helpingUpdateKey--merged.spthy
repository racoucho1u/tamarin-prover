restriction onylOnce:
  "∀ x #i1 #i2.
    ((OnlyOnce( x ) @ #i1) ∧ (OnlyOnce( x ) @ #i2)) ⇒ (#i1 = #i2)"
  // safety formula

lemma helpingUpdateKey [use_induction, reuse]:
  all-traces
  "∀ k r #i.
    (Key( k, r ) @ #i) ⇒ (∃ #j. (Update( k, r ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ k r #i. (Key( k, r ) @ #i) ∧ ∀ #j. (Update( k, r ) @ #j) ⇒ ¬(#j < #i)"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  solve( (last(#i))  ∥
         (∃ #j. (Update( k, r ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #i)) )
    case case_1
    solve( Key( k, r ) @ #i )
      case acceptreaderNew_case_1
      solve( ReaderK( ~id, k, k.1 ) ▶₂ #i )
        case acceptreaderNew
        by contradiction /* from formulas */
      next
        case acceptreaderOld
        by contradiction /* from formulas */
      next
        case setup
        by contradiction /* from formulas */
      qed
    next
      case acceptreaderNew_case_2
      solve( ReaderK( ~id, k0, k ) ▶₂ #i )
        case acceptreaderNew
        by contradiction /* from formulas */
      next
        case acceptreaderOld
        by contradiction /* from formulas */
      next
        case setup
        by contradiction /* from formulas */
      qed
    next
      case acceptreaderOld_case_1
      solve( ReaderK( ~id, k, k.1 ) ▶₂ #i )
        case acceptreaderNew
        by contradiction /* from formulas */
      next
        case acceptreaderOld
        by contradiction /* from formulas */
      next
        case setup
        by contradiction /* from formulas */
      qed
    next
      case acceptreaderOld_case_2
      solve( ReaderK( ~id, k0, k ) ▶₂ #i )
        case acceptreaderNew
        by contradiction /* from formulas */
      next
        case acceptreaderOld
        by contradiction /* from formulas */
      next
        case setup
        by contradiction /* from formulas */
      qed
    next
      case accepttag
      solve( TagState1( ~id, k, ~r1, r0, m ) ▶₀ #i )
        case tag1
        by contradiction /* from formulas */
      qed
    next
      case tag1
      solve( !Tag( ~id ) ▶₀ #i )
        case setup
        solve( TagK( ~id, k ) ▶₁ #i )
          case accepttag
          by contradiction /* from formulas */
        next
          case setup
          by contradiction /* from formulas */
        next
          case tag1
          by contradiction /* from formulas */
        qed
      qed
    qed
  next
    case case_2
    by contradiction /* from formulas */
  qed
qed

lemma helpingStackHash [use_induction, reuse]:
  all-traces
  "(∀ k r #i. (Key( k, r ) @ #i) ⇒ (∃ k0. k = h(k0))) ∧
   (∀ k r #i. (Update( k, r ) @ #i) ⇒ (∃ k0. k = h(k0)))"
/*
guarded formula characterizing all counter-examples:
"((∃ k r #i. (Key( k, r ) @ #i) ∧ ∀ k0. (k = h(k0)) ⇒ ⊥) ∨
  (∃ k r #i. (Update( k, r ) @ #i) ∧ ∀ k0. (k = h(k0)) ⇒ ⊥))"
*/
by sorry

lemma helpingSecrecy [use_induction, reuse]:
  all-traces "∀ k r #i. (Key( k, r ) @ #i) ⇒ (¬(∃ #j. !KU( k ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ k r #i. (Key( k, r ) @ #i) ∧ ∃ #j. (!KU( k ) @ #j)"
*/
by sorry

lemma executable:
  exists-trace
  "(∃ #i. FinTag( ) @ #i) ∧
   (∀ x #i1 #i2.
     ((OnlyOnce( x ) @ #i1) ∧ (OnlyOnce( x ) @ #i2)) ⇒ (#i1 = #i2))"
/*
guarded formula characterizing all satisfying traces:
"(∃ #i. (FinTag( ) @ #i)) ∧
 (∀ x #i1 #i2. (OnlyOnce( x ) @ #i1) ∧ (OnlyOnce( x ) @ #i2) ⇒ #i1 = #i2)"
*/
by sorry

lemma noninjectiveagreementTAG [use_induction]:
  all-traces
  "∀ t #i.
    (Commit( <'T', 'R', t> ) @ #i) ⇒ (∃ #j. Running( <'T', 'R', t> ) @ #j)"
/*
guarded formula characterizing all counter-examples:
"∃ t #i.
  (Commit( <'T', 'R', t> ) @ #i)
 ∧
  ∀ #j. (Running( <'T', 'R', t> ) @ #j) ⇒ ⊥"
*/
by sorry

