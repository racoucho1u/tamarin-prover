theory LAK06_state begin

// Function signature and definition of the equational theory E

builtins: xor
functions: fst/1, h/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2







/* looping facts with injective instances: ReaderK/3, TagK/2 */





rule (modulo E) setup:
   [ Fr( ~k ), Fr( ~id ) ]
  --[
  OnlyOnce( '2Users' ), Update( h(h(~k)), 'T' ), Update( h(~k), 'R1' ),
  Update( h(h(~k)), 'R2' ), Setup( )
  ]->
   [
   !Reader( ~id ), !Tag( ~id ), ReaderK( ~id, h(~k), h(h(~k)) ),
   TagK( ~id, h(h(~k)) )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) initiatereader:
   [ !Reader( ~id ), Fr( ~r0 ) ]
  -->
   [ ReaderState1( ~id, ~r0 ), Out( ~r0 ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) tag1:
   [ !Tag( ~id ), TagK( ~id, k ), Fr( ~r1 ), In( r0 ) ]
  --[ Running( <'R', 'T', k, r0, ~r1> ), Key( k, 'T' ), OutH( (~r1⊕k⊕r0) )
  ]->
   [
   TagState1( ~id, k, ~r1, r0, h((~r1⊕k⊕r0)) ), Out( <~r1, h((~r1⊕k⊕r0))> ),
   TagK( ~id, k )
   ]

  // loop breaker: [1]
  /*
  rule (modulo AC) tag1:
     [ !Tag( ~id ), TagK( ~id, k ), Fr( ~r1 ), In( r0 ) ]
    --[ Running( <'R', 'T', k, r0, ~r1> ), Key( k, 'T' ), OutH( z ) ]->
     [ TagState1( ~id, k, ~r1, r0, h(z) ), Out( <~r1, h(z)> ), TagK( ~id, k )
     ]
    variants (modulo AC)
    1. ~r1   = ~r1.8
       k     = k.9
       r0    = k.9
       z     = ~r1.8
    
    2. ~r1   = ~r1.8
       k     = k.9
       r0    = zero
       z     = (~r1.8⊕k.9)
    
    3. ~r1   = ~r1.9
       k     = k.10
       r0    = r0.11
       z     = (~r1.9⊕k.10⊕r0.11)
    
    4. ~r1   = ~r1.9
       k     = zero
       r0    = r0.11
       z     = (~r1.9⊕r0.11)
    
    5. ~r1   = ~r1.14
       k     = k.15
       r0    = (k.15⊕x.25)
       z     = (~r1.14⊕x.25)
    
    6. ~r1   = ~r1.14
       k     = (r0.16⊕x.25)
       r0    = r0.16
       z     = (~r1.14⊕x.25)
    
    7. ~r1   = ~r1.15
       k     = (x.25⊕x.26)
       r0    = (x.25⊕x.27)
       z     = (~r1.15⊕x.26⊕x.27)
    // loop breaker: [1]
  */

