                              'STORAGE',
                              <'1', 'SHA256', H_SHA256(<'DAA_public_data', multp(~f.28, 'P1')>)>)))
       z.1   = snd(adec(aenc(<'1', s.34>, pk(KDF_EK(~TPM_EK_Seed.27))), e.32))
    
    2. ~TPM_EK_Seed
