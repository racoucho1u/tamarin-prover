rule (modulo E) Host_CredentialsReveal:
   [ Host_Org_Creds( $PS, $AS, pk(KDF_EK(TPM_EK_Seed)), A, B, C, D ) ]
  --[
  KeyReveal( 'Host_OrgCred_Reveal', $AS ),
  KeyReveal( 'TPM_OrgCred_Reveal', $PS ),
  KeyReveal( 'PKE_OrgCred_Reveal', pk(KDF_EK(TPM_EK_Seed)) )
  ]->
   [ Out( <A, B, C, D> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Host_Randomise_Credentials:
   [
   !Host_State_RNDCreds( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)), A, B, C, D ),
   Fr( ~l )
   ]
  --[ RandomisedCredentials( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)) ) ]->
   [
   !Host_Random_Credentials( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)),
                             multp(~l, A), multp(~l, B), multp(~l, C), multp(~l, D)
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Generate_Basename:
   [
   !Host_Join_Complete( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)) ),
   Fr( ~BaseName )
   ]
  --[ GenerateBasename( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)) ) ]->
   [ !Host_BaseName( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)), BSN(~BaseName) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Host_Basename:
   [
   !Host_Random_Credentials( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)), R, S, T, W
   ),
   !Host_BaseName( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)), bsn )
   ]
  --[ SetBasename( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)), bsn ) ]->
   [ !Host_State_07( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)), R, S, T, W, bsn ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Host_Process_Credentials:
   [
   !Host_State_07( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)),
                   multp(~l, multp(r, 'P1')), multp(~l, multp(y, multp(r, 'P1'))),
                   multp(~l,
                         plus(multp(x, multp(r, 'P1')), multp(multp(multp(r, x), y), Q))),
                   multp(~l, multp(multp(r, y), Q)), BSN(basename)
   )
   ]
  --[
  ProcessRandomisedCredentials( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)),
                                BSN(basename)
  ),
  QuotePCROnlyOnce( 'Host_Randomise_Credentials' )
  ]->
   [
   Out_S( $AS, $PS,
          <F1(BSN(basename)), F2(BSN(basename)), 
           multp(~l, multp(y, multp(r, 'P1'))), 'TPM2_Commit_rand'>
   ),
   Host_State_08( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)), BSN(basename),
                  multp(~l, multp(r, 'P1')), multp(~l, multp(y, multp(r, 'P1'))),
                  multp(~l,
                        plus(multp(x, multp(r, 'P1')), multp(multp(multp(r, x), y), Q))),
                  multp(~l, multp(multp(r, y), Q)),
                  PointG1(H_p(F1(BSN(basename))), F2(BSN(basename)))
   ),
   Host_Rnd_Creds( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)), BSN(basename),
                   multp(~l, multp(r, 'P1')), multp(~l, multp(y, multp(r, 'P1'))),
                   multp(~l,
                         plus(multp(x, multp(r, 'P1')), multp(multp(multp(r, x), y), Q))),
                   multp(~l, multp(multp(r, y), Q))
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Host_RandomCredentialsReveal:
   [ Host_Rnd_Creds( $PS, $AS, pk(KDF_EK(TPM_EK_Seed)), bsn, R, S, T, W ) ]
  --[
  KeyReveal( 'Host_RndCred_Reveal', $AS ),
  KeyReveal( 'TPM_RndCred_Reveal', $PS ),
  KeyReveal( 'PKE_RndCred_Reveal', pk(KDF_EK(TPM_EK_Seed)) )
  ]->
   [ Out( <bsn, R, S, T, W> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) TPM2_Commit_2:
   [
   In_S( $AS, $PS, <F1(bsn), F2(bsn), S, 'TPM2_Commit_rand'> ),
   !TPM_DAA_SK( $PS, pk(KDF_EK(~TPM_EK_Seed)), ~f ), Fr( ~cv1 ),
   Fr( ~r_cv1 )
   ]
  --[
  TPMCommitRandomised( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)) ),
  CheckInG1( PointG1(H_p(F1(bsn)), F2(bsn)) ),
  SignOnlyOnce( 'TPM2_Commit_2' )
  ]->
   [
   Out_S( $PS, $AS,
          <multp(~f, PointG1(H_p(F1(bsn)), F2(bsn))), 
           L_J(~r_cv1, PointG1(H_p(F1(bsn)), F2(bsn))), E_S(~r_cv1, S), 
           Nonce(~cv1), 'ret_TPM2_Commit_rand'>
   ),
   TPM_Commit_RCV1( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)), Nonce(~cv1), ~r_cv1
   )
   ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) Host_Request_PCR_Quote:
   [
   In_S( $PS, $AS, <K, L, E, Nonce(cv1), 'ret_TPM2_Commit_rand'> ),
   Fr( ~pcr_set ),
   Host_State_08( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)), BSN(basename),
                  multp(sl, multp(r, 'P1')), multp(sl, multp(y, multp(r, 'P1'))),
                  multp(sl,
                        plus(multp(x, multp(r, 'P1')), multp(multp(multp(r, x), y), Q))),
                  multp(sl, multp(multp(r, y), Q)), J
   )
   ]
  --[
  RequestPCRQuote( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)) ),
  QuotePCROnlyOnce( 'Host_Request_PCR_Quote' )
  ]->
   [
   Out_S( $AS, $PS,
          <pk(KDF_EK(~TPM_EK_Seed)), 
           H_k_9('pcr_data', multp(sl, multp(r, 'P1')),
                 multp(sl, multp(y, multp(r, 'P1'))),
                 multp(sl,
                       plus(multp(x, multp(r, 'P1')), multp(multp(multp(r, x), y), Q))),
                 multp(sl, multp(multp(r, y), Q)), J, K, L, E), 
           Nonce(cv1), Pcr_Set(~pcr_set), 'TPM2_Quote'>
   ),
   Host_State_09( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)),
                  H_k_9('pcr_data', multp(sl, multp(r, 'P1')),
                        multp(sl, multp(y, multp(r, 'P1'))),
                        multp(sl,
                              plus(multp(x, multp(r, 'P1')), multp(multp(multp(r, x), y), Q))),
                        multp(sl, multp(multp(r, y), Q)), J, K, L, E),
                  'pcr_data', Pcr_Set(~pcr_set), BSN(basename), multp(sl, multp(r, 'P1')),
                  multp(sl, multp(y, multp(r, 'P1'))),
                  multp(sl,
                        plus(multp(x, multp(r, 'P1')), multp(multp(multp(r, x), y), Q))),
                  multp(sl, multp(multp(r, y), Q)), J, K, L, E
   )
   ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) TPM2_Quote:
   [
   In_S( $AS, $PS,
         <pk(KDF_EK(~TPM_EK_Seed)), H_k_9(pcrData, R, S, T, W, J, K, L, E), 
          cv1val_in, pcrset, 'TPM2_Quote'>
   ),
   !TPM_DAA_SK( $PS, pk(KDF_EK(~TPM_EK_Seed)), ~f ),
   TPM_Commit_RCV1( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)), cv1val, ~r_cv1 ),
   Fr( ~pcrset_values ), Fr( ~rnd_n_Q )
   ]
  --[
  TPM2_Created_PCRQuote_TPM( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)) ),
  Eq( cv1val_in, cv1val ), QuotePCROnlyOnce( 'TPM2_Quote' )
  ]->
   [
   Out_S( $PS, $AS,
          <quotePCR(pcrset, ~pcrset_values), 
           plus(~r_cv1,
                multp(H_n_2(Nonce(~rnd_n_Q),
                            H_k_2(H_k_9(pcrData, R, S, T, W, J, K, L, E),
                                  H_6(quotePCR(pcrset, ~pcrset_values)))),
                      ~f)), 
           Nonce(~rnd_n_Q), 'ret_TPM2_Quote'>
   )
   ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) Host_Receive_Quoted_PCR:
   [
   In_S( $PS, $AS,
         <quotePCR(Pcr_Set(~pcr_set), pcrset_values), plus(r_cv1, multp(h2, f)), 
          Nonce(rnd_n_Q), 'ret_TPM2_Quote'>
   ),
   Host_State_09( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)), small_c, 'pcr_data',
                  Pcr_Set(~pcr_set), BSN(basename), multp(sl, A), multp(sl, B),
                  multp(sl, C), multp(sl, D),
                  PointG1(H_p(F1(BSN(basename))), F2(BSN(basename))),
                  multp(f, PointG1(H_p(F1(BSN(basename))), F2(BSN(basename)))),
                  L_J(r_cv1, PointG1(H_p(F1(BSN(basename))), F2(BSN(basename)))),
                  E_S(r_cv1, S)
   )
   ]
  --[
  Host_Receive_Quoted_PCR( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)),
                           Pcr_Set(~pcr_set)
  ),
  Host_Sends_Quote( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)),
                    <Pcr_Set(~pcr_set), BSN(basename), multp(sl, A), multp(sl, B), 
                     multp(sl, C), multp(sl, D), 
                     PointG1(H_p(F1(BSN(basename))), F2(BSN(basename))), 
                     multp(f, PointG1(H_p(F1(BSN(basename))), F2(BSN(basename)))), 
                     quotePCR(Pcr_Set(~pcr_set), pcrset_values), 
                     H_n_2(Nonce(rnd_n_Q),
                           H_k_2(small_c, H_6(quotePCR(Pcr_Set(~pcr_set), pcrset_values)))), 
                     plus(r_cv1, multp(h2, f)), Nonce(rnd_n_Q), 'pcr_data'>
  ),
  Host_Sends_Quote_With_BSN( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)),
                             BSN(basename),
                             <Pcr_Set(~pcr_set), BSN(basename), multp(sl, A), multp(sl, B), 
                              multp(sl, C), multp(sl, D), 
                              PointG1(H_p(F1(BSN(basename))), F2(BSN(basename))), 
                              multp(f, PointG1(H_p(F1(BSN(basename))), F2(BSN(basename)))), 
                              quotePCR(Pcr_Set(~pcr_set), pcrset_values), 
                              H_n_2(Nonce(rnd_n_Q),
                                    H_k_2(small_c, H_6(quotePCR(Pcr_Set(~pcr_set), pcrset_values)))), 
                              plus(r_cv1, multp(h2, f)), Nonce(rnd_n_Q), 'pcr_data'>
  ),
  Host_Sends_Quote_cred( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)), BSN(basename),
                         multp(sl, A), multp(sl, B), multp(sl, C), multp(sl, D),
                         <Pcr_Set(~pcr_set), BSN(basename), multp(sl, A), multp(sl, B), 
                          multp(sl, C), multp(sl, D), 
                          PointG1(H_p(F1(BSN(basename))), F2(BSN(basename))), 
                          multp(f, PointG1(H_p(F1(BSN(basename))), F2(BSN(basename)))), 
                          quotePCR(Pcr_Set(~pcr_set), pcrset_values), 
                          H_n_2(Nonce(rnd_n_Q),
                                H_k_2(small_c, H_6(quotePCR(Pcr_Set(~pcr_set), pcrset_values)))), 
                          plus(r_cv1, multp(h2, f)), Nonce(rnd_n_Q), 'pcr_data'>
  ),
  Honest( $PS ), Honest( $AS ), Honest( pk(KDF_EK(~TPM_EK_Seed)) ),
  QuotePCROnlyOnce( 'Host_Receive_Quoted_PCR' )
  ]->
   [
   Out( <Pcr_Set(~pcr_set), BSN(basename), multp(sl, A), multp(sl, B), 
         multp(sl, C), multp(sl, D), 
         PointG1(H_p(F1(BSN(basename))), F2(BSN(basename))), 
         multp(f, PointG1(H_p(F1(BSN(basename))), F2(BSN(basename)))), 
         quotePCR(Pcr_Set(~pcr_set), pcrset_values), 
         H_n_2(Nonce(rnd_n_Q),
               H_k_2(small_c, H_6(quotePCR(Pcr_Set(~pcr_set), pcrset_values)))), 
         plus(r_cv1, multp(h2, f)), Nonce(rnd_n_Q), 'pcr_data'>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Verifier_Check_TPM_PCR_Quote:
   [
   In( <Pcr_Set(pcr_set), BSN(basename), multp(sl, A), multp(sl, B), 
        multp(sl, C), multp(sl, D), PointG1(H_p(s_2_bar), y_2), 
        multp(f, PointG1(H_p(s_2_bar), y_2)), quotePCR(pcrset, pcrset_values), 
        H_n_2(Nonce(rnd_n_Q), h1), plus(r_cv1, multp(h2, f)), Nonce(rnd_n_Q), 
        'pcr_data'>
   ),
   !Pk( 'Issuer', pkX, pkY )
   ]
  --[
  Eq( Pcr_Set(pcr_set), pcrset ),
  Eq( PointG1(H_p(F1(BSN(basename))), F2(BSN(basename))),
      PointG1(H_p(s_2_bar), y_2)
  ),
  Eq( verifyCre3(multp(sl, A), pkY, multp(sl, B), 'P2'), accept ),
  Eq( verifyCre4(multp(sl, A), multp(sl, D), pkX, multp(sl, C), 'P2'),
      accept
  ),
  Eq( H_n_2(Nonce(rnd_n_Q),
            H_k_2(H_k_9('pcr_data', multp(sl, A), multp(sl, B), multp(sl, C),
                        multp(sl, D), PointG1(H_p(F1(BSN(basename))), F2(BSN(basename))),
                        multp(f, PointG1(H_p(s_2_bar), y_2)),
                        calcL_J_quot(plus(r_cv1, multp(h2, f)), PointG1(H_p(s_2_bar), y_2),
                                     H_n_2(Nonce(rnd_n_Q), h1), multp(f, PointG1(H_p(s_2_bar), y_2))),
                        calcE_S_quot(plus(r_cv1, multp(h2, f)), multp(sl, B),
                                     H_n_2(Nonce(rnd_n_Q), h1), multp(sl, D))),
                  H_6(quotePCR(pcrset, pcrset_values)))),
      H_n_2(Nonce(rnd_n_Q), h1)
  ),
  VerifiedQuotedPCR( $V,
                     <Pcr_Set(pcr_set), BSN(basename), multp(sl, A), multp(sl, B), 
                      multp(sl, C), multp(sl, D), PointG1(H_p(s_2_bar), y_2), 
                      multp(f, PointG1(H_p(s_2_bar), y_2)), quotePCR(pcrset, pcrset_values), 
                      H_n_2(Nonce(rnd_n_Q), h1), plus(r_cv1, multp(h2, f)), Nonce(rnd_n_Q), 
                      'pcr_data'>
  ),
  VerifiedQuotedPCRDeAnonymised( BSN(basename),
                                 <Pcr_Set(pcr_set), BSN(basename), multp(sl, A), multp(sl, B), 
                                  multp(sl, C), multp(sl, D), PointG1(H_p(s_2_bar), y_2), 
                                  multp(f, PointG1(H_p(s_2_bar), y_2)), quotePCR(pcrset, pcrset_values), 
                                  H_n_2(Nonce(rnd_n_Q), h1), plus(r_cv1, multp(h2, f)), Nonce(rnd_n_Q), 
                                  'pcr_data'>,
                                 f
  ),
  QuotePCROnlyOnce( 'Verifier_Check_TPM_PCR_Quote' )
  ]->
   [
   !SignatureVerified( $V,
                       <Pcr_Set(pcr_set), BSN(basename), multp(sl, A), multp(sl, B), 
                        multp(sl, C), multp(sl, D), PointG1(H_p(s_2_bar), y_2), 
                        multp(f, PointG1(H_p(s_2_bar), y_2)), quotePCR(pcrset, pcrset_values), 
                        H_n_2(Nonce(rnd_n_Q), h1), plus(r_cv1, multp(h2, f)), Nonce(rnd_n_Q), 
                        'pcr_data'>
   )
   ]

  /*
  rule (modulo AC) Verifier_Check_TPM_PCR_Quote:
     [
     In( <Pcr_Set(pcr_set), BSN(basename), multp(sl, A), multp(sl, B), 
