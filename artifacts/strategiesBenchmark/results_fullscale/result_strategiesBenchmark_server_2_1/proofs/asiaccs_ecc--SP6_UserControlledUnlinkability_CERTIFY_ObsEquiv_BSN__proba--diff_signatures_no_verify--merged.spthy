                  <Qk_PD2, curlyA2, bsn2, R2, S2, T2, W2, J2, K2, h2_host2, small_s2, n_C2>
   ),
   CorrectSigma3( 'CorrectSigma3', L_J(r_cv1_3, J3), E_S(r_cv1_3, S3),
                  <Qk_PD3, curlyA3, bsn3, R3, S3, T3, W3, J3, K3, h2_host3, small_s3, n_C3>
   ),
   TPM_PublicKeys( TPM1_Keys, TPM2_Keys )
   ]
  --[ Diff_Sigs( ), OnlyOnce( 'Diff_DAA_Quote' ) ]->
   [
   Out( TPM1_Keys ), Out( TPM2_Keys ),
   Out( <'diffSigma', 
         <L_J(r_cv1_1, J1), E_S(r_cv1_1, S1), Qk_PD1, curlyA1, bsn1, R1, S1, T1, 
          W1, J1, K1, h2_host1, small_s1, n_C1>, 
         diff(<L_J(r_cv1_2, J2), E_S(r_cv1_2, S2), Qk_PD2, curlyA2, bsn2, R2, S2, 
               T2, W2, J2, K2, h2_host2, small_s2, n_C2>, <L_J(r_cv1_3, J3), 
