*/
simplify
solve( !Pk( I, PkX(x.1, 'P2'), PkY(y.1, 'P2') ) ▶₀ #t2 )
  case Issuer_Init
  solve( !Ltk( 'Issuer', ~x, ~y ) ▶₁ #t2 )
