                          multp(sl.201, D.191), pkX.197, multp(sl.201, C.190), 'P2')
       z.2   = calcE_S_cert(plus(r_cv1.199, multp(h2.195, f.192)),
                            multp(sl.201, multp(x.375, multp(x.373, x.374))), h2_host.196,
                            multp(sl.201, D.191))
    
    7. A     = multp(x.381, x.382)
       B     = multp(x.383, multp(x.381, x.382))
       C     = C.198
       D     = multp(multp(x.381, x.383), multp(f.200, x.382))
       f     = f.200
       h2    = H_n_2(x.388, H_k_2(x.389, H_6(certData(x.390, x.391))))
       h2_host
             = H_n_2(x.388, H_k_2(x.389, H_6(certData(x.390, x.391))))
       pkX   = pkX.205
       pkY   = PkY(x.383, 'P2')
       r_cv1 = r_cv1.207
       sl    = sl.209
       z     = accept
       z.1   = verifyCre4(multp(sl.209, multp(x.381, x.382)),
                          multp(sl.209, multp(multp(x.381, x.383), multp(f.200, x.382))), pkX.205,
                          multp(sl.209, C.198), 'P2')
       z.2   = E_S(r_cv1.207, multp(sl.209, multp(x.383, multp(x.381, x.382))))
    
