                                      solve( !KU( 'g'^~s ) @ #vk.31 )
                                        case channel_send
                                        solve( splitEqs(13) )
                                          case split_case_1
                                          solve( !KU( kdf2(<'IK', 'g'^~e0.1>) ) @ #vk.32 )
                                            case c_kdf2
                                            solve( !KU( 'g'^~e0.1 ) @ #vk.36 )
                                              case c_exp
                                              solve( !KU( ~e0.1 ) @ #vk.37 )
                                                case ephemeral_reveal
                                                SOLVED // trace found
                                              qed
                                            qed
                                          qed
                                        qed
                                      qed
                                    qed
                                  qed
                                qed
                              qed
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma Secrecy_IK_2_for_Responder_unless_dishonest_re_or_dishonest_rs_or_reveal_e_Before_or_reveal_s_Before_or_reveal_re_Before_or_reveal_rs_AnyTime_end:
  all-traces
  "∀ msg e me re peer #claim.
    (Secret_IK_2_Responder( e, me, re, peer, msg ) @ #claim) ⇒
    ((¬(∃ #attack. K( msg ) @ #attack)) ∨
     ((((((¬(∃ #honest. HonestEk( re ) @ #honest)) ∨
          (¬(∃ #honest. HonestPk( peer ) @ #honest))) ∨
         (∃ #reveal. (RevealEk( e ) @ #reveal) ∧ (#reveal < #claim))) ∨
        (∃ #reveal. (RevealLtk( me ) @ #reveal) ∧ (#reveal < #claim))) ∨
       (∃ #reveal. (RevealEk( re ) @ #reveal) ∧ (#reveal < #claim))) ∨
      (∃ #reveal. RevealLtk( peer ) @ #reveal)))"
/*
guarded formula characterizing all counter-examples:
"∃ msg e me re peer #claim.
  (Secret_IK_2_Responder( e, me, re, peer, msg ) @ #claim)
 ∧
  (∃ #attack. (K( msg ) @ #attack)) ∧
  (∃ #honest. (HonestEk( re ) @ #honest)) ∧
  (∃ #honest. (HonestPk( peer ) @ #honest)) ∧
  (∀ #reveal. (RevealEk( e ) @ #reveal) ⇒ ¬(#reveal < #claim)) ∧
  (∀ #reveal. (RevealLtk( me ) @ #reveal) ⇒ ¬(#reveal < #claim)) ∧
  (∀ #reveal. (RevealEk( re ) @ #reveal) ⇒ ¬(#reveal < #claim)) ∧
  (∀ #reveal. (RevealLtk( peer ) @ #reveal) ⇒ ⊥)"
*/
simplify
solve( HandshakeState_Responder_1( id, hash, ck, k, 'g'^~e, ~s, 'g'^~key
       ) ▶₀ #claim )
  case Handshake_Responder_Recv_1
  solve( Handshake_Snd_2( ~id, msg ) ▶₁ #claim )
    case Instrumentation_Responder_2
    solve( Ek( ~e0 ) ▶₂ #claim )
      case ephemeral_keygen
      solve( !KU( ~n ) @ #vk )
        case channel_send
        solve( !KU( kdf2(<
                          kdf1(<kdf1(<kdf1(<'IK', 'g'^(~e*~s)>), 'g'^(~key*~s)>), 'g'^(~e*~e0)>), 
                          'g'^(~e0*~key)>)
               ) @ #vk.7 )
          case c_kdf2
          solve( !KU( kdf1(<kdf1(<kdf1(<'IK', 'g'^(~e*~s)>), 'g'^(~key*~s)>), 
                            'g'^(~e*~e0)>)
                 ) @ #vk.10 )
            case c_kdf1
            solve( !KU( kdf1(<kdf1(<'IK', 'g'^(~e*~s)>), 'g'^(~key*~s)>) ) @ #vk.13 )
              case c_kdf1
              solve( !KU( kdf1(<'IK', 'g'^(~e*~s)>) ) @ #vk.16 )
                case c_kdf1
                solve( !KU( 'g'^(~e0*~key) ) @ #vk.14 )
                  case channel_send_case_1
                  solve( !KU( ~e0 ) @ #vk.22 )
                    case ephemeral_reveal
                    solve( splitEqs(11) )
                      case split_case_1
                      solve( !KU( kdf2(<'IK', 'g'^~e0.1>) ) @ #vk.22 )
                        case c_kdf2
                        solve( !KU( 'g'^(~e*~e0) ) @ #vk.18 )
                          case c_exp
                          solve( !KU( ~e ) @ #vk.29 )
                            case ephemeral_reveal
                            solve( !KU( 'g'^(~key*~s) ) @ #vk.21 )
                              case channel_send_case_2
                              solve( !KU( ~s ) @ #vk.30 )
                                case static_reveal
                                solve( !KU( 'g'^(~e*~s) ) @ #vk.26 )
                                  case c_exp
                                  solve( !KU( aead(kdf2(<'IK', 'g'^(~e*~s)>), '0',
                                                   h(<h(<h(<'IK', prologue>), 'g'^~s>), 'g'^~e>), 'g'^~key)
                                         ) @ #vk.21 )
                                    case channel_send
                                    solve( !KU( aead(kdf2(<kdf1(<'IK', 'g'^(~e*~s)>), 'g'^(~key*~s)>), '0',
                                                     h(<h(<h(<h(<'IK', prologue>), 'g'^~s>), 'g'^~e>), 
                                                        aead(kdf2(<'IK', 'g'^(~e*~s)>), '0',
                                                             h(<h(<h(<'IK', prologue>), 'g'^~s>), 'g'^~e>),
                                                             'g'^~key)
                                                       >),
                                                     payload)
                                           ) @ #vk.23 )
                                      case channel_send
                                      solve( !KU( 'g'^~e ) @ #vk.23 )
                                        case channel_send
                                        solve( !KU( 'g'^~e0.1 ) @ #vk.31 )
                                          case c_exp
                                          solve( !KU( ~e0.1 ) @ #vk.34 )
                                            case ephemeral_reveal
                                            solve( !KU( 'g'^~s ) @ #vk.34 )
                                              case channel_send
                                              solve( splitEqs(18) )
                                                case split_case_1
                                                solve( !KU( kdf2(<'IK', 'g'^~e0.2>) ) @ #vk.35 )
                                                  case c_kdf2
                                                  solve( !KU( 'g'^~e0.2 ) @ #vk.39 )
                                                    case c_exp
                                                    solve( !KU( ~e0.2 ) @ #vk.40 )
                                                      case ephemeral_reveal
                                                      SOLVED // trace found
                                                    qed
                                                  qed
                                                qed
                                              qed
                                            qed
                                          qed
                                        qed
                                      qed
                                    qed
                                  qed
                                qed
                              qed
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma Secrecy_IK_2_for_Responder_unless_dishonest_re_or_dishonest_rs_or_reveal_e_Before_or_reveal_s_Before_or_reveal_re_Before_or_reveal_rs_Before_end:
  all-traces
  "∀ msg e me re peer #claim.
    (Secret_IK_2_Responder( e, me, re, peer, msg ) @ #claim) ⇒
    ((¬(∃ #attack. K( msg ) @ #attack)) ∨
     ((((((¬(∃ #honest. HonestEk( re ) @ #honest)) ∨
          (¬(∃ #honest. HonestPk( peer ) @ #honest))) ∨
         (∃ #reveal. (RevealEk( e ) @ #reveal) ∧ (#reveal < #claim))) ∨
        (∃ #reveal. (RevealLtk( me ) @ #reveal) ∧ (#reveal < #claim))) ∨
       (∃ #reveal. (RevealEk( re ) @ #reveal) ∧ (#reveal < #claim))) ∨
      (∃ #reveal. (RevealLtk( peer ) @ #reveal) ∧ (#reveal < #claim))))"
/*
guarded formula characterizing all counter-examples:
"∃ msg e me re peer #claim.
  (Secret_IK_2_Responder( e, me, re, peer, msg ) @ #claim)
 ∧
  (∃ #attack. (K( msg ) @ #attack)) ∧
  (∃ #honest. (HonestEk( re ) @ #honest)) ∧
  (∃ #honest. (HonestPk( peer ) @ #honest)) ∧
  (∀ #reveal. (RevealEk( e ) @ #reveal) ⇒ ¬(#reveal < #claim)) ∧
  (∀ #reveal. (RevealLtk( me ) @ #reveal) ⇒ ¬(#reveal < #claim)) ∧
  (∀ #reveal. (RevealEk( re ) @ #reveal) ⇒ ¬(#reveal < #claim)) ∧
  (∀ #reveal. (RevealLtk( peer ) @ #reveal) ⇒ ¬(#reveal < #claim))"
*/
simplify
solve( HandshakeState_Responder_1( id, hash, ck, k, 'g'^~e, ~s, 'g'^~key
       ) ▶₀ #claim )
  case Handshake_Responder_Recv_1
  solve( Handshake_Snd_2( ~id, msg ) ▶₁ #claim )
    case Instrumentation_Responder_2
    solve( Ek( ~e0 ) ▶₂ #claim )
      case ephemeral_keygen
      solve( !KU( ~n ) @ #vk )
        case channel_send
        solve( !KU( kdf2(<
                          kdf1(<kdf1(<kdf1(<'IK', 'g'^(~e*~s)>), 'g'^(~key*~s)>), 'g'^(~e*~e0)>), 
                          'g'^(~e0*~key)>)
               ) @ #vk.7 )
          case c_kdf2
          solve( !KU( kdf1(<kdf1(<kdf1(<'IK', 'g'^(~e*~s)>), 'g'^(~key*~s)>), 
                            'g'^(~e*~e0)>)
                 ) @ #vk.10 )
            case c_kdf1
            solve( !KU( kdf1(<kdf1(<'IK', 'g'^(~e*~s)>), 'g'^(~key*~s)>) ) @ #vk.13 )
              case c_kdf1
              solve( !KU( kdf1(<'IK', 'g'^(~e*~s)>) ) @ #vk.16 )
                case c_kdf1
                solve( !KU( 'g'^(~e0*~key) ) @ #vk.14 )
                  case c_exp
                  solve( !KU( ~e0 ) @ #vk.23 )
                    case ephemeral_reveal
                    solve( !KU( ~key ) @ #vk.24 )
                      case static_reveal
                      solve( !KU( 'g'^(~e*~e0) ) @ #vk.19 )
                        case c_exp
                        solve( !KU( ~e ) @ #vk.26 )
                          case ephemeral_reveal
                          solve( !KU( 'g'^(~key*~s) ) @ #vk.22 )
                            case c_exp
                            solve( !KU( ~s ) @ #vk.28 )
                              case static_reveal
                              solve( !KU( 'g'^(~e*~s) ) @ #vk.27 )
                                case c_exp
                                solve( !KU( aead(kdf2(<'IK', 'g'^(~e*~s)>), '0',
                                                 h(<h(<h(<'IK', prologue>), 'g'^~s>), 'g'^~e>), 'g'^~key)
                                       ) @ #vk.23 )
                                  case channel_send
                                  solve( !KU( aead(kdf2(<kdf1(<'IK', 'g'^(~e*~s)>), 'g'^(~key*~s)>), '0',
                                                   h(<h(<h(<h(<'IK', prologue>), 'g'^~s>), 'g'^~e>), 
                                                      aead(kdf2(<'IK', 'g'^(~e*~s)>), '0',
                                                           h(<h(<h(<'IK', prologue>), 'g'^~s>), 'g'^~e>),
                                                           'g'^~key)
                                                     >),
                                                   payload)
                                         ) @ #vk.25 )
                                    case channel_send
                                    solve( !KU( 'g'^~e ) @ #vk.25 )
                                      case channel_send
                                      solve( !KU( 'g'^~s ) @ #vk.31 )
                                        case channel_send
                                        solve( splitEqs(13) )
                                          case split_case_1
                                          solve( !KU( kdf2(<'IK', 'g'^~e0.1>) ) @ #vk.32 )
                                            case c_kdf2
                                            solve( !KU( 'g'^~e0.1 ) @ #vk.36 )
                                              case c_exp
                                              solve( !KU( ~e0.1 ) @ #vk.37 )
                                                case ephemeral_reveal
                                                SOLVED // trace found
                                              qed
                                            qed
                                          qed
                                        qed
                                      qed
                                    qed
                                  qed
                                qed
                              qed
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
