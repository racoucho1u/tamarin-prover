                  case channel_send_case_2
                  solve( !KU( ~s ) @ #vk.26 )
                    case static_reveal
                    by contradiction /* from formulas */
                  qed
                next
                  case ephemeral_keygen
                  solve( !KU( ~s ) @ #vk.26 )
                    case static_reveal
                    by contradiction /* from formulas */
                  qed
                next
                  case static_keygen
                  solve( !KU( ~e.1 ) @ #vk.26 )
                    case ephemeral_reveal
                    solve( !KU( 'g'^(~e*~e.1) ) @ #vk.22 )
                      case c_exp
                      solve( !KU( ~e ) @ #vk.29 )
                        case ephemeral_reveal
                        solve( !KU( 'g'^(~key*~s) ) @ #vk.25 )
                          case c_exp
                          solve( !KU( ~key ) @ #vk.31 )
                            case static_reveal
                            by contradiction /* from formulas */
                          qed
                        next
                          case channel_send
                          solve( !KU( ~s ) @ #vk.31 )
                            case static_reveal
                            by contradiction /* from formulas */
                          qed
                        next
                          case static_keygen_case_1
                          solve( !KU( ~key ) @ #vk.30 )
                            case static_reveal
                            by contradiction /* from formulas */
                          qed
                        next
                          case static_keygen_case_2
                          solve( !KU( ~s ) @ #vk.30 )
                            case static_reveal
                            by contradiction /* from formulas */
                          qed
                        qed
                      qed
                    next
                      case channel_send_case_1
                      solve( !KU( 'g'^(~key*~s) ) @ #vk.23 )
                        case c_exp
                        solve( !KU( ~key ) @ #vk.29 )
                          case static_reveal
                          by contradiction /* from formulas */
                        qed
                      next
                        case channel_send
                        solve( !KU( ~s ) @ #vk.28 )
                          case static_reveal
                          by contradiction /* from formulas */
                        qed
                      next
                        case static_keygen_case_1
                        solve( !KU( ~key ) @ #vk.27 )
                          case static_reveal
                          by contradiction /* from formulas */
                        qed
                      next
                        case static_keygen_case_2
                        solve( !KU( ~s ) @ #vk.27 )
                          case static_reveal
                          by contradiction /* from formulas */
                        qed
                      qed
                    next
                      case channel_send_case_2
                      solve( !KU( ~e ) @ #vk.27 )
                        case ephemeral_reveal
                        solve( !KU( 'g'^(~key*~s) ) @ #vk.24 )
                          case c_exp
                          solve( !KU( ~key ) @ #vk.30 )
                            case static_reveal
                            by contradiction /* from formulas */
                          qed
                        next
                          case channel_send
                          solve( !KU( ~s ) @ #vk.29 )
                            case static_reveal
                            by contradiction /* from formulas */
                          qed
                        next
                          case static_keygen_case_1
                          solve( !KU( ~key ) @ #vk.28 )
                            case static_reveal
                            by contradiction /* from formulas */
                          qed
                        next
                          case static_keygen_case_2
                          solve( !KU( ~s ) @ #vk.28 )
                            case static_reveal
                            by contradiction /* from formulas */
                          qed
                        qed
                      qed
                    next
                      case ephemeral_keygen_case_1
                      solve( !KU( ~e ) @ #vk.27 )
                        case ephemeral_reveal
                        solve( !KU( 'g'^(~key*~s) ) @ #vk.24 )
                          case c_exp
                          solve( !KU( ~key ) @ #vk.30 )
                            case static_reveal
                            by contradiction /* from formulas */
                          qed
                        next
                          case channel_send
                          solve( !KU( ~s ) @ #vk.29 )
                            case static_reveal
                            by contradiction /* from formulas */
                          qed
                        next
                          case static_keygen_case_1
                          solve( !KU( ~key ) @ #vk.28 )
                            case static_reveal
                            by contradiction /* from formulas */
                          qed
                        next
                          case static_keygen_case_2
                          solve( !KU( ~s ) @ #vk.28 )
                            case static_reveal
                            by contradiction /* from formulas */
                          qed
                        qed
                      qed
                    next
                      case ephemeral_keygen_case_2
                      solve( !KU( 'g'^(~key*~s) ) @ #vk.23 )
                        case c_exp
                        solve( !KU( ~key ) @ #vk.29 )
                          case static_reveal
                          by contradiction /* from formulas */
                        qed
                      next
                        case channel_send
                        solve( !KU( ~s ) @ #vk.28 )
                          case static_reveal
                          by contradiction /* from formulas */
                        qed
                      next
                        case static_keygen_case_1
                        solve( !KU( ~key ) @ #vk.27 )
                          case static_reveal
                          by contradiction /* from formulas */
                        qed
                      next
                        case static_keygen_case_2
                        solve( !KU( ~s ) @ #vk.27 )
                          case static_reveal
                          by contradiction /* from formulas */
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
