        z     = 'g'^rs.420
        z.1   = 'g'^inv((~e.211*x.419))
        z.2   = 'g'^inv(x.419)
        z.3   = 'g'^inv(x.419)
    
    19. ~e    = ~e.211
        ~s    = ~e.211
        z     = 'g'^rs.420
        z.1   = 'g'^(x.419*inv(~e.211))
        z.2   = 'g'^x.419
        z.3   = 'g'^x.419
    
    20. ~e    = ~e.211
        ~s    = ~s.212
        z     = 'g'
        z.1   = 'g'^inv((~e.211*~s.212*x.420))
        z.2   = 'g'^inv((~s.212*x.420))
        z.3   = 'g'^inv((~e.211*x.420))
    
    21. ~e    = ~e.211
        ~s    = ~s.212
        z     = 'g'
        z.1   = 'g'^inv((~e.211*x.420))
        z.2   = 'g'^inv(x.420)
        z.3   = 'g'^(~s.212*inv((~e.211*x.420)))
    
    22. ~e    = ~e.211
        ~s    = ~s.212
        z     = 'g'
        z.1   = 'g'^(x.419*inv((~s.212*x.420)))
        z.2   = 'g'^(~e.211*x.419*inv((~s.212*x.420)))
        z.3   = 'g'^(x.419*inv(x.420))
    
    23. ~e    = ~e.211
        ~s    = ~s.212
        z     = 'g'
        z.1   = 'g'^(x.420*inv(~e.211))
        z.2   = 'g'^x.420
        z.3   = 'g'^(~s.212*x.420*inv(~e.211))
    
    24. ~e    = ~e.211
        ~s    = ~s.212
        z     = 'g'
        z.1   = 'g'^(x.420*inv((~e.211*~s.212)))
        z.2   = 'g'^(x.420*inv(~s.212))
        z.3   = 'g'^(x.420*inv(~e.211))
    
    25. ~e    = ~e.211
        ~s    = ~s.212
        z     = 'g'^rs.420
        z.1   = 'g'^inv((~s.212*x.419))
        z.2   = 'g'^(~e.211*inv((~s.212*x.419)))
        z.3   = 'g'^inv(x.419)
    
    26. ~e    = ~e.211
