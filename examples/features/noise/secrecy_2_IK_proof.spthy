lemma Secrecy_IK_2_for_Responder_unless_dishonest_re_or_dishonest_rs_or_reveal_s_AnyTime_or_reveal_re_AnyTime_or_reveal_rs_AnyTime_end:
  all-traces
  "∀ msg e me re peer #claim.
    (Secret_IK_2_Responder( e, me, re, peer, msg ) @ #claim) ⇒
    ((¬(∃ #attack. K( msg ) @ #attack)) ∨
     (((((¬(∃ #honest. HonestEk( re ) @ #honest)) ∨
         (¬(∃ #honest. HonestPk( peer ) @ #honest))) ∨
        (∃ #reveal. RevealLtk( me ) @ #reveal)) ∨
       (∃ #reveal. RevealEk( re ) @ #reveal)) ∨
      (∃ #reveal. RevealLtk( peer ) @ #reveal)))"
/*
guarded formula characterizing all counter-examples:
"∃ msg e me re peer #claim.
  (Secret_IK_2_Responder( e, me, re, peer, msg ) @ #claim)
 ∧
  (∃ #attack. (K( msg ) @ #attack)) ∧
  (∃ #honest. (HonestEk( re ) @ #honest)) ∧
  (∃ #honest. (HonestPk( peer ) @ #honest)) ∧
  (∀ #reveal. (RevealLtk( me ) @ #reveal) ⇒ ⊥) ∧
  (∀ #reveal. (RevealEk( re ) @ #reveal) ⇒ ⊥) ∧
  (∀ #reveal. (RevealLtk( peer ) @ #reveal) ⇒ ⊥)"
*/
simplify
solve( HandshakeState_Responder_1( id, hash, ck, k, 'g'^~e, ~s, 'g'^~key
       ) ▶₀ #claim )
  case Handshake_Responder_Recv_1
  solve( Handshake_Snd_2( ~id, msg ) ▶₁ #claim )
    case Instrumentation_Responder_2
    solve( Ek( ~e0 ) ▶₂ #claim )
      case ephemeral_keygen
      solve( !KU( ~n ) @ #vk )
        case channel_send
        solve( !KU( kdf2(<
                          kdf1(<kdf1(<kdf1(<'IK', 'g'^(~e*~s)>), 'g'^(~key*~s)>), 'g'^(~e*~e0)>), 
                          'g'^(~e0*~key)>)
               ) @ #vk.7 )
          case c_kdf2
          solve( !KU( kdf1(<kdf1(<kdf1(<'IK', 'g'^(~e*~s)>), 'g'^(~key*~s)>), 
                            'g'^(~e*~e0)>)
                 ) @ #vk.10 )
            case c_kdf1
            solve( !KU( kdf1(<kdf1(<'IK', 'g'^(~e*~s)>), 'g'^(~key*~s)>) ) @ #vk.13 )
              case c_kdf1
              solve( !KU( kdf1(<'IK', 'g'^(~e*~s)>) ) @ #vk.16 )
                case c_kdf1
                solve( !KU( 'g'^(~e0*~key) ) @ #vk.14 )
                  case c_exp
                  solve( !KU( ~e0 ) @ #vk.23 )
                    case ephemeral_reveal
                    solve( !KU( ~key ) @ #vk.24 )
                      case static_reveal
                      by contradiction /* from formulas */
                    qed
                  qed
                next
                  case channel_send_case_1
                  solve( !KU( ~e0 ) @ #vk.22 )
                    case ephemeral_reveal
                    solve( splitEqs(11) )
                      case split_case_1
                      solve( !KU( kdf2(<'IK', 'g'^~e0.1>) ) @ #vk.22 )
                        case c_kdf2
                        solve( !KU( 'g'^(~e*~e0) ) @ #vk.18 )
                          case c_exp
                          solve( !KU( ~e ) @ #vk.29 )
                            case ephemeral_reveal
                            by contradiction /* from formulas */
                          qed
                        next
                          case channel_send_case_1
                          solve( splitEqs(14) )
                            case split_case_1
                            solve( !KU( 'g'^(~key*~s) ) @ #vk.19 )
                              case c_exp
                              solve( !KU( ~key ) @ #vk.31 )
                                case static_reveal
                                by contradiction /* from formulas */
                              qed
