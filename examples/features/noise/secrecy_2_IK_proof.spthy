                                                     h(<h(<h(<'IK', prologue>), 'g'^~s>), re>), 'g'^~key)
                                               >),
                                             payload)
                                   ) @ #vk.17 )
                              case channel_send
                              solve( !KU( kdf1(<'IK', 'g'^(~e0*~s)>) ) @ #vk.21 )
                                case c_kdf1
                                solve( !KU( kdf2(<'IK', 'g'^(~e0*~s)>) ) @ #vk.29 )
                                  case c_kdf2
                                  solve( !KU( 'g'^(~e0*~e0.1) ) @ #vk.22 )
                                    case c_exp
