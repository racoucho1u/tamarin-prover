                       ) @ #vk.17 )
                  case c_kdf1
                  solve( !KU( kdf2(<'IK', 'g'^~e0>) ) @ #vk.18 )
                    case c_kdf2
                    solve( !KU( kdf1(<kdf1(<'IK', 'g'^(~e*~s)>), 'g'^(~s*~s.1)>) ) @ #vk.23 )
                      case c_kdf1
                      solve( !KU( kdf1(<'IK', 'g'^(~e*~s)>) ) @ #vk.29 )
