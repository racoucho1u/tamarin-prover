lemma Secrecy_IK_2_for_Initiator_unless_dishonest_rs_or_reveal_e_AnyTime_or_reveal_re_AnyTime_or_reveal_rs_AnyTime_end:
  all-traces
  "∀ msg e me re peer #claim.
    (Secret_IK_2_Initiator( e, me, re, peer, msg ) @ #claim) ⇒
    ((¬(∃ #attack. K( msg ) @ #attack)) ∨
     ((((¬(∃ #honest. HonestPk( peer ) @ #honest)) ∨
        (∃ #reveal. RevealEk( e ) @ #reveal)) ∨
       (∃ #reveal. RevealEk( re ) @ #reveal)) ∨
      (∃ #reveal. RevealLtk( peer ) @ #reveal)))"
/*
guarded formula characterizing all counter-examples:
"∃ msg e me re peer #claim.
  (Secret_IK_2_Initiator( e, me, re, peer, msg ) @ #claim)
 ∧
  (∃ #attack. (K( msg ) @ #attack)) ∧
  (∃ #honest. (HonestPk( peer ) @ #honest)) ∧
  (∀ #reveal. (RevealEk( e ) @ #reveal) ⇒ ⊥) ∧
  (∀ #reveal. (RevealEk( re ) @ #reveal) ⇒ ⊥) ∧
