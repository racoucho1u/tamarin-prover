                      case split_case_1
                      solve( !KU( kdf2(<'IK', 'g'^~e0>) ) @ #vk.27 )
                        case c_kdf2
                        solve( !KU( 'g'^(~e*~e.1) ) @ #vk.23 )
                          case channel_send_case_1
                          solve( !KU( 'g'^(~key*~s) ) @ #vk.24 )
                            case channel_send_case_1
                            solve( !KU( ~key ) @ #vk.33 )
                              case static_reveal
                              solve( !KU( 'g'^(~e*~key) ) @ #vk.29 )
                                case channel_send_case_1
                                solve( !KU( 'g'^~key ) @ #vk.20 )
