                                                        case c_exp
                                                        solve( !KU( ~e0 ) @ #vk.45 )
                                                          case ephemeral_reveal
                                                          solve( !KU( 'g'^~s.1 ) @ #vk.45 )
                                                            case static_keygen
                                                            SOLVED // trace found
                                                          qed
                                                        qed
                                                      qed
                                                    qed
                                                  qed
                                                qed
                                              qed
                                            qed
                                          qed
