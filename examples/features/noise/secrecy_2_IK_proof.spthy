              case c_kdf1
              solve( !KU( 'g'^(~e0*~key) ) @ #vk.12 )
                case channel_send_case_2
                solve( !KU( ~key ) @ #vk.18 )
                  case static_reveal
                  solve( !KU( 'g'^(~key*~s) ) @ #vk.18 )
                    case channel_send_case_2
                    solve( !KU( ~s ) @ #vk.20 )
                      case static_reveal
                      solve( splitEqs(16) )
                        case split_case_1
                        solve( !KU( kdf2(<'IK', 'g'^~e0.1>) ) @ #vk.20 )
                          case c_kdf2
                          solve( !KU( aead(kdf2(<'IK', z>), '0',
                                           h(<h(<h(<'IK', prologue>), 'g'^~s>), re>), 'g'^~key)
                                 ) @ #vk.15 )
                            case c_aead
