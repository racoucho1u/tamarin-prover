                                                 h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>), 'g'^~s)
                                       ) @ #vk.29 )
                                  case channel_send
                                  solve( !KU( 'g'^~key ) @ #vk.26 )
                                    case channel_send
                                    solve( splitEqs(8) )
                                      case split_case_1
