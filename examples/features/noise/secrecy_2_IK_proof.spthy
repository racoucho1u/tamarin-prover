                          case static_reveal
                          by contradiction /* from formulas */
                        qed
                      next
                        case channel_send_case_2
                        solve( !KU( ~s ) @ #vk.26 )
                          case static_reveal
                          by contradiction /* from formulas */
                        qed
                      next
                        case static_keygen
                        solve( !KU( ~key ) @ #vk.26 )
                          case static_reveal
                          by contradiction /* from formulas */
                        qed
                      qed
                    qed
                  next
                    case split_case_2
                    solve( !KU( 'g'^(~key*~s) ) @ #vk.18 )
                      case c_exp
                      solve( !KU( ~key ) @ #vk.25 )
                        case static_reveal
                        by contradiction /* from formulas */
                      qed
                    next
                      case channel_send_case_1
                      solve( !KU( ~key ) @ #vk.24 )
                        case static_reveal
                        by contradiction /* from formulas */
                      qed
                    next
                      case channel_send_case_2
                      solve( !KU( ~s ) @ #vk.23 )
                        case static_reveal
                        by contradiction /* from formulas */
                      qed
                    next
                      case static_keygen
                      solve( !KU( ~key ) @ #vk.23 )
                        case static_reveal
                        by contradiction /* from formulas */
                      qed
                    qed
                  qed
                qed
              next
                case channel_send_case_2
                solve( !KU( ~key ) @ #vk.18 )
                  case static_reveal
                  by contradiction /* from formulas */
                qed
              next
                case ephemeral_keygen
                solve( !KU( ~key ) @ #vk.18 )
                  case static_reveal
                  by contradiction /* from formulas */
                qed
              next
                case static_keygen
                solve( !KU( ~e0 ) @ #vk.18 )
                  case ephemeral_reveal
                  solve( !KU( 'g'^(~key*~s) ) @ #vk.18 )
                    case c_exp
                    solve( !KU( ~key ) @ #vk.21 )
                      case static_reveal
                      by contradiction /* from formulas */
                    qed
                  next
                    case channel_send
                    solve( !KU( ~key ) @ #vk.20 )
                      case static_reveal
                      by contradiction /* from formulas */
                    qed
                  next
                    case static_keygen_case_1
                    solve( !KU( ~key ) @ #vk.19 )
                      case static_reveal
                      by contradiction /* from formulas */
                    qed
                  next
                    case static_keygen_case_2
                    solve( !KU( ~s ) @ #vk.19 )
                      case static_reveal
                      by contradiction /* from formulas */
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
