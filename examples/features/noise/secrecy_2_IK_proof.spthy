  (∀ #reveal. (RevealEk( re ) @ #reveal) ⇒ ¬(#reveal < #claim)) ∧
  (∀ #reveal. (RevealLtk( peer ) @ #reveal) ⇒ ⊥)"
*/
simplify
solve( HandshakeState_Responder_1( id, hash, ck, k, 'g'^~e, ~s, peer
       ) ▶₀ #claim )
  case Handshake_Responder_Recv_1
  solve( Handshake_Snd_2( ~id, msg ) ▶₁ #claim )
    case Instrumentation_Responder_2
    solve( Ek( ~e0 ) ▶₂ #claim )
      case ephemeral_keygen
      solve( !KU( ~n ) @ #vk )
        case channel_send
        solve( !KU( kdf2(<
                          kdf1(<kdf1(<kdf1(<'IK', 'g'^(~e*~s)>), z>), 'g'^(~e*~e0)>), z.1>)
               ) @ #vk.7 )
          case c_kdf2
          solve( !KU( kdf1(<kdf1(<kdf1(<'IK', 'g'^(~e*~s)>), z>), 'g'^(~e*~e0)>)
                 ) @ #vk.10 )
            case c_kdf1
            solve( !KU( kdf1(<kdf1(<'IK', 'g'^(~e*~s)>), z>) ) @ #vk.13 )
              case c_kdf1
              solve( !KU( kdf1(<'IK', 'g'^(~e*~s)>) ) @ #vk.16 )
                case c_kdf1
                solve( !KU( 'g'^(~e*~e0) ) @ #vk.15 )
                  case channel_send_case_2
                  solve( !KU( ~e ) @ #vk.21 )
                    case ephemeral_reveal
                    solve( !KU( 'g'^(~e*~s) ) @ #vk.21 )
                      case channel_send_case_1
                      solve( !KU( ~s ) @ #vk.22 )
                        case static_reveal
                        solve( splitEqs(16) )
                          case split_case_1
                          solve( !KU( aead(kdf2(<'IK', 'g'^(~e*~s)>), '0',
                                           h(<h(<h(<'IK', prologue>), 'g'^~s>), 'g'^~e>), peer)
                                 ) @ #vk.16 )
                            case c_aead
                            solve( !KU( kdf2(<'IK', 'g'^(~e*~s)>) ) @ #vk.26 )
                              case c_kdf2
                              solve( !KU( aead(kdf2(<kdf1(<'IK', 'g'^(~e*~s)>), z>), '0',
                                               h(<h(<h(<h(<'IK', prologue>), 'g'^~s>), 'g'^~e>), 
                                                  aead(kdf2(<'IK', 'g'^(~e*~s)>), '0',
                                                       h(<h(<h(<'IK', prologue>), 'g'^~s>), 'g'^~e>), peer)
                                                 >),
                                               payload)
                                     ) @ #vk.18 )
                                case c_aead
                                solve( !KU( kdf2(<kdf1(<'IK', 'g'^(~e*~s)>), z>) ) @ #vk.29 )
                                  case c_kdf2
                                  solve( !KU( h(<h(<h(<'IK', prologue>), 'g'^~s>), 'g'^~e>) ) @ #vk.28 )
                                    case c_h
                                    solve( !KU( h(<h(<h(<h(<'IK', prologue>), 'g'^~s>), 'g'^~e>), 
                                                   aead(kdf2(<'IK', 'g'^(~e*~s)>), '0',
                                                        h(<h(<h(<'IK', prologue>), 'g'^~s>), 'g'^~e>), peer)
                                                  >)
                                           ) @ #vk.31 )
                                      case c_h
                                      solve( !KU( h(<h(<'IK', prologue>), 'g'^~s>) ) @ #vk.34 )
                                        case c_h
                                        solve( splitEqs(0) )
                                          case split_case_1
                                          solve( !KU( h(<'IK', prologue>) ) @ #vk.35 )
                                            case c_h
                                            solve( !KU( 'g'^~e ) @ #vk.25 )
                                              case channel_send
                                              solve( !KU( 'g'^~s ) @ #vk.31 )
                                                case c_exp
                                                solve( !KU( 'g'^~e0 ) @ #vk.25 )
                                                  case channel_send
                                                  SOLVED // trace found
                                                qed
                                              qed
                                            qed
                                          qed
                                        qed
                                      qed
                                    qed
                                  qed
                                qed
                              qed
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

