                                  case c_exp
                                  solve( !KU( ~s ) @ #vk.32 )
                                    case static_reveal
                                    by contradiction /* from formulas */
                                  qed
                                next
                                  case channel_send
                                  solve( !KU( ~s ) @ #vk.31 )
                                    case static_reveal
                                    by contradiction /* from formulas */
                                  qed
                                next
                                  case static_keygen
                                  solve( !KU( ~s.1 ) @ #vk.31 )
                                    case static_reveal
                                    by contradiction /* from formulas */
                                  qed
                                qed
                              qed
                            next
