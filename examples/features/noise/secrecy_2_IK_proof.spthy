lemma Secrecy_IK_2_for_Initiator_unless_dishonest_re_or_dishonest_rs_or_reveal_s_Before_or_reveal_re_AnyTime_end:
  all-traces
  "∀ msg e me re peer #claim.
    (Secret_IK_2_Initiator( e, me, re, peer, msg ) @ #claim) ⇒
