        z.2   = 'g'^(x.421*inv(~s.213))
        z.3   = 'g'^(x.421*inv(~e.212))
    
    35. ~e    = ~e.213
        ~s    = ~s.214
        z     = 'g'^rs.424
        z.1   = 'g'^(x.422*inv((~e.213*~s.214*x.423)))
        z.2   = 'g'^(x.422*inv((~s.214*x.423)))
        z.3   = 'g'^(x.422*inv((~e.213*x.423)))
    
    36. ~e    = ~e.213
        ~s    = ~s.214
        z     = 'g'^rs.424
        z.1   = 'g'^(x.422*inv((~e.213*x.423)))
        z.2   = 'g'^(x.422*inv(x.423))
        z.3   = 'g'^(~s.214*x.422*inv((~e.213*x.423)))
  */

rule (modulo E) Initiator_to_transport_mode:
   [ HandshakeState_Initiator_2( id, hash, ck, k, ~e, 'g'^re, ~s, 'g'^rs ) ]
  -->
   [ !Transport_Initiator( id, kdf1(ck), kdf2(ck) ), !SessionId( id, hash )
   ]

  /*
  rule (modulo AC) Initiator_to_transport_mode:
     [ HandshakeState_Initiator_2( id, hash, ck, k, ~e, z, ~s, z.1 ) ]
    -->
     [ !Transport_Initiator( id, kdf1(ck), kdf2(ck) ), !SessionId( id, hash )
     ]
    variants (modulo AC)
    1. z     = 'g'
       z.1   = 'g'
    
    2. z     = 'g'
       z.1   = 'g'^rs.11
    
    3. z     = 'g'^re.11
       z.1   = 'g'
    
    4. z     = 'g'^re.11
       z.1   = 'g'^rs.11
  */

rule (modulo E) Init_Handshake_Responder:
   [ Init_Handshake_Responder( id, prologue, ~s ) ]
  -->
   [
   HandshakeState_Responder_0( id, h(<h(<'IK', prologue>), 'g'^~s>), 'IK',
                               ~s
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Handshake_Responder_Recv_1:
   [
   HandshakeState_Responder_0( id, hash, ck, ~s ),
   Recv( <'g'^re0, 
          aead(kdf2(<ck, 'g'^re0^~s>), '0', h(<hash, 'g'^re0>), 'g'^rs4), 
          aead(kdf2(<kdf1(<ck, 'g'^re0^~s>), 'g'^rs4^~s>), '0',
               h(<h(<hash, 'g'^re0>), 
                  aead(kdf2(<ck, 'g'^re0^~s>), '0', h(<hash, 'g'^re0>), 'g'^rs4)>),
               payload)
         >
   )
   ]
  --[
  RawRecv( 'Initiator1',
           <'g'^re0, 
            aead(kdf2(<ck, 'g'^re0^~s>), '0', h(<hash, 'g'^re0>), 'g'^rs4), 
            aead(kdf2(<kdf1(<ck, 'g'^re0^~s>), 'g'^rs4^~s>), '0',
                 h(<h(<hash, 'g'^re0>), 
                    aead(kdf2(<ck, 'g'^re0^~s>), '0', h(<hash, 'g'^re0>), 'g'^rs4)>),
                 payload)
           >
  )
  ]->
   [
   PeerEk_Responder( id, 'g'^re0 ), PeerLtk_Responder( id, 'g'^rs4 ),
   HandshakeState_Responder_1( id,
                               h(<
                                  h(<h(<hash, 'g'^re0>), 
                                     aead(kdf2(<ck, 'g'^re0^~s>), '0', h(<hash, 'g'^re0>), 'g'^rs4)>), 
                                  aead(kdf2(<kdf1(<ck, 'g'^re0^~s>), 'g'^rs4^~s>), '0',
                                       h(<h(<hash, 'g'^re0>), 
                                          aead(kdf2(<ck, 'g'^re0^~s>), '0', h(<hash, 'g'^re0>), 'g'^rs4)>),
                                       payload)
                                 >),
                               kdf1(<kdf1(<ck, 'g'^re0^~s>), 'g'^rs4^~s>),
                               kdf2(<kdf1(<ck, 'g'^re0^~s>), 'g'^rs4^~s>), 'g'^re0, ~s, 'g'^rs4
   ),
   Handshake_Recv_1( id, payload )
   ]

  /*
  rule (modulo AC) Handshake_Responder_Recv_1:
     [
     HandshakeState_Responder_0( id, hash, ck, ~s ),
     Recv( <z, aead(kdf2(<ck, z.1>), '0', h(<hash, z>), z.2), 
            aead(kdf2(<kdf1(<ck, z.1>), z.3>), '0',
                 h(<h(<hash, z>), aead(kdf2(<ck, z.1>), '0', h(<hash, z>), z.2)>),
                 payload)
           >
     )
     ]
    --[
    RawRecv( 'Initiator1',
             <z, aead(kdf2(<ck, z.1>), '0', h(<hash, z>), z.2), 
              aead(kdf2(<kdf1(<ck, z.1>), z.3>), '0',
                   h(<h(<hash, z>), aead(kdf2(<ck, z.1>), '0', h(<hash, z>), z.2)>),
                   payload)
             >
    )
    ]->
     [
     PeerEk_Responder( id, z ), PeerLtk_Responder( id, z.2 ),
     HandshakeState_Responder_1( id,
                                 h(<h(<h(<hash, z>), aead(kdf2(<ck, z.1>), '0', h(<hash, z>), z.2)>), 
                                    aead(kdf2(<kdf1(<ck, z.1>), z.3>), '0',
                                         h(<h(<hash, z>), aead(kdf2(<ck, z.1>), '0', h(<hash, z>), z.2)>),
                                         payload)
                                   >),
                                 kdf1(<kdf1(<ck, z.1>), z.3>), kdf2(<kdf1(<ck, z.1>), z.3>), z, ~s, z.2
     ),
     Handshake_Recv_1( id, payload )
     ]
    variants (modulo AC)
     1. ~s    = ~s.14
        z     = 'g'
        z.1   = 'g'^~s.14
        z.2   = 'g'
        z.3   = 'g'^~s.14
    
     2. ~s    = ~s.14
        z     = 'g'
        z.1   = 'g'^~s.14
        z.2   = 'g'^inv(~s.14)
        z.3   = 'g'
    
     3. ~s    = ~s.14
        z     = 'g'^inv(~s.14)
        z.1   = 'g'
        z.2   = 'g'
        z.3   = 'g'^~s.14
    
     4. ~s    = ~s.14
        z     = 'g'^inv(~s.14)
        z.1   = 'g'
        z.2   = 'g'^inv(~s.14)
        z.3   = 'g'
    
     5. ~s    = ~s.27
        z     = 'g'
        z.1   = 'g'^~s.27
        z.2   = 'g'^rs4.52
        z.3   = 'g'^(~s.27*rs4.52)
    
     6. ~s    = ~s.27
        z     = 'g'^re0.52
        z.1   = 'g'^(~s.27*re0.52)
        z.2   = 'g'
        z.3   = 'g'^~s.27
    
     7. ~s    = ~s.27
        z     = 'g'^re0.52
        z.1   = 'g'^(~s.27*re0.52)
        z.2   = 'g'^rs4.52
        z.3   = 'g'^(~s.27*rs4.52)
    
     8. ~s    = ~s.28
        z     = 'g'^re0.54
        z.1   = 'g'^(~s.28*re0.54)
        z.2   = 'g'^inv(~s.28)
        z.3   = 'g'
    
     9. ~s    = ~s.28
        z     = 'g'^inv(~s.28)
        z.1   = 'g'
        z.2   = 'g'^rs4.54
        z.3   = 'g'^(~s.28*rs4.54)
    
    10. ~s    = ~s.32
        z     = 'g'
        z.1   = 'g'^~s.32
        z.2   = 'g'^inv((~s.32*x.62))
        z.3   = 'g'^inv(x.62)
    
    11. ~s    = ~s.32
        z     = 'g'
        z.1   = 'g'^~s.32
        z.2   = 'g'^(x.62*inv(~s.32))
        z.3   = 'g'^x.62
    
    12. ~s    = ~s.32
        z     = 'g'^inv(~s.32)
        z.1   = 'g'
        z.2   = 'g'^inv((~s.32*x.62))
        z.3   = 'g'^inv(x.62)
    
    13. ~s    = ~s.32
        z     = 'g'^inv(~s.32)
        z.1   = 'g'
        z.2   = 'g'^(x.62*inv(~s.32))
        z.3   = 'g'^x.62
    
    14. ~s    = ~s.32
        z     = 'g'^inv((~s.32*x.62))
        z.1   = 'g'^inv(x.62)
        z.2   = 'g'
        z.3   = 'g'^~s.32
    
    15. ~s    = ~s.32
        z     = 'g'^inv((~s.32*x.62))
        z.1   = 'g'^inv(x.62)
        z.2   = 'g'^inv(~s.32)
        z.3   = 'g'
    
    16. ~s    = ~s.32
        z     = 'g'^(x.62*inv(~s.32))
        z.1   = 'g'^x.62
        z.2   = 'g'
        z.3   = 'g'^~s.32
    
    17. ~s    = ~s.32
        z     = 'g'^(x.62*inv(~s.32))
        z.1   = 'g'^x.62
        z.2   = 'g'^inv(~s.32)
        z.3   = 'g'
    
    18. ~s    = ~s.33
        z     = 'g'
        z.1   = 'g'^~s.33
        z.2   = 'g'^(x.63*inv((~s.33*x.64)))
        z.3   = 'g'^(x.63*inv(x.64))
    
    19. ~s    = ~s.33
        z     = 'g'^inv(~s.33)
        z.1   = 'g'
        z.2   = 'g'^(x.63*inv((~s.33*x.64)))
        z.3   = 'g'^(x.63*inv(x.64))
    
    20. ~s    = ~s.33
        z     = 'g'^inv((~s.33*x.63))
        z.1   = 'g'^inv(x.63)
        z.2   = 'g'^rs4.64
        z.3   = 'g'^(~s.33*rs4.64)
    
    21. ~s    = ~s.33
        z     = 'g'^inv((~s.33*x.63))
        z.1   = 'g'^inv(x.63)
        z.2   = 'g'^inv((~s.33*x.64))
        z.3   = 'g'^inv(x.64)
    
    22. ~s    = ~s.33
        z     = 'g'^inv((~s.33*x.63))
        z.1   = 'g'^inv(x.63)
        z.2   = 'g'^(x.64*inv(~s.33))
        z.3   = 'g'^x.64
    
    23. ~s    = ~s.33
        z     = 'g'^(x.63*inv(~s.33))
        z.1   = 'g'^x.63
        z.2   = 'g'^rs4.64
        z.3   = 'g'^(~s.33*rs4.64)
    
    24. ~s    = ~s.33
        z     = 'g'^(x.63*inv(~s.33))
        z.1   = 'g'^x.63
        z.2   = 'g'^inv((~s.33*x.64))
        z.3   = 'g'^inv(x.64)
    
    25. ~s    = ~s.33
        z     = 'g'^(x.63*inv(~s.33))
        z.1   = 'g'^x.63
        z.2   = 'g'^(x.64*inv(~s.33))
        z.3   = 'g'^x.64
    
    26. ~s    = ~s.33
        z     = 'g'^(x.63*inv((~s.33*x.64)))
        z.1   = 'g'^(x.63*inv(x.64))
        z.2   = 'g'
        z.3   = 'g'^~s.33
    
    27. ~s    = ~s.33
        z     = 'g'^(x.63*inv((~s.33*x.64)))
        z.1   = 'g'^(x.63*inv(x.64))
        z.2   = 'g'^inv(~s.33)
        z.3   = 'g'
    
    28. ~s    = ~s.34
        z     = 'g'^re0.66
        z.1   = 'g'^(~s.34*re0.66)
        z.2   = 'g'^inv((~s.34*x.65))
        z.3   = 'g'^inv(x.65)
    
    29. ~s    = ~s.34
        z     = 'g'^re0.66
        z.1   = 'g'^(~s.34*re0.66)
        z.2   = 'g'^(x.65*inv(~s.34))
        z.3   = 'g'^x.65
    
    30. ~s    = ~s.34
        z     = 'g'^inv((~s.34*x.64))
        z.1   = 'g'^inv(x.64)
        z.2   = 'g'^(x.65*inv((~s.34*x.66)))
        z.3   = 'g'^(x.65*inv(x.66))
    
    31. ~s    = ~s.34
        z     = 'g'^(x.64*inv(~s.34))
        z.1   = 'g'^x.64
        z.2   = 'g'^(x.65*inv((~s.34*x.66)))
        z.3   = 'g'^(x.65*inv(x.66))
    
    32. ~s    = ~s.34
        z     = 'g'^(x.64*inv((~s.34*x.65)))
        z.1   = 'g'^(x.64*inv(x.65))
        z.2   = 'g'^rs4.66
        z.3   = 'g'^(~s.34*rs4.66)
    
    33. ~s    = ~s.34
        z     = 'g'^(x.64*inv((~s.34*x.65)))
        z.1   = 'g'^(x.64*inv(x.65))
        z.2   = 'g'^inv((~s.34*x.66))
        z.3   = 'g'^inv(x.66)
    
    34. ~s    = ~s.34
        z     = 'g'^(x.64*inv((~s.34*x.65)))
        z.1   = 'g'^(x.64*inv(x.65))
        z.2   = 'g'^(x.66*inv(~s.34))
        z.3   = 'g'^x.66
    
    35. ~s    = ~s.35
        z     = 'g'^re0.68
        z.1   = 'g'^(~s.35*re0.68)
        z.2   = 'g'^(x.66*inv((~s.35*x.67)))
        z.3   = 'g'^(x.66*inv(x.67))
    
    36. ~s    = ~s.35
        z     = 'g'^(x.65*inv((~s.35*x.66)))
        z.1   = 'g'^(x.65*inv(x.66))
        z.2   = 'g'^(x.67*inv((~s.35*x.68)))
        z.3   = 'g'^(x.67*inv(x.68))
  */

rule (modulo E) Handshake_Responder_Snd_2:
   [
   HandshakeState_Responder_1( id, hash, ck, k, 'g'^re, ~s, 'g'^rs ),
   Handshake_Snd_2( id, payload ), Ek( ~e0 )
   ]
  --[
  Secret_IK_2_Responder( 'g'^~e0, 'g'^~s, 'g'^re, 'g'^rs, payload ),
  RawSnd( 'Responder2',
          <'g'^~e0, 
           aead(kdf2(<kdf1(<ck, 'g'^re^~e0>), 'g'^rs^~e0>), '0', h(<hash, 'g'^~e0>),
                payload)
          >
  )
  ]->
   [
   MyEk_Responder( id, 'g'^~e0 ),
   HandshakeState_Responder_2( id,
                               h(<h(<hash, 'g'^~e0>), 
                                  aead(kdf2(<kdf1(<ck, 'g'^re^~e0>), 'g'^rs^~e0>), '0', h(<hash, 'g'^~e0>),
                                       payload)
                                 >),
                               kdf1(<kdf1(<ck, 'g'^re^~e0>), 'g'^rs^~e0>),
                               kdf2(<kdf1(<ck, 'g'^re^~e0>), 'g'^rs^~e0>), ~e0, 'g'^re, ~s, 'g'^rs
   ),
   Send( <'g'^~e0, 
          aead(kdf2(<kdf1(<ck, 'g'^re^~e0>), 'g'^rs^~e0>), '0', h(<hash, 'g'^~e0>),
               payload)
         >
   )
   ]

  /*
  rule (modulo AC) Handshake_Responder_Snd_2:
     [
     HandshakeState_Responder_1( id, hash, ck, k, z, ~s, z.1 ),
     Handshake_Snd_2( id, payload ), Ek( ~e0 )
     ]
    --[
    Secret_IK_2_Responder( 'g'^~e0, 'g'^~s, z, z.1, payload ),
    RawSnd( 'Responder2',
            <'g'^~e0, 
             aead(kdf2(<kdf1(<ck, z.2>), z.3>), '0', h(<hash, 'g'^~e0>), payload)>
    )
    ]->
     [
     MyEk_Responder( id, 'g'^~e0 ),
     HandshakeState_Responder_2( id,
                                 h(<h(<hash, 'g'^~e0>), 
                                    aead(kdf2(<kdf1(<ck, z.2>), z.3>), '0', h(<hash, 'g'^~e0>), payload)>),
                                 kdf1(<kdf1(<ck, z.2>), z.3>), kdf2(<kdf1(<ck, z.2>), z.3>), ~e0, z, ~s,
                                 z.1
     ),
     Send( <'g'^~e0, 
            aead(kdf2(<kdf1(<ck, z.2>), z.3>), '0', h(<hash, 'g'^~e0>), payload)>
     )
     ]
    variants (modulo AC)
     1. ~e0   = ~e0.16
        z     = 'g'
        z.1   = 'g'
        z.2   = 'g'^~e0.16
        z.3   = 'g'^~e0.16
    
     2. ~e0   = ~e0.16
        z     = 'g'
        z.1   = 'g'^inv(~e0.16)
        z.2   = 'g'^~e0.16
        z.3   = 'g'
    
     3. ~e0   = ~e0.16
        z     = 'g'^inv(~e0.16)
        z.1   = 'g'
        z.2   = 'g'
        z.3   = 'g'^~e0.16
    
     4. ~e0   = ~e0.16
        z     = 'g'^inv(~e0.16)
        z.1   = 'g'^inv(~e0.16)
        z.2   = 'g'
        z.3   = 'g'
    
     5. ~e0   = ~e0.205
        z     = 'g'
        z.1   = 'g'^rs.408
        z.2   = 'g'^~e0.205
        z.3   = 'g'^(~e0.205*rs.408)
    
     6. ~e0   = ~e0.205
        z     = 'g'^re.408
        z.1   = 'g'
        z.2   = 'g'^(~e0.205*re.408)
        z.3   = 'g'^~e0.205
    
     7. ~e0   = ~e0.205
        z     = 'g'^re.408
        z.1   = 'g'^rs.408
        z.2   = 'g'^(~e0.205*re.408)
        z.3   = 'g'^(~e0.205*rs.408)
    
     8. ~e0   = ~e0.206
        z     = 'g'^re.410
        z.1   = 'g'^inv(~e0.206)
        z.2   = 'g'^(~e0.206*re.410)
        z.3   = 'g'
    
     9. ~e0   = ~e0.206
        z     = 'g'^inv(~e0.206)
        z.1   = 'g'^rs.410
        z.2   = 'g'
        z.3   = 'g'^(~e0.206*rs.410)
    
    10. ~e0   = ~e0.212
        z     = 'g'
        z.1   = 'g'^inv((~e0.212*x.422))
        z.2   = 'g'^~e0.212
        z.3   = 'g'^inv(x.422)
    
    11. ~e0   = ~e0.212
        z     = 'g'
        z.1   = 'g'^(x.422*inv(~e0.212))
        z.2   = 'g'^~e0.212
        z.3   = 'g'^x.422
    
    12. ~e0   = ~e0.212
        z     = 'g'^inv(~e0.212)
        z.1   = 'g'^inv((~e0.212*x.422))
        z.2   = 'g'
        z.3   = 'g'^inv(x.422)
    
    13. ~e0   = ~e0.212
        z     = 'g'^inv(~e0.212)
        z.1   = 'g'^(x.422*inv(~e0.212))
        z.2   = 'g'
        z.3   = 'g'^x.422
    
    14. ~e0   = ~e0.212
        z     = 'g'^inv((~e0.212*x.422))
        z.1   = 'g'
        z.2   = 'g'^inv(x.422)
        z.3   = 'g'^~e0.212
    
    15. ~e0   = ~e0.212
        z     = 'g'^inv((~e0.212*x.422))
        z.1   = 'g'^inv(~e0.212)
        z.2   = 'g'^inv(x.422)
        z.3   = 'g'
    
    16. ~e0   = ~e0.212
        z     = 'g'^(x.422*inv(~e0.212))
        z.1   = 'g'
        z.2   = 'g'^x.422
        z.3   = 'g'^~e0.212
    
    17. ~e0   = ~e0.212
