              qed
            next
              case channel_send_case_3
              solve( !KU( ~s ) @ #vk.16 )
                case static_reveal
                by contradiction /* from formulas */
              qed
            next
              case ephemeral_keygen
              solve( !KU( ~s ) @ #vk.16 )
                case static_reveal
                by contradiction /* from formulas */
              qed
            next
              case static_keygen
              solve( !KU( ~e.1 ) @ #vk.16 )
                case ephemeral_reveal
                by contradiction /* from formulas */
              qed
            qed
          qed
        qed
      next
        case channel_send
        solve( !KU( ~n ) @ #vk.1 )
          case channel_send
          solve( !KU( kdf2(<
                            kdf1(<kdf1(<kdf1(<'IK', 'g'^(~e*~s)>), 'g'^(~s*~s.1)>), 'g'^(~e*~e.1)>), 
