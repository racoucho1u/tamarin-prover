                  case channel_send_case_1
                  solve( !KU( ~e.1 ) @ #vk.27 )
                    case ephemeral_reveal
                    solve( splitEqs(8) )
                      case split_case_1
                      solve( !KU( kdf2(<'IK', 'g'^~e0>) ) @ #vk.27 )
                        case c_kdf2
                        solve( !KU( 'g'^(~e*~e.1) ) @ #vk.23 )
                          case c_exp
