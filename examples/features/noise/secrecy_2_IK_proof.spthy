lemma Secrecy_IK_2_for_Responder_unless_dishonest_rs_or_reveal_e_Before_or_reveal_s_AnyTime_or_reveal_rs_AnyTime_end:
  all-traces
  "∀ msg e me re peer #claim.
    (Secret_IK_2_Responder( e, me, re, peer, msg ) @ #claim) ⇒
    ((¬(∃ #attack. K( msg ) @ #attack)) ∨
     ((((¬(∃ #honest. HonestPk( peer ) @ #honest)) ∨
        (∃ #reveal. (RevealEk( e ) @ #reveal) ∧ (#reveal < #claim))) ∨
       (∃ #reveal. RevealLtk( me ) @ #reveal)) ∨
      (∃ #reveal. RevealLtk( peer ) @ #reveal)))"
/*
guarded formula characterizing all counter-examples:
"∃ msg e me re peer #claim.
  (Secret_IK_2_Responder( e, me, re, peer, msg ) @ #claim)
 ∧
  (∃ #attack. (K( msg ) @ #attack)) ∧
  (∃ #honest. (HonestPk( peer ) @ #honest)) ∧
  (∀ #reveal. (RevealEk( e ) @ #reveal) ⇒ ¬(#reveal < #claim)) ∧
  (∀ #reveal. (RevealLtk( me ) @ #reveal) ⇒ ⊥) ∧
  (∀ #reveal. (RevealLtk( peer ) @ #reveal) ⇒ ⊥)"
*/
simplify
solve( HandshakeState_Responder_1( id, hash, ck, k, re, ~s, 'g'^~key
       ) ▶₀ #claim )
  case Handshake_Responder_Recv_1
  solve( Handshake_Snd_2( ~id, msg ) ▶₁ #claim )
    case Instrumentation_Responder_2
    solve( Ek( ~e0 ) ▶₂ #claim )
      case ephemeral_keygen
      solve( !KU( ~n ) @ #vk )
        case channel_send
        solve( !KU( kdf2(<kdf1(<kdf1(<kdf1(<'IK', z>), 'g'^(~key*~s)>), z.1>), 
                          'g'^(~e0*~key)>)
               ) @ #vk.7 )
          case c_kdf2
          solve( !KU( kdf1(<kdf1(<kdf1(<'IK', z>), 'g'^(~key*~s)>), z.1>)
                 ) @ #vk.10 )
            case c_kdf1
            solve( !KU( kdf1(<kdf1(<'IK', z>), 'g'^(~key*~s)>) ) @ #vk.13 )
              case c_kdf1
              solve( !KU( 'g'^(~e0*~key) ) @ #vk.12 )
                case c_exp
                solve( !KU( ~e0 ) @ #vk.20 )
                  case ephemeral_reveal
                  solve( !KU( ~key ) @ #vk.21 )
                    case static_reveal
                    by contradiction /* from formulas */
                  qed
                qed
              next
                case channel_send_case_1
                solve( !KU( ~e0 ) @ #vk.19 )
                  case ephemeral_reveal
                  solve( splitEqs(11) )
                    case split_case_1
                    solve( !KU( kdf2(<'IK', 'g'^~e0.1>) ) @ #vk.19 )
                      case c_kdf2
                      solve( !KU( 'g'^(~key*~s) ) @ #vk.19 )
                        case c_exp
                        solve( !KU( ~key ) @ #vk.27 )
                          case static_reveal
                          by contradiction /* from formulas */
                        qed
                      next
                        case channel_send_case_1
                        solve( !KU( ~key ) @ #vk.27 )
                          case static_reveal
                          by contradiction /* from formulas */
                        qed
                      next
                        case channel_send_case_2
                        solve( !KU( ~s ) @ #vk.26 )
                          case static_reveal
                          by contradiction /* from formulas */
                        qed
                      next
                        case static_keygen
                        solve( !KU( ~key ) @ #vk.26 )
                          case static_reveal
                          by contradiction /* from formulas */
                        qed
                      qed
                    qed
                  next
                    case split_case_2
                    solve( !KU( 'g'^(~key*~s) ) @ #vk.18 )
                      case c_exp
                      solve( !KU( ~key ) @ #vk.25 )
                        case static_reveal
                        by contradiction /* from formulas */
                      qed
                    next
                      case channel_send_case_1
                      solve( !KU( ~key ) @ #vk.24 )
                        case static_reveal
                        by contradiction /* from formulas */
                      qed
                    next
                      case channel_send_case_2
                      solve( !KU( ~s ) @ #vk.23 )
                        case static_reveal
                        by contradiction /* from formulas */
                      qed
                    next
                      case static_keygen
                      solve( !KU( ~key ) @ #vk.23 )
                        case static_reveal
                        by contradiction /* from formulas */
                      qed
                    qed
                  qed
                qed
              next
                case channel_send_case_2
                solve( !KU( ~key ) @ #vk.18 )
                  case static_reveal
                  by contradiction /* from formulas */
                qed
              next
                case ephemeral_keygen
                solve( !KU( ~key ) @ #vk.18 )
                  case static_reveal
                  by contradiction /* from formulas */
                qed
              next
                case static_keygen
                solve( !KU( ~e0 ) @ #vk.18 )
                  case ephemeral_reveal
                  solve( !KU( 'g'^(~key*~s) ) @ #vk.18 )
                    case c_exp
                    solve( !KU( ~key ) @ #vk.21 )
                      case static_reveal
                      by contradiction /* from formulas */
                    qed
                  next
                    case channel_send
                    solve( !KU( ~key ) @ #vk.20 )
                      case static_reveal
                      by contradiction /* from formulas */
                    qed
                  next
                    case static_keygen_case_1
                    solve( !KU( ~key ) @ #vk.19 )
                      case static_reveal
                      by contradiction /* from formulas */
                    qed
                  next
                    case static_keygen_case_2
                    solve( !KU( ~s ) @ #vk.19 )
                      case static_reveal
                      by contradiction /* from formulas */
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

