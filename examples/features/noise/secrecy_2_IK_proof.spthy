                  case channel_send_case_1
                  solve( !KU( ~e0 ) @ #vk.27 )
                    case ephemeral_reveal
                    solve( splitEqs(7) )
                      case split_case_1
                      solve( !KU( kdf2(<'IK', 'g'^~e0.1>) ) @ #vk.27 )
                        case c_kdf2
                        solve( !KU( 'g'^(~e*~e0) ) @ #vk.23 )
                          case c_exp
                          solve( !KU( ~e ) @ #vk.34 )
                            case ephemeral_reveal
                            solve( !KU( 'g'^(~key*~s) ) @ #vk.26 )
                              case channel_send_case_1
                              solve( !KU( ~key ) @ #vk.35 )
                                case static_reveal
                                solve( !KU( 'g'^(~e*~key) ) @ #vk.31 )
                                  case c_exp
                                  solve( !KU( aead(kdf2(<'IK', 'g'^(~e*~key)>), '0',
                                                   h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>), 'g'^~s)
                                         ) @ #vk.27 )
                                    case channel_send
                                    solve( !KU( 'g'^~key ) @ #vk.24 )
                                      case channel_send
                                      solve( splitEqs(12) )
                                        case split_case_1
                                        solve( !KU( kdf2(<'IK', 'g'^~e0.2>) ) @ #vk.37 )
                                          case c_kdf2
                                          solve( !KU( 'g'^~e ) @ #vk.29 )
                                            case channel_send
                                            solve( !KU( aead(kdf2(<kdf1(<'IK', 'g'^(~e*~key)>), 'g'^(~key*~s)
                                                                  >),
                                                             '0',
                                                             h(<
                                                                h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e
                                                                  >), 
                                                                aead(kdf2(<'IK', 'g'^(~e*~key)>), '0',
                                                                     h(<h(<h(<'IK', prologue>), 'g'^~key>), 
                                                                        'g'^~e>),
                                                                     'g'^~s)
                                                               >),
                                                             payload)
                                                   ) @ #vk.30 )
                                              case channel_send
                                              solve( !KU( 'g'^~e0 ) @ #vk.30 )
                                                case channel_send
                                                solve( !KU( 'g'^~e0.1 ) @ #vk.38 )
                                                  case c_exp
