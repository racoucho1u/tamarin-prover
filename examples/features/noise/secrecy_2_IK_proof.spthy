theory secrecy_2_IK begin

// Function signature and definition of the equational theory E

builtins: diffie-hellman
functions: aead/4, decrypt/3, fst/1, h/1, kdf1/1, kdf2/1, kdf3/1, pair/2,
           snd/1, true/0, verify/4
equations:
    decrypt(k, n, aead(k, n, a, p)) = p,
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(k, n, a, aead(k, n, a, p)) = true

tactic: unless
presort: s
prio: {id}
  regex"^My"
  regex"^I_"
  regex"^R_"
  regex"^St_"
  regex"^!Transport_"
  regex"^!SessionId\("
  regex"^Ek"
  regex"^Handshake"
  regex"^Peer"
prio: {id}
  regex"!KU\(*~.*\)" & reasonableNoncesNoise"resN"
prio: {smallest}
  dhreNoise"dh"
prio: {smallest}
  regex"Receivable\(.*'"""""
  regex"Receivable\(.*\("""""
  regex"Recv\(.*\("""""
  regex"Recv\(.*'"""""


tactic: unless_reveal_psk
presort: s
prio: {id}
  regex"^My"
  regex"^I_"
  regex"^R_"
  regex"^St_"
  regex"^!Transport_"
  regex"^!SessionId\("
  regex"^Ek"
  regex"^Handshake"
  regex"^Peer"
prio: {id}
  regex"!KU\(*~.*\)" & reasonableNoncesNoise""
prio: {smallest}
  regex"!KU\(.*~psk.*\)"""""
prio: {smallest}
  dhreNoise"~n""\(Reveal[a-zA-Z]+\(*'g'^(~[a-zA-Z0-9.]+)*\)*@*#reveal""^(~[a-zA-Z0-9.]+)"
prio: {smallest}
  regex"Receivable\(.*'"""""
  regex"Receivable\(.*\("""""
  regex"Recv\(.*\("""""
  regex"Recv\(.*'"""""









rule (modulo E) Init_Handshake_Initiator:
   [ Init_Handshake_Initiator( id, prologue, ~s, 'g'^rs ) ]
  -->
   [
   HandshakeState_Initiator_0( id, h(<h(<'IK', prologue>), 'g'^rs>), 'IK',
                               ~s, 'g'^rs
   )
   ]

  /*
  rule (modulo AC) Init_Handshake_Initiator:
     [ Init_Handshake_Initiator( id, prologue, ~s, z ) ]
    -->
     [
     HandshakeState_Initiator_0( id, h(<h(<'IK', prologue>), z>), 'IK', ~s, z
     )
     ]
    variants (modulo AC)
    1. z     = 'g'
    
    2. z     = 'g'^rs.7
  */

rule (modulo E) Handshake_Initiator_Snd_1:
   [
   HandshakeState_Initiator_0( id, hash, ck, ~s, 'g'^rs ),
   Handshake_Snd_1( id, payload ), Ek( ~e0 )
   ]
  --[
  RawSnd( 'Initiator1',
          <'g'^~e0, aead(kdf2(<ck, 'g'^rs^~e0>), '0', h(<hash, 'g'^~e0>), 'g'^~s), 
           aead(kdf2(<kdf1(<ck, 'g'^rs^~e0>), 'g'^rs^~s>), '0',
                h(<h(<hash, 'g'^~e0>), 
                   aead(kdf2(<ck, 'g'^rs^~e0>), '0', h(<hash, 'g'^~e0>), 'g'^~s)>),
                payload)
          >
  )
  ]->
   [
   MyEk_Initiator( id, 'g'^~e0 ),
   HandshakeState_Initiator_1( id,
                               h(<
                                  h(<h(<hash, 'g'^~e0>), 
                                     aead(kdf2(<ck, 'g'^rs^~e0>), '0', h(<hash, 'g'^~e0>), 'g'^~s)>), 
                                  aead(kdf2(<kdf1(<ck, 'g'^rs^~e0>), 'g'^rs^~s>), '0',
                                       h(<h(<hash, 'g'^~e0>), 
                                          aead(kdf2(<ck, 'g'^rs^~e0>), '0', h(<hash, 'g'^~e0>), 'g'^~s)>),
                                       payload)
                                 >),
                               kdf1(<kdf1(<ck, 'g'^rs^~e0>), 'g'^rs^~s>),
                               kdf2(<kdf1(<ck, 'g'^rs^~e0>), 'g'^rs^~s>), ~e0, ~s, 'g'^rs
   ),
   Send( <'g'^~e0, 
          aead(kdf2(<ck, 'g'^rs^~e0>), '0', h(<hash, 'g'^~e0>), 'g'^~s), 
          aead(kdf2(<kdf1(<ck, 'g'^rs^~e0>), 'g'^rs^~s>), '0',
               h(<h(<hash, 'g'^~e0>), 
                  aead(kdf2(<ck, 'g'^rs^~e0>), '0', h(<hash, 'g'^~e0>), 'g'^~s)>),
               payload)
         >
   )
   ]

  /*
  rule (modulo AC) Handshake_Initiator_Snd_1:
     [
     HandshakeState_Initiator_0( id, hash, ck, ~s, z ),
     Handshake_Snd_1( id, payload ), Ek( ~e0 )
     ]
    --[
    RawSnd( 'Initiator1',
            <'g'^~e0, aead(kdf2(<ck, z.1>), '0', h(<hash, 'g'^~e0>), 'g'^~s), 
             aead(kdf2(<kdf1(<ck, z.1>), z.2>), '0',
                  h(<h(<hash, 'g'^~e0>), 
                     aead(kdf2(<ck, z.1>), '0', h(<hash, 'g'^~e0>), 'g'^~s)>),
                  payload)
            >
    )
    ]->
     [
     MyEk_Initiator( id, 'g'^~e0 ),
     HandshakeState_Initiator_1( id,
                                 h(<
                                    h(<h(<hash, 'g'^~e0>), 
                                       aead(kdf2(<ck, z.1>), '0', h(<hash, 'g'^~e0>), 'g'^~s)>), 
                                    aead(kdf2(<kdf1(<ck, z.1>), z.2>), '0',
                                         h(<h(<hash, 'g'^~e0>), 
                                            aead(kdf2(<ck, z.1>), '0', h(<hash, 'g'^~e0>), 'g'^~s)>),
                                         payload)
                                   >),
                                 kdf1(<kdf1(<ck, z.1>), z.2>), kdf2(<kdf1(<ck, z.1>), z.2>), ~e0, ~s, z
     ),
     Send( <'g'^~e0, aead(kdf2(<ck, z.1>), '0', h(<hash, 'g'^~e0>), 'g'^~s), 
            aead(kdf2(<kdf1(<ck, z.1>), z.2>), '0',
                 h(<h(<hash, 'g'^~e0>), 
                    aead(kdf2(<ck, z.1>), '0', h(<hash, 'g'^~e0>), 'g'^~s)>),
                 payload)
           >
     )
     ]
    variants (modulo AC)
     1. ~e0   = ~e0.15
        ~s    = ~e0.15
        z     = 'g'^inv(~e0.15)
        z.1   = 'g'
        z.2   = 'g'
    
     2. ~e0   = ~e0.16
        ~s    = ~s.17
        z     = 'g'
        z.1   = 'g'^~e0.16
        z.2   = 'g'^~s.17
    
     3. ~e0   = ~e0.16
        ~s    = ~s.17
        z     = 'g'^inv(~e0.16)
        z.1   = 'g'
        z.2   = 'g'^(~s.17*inv(~e0.16))
    
     4. ~e0   = ~e0.16
        ~s    = ~s.17
        z     = 'g'^inv(~s.17)
        z.1   = 'g'^(~e0.16*inv(~s.17))
        z.2   = 'g'
    
     5. ~e0   = ~e0.16
        ~s    = ~s.17
        z     = 'g'^inv((~e0.16*~s.17))
        z.1   = 'g'^inv(~s.17)
        z.2   = 'g'^inv(~e0.16)
    
     6. ~e0   = ~e0.177
        ~s    = ~s.178
        z     = 'g'^rs.352
        z.1   = 'g'^(~e0.177*rs.352)
        z.2   = 'g'^(~s.178*rs.352)
    
     7. ~e0   = ~e0.182
        ~s    = ~e0.182
        z     = 'g'^inv((~e0.182*x.362))
        z.1   = 'g'^inv(x.362)
        z.2   = 'g'^inv(x.362)
    
     8. ~e0   = ~e0.182
        ~s    = ~e0.182
        z     = 'g'^(x.362*inv(~e0.182))
        z.1   = 'g'^x.362
        z.2   = 'g'^x.362
    
     9. ~e0   = ~e0.182
        ~s    = ~s.183
        z     = 'g'^inv((~s.183*x.362))
        z.1   = 'g'^(~e0.182*inv((~s.183*x.362)))
        z.2   = 'g'^inv(x.362)
    
    10. ~e0   = ~e0.182
        ~s    = ~s.183
        z     = 'g'^(x.362*inv(~s.183))
        z.1   = 'g'^(~e0.182*x.362*inv(~s.183))
        z.2   = 'g'^x.362
    
    11. ~e0   = ~e0.183
        ~s    = ~e0.183
        z     = 'g'^(x.363*inv((~e0.183*x.364)))
        z.1   = 'g'^(x.363*inv(x.364))
        z.2   = 'g'^(x.363*inv(x.364))
    
    12. ~e0   = ~e0.183
        ~s    = ~s.184
        z     = 'g'^inv((~e0.183*~s.184*x.364))
        z.1   = 'g'^inv((~s.184*x.364))
        z.2   = 'g'^inv((~e0.183*x.364))
    
    13. ~e0   = ~e0.183
        ~s    = ~s.184
        z     = 'g'^inv((~e0.183*x.364))
        z.1   = 'g'^inv(x.364)
        z.2   = 'g'^(~s.184*inv((~e0.183*x.364)))
    
    14. ~e0   = ~e0.183
        ~s    = ~s.184
        z     = 'g'^(x.363*inv((~s.184*x.364)))
        z.1   = 'g'^(~e0.183*x.363*inv((~s.184*x.364)))
        z.2   = 'g'^(x.363*inv(x.364))
    
    15. ~e0   = ~e0.183
        ~s    = ~s.184
        z     = 'g'^(x.364*inv(~e0.183))
        z.1   = 'g'^x.364
        z.2   = 'g'^(~s.184*x.364*inv(~e0.183))
    
    16. ~e0   = ~e0.183
        ~s    = ~s.184
        z     = 'g'^(x.364*inv((~e0.183*~s.184)))
        z.1   = 'g'^(x.364*inv(~s.184))
        z.2   = 'g'^(x.364*inv(~e0.183))
    
    17. ~e0   = ~e0.184
        ~s    = ~s.185
        z     = 'g'^(x.365*inv((~e0.184*~s.185*x.366)))
        z.1   = 'g'^(x.365*inv((~s.185*x.366)))
        z.2   = 'g'^(x.365*inv((~e0.184*x.366)))
    
    18. ~e0   = ~e0.184
        ~s    = ~s.185
        z     = 'g'^(x.365*inv((~e0.184*x.366)))
        z.1   = 'g'^(x.365*inv(x.366))
        z.2   = 'g'^(~s.185*x.365*inv((~e0.184*x.366)))
  */

rule (modulo E) Handshake_Initiator_Recv_2:
   [
   HandshakeState_Initiator_1( id, hash, ck, k, ~e, ~s, 'g'^rs ),
   Recv( <'g'^re0, 
          aead(kdf2(<kdf1(<ck, 'g'^re0^~e>), 'g'^re0^~s>), '0', h(<hash, 'g'^re0>),
               payload)
         >
   )
   ]
  --[
  Secret_IK_2_Initiator( 'g'^~e, 'g'^~s, 'g'^re0, 'g'^rs, payload ),
  RawRecv( 'Responder2',
           <'g'^re0, 
            aead(kdf2(<kdf1(<ck, 'g'^re0^~e>), 'g'^re0^~s>), '0', h(<hash, 'g'^re0>),
                 payload)
           >
  )
  ]->
   [
   PeerEk_Initiator( id, 'g'^re0 ),
   HandshakeState_Initiator_2( id,
                               h(<h(<hash, 'g'^re0>), 
                                  aead(kdf2(<kdf1(<ck, 'g'^re0^~e>), 'g'^re0^~s>), '0', h(<hash, 'g'^re0>),
                                       payload)
                                 >),
                               kdf1(<kdf1(<ck, 'g'^re0^~e>), 'g'^re0^~s>),
                               kdf2(<kdf1(<ck, 'g'^re0^~e>), 'g'^re0^~s>), ~e, 'g'^re0, ~s, 'g'^rs
   ),
   Handshake_Recv_2( id, payload )
   ]

  /*
  rule (modulo AC) Handshake_Initiator_Recv_2:
     [
     HandshakeState_Initiator_1( id, hash, ck, k, ~e, ~s, z ),
     Recv( <z.1, 
            aead(kdf2(<kdf1(<ck, z.2>), z.3>), '0', h(<hash, z.1>), payload)>
     )
     ]
    --[
    Secret_IK_2_Initiator( 'g'^~e, 'g'^~s, z.1, z, payload ),
    RawRecv( 'Responder2',
             <z.1, aead(kdf2(<kdf1(<ck, z.2>), z.3>), '0', h(<hash, z.1>), payload)>
    )
    ]->
     [
     PeerEk_Initiator( id, z.1 ),
     HandshakeState_Initiator_2( id,
                                 h(<h(<hash, z.1>), 
                                    aead(kdf2(<kdf1(<ck, z.2>), z.3>), '0', h(<hash, z.1>), payload)>),
                                 kdf1(<kdf1(<ck, z.2>), z.3>), kdf2(<kdf1(<ck, z.2>), z.3>), ~e, z.1, ~s,
                                 z
     ),
     Handshake_Recv_2( id, payload )
     ]
    variants (modulo AC)
     1. ~e    = ~e.15
        ~s    = ~e.15
        z     = 'g'
        z.1   = 'g'^inv(~e.15)
        z.2   = 'g'
        z.3   = 'g'
    
     2. ~e    = ~e.16
        ~s    = ~s.17
        z     = 'g'
        z.1   = 'g'
        z.2   = 'g'^~e.16
        z.3   = 'g'^~s.17
    
     3. ~e    = ~e.16
        ~s    = ~s.17
        z     = 'g'
        z.1   = 'g'^inv(~e.16)
        z.2   = 'g'
        z.3   = 'g'^(~s.17*inv(~e.16))
    
     4. ~e    = ~e.16
        ~s    = ~s.17
        z     = 'g'
        z.1   = 'g'^inv(~s.17)
        z.2   = 'g'^(~e.16*inv(~s.17))
        z.3   = 'g'
    
     5. ~e    = ~e.16
        ~s    = ~s.17
        z     = 'g'
        z.1   = 'g'^inv((~e.16*~s.17))
        z.2   = 'g'^inv(~s.17)
        z.3   = 'g'^inv(~e.16)
    
     6. ~e    = ~e.204
        ~s    = ~s.205
        z     = 'g'
        z.1   = 'g'^re0.406
        z.2   = 'g'^(~e.204*re0.406)
        z.3   = 'g'^(~s.205*re0.406)
    
     7. ~e    = ~e.204
        ~s    = ~s.205
        z     = 'g'^rs.406
        z.1   = 'g'
        z.2   = 'g'^~e.204
        z.3   = 'g'^~s.205
    
     8. ~e    = ~e.204
        ~s    = ~s.205
        z     = 'g'^rs.406
        z.1   = 'g'^re0.406
        z.2   = 'g'^(~e.204*re0.406)
        z.3   = 'g'^(~s.205*re0.406)
    
     9. ~e    = ~e.205
        ~s    = ~e.205
        z     = 'g'^rs.408
        z.1   = 'g'^inv(~e.205)
        z.2   = 'g'
        z.3   = 'g'
    
    10. ~e    = ~e.205
        ~s    = ~s.206
        z     = 'g'^rs.408
        z.1   = 'g'^inv(~e.205)
        z.2   = 'g'
        z.3   = 'g'^(~s.206*inv(~e.205))
    
    11. ~e    = ~e.205
        ~s    = ~s.206
        z     = 'g'^rs.408
        z.1   = 'g'^inv(~s.206)
        z.2   = 'g'^(~e.205*inv(~s.206))
        z.3   = 'g'
    
    12. ~e    = ~e.206
        ~s    = ~s.207
        z     = 'g'^rs.410
        z.1   = 'g'^inv((~e.206*~s.207))
        z.2   = 'g'^inv(~s.207)
        z.3   = 'g'^inv(~e.206)
    
    13. ~e    = ~e.210
        ~s    = ~e.210
        z     = 'g'
        z.1   = 'g'^inv((~e.210*x.418))
        z.2   = 'g'^inv(x.418)
        z.3   = 'g'^inv(x.418)
    
    14. ~e    = ~e.210
        ~s    = ~e.210
        z     = 'g'
        z.1   = 'g'^(x.418*inv(~e.210))
        z.2   = 'g'^x.418
        z.3   = 'g'^x.418
    
    15. ~e    = ~e.210
        ~s    = ~s.211
        z     = 'g'
        z.1   = 'g'^inv((~s.211*x.418))
        z.2   = 'g'^(~e.210*inv((~s.211*x.418)))
        z.3   = 'g'^inv(x.418)
    
    16. ~e    = ~e.210
        ~s    = ~s.211
        z     = 'g'
        z.1   = 'g'^(x.418*inv(~s.211))
        z.2   = 'g'^(~e.210*x.418*inv(~s.211))
        z.3   = 'g'^x.418
    
    17. ~e    = ~e.211
        ~s    = ~e.211
        z     = 'g'
        z.1   = 'g'^(x.419*inv((~e.211*x.420)))
        z.2   = 'g'^(x.419*inv(x.420))
        z.3   = 'g'^(x.419*inv(x.420))
    
    18. ~e    = ~e.211
