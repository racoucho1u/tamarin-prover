                  solve( !KU( ~e0 ) @ #vk.23 )
                    case ephemeral_reveal
                    solve( !KU( ~key ) @ #vk.24 )
                      case static_reveal
                      solve( !KU( 'g'^(~e*~e0) ) @ #vk.19 )
                        case c_exp
                        solve( !KU( ~e ) @ #vk.26 )
                          case ephemeral_reveal
                          solve( !KU( 'g'^(~key*~s) ) @ #vk.22 )
                            case c_exp
                            solve( !KU( ~s ) @ #vk.28 )
                              case static_reveal
