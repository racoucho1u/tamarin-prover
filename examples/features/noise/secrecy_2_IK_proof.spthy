              solve( !KU( 'g'^(~e0*~key) ) @ #vk.12 )
                case c_exp
                solve( !KU( ~e0 ) @ #vk.20 )
                  case ephemeral_reveal
                  solve( !KU( ~key ) @ #vk.21 )
                    case static_reveal
                    solve( !KU( 'g'^(~key*~s) ) @ #vk.20 )
                      case c_exp
                      solve( !KU( ~s ) @ #vk.23 )
                        case static_reveal
                        solve( !KU( aead(kdf2(<'IK', z>), '0',
                                         h(<h(<h(<'IK', prologue>), 'g'^~s>), re>), 'g'^~key)
                               ) @ #vk.17 )
                          case c_aead
                          solve( !KU( aead(kdf2(<kdf1(<'IK', z>), 'g'^(~key*~s)>), '0',
                                           h(<h(<h(<h(<'IK', prologue>), 'g'^~s>), re>), 
                                              aead(kdf2(<'IK', z>), '0',
                                                   h(<h(<h(<'IK', prologue>), 'g'^~s>), re>), 'g'^~key)
                                             >),
                                           payload)
                                 ) @ #vk.18 )
                            case channel_send
                            solve( !KU( kdf1(<'IK', 'g'^(~e0*~s)>) ) @ #vk.22 )
                              case c_kdf1
                              solve( !KU( kdf2(<'IK', 'g'^(~e0*~s)>) ) @ #vk.24 )
                                case c_kdf2
                                solve( !KU( 'g'^(~e0*~e0.1) ) @ #vk.23 )
                                  case c_exp
                                  solve( !KU( ~e0 ) @ #vk.33 )
                                    case ephemeral_reveal
                                    solve( !KU( 'g'^(~e0*~s) ) @ #vk.33 )
                                      case c_exp
                                      solve( !KU( h(<h(<h(<'IK', prologue>), 'g'^~s>), 'g'^~e0>) ) @ #vk.29 )
                                        case c_h
                                        solve( !KU( h(<h(<'IK', prologue>), 'g'^~s>) ) @ #vk.36 )
                                          case c_h
                                          solve( !KU( h(<'IK', prologue>) ) @ #vk.38 )
                                            case c_h
                                            solve( !KU( 'g'^~key ) @ #vk.35 )
                                              case channel_send
                                              solve( splitEqs(11) )
                                                case split_case_1
                                                solve( !KU( kdf2(<'IK', 'g'^~e0.2>) ) @ #vk.40 )
                                                  case c_kdf2
                                                  solve( !KU( 'g'^~s ) @ #vk.39 )
                                                    case c_exp
                                                    solve( !KU( 'g'^~e0 ) @ #vk.34 )
                                                      case c_exp
