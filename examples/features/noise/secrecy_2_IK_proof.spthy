                                case static_reveal
                                by contradiction /* from formulas */
                              qed
                            next
                              case static_keygen
                              solve( !KU( ~key ) @ #vk.30 )
                                case static_reveal
                                by contradiction /* from formulas */
                              qed
                            qed
                          next
                            case split_case_2
                            solve( !KU( 'g'^(~key*~s) ) @ #vk.19 )
                              case c_exp
                              solve( !KU( ~key ) @ #vk.32 )
                                case static_reveal
                                by contradiction /* from formulas */
                              qed
