                                                   payload)
                                         ) @ #vk.25 )
                                    case channel_send
                                    solve( !KU( 'g'^~e ) @ #vk.25 )
                                      case c_exp
                                      solve( !KU( 'g'^~s ) @ #vk.31 )
                                        case channel_send
