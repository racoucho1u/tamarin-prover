              case c_kdf1
              solve( !KU( kdf1(<'IK', 'g'^(~e*~s)>) ) @ #vk.16 )
                case c_kdf1
                solve( !KU( 'g'^(~e0*~key) ) @ #vk.14 )
                  case channel_send_case_2
                  solve( !KU( ~key ) @ #vk.21 )
                    case static_reveal
                    solve( !KU( 'g'^(~e*~e0) ) @ #vk.17 )
                      case channel_send_case_2
                      solve( !KU( ~e ) @ #vk.22 )
                        case ephemeral_reveal
                        solve( !KU( 'g'^(~key*~s) ) @ #vk.19 )
                          case c_exp
                          solve( !KU( ~s ) @ #vk.25 )
                            case static_reveal
                            solve( !KU( 'g'^(~e*~s) ) @ #vk.24 )
                              case c_exp
                              solve( !KU( aead(kdf2(<'IK', 'g'^(~e*~s)>), '0',
                                               h(<h(<h(<'IK', prologue>), 'g'^~s>), 'g'^~e>), 'g'^~key)
                                     ) @ #vk.20 )
                                case channel_send
                                solve( !KU( aead(kdf2(<kdf1(<'IK', 'g'^(~e*~s)>), 'g'^(~key*~s)>), '0',
                                                 h(<h(<h(<h(<'IK', prologue>), 'g'^~s>), 'g'^~e>), 
                                                    aead(kdf2(<'IK', 'g'^(~e*~s)>), '0',
                                                         h(<h(<h(<'IK', prologue>), 'g'^~s>), 'g'^~e>),
                                                         'g'^~key)
                                                   >),
                                                 payload)
                                       ) @ #vk.22 )
                                  case channel_send
                                  solve( !KU( 'g'^~e ) @ #vk.22 )
                                    case channel_send
                                    solve( !KU( 'g'^~s ) @ #vk.28 )
                                      case c_exp
