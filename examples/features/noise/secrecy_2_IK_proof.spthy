        case c_aead
        solve( !KU( kdf2(<
                          kdf1(<kdf1(<kdf1(<'IK', 'g'^~e>), 'g'^~s>), 'g'^(~e*~e.1)>), 
                          'g'^(~s*~e.1)>)
               ) @ #vk.7 )
          case c_kdf2
          solve( !KU( kdf1(<kdf1(<kdf1(<'IK', 'g'^~e>), 'g'^~s>), 'g'^(~e*~e.1)>)
                 ) @ #vk.11 )
            case c_kdf1
