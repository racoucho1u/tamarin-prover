                                              case channel_send
                                              solve( splitEqs(13) )
                                                case split_case_1
                                                solve( !KU( kdf2(<'IK', 'g'^~e0.2>) ) @ #vk.39 )
                                                  case c_kdf2
                                                  solve( !KU( 'g'^~s ) @ #vk.38 )
                                                    case c_exp
