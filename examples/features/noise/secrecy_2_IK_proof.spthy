                                                                     h(<h(<h(<'IK', prologue>), 'g'^~s>), 
                                                                        'g'^~e>),
                                                                     'g'^~s.1)
                                                               >),
                                                             payload)
                                                   ) @ #vk.29 )
                                              case channel_send
                                              solve( !KU( 'g'^~e0 ) @ #vk.36 )
                                                case c_exp
                                                solve( !KU( ~e0 ) @ #vk.37 )
                                                  case ephemeral_reveal
                                                  SOLVED // trace found
                                                qed
                                              qed
                                            qed
                                          qed
                                        qed
                                      qed
                                    qed
                                  qed
                                qed
                              qed
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
