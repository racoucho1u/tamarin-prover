lemma Secrecy_IK_2_for_Initiator_unless_dishonest_re_or_dishonest_rs_or_reveal_e_AnyTime_or_reveal_re_Before_end:
  all-traces
  "∀ msg e me re peer #claim.
    (Secret_IK_2_Initiator( e, me, re, peer, msg ) @ #claim) ⇒
    ((¬(∃ #attack. K( msg ) @ #attack)) ∨
     ((((¬(∃ #honest. HonestEk( re ) @ #honest)) ∨
        (¬(∃ #honest. HonestPk( peer ) @ #honest))) ∨
       (∃ #reveal. RevealEk( e ) @ #reveal)) ∨
      (∃ #reveal. (RevealEk( re ) @ #reveal) ∧ (#reveal < #claim))))"
/*
guarded formula characterizing all counter-examples:
"∃ msg e me re peer #claim.
  (Secret_IK_2_Initiator( e, me, re, peer, msg ) @ #claim)
 ∧
  (∃ #attack. (K( msg ) @ #attack)) ∧
  (∃ #honest. (HonestEk( re ) @ #honest)) ∧
  (∃ #honest. (HonestPk( peer ) @ #honest)) ∧
  (∀ #reveal. (RevealEk( e ) @ #reveal) ⇒ ⊥) ∧
  (∀ #reveal. (RevealEk( re ) @ #reveal) ⇒ ¬(#reveal < #claim))"
*/
simplify
solve( HandshakeState_Initiator_1( id, hash, ck, k, ~e, ~s, 'g'^~key
       ) ▶₀ #claim )
  case Handshake_Initiator_Snd_1
  solve( Recv( <'g'^~e.1, 
                aead(kdf2(<
                           kdf1(<kdf1(<kdf1(<'IK', 'g'^(~e*~key)>), 'g'^(~key*~s)>), 'g'^(~e*~e.1)
                                >), 
                           'g'^(~s*~e.1)>),
                     '0',
                     h(<
                        h(<
                           h(<h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>), 
                              aead(kdf2(<'IK', 'g'^(~e*~key)>), '0',
                                   h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>), 'g'^~s)
                             >), 
                           aead(kdf2(<kdf1(<'IK', 'g'^(~e*~key)>), 'g'^(~key*~s)>), '0',
                                h(<h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>), 
                                   aead(kdf2(<'IK', 'g'^(~e*~key)>), '0',
                                        h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>), 'g'^~s)
                                  >),
                                payload)
                          >), 
                        'g'^~e.1>),
                     msg)
               >
         ) ▶₁ #claim )
    case channel_receive
    solve( !KU( aead(kdf2(<
                           kdf1(<kdf1(<kdf1(<'IK', 'g'^(~e*~key)>), 'g'^(~key*~s)>), 'g'^(~e*~e.1)
                                >), 
                           'g'^(~s*~e.1)>),
                     '0',
                     h(<
                        h(<
                           h(<h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>), 
                              aead(kdf2(<'IK', 'g'^(~e*~key)>), '0',
                                   h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>), 'g'^~s)
                             >), 
                           aead(kdf2(<kdf1(<'IK', 'g'^(~e*~key)>), 'g'^(~key*~s)>), '0',
                                h(<h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>), 
                                   aead(kdf2(<'IK', 'g'^(~e*~key)>), '0',
                                        h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>), 'g'^~s)
                                  >),
                                payload)
                          >), 
                        'g'^~e.1>),
                     msg)
           ) @ #vk.6 )
      case channel_send
      solve( !KU( ~n ) @ #vk.1 )
        case channel_send
        solve( !KU( kdf2(<
                          kdf1(<kdf1(<kdf1(<'IK', 'g'^(~e*~key)>), 'g'^(~key*~s)>), 'g'^(~e*~e.1)
                               >), 
                          'g'^(~s*~e.1)>)
               ) @ #vk.12 )
          case c_kdf2
          solve( !KU( kdf1(<kdf1(<kdf1(<'IK', 'g'^(~e*~key)>), 'g'^(~key*~s)>), 
                            'g'^(~e*~e.1)>)
                 ) @ #vk.15 )
            case c_kdf1
            solve( !KU( kdf1(<kdf1(<'IK', 'g'^(~e*~key)>), 'g'^(~key*~s)>)
                   ) @ #vk.18 )
              case c_kdf1
              solve( !KU( kdf1(<'IK', 'g'^(~e*~key)>) ) @ #vk.21 )
                case c_kdf1
                solve( !KU( 'g'^(~s*~e.1) ) @ #vk.19 )
                  case c_exp
                  solve( !KU( ~s ) @ #vk.28 )
                    case static_reveal
                    solve( !KU( ~e.1 ) @ #vk.29 )
                      case ephemeral_reveal
                      solve( !KU( 'g'^(~e*~e.1) ) @ #vk.24 )
                        case channel_send_case_1
                        solve( !KU( 'g'^(~key*~s) ) @ #vk.25 )
                          case c_exp
                          solve( !KU( ~key ) @ #vk.31 )
                            case static_reveal
                            solve( !KU( 'g'^(~e*~key) ) @ #vk.30 )
                              case channel_send_case_1
                              solve( !KU( 'g'^~key ) @ #vk.23 )
                                case c_exp
                                solve( !KU( 'g'^~e.1 ) @ #vk.25 )
                                  case channel_send
                                  solve( !KU( 'g'^~e ) @ #vk.23 )
                                    case channel_send
                                    solve( !KU( aead(kdf2(<'IK', 'g'^(~e*~key)>), '0',
                                                     h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>), 'g'^~s)
                                           ) @ #vk.27 )
                                      case c_aead
                                      solve( !KU( kdf2(<'IK', 'g'^(~e*~key)>) ) @ #vk.32 )
                                        case c_kdf2
                                        solve( !KU( h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>)
                                               ) @ #vk.33 )
                                          case c_h
                                          solve( !KU( h(<h(<'IK', prologue>), 'g'^~key>) ) @ #vk.36 )
                                            case c_h
                                            solve( !KU( h(<'IK', prologue>) ) @ #vk.38 )
                                              case c_h
                                              solve( !KU( aead(kdf2(<kdf1(<'IK', 'g'^(~e*~key)>), 
                                                                     'g'^(~key*~s)>),
                                                               '0',
                                                               h(<
                                                                  h(<h(<h(<'IK', prologue>), 'g'^~key>), 
                                                                     'g'^~e>), 
                                                                  aead(kdf2(<'IK', 'g'^(~e*~key)>), '0',
                                                                       h(<h(<h(<'IK', prologue>), 'g'^~key>), 
                                                                          'g'^~e>),
                                                                       'g'^~s)
                                                                 >),
                                                               payload)
                                                     ) @ #vk.35 )
                                                case c_aead
                                                solve( !KU( kdf2(<kdf1(<'IK', 'g'^(~e*~key)>), 'g'^(~key*~s)>)
                                                       ) @ #vk.40 )
                                                  case c_kdf2
                                                  solve( !KU( h(<
                                                                 h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e
                                                                   >), 
                                                                 aead(kdf2(<'IK', 'g'^(~e*~key)>), '0',
                                                                      h(<h(<h(<'IK', prologue>), 'g'^~key>), 
                                                                         'g'^~e>),
                                                                      'g'^~s)
                                                                >)
                                                         ) @ #vk.41 )
                                                    case c_h
                                                    solve( !KU( 'g'^~s ) @ #vk.42 )
                                                      case c_exp
                                                      SOLVED // trace found
                                                    qed
                                                  qed
                                                qed
                                              qed
                                            qed
                                          qed
                                        qed
                                      qed
                                    qed
                                  qed
                                qed
                              qed
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

