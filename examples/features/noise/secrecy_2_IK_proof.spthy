lemma Secrecy_IK_2_for_Initiator_unless_dishonest_re_or_dishonest_rs_or_reveal_e_Before_or_reveal_s_AnyTime_or_reveal_re_Before_or_reveal_rs_Before_end:
  all-traces
  "∀ msg e me re peer #claim.
    (Secret_IK_2_Initiator( e, me, re, peer, msg ) @ #claim) ⇒
    ((¬(∃ #attack. K( msg ) @ #attack)) ∨
     ((((((¬(∃ #honest. HonestEk( re ) @ #honest)) ∨
          (¬(∃ #honest. HonestPk( peer ) @ #honest))) ∨
         (∃ #reveal. (RevealEk( e ) @ #reveal) ∧ (#reveal < #claim))) ∨
        (∃ #reveal. RevealLtk( me ) @ #reveal)) ∨
       (∃ #reveal. (RevealEk( re ) @ #reveal) ∧ (#reveal < #claim))) ∨
      (∃ #reveal. (RevealLtk( peer ) @ #reveal) ∧ (#reveal < #claim))))"
/*
guarded formula characterizing all counter-examples:
"∃ msg e me re peer #claim.
  (Secret_IK_2_Initiator( e, me, re, peer, msg ) @ #claim)
 ∧
  (∃ #attack. (K( msg ) @ #attack)) ∧
  (∃ #honest. (HonestEk( re ) @ #honest)) ∧
  (∃ #honest. (HonestPk( peer ) @ #honest)) ∧
  (∀ #reveal. (RevealEk( e ) @ #reveal) ⇒ ¬(#reveal < #claim)) ∧
  (∀ #reveal. (RevealLtk( me ) @ #reveal) ⇒ ⊥) ∧
  (∀ #reveal. (RevealEk( re ) @ #reveal) ⇒ ¬(#reveal < #claim)) ∧
  (∀ #reveal. (RevealLtk( peer ) @ #reveal) ⇒ ¬(#reveal < #claim))"
*/
simplify
solve( HandshakeState_Initiator_1( id, hash, ck, k, ~e, ~s, 'g'^~key
       ) ▶₀ #claim )
  case Handshake_Initiator_Snd_1
  solve( Recv( <'g'^~e.1, 
                aead(kdf2(<
                           kdf1(<kdf1(<kdf1(<'IK', 'g'^(~e*~key)>), 'g'^(~key*~s)>), 'g'^(~e*~e.1)
                                >), 
                           'g'^(~s*~e.1)>),
                     '0',
                     h(<
                        h(<
                           h(<h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>), 
                              aead(kdf2(<'IK', 'g'^(~e*~key)>), '0',
                                   h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>), 'g'^~s)
                             >), 
                           aead(kdf2(<kdf1(<'IK', 'g'^(~e*~key)>), 'g'^(~key*~s)>), '0',
                                h(<h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>), 
                                   aead(kdf2(<'IK', 'g'^(~e*~key)>), '0',
                                        h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>), 'g'^~s)
                                  >),
                                payload)
                          >), 
                        'g'^~e.1>),
                     msg)
               >
         ) ▶₁ #claim )
    case channel_receive
    solve( !KU( aead(kdf2(<
                           kdf1(<kdf1(<kdf1(<'IK', 'g'^(~e*~key)>), 'g'^(~key*~s)>), 'g'^(~e*~e.1)
                                >), 
                           'g'^(~s*~e.1)>),
                     '0',
                     h(<
                        h(<
                           h(<h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>), 
                              aead(kdf2(<'IK', 'g'^(~e*~key)>), '0',
                                   h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>), 'g'^~s)
                             >), 
                           aead(kdf2(<kdf1(<'IK', 'g'^(~e*~key)>), 'g'^(~key*~s)>), '0',
                                h(<h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>), 
                                   aead(kdf2(<'IK', 'g'^(~e*~key)>), '0',
                                        h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>), 'g'^~s)
                                  >),
                                payload)
                          >), 
                        'g'^~e.1>),
                     msg)
           ) @ #vk.6 )
      case channel_send
      solve( !KU( ~n ) @ #vk.1 )
        case channel_send
        solve( !KU( kdf2(<
                          kdf1(<kdf1(<kdf1(<'IK', 'g'^(~e*~key)>), 'g'^(~key*~s)>), 'g'^(~e*~e.1)
                               >), 
                          'g'^(~s*~e.1)>)
               ) @ #vk.12 )
          case c_kdf2
          solve( !KU( kdf1(<kdf1(<kdf1(<'IK', 'g'^(~e*~key)>), 'g'^(~key*~s)>), 
                            'g'^(~e*~e.1)>)
                 ) @ #vk.15 )
            case c_kdf1
            solve( !KU( kdf1(<kdf1(<'IK', 'g'^(~e*~key)>), 'g'^(~key*~s)>)
                   ) @ #vk.18 )
              case c_kdf1
              solve( !KU( kdf1(<'IK', 'g'^(~e*~key)>) ) @ #vk.21 )
                case c_kdf1
                solve( !KU( 'g'^(~s*~e.1) ) @ #vk.19 )
                  case channel_send_case_1
                  solve( !KU( ~e.1 ) @ #vk.27 )
                    case ephemeral_reveal
                    solve( splitEqs(8) )
                      case split_case_1
                      solve( !KU( kdf2(<'IK', 'g'^~e0>) ) @ #vk.27 )
                        case c_kdf2
                        solve( !KU( 'g'^(~e*~e.1) ) @ #vk.23 )
                          case c_exp
                          solve( !KU( ~e ) @ #vk.34 )
                            case ephemeral_reveal
                            solve( !KU( 'g'^(~key*~s) ) @ #vk.26 )
                              case channel_send_case_1
                              solve( !KU( ~key ) @ #vk.35 )
                                case static_reveal
                                solve( !KU( 'g'^(~e*~key) ) @ #vk.31 )
                                  case c_exp
                                  solve( !KU( aead(kdf2(<'IK', 'g'^(~e*~key)>), '0',
                                                   h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>), 'g'^~s)
                                         ) @ #vk.27 )
                                    case channel_send
                                    solve( !KU( 'g'^~key ) @ #vk.24 )
                                      case channel_send
                                      solve( splitEqs(13) )
                                        case split_case_1
                                        solve( !KU( kdf2(<'IK', 'g'^~e0.1>) ) @ #vk.37 )
                                          case c_kdf2
                                          solve( !KU( 'g'^~e.1 ) @ #vk.28 )
                                            case channel_send
                                            solve( !KU( 'g'^~e ) @ #vk.29 )
                                              case channel_send
                                              solve( !KU( aead(kdf2(<kdf1(<'IK', 'g'^(~e*~key)>), 
                                                                     'g'^(~key*~s)>),
                                                               '0',
                                                               h(<
                                                                  h(<h(<h(<'IK', prologue>), 'g'^~key>), 
                                                                     'g'^~e>), 
                                                                  aead(kdf2(<'IK', 'g'^(~e*~key)>), '0',
                                                                       h(<h(<h(<'IK', prologue>), 'g'^~key>), 
                                                                          'g'^~e>),
                                                                       'g'^~s)
                                                                 >),
                                                               payload)
                                                     ) @ #vk.30 )
                                                case channel_send
                                                solve( !KU( 'g'^~e0 ) @ #vk.38 )
                                                  case c_exp
                                                  solve( !KU( ~e0 ) @ #vk.42 )
                                                    case ephemeral_reveal
                                                    solve( !KU( 'g'^~e0.1 ) @ #vk.42 )
                                                      case c_exp
                                                      solve( !KU( ~e0.1 ) @ #vk.43 )
                                                        case ephemeral_reveal
                                                        SOLVED // trace found
                                                      qed
                                                    qed
                                                  qed
                                                qed
                                              qed
                                            qed
                                          qed
                                        qed
                                      qed
                                    qed
                                  qed
                                qed
                              qed
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

