lemma Secrecy_IK_2_for_Responder_unless_dishonest_rs_or_reveal_e_Before_or_reveal_s_Before_or_reveal_rs_Before_end:
  all-traces
  "∀ msg e me re peer #claim.
    (Secret_IK_2_Responder( e, me, re, peer, msg ) @ #claim) ⇒
    ((¬(∃ #attack. K( msg ) @ #attack)) ∨
     ((((¬(∃ #honest. HonestPk( peer ) @ #honest)) ∨
        (∃ #reveal. (RevealEk( e ) @ #reveal) ∧ (#reveal < #claim))) ∨
       (∃ #reveal. (RevealLtk( me ) @ #reveal) ∧ (#reveal < #claim))) ∨
      (∃ #reveal. (RevealLtk( peer ) @ #reveal) ∧ (#reveal < #claim))))"
/*
guarded formula characterizing all counter-examples:
"∃ msg e me re peer #claim.
  (Secret_IK_2_Responder( e, me, re, peer, msg ) @ #claim)
 ∧
  (∃ #attack. (K( msg ) @ #attack)) ∧
  (∃ #honest. (HonestPk( peer ) @ #honest)) ∧
  (∀ #reveal. (RevealEk( e ) @ #reveal) ⇒ ¬(#reveal < #claim)) ∧
  (∀ #reveal. (RevealLtk( me ) @ #reveal) ⇒ ¬(#reveal < #claim)) ∧
  (∀ #reveal. (RevealLtk( peer ) @ #reveal) ⇒ ¬(#reveal < #claim))"
*/
simplify
solve( HandshakeState_Responder_1( id, hash, ck, k, re, ~s, 'g'^~key
       ) ▶₀ #claim )
  case Handshake_Responder_Recv_1
  solve( Handshake_Snd_2( ~id, msg ) ▶₁ #claim )
    case Instrumentation_Responder_2
    solve( Ek( ~e0 ) ▶₂ #claim )
      case ephemeral_keygen
      solve( !KU( ~n ) @ #vk )
        case channel_send
        solve( !KU( kdf2(<kdf1(<kdf1(<kdf1(<'IK', z>), 'g'^(~key*~s)>), z.1>), 
                          'g'^(~e0*~key)>)
               ) @ #vk.7 )
          case c_kdf2
          solve( !KU( kdf1(<kdf1(<kdf1(<'IK', z>), 'g'^(~key*~s)>), z.1>)
                 ) @ #vk.10 )
            case c_kdf1
            solve( !KU( kdf1(<kdf1(<'IK', z>), 'g'^(~key*~s)>) ) @ #vk.13 )
              case c_kdf1
              solve( !KU( 'g'^(~e0*~key) ) @ #vk.12 )
                case c_exp
                solve( !KU( ~e0 ) @ #vk.20 )
                  case ephemeral_reveal
                  solve( !KU( ~key ) @ #vk.21 )
                    case static_reveal
                    solve( !KU( 'g'^(~key*~s) ) @ #vk.20 )
                      case c_exp
                      solve( !KU( ~s ) @ #vk.23 )
                        case static_reveal
                        solve( !KU( aead(kdf2(<'IK', z>), '0',
                                         h(<h(<h(<'IK', prologue>), 'g'^~s>), re>), 'g'^~key)
                               ) @ #vk.17 )
                          case c_aead
                          solve( !KU( aead(kdf2(<kdf1(<'IK', z>), 'g'^(~key*~s)>), '0',
                                           h(<h(<h(<h(<'IK', prologue>), 'g'^~s>), re>), 
                                              aead(kdf2(<'IK', z>), '0',
                                                   h(<h(<h(<'IK', prologue>), 'g'^~s>), re>), 'g'^~key)
                                             >),
                                           payload)
                                 ) @ #vk.18 )
                            case channel_send
                            solve( !KU( kdf1(<'IK', 'g'^(~e0*~s)>) ) @ #vk.22 )
                              case c_kdf1
                              solve( !KU( kdf2(<'IK', 'g'^(~e0*~s)>) ) @ #vk.24 )
                                case c_kdf2
                                solve( !KU( 'g'^(~e0*~e0.1) ) @ #vk.23 )
                                  case c_exp
                                  solve( !KU( ~e0 ) @ #vk.33 )
                                    case ephemeral_reveal
                                    solve( !KU( 'g'^(~e0*~s) ) @ #vk.33 )
                                      case channel_send_case_2
                                      solve( splitEqs(11) )
                                        case split_case_1
                                        solve( !KU( kdf2(<'IK', 'g'^~e0.2>) ) @ #vk.34 )
                                          case c_kdf2
                                          solve( !KU( h(<h(<h(<'IK', prologue>), 'g'^~s>), 'g'^~e0>)
                                                 ) @ #vk.31 )
                                            case c_h
                                            solve( !KU( h(<h(<'IK', prologue>), 'g'^~s>) ) @ #vk.40 )
                                              case c_h
                                              solve( !KU( h(<'IK', prologue>) ) @ #vk.42 )
                                                case c_h
                                                solve( !KU( 'g'^~key ) @ #vk.37 )
                                                  case static_keygen
                                                  solve( !KU( 'g'^~s ) @ #vk.32 )
                                                    case channel_send
                                                    solve( !KU( 'g'^~e0 ) @ #vk.33 )
                                                      case c_exp
                                                      solve( !KU( 'g'^~e0.2 ) @ #vk.43 )
                                                        case c_exp
                                                        solve( !KU( ~e0.2 ) @ #vk.44 )
                                                          case ephemeral_reveal
                                                          SOLVED // trace found
                                                        qed
                                                      qed
                                                    qed
                                                  qed
                                                qed
                                              qed
                                            qed
                                          qed
                                        qed
                                      qed
                                    qed
                                  qed
                                qed
                              qed
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

