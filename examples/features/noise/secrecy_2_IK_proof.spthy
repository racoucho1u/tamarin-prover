                                        'g'^~s)
                                  >),
                                payload)
                          >), 
                        'g'^~e.1>),
                     msg)
               >
         ) ▶₁ #claim )
    case channel_receive
    solve( splitEqs(0) )
      case split_case_1
      solve( !KU( aead(kdf2(<
                             kdf1(<kdf1(<kdf1(<'IK', 'g'^~e>), 'g'^~s>), 'g'^(~e*~e.1)>), 
                             'g'^(~s*~e.1)>),
                       '0',
                       h(<
                          h(<
                             h(<h(<h(<h(<'IK', prologue>), 'g'>), 'g'^~e>), 
                                aead(kdf2(<'IK', 'g'^~e>), '0',
                                     h(<h(<h(<'IK', prologue>), 'g'>), 'g'^~e>), 'g'^~s)
                               >), 
                             aead(kdf2(<kdf1(<'IK', 'g'^~e>), 'g'^~s>), '0',
                                  h(<h(<h(<h(<'IK', prologue>), 'g'>), 'g'^~e>), 
                                     aead(kdf2(<'IK', 'g'^~e>), '0',
                                          h(<h(<h(<'IK', prologue>), 'g'>), 'g'^~e>), 'g'^~s)
                                    >),
                                  payload)
                            >), 
                          'g'^~e.1>),
                       msg)
