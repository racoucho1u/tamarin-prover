                                    by contradiction /* from formulas */
                                  qed
                                next
                                  case channel_send
                                  solve( !KU( ~s ) @ #vk.31 )
                                    case static_reveal
                                    by contradiction /* from formulas */
                                  qed
                                next
                                  case static_keygen
                                  solve( !KU( ~s.1 ) @ #vk.31 )
                                    case static_reveal
                                    by contradiction /* from formulas */
                                  qed
                                qed
                              qed
                            next
                              case split_case_2
                              solve( !KU( 'g'^(~s*~s.1) ) @ #vk.22 )
                                case c_exp
                                solve( !KU( ~s ) @ #vk.31 )
                                  case static_reveal
                                  by contradiction /* from formulas */
                                qed
                              next
                                case channel_send
                                solve( !KU( ~s ) @ #vk.29 )
                                  case static_reveal
                                  by contradiction /* from formulas */
                                qed
                              next
                                case static_keygen
                                solve( !KU( ~s.1 ) @ #vk.29 )
                                  case static_reveal
                                  by contradiction /* from formulas */
                                qed
                              qed
                            qed
                          next
                            case channel_send_case_2
                            solve( !KU( ~s.1 ) @ #vk.25 )
                              case static_reveal
                              by contradiction /* from formulas */
                            qed
                          next
                            case ephemeral_keygen
                            solve( !KU( ~s.1 ) @ #vk.25 )
                              case static_reveal
                              by contradiction /* from formulas */
                            qed
                          next
                            case static_keygen
                            solve( !KU( 'g'^(~s*~s.1) ) @ #vk.22 )
                              case c_exp
                              solve( !KU( ~s ) @ #vk.27 )
                                case static_reveal
                                by contradiction /* from formulas */
                              qed
                            next
                              case static_keygen_case_1
                              solve( !KU( ~s ) @ #vk.25 )
                                case static_reveal
                                by contradiction /* from formulas */
                              qed
                            next
                              case static_keygen_case_2
                              solve( !KU( ~s.1 ) @ #vk.25 )
                                case static_reveal
                                by contradiction /* from formulas */
                              qed
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma Secrecy_IK_2_for_Responder_unless_dishonest_re_or_reveal_e_Before_or_reveal_s_AnyTime_or_reveal_re_Before_or_reveal_rs_Before_end:
  all-traces
  "∀ msg e me re peer #claim.
    (Secret_IK_2_Responder( e, me, re, peer, msg ) @ #claim) ⇒
    ((¬(∃ #attack. K( msg ) @ #attack)) ∨
     (((((¬(∃ #honest. HonestEk( re ) @ #honest)) ∨
         (∃ #reveal. (RevealEk( e ) @ #reveal) ∧ (#reveal < #claim))) ∨
        (∃ #reveal. RevealLtk( me ) @ #reveal)) ∨
       (∃ #reveal. (RevealEk( re ) @ #reveal) ∧ (#reveal < #claim))) ∨
      (∃ #reveal. (RevealLtk( peer ) @ #reveal) ∧ (#reveal < #claim))))"
/*
guarded formula characterizing all counter-examples:
"∃ msg e me re peer #claim.
  (Secret_IK_2_Responder( e, me, re, peer, msg ) @ #claim)
 ∧
  (∃ #attack. (K( msg ) @ #attack)) ∧
  (∃ #honest. (HonestEk( re ) @ #honest)) ∧
  (∀ #reveal. (RevealEk( e ) @ #reveal) ⇒ ¬(#reveal < #claim)) ∧
  (∀ #reveal. (RevealLtk( me ) @ #reveal) ⇒ ⊥) ∧
  (∀ #reveal. (RevealEk( re ) @ #reveal) ⇒ ¬(#reveal < #claim)) ∧
  (∀ #reveal. (RevealLtk( peer ) @ #reveal) ⇒ ¬(#reveal < #claim))"
*/
simplify
solve( HandshakeState_Responder_1( id, hash, ck, k, 'g'^~e, ~s, peer
       ) ▶₀ #claim )
  case Handshake_Responder_Recv_1
  solve( Handshake_Snd_2( ~id, msg ) ▶₁ #claim )
    case Instrumentation_Responder_2
    solve( Ek( ~e0 ) ▶₂ #claim )
      case ephemeral_keygen
      solve( !KU( ~n ) @ #vk )
        case channel_send
        solve( !KU( kdf2(<
                          kdf1(<kdf1(<kdf1(<'IK', 'g'^(~e*~s)>), z>), 'g'^(~e*~e0)>), z.1>)
               ) @ #vk.7 )
          case c_kdf2
          solve( !KU( kdf1(<kdf1(<kdf1(<'IK', 'g'^(~e*~s)>), z>), 'g'^(~e*~e0)>)
                 ) @ #vk.10 )
            case c_kdf1
            solve( !KU( kdf1(<kdf1(<'IK', 'g'^(~e*~s)>), z>) ) @ #vk.13 )
              case c_kdf1
              solve( !KU( kdf1(<'IK', 'g'^(~e*~s)>) ) @ #vk.16 )
                case c_kdf1
                solve( !KU( 'g'^(~e*~e0) ) @ #vk.15 )
                  case c_exp
                  solve( !KU( ~e ) @ #vk.23 )
                    case ephemeral_reveal
                    solve( !KU( ~e0 ) @ #vk.24 )
                      case ephemeral_reveal
                      solve( !KU( 'g'^(~e*~s) ) @ #vk.23 )
                        case channel_send_case_2
                        solve( splitEqs(11) )
                          case split_case_1
                          solve( !KU( kdf2(<'IK', 'g'^~e0.1>) ) @ #vk.25 )
                            case c_kdf2
                            solve( !KU( aead(kdf2(<'IK', 'g'^(~e*~s)>), '0',
                                             h(<h(<h(<'IK', prologue>), 'g'^~s>), 'g'^~e>), peer)
                                   ) @ #vk.18 )
                              case channel_send
                              solve( !KU( 'g'^(~e0*~s.1) ) @ #vk.23 )
                                case c_exp
                                solve( !KU( ~s.1 ) @ #vk.33 )
                                  case static_reveal
                                  solve( !KU( 'g'^(~s*~s.1) ) @ #vk.26 )
                                    case channel_send_case_2
                                    solve( !KU( aead(kdf2(<kdf1(<'IK', 'g'^(~e*~s)>), 'g'^(~s*~s.1)>), '0',
                                                     h(<h(<h(<h(<'IK', prologue>), 'g'^~s>), 'g'^~e>), 
                                                        aead(kdf2(<'IK', 'g'^(~e*~s)>), '0',
                                                             h(<h(<h(<'IK', prologue>), 'g'^~s>), 'g'^~e>),
                                                             'g'^~s.1)
                                                       >),
                                                     payload)
                                           ) @ #vk.24 )
                                      case channel_send
                                      solve( !KU( 'g'^~e ) @ #vk.24 )
                                        case channel_send
                                        solve( !KU( 'g'^~e0.1 ) @ #vk.32 )
                                          case c_exp
                                          solve( !KU( ~e0.1 ) @ #vk.34 )
                                            case ephemeral_reveal
                                            solve( !KU( 'g'^~s ) @ #vk.27 )
                                              case channel_send
                                              SOLVED // trace found
                                            qed
                                          qed
                                        qed
                                      qed
                                    qed
                                  qed
                                qed
                              qed
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

