                                case ephemeral_reveal
                                by contradiction /* from formulas */
                              qed
                            next
                              case ephemeral_keygen
                              solve( !KU( ~s ) @ #vk.28 )
                                case static_reveal
                                by contradiction /* from formulas */
                              qed
                            next
                              case static_keygen
                              solve( !KU( ~e ) @ #vk.28 )
                                case ephemeral_reveal
                                by contradiction /* from formulas */
                              qed
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma Secrecy_IK_2_for_Initiator_unless_dishonest_re_or_reveal_e_AnyTime_or_reveal_re_Before_or_reveal_rs_Before_end:
  all-traces
  "∀ msg e me re peer #claim.
    (Secret_IK_2_Initiator( e, me, re, peer, msg ) @ #claim) ⇒
    ((¬(∃ #attack. K( msg ) @ #attack)) ∨
     ((((¬(∃ #honest. HonestEk( re ) @ #honest)) ∨
        (∃ #reveal. RevealEk( e ) @ #reveal)) ∨
       (∃ #reveal. (RevealEk( re ) @ #reveal) ∧ (#reveal < #claim))) ∨
      (∃ #reveal. (RevealLtk( peer ) @ #reveal) ∧ (#reveal < #claim))))"
/*
guarded formula characterizing all counter-examples:
"∃ msg e me re peer #claim.
  (Secret_IK_2_Initiator( e, me, re, peer, msg ) @ #claim)
 ∧
  (∃ #attack. (K( msg ) @ #attack)) ∧
  (∃ #honest. (HonestEk( re ) @ #honest)) ∧
  (∀ #reveal. (RevealEk( e ) @ #reveal) ⇒ ⊥) ∧
  (∀ #reveal. (RevealEk( re ) @ #reveal) ⇒ ¬(#reveal < #claim)) ∧
  (∀ #reveal. (RevealLtk( peer ) @ #reveal) ⇒ ¬(#reveal < #claim))"
*/
simplify
solve( HandshakeState_Initiator_1( id, hash, ck, k, ~e, ~s, peer
       ) ▶₀ #claim )
  case Handshake_Initiator_Snd_1
  solve( Recv( <'g'^~e.1, 
                aead(kdf2(<kdf1(<kdf1(<kdf1(<'IK', z>), z.1>), 'g'^(~e*~e.1)>), 
                           'g'^(~s*~e.1)>),
                     '0',
                     h(<
                        h(<
                           h(<h(<h(<h(<'IK', prologue>), peer>), 'g'^~e>), 
                              aead(kdf2(<'IK', z>), '0', h(<h(<h(<'IK', prologue>), peer>), 'g'^~e>),
                                   'g'^~s)
                             >), 
                           aead(kdf2(<kdf1(<'IK', z>), z.1>), '0',
                                h(<h(<h(<h(<'IK', prologue>), peer>), 'g'^~e>), 
                                   aead(kdf2(<'IK', z>), '0', h(<h(<h(<'IK', prologue>), peer>), 'g'^~e>),
                                        'g'^~s)
                                  >),
                                payload)
                          >), 
                        'g'^~e.1>),
                     msg)
               >
         ) ▶₁ #claim )
    case channel_receive
    solve( splitEqs(0) )
      case split_case_2
      solve( !KU( aead(kdf2(<
                             kdf1(<kdf1(<kdf1(<'IK', z>), z.1>), 'g'^(~e*~e.1)>), 'g'^(~s*~e.1)>),
                       '0',
                       h(<
                          h(<
                             h(<h(<h(<h(<'IK', prologue>), 'g'^rs>), 'g'^~e>), 
                                aead(kdf2(<'IK', z>), '0', h(<h(<h(<'IK', prologue>), 'g'^rs>), 'g'^~e>),
                                     'g'^~s)
                               >), 
                             aead(kdf2(<kdf1(<'IK', z>), z.1>), '0',
                                  h(<h(<h(<h(<'IK', prologue>), 'g'^rs>), 'g'^~e>), 
                                     aead(kdf2(<'IK', z>), '0', h(<h(<h(<'IK', prologue>), 'g'^rs>), 'g'^~e>),
                                          'g'^~s)
                                    >),
                                  payload)
                            >), 
                          'g'^~e.1>),
                       msg)
             ) @ #vk.6 )
        case channel_send
        solve( !KU( ~n ) @ #vk.1 )
          case channel_send
          solve( !KU( kdf2(<
                            kdf1(<kdf1(<kdf1(<'IK', 'g'^(~e*~s)>), 'g'^(~s*~s.1)>), 'g'^(~e*~e.1)>), 
                            'g'^(~e.1*~s.1)>)
                 ) @ #vk.12 )
            case c_kdf2
            solve( !KU( kdf1(<kdf1(<kdf1(<'IK', 'g'^(~e*~s)>), 'g'^(~s*~s.1)>), 
                              'g'^(~e*~e.1)>)
                   ) @ #vk.15 )
              case c_kdf1
              solve( !KU( kdf1(<kdf1(<'IK', 'g'^(~e*~s)>), 'g'^(~s*~s.1)>) ) @ #vk.18 )
                case c_kdf1
                solve( !KU( kdf1(<'IK', 'g'^(~e*~s)>) ) @ #vk.21 )
                  case c_kdf1
                  solve( !KU( 'g'^(~e.1*~s.1) ) @ #vk.19 )
                    case c_exp
                    solve( !KU( ~e.1 ) @ #vk.28 )
                      case ephemeral_reveal
                      solve( !KU( ~s.1 ) @ #vk.29 )
                        case static_reveal
                        solve( !KU( 'g'^(~e*~e.1) ) @ #vk.24 )
                          case channel_send_case_1
                          solve( !KU( 'g'^(~s*~s.1) ) @ #vk.25 )
                            case c_exp
                            solve( !KU( ~s ) @ #vk.31 )
                              case static_reveal
                              solve( !KU( 'g'^(~e*~s) ) @ #vk.30 )
                                case channel_send_case_1
                                solve( !KU( 'g'^~e.1 ) @ #vk.24 )
                                  case channel_send
                                  solve( !KU( 'g'^~s ) @ #vk.25 )
                                    case channel_send
                                    solve( splitEqs(19) )
                                      case split_case_1
                                      solve( !KU( kdf2(<'IK', 'g'^~e0>) ) @ #vk.32 )
                                        case c_kdf2
                                        solve( !KU( 'g'^~e ) @ #vk.24 )
                                          case channel_send
                                          solve( !KU( aead(kdf2(<'IK', 'g'^(~e*~s)>), '0',
                                                           h(<h(<h(<'IK', prologue>), 'g'^~s>), 'g'^~e>),
                                                           'g'^~s.1)
                                                 ) @ #vk.28 )
                                            case channel_send
                                            solve( !KU( aead(kdf2(<kdf1(<'IK', 'g'^(~e*~s)>), 'g'^(~s*~s.1)>),
                                                             '0',
                                                             h(<
                                                                h(<h(<h(<'IK', prologue>), 'g'^~s>), 'g'^~e
                                                                  >), 
                                                                aead(kdf2(<'IK', 'g'^(~e*~s)>), '0',
                                                                     h(<h(<h(<'IK', prologue>), 'g'^~s>), 
                                                                        'g'^~e>),
                                                                     'g'^~s.1)
                                                               >),
                                                             payload)
                                                   ) @ #vk.29 )
                                              case channel_send
                                              solve( !KU( 'g'^~e0 ) @ #vk.36 )
                                                case c_exp
                                                solve( !KU( ~e0 ) @ #vk.37 )
                                                  case ephemeral_reveal
                                                  SOLVED // trace found
                                                qed
                                              qed
                                            qed
                                          qed
                                        qed
                                      qed
                                    qed
                                  qed
                                qed
                              qed
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

