lemma Secrecy_IK_2_for_Initiator_unless_dishonest_re_or_reveal_s_AnyTime_or_reveal_re_AnyTime_or_reveal_rs_Before_end:
  all-traces
  "∀ msg e me re peer #claim.
    (Secret_IK_2_Initiator( e, me, re, peer, msg ) @ #claim) ⇒
    ((¬(∃ #attack. K( msg ) @ #attack)) ∨
     ((((¬(∃ #honest. HonestEk( re ) @ #honest)) ∨
        (∃ #reveal. RevealLtk( me ) @ #reveal)) ∨
       (∃ #reveal. RevealEk( re ) @ #reveal)) ∨
      (∃ #reveal. (RevealLtk( peer ) @ #reveal) ∧ (#reveal < #claim))))"
/*
guarded formula characterizing all counter-examples:
"∃ msg e me re peer #claim.
  (Secret_IK_2_Initiator( e, me, re, peer, msg ) @ #claim)
 ∧
  (∃ #attack. (K( msg ) @ #attack)) ∧
  (∃ #honest. (HonestEk( re ) @ #honest)) ∧
  (∀ #reveal. (RevealLtk( me ) @ #reveal) ⇒ ⊥) ∧
  (∀ #reveal. (RevealEk( re ) @ #reveal) ⇒ ⊥) ∧
  (∀ #reveal. (RevealLtk( peer ) @ #reveal) ⇒ ¬(#reveal < #claim))"
*/
simplify
solve( HandshakeState_Initiator_1( id, hash, ck, k, ~e, ~s, peer
       ) ▶₀ #claim )
  case Handshake_Initiator_Snd_1
  solve( Recv( <'g'^~e.1, 
                aead(kdf2(<kdf1(<kdf1(<kdf1(<'IK', z>), z.1>), 'g'^(~e*~e.1)>), 
                           'g'^(~s*~e.1)>),
                     '0',
                     h(<
                        h(<
                           h(<h(<h(<h(<'IK', prologue>), peer>), 'g'^~e>), 
                              aead(kdf2(<'IK', z>), '0', h(<h(<h(<'IK', prologue>), peer>), 'g'^~e>),
                                   'g'^~s)
                             >), 
                           aead(kdf2(<kdf1(<'IK', z>), z.1>), '0',
                                h(<h(<h(<h(<'IK', prologue>), peer>), 'g'^~e>), 
                                   aead(kdf2(<'IK', z>), '0', h(<h(<h(<'IK', prologue>), peer>), 'g'^~e>),
                                        'g'^~s)
                                  >),
                                payload)
                          >), 
                        'g'^~e.1>),
                     msg)
               >
         ) ▶₁ #claim )
    case channel_receive
    solve( splitEqs(0) )
      case split_case_1
      solve( !KU( aead(kdf2(<
                             kdf1(<kdf1(<kdf1(<'IK', 'g'^~e>), 'g'^~s>), 'g'^(~e*~e.1)>), 
                             'g'^(~s*~e.1)>),
                       '0',
                       h(<
                          h(<
                             h(<h(<h(<h(<'IK', prologue>), 'g'>), 'g'^~e>), 
                                aead(kdf2(<'IK', 'g'^~e>), '0',
                                     h(<h(<h(<'IK', prologue>), 'g'>), 'g'^~e>), 'g'^~s)
                               >), 
                             aead(kdf2(<kdf1(<'IK', 'g'^~e>), 'g'^~s>), '0',
                                  h(<h(<h(<h(<'IK', prologue>), 'g'>), 'g'^~e>), 
                                     aead(kdf2(<'IK', 'g'^~e>), '0',
                                          h(<h(<h(<'IK', prologue>), 'g'>), 'g'^~e>), 'g'^~s)
                                    >),
                                  payload)
                            >), 
                          'g'^~e.1>),
                       msg)
             ) @ #vk.6 )
        case c_aead
        solve( !KU( kdf2(<
                          kdf1(<kdf1(<kdf1(<'IK', 'g'^~e>), 'g'^~s>), 'g'^(~e*~e.1)>), 
                          'g'^(~s*~e.1)>)
               ) @ #vk.7 )
          case c_kdf2
          solve( !KU( kdf1(<kdf1(<kdf1(<'IK', 'g'^~e>), 'g'^~s>), 'g'^(~e*~e.1)>)
                 ) @ #vk.11 )
            case c_kdf1
            solve( !KU( kdf1(<kdf1(<'IK', 'g'^~e>), 'g'^~s>) ) @ #vk.14 )
              case c_kdf1
              solve( !KU( kdf1(<'IK', 'g'^~e>) ) @ #vk.17 )
                case c_kdf1
                solve( !KU( 'g'^(~s*~e.1) ) @ #vk.15 )
                  case c_exp
                  solve( !KU( ~s ) @ #vk.23 )
                    case static_reveal
                    by contradiction /* from formulas */
                  qed
                next
                  case channel_send_case_1
                  solve( !KU( ~s ) @ #vk.22 )
                    case static_reveal
                    by contradiction /* from formulas */
                  qed
                next
                  case channel_send_case_2
                  solve( !KU( ~e.1 ) @ #vk.23 )
                    case ephemeral_reveal
                    by contradiction /* from formulas */
                  qed
                next
                  case channel_send_case_3
                  solve( !KU( ~s ) @ #vk.22 )
                    case static_reveal
                    by contradiction /* from formulas */
                  qed
                next
                  case ephemeral_keygen
                  solve( !KU( ~s ) @ #vk.22 )
                    case static_reveal
                    by contradiction /* from formulas */
                  qed
                next
                  case static_keygen
                  solve( !KU( ~e.1 ) @ #vk.22 )
                    case ephemeral_reveal
                    by contradiction /* from formulas */
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    next
      case split_case_2
      solve( !KU( aead(kdf2(<
                             kdf1(<kdf1(<kdf1(<'IK', z>), z.1>), 'g'^(~e*~e.1)>), 'g'^(~s*~e.1)>),
                       '0',
                       h(<
                          h(<
                             h(<h(<h(<h(<'IK', prologue>), 'g'^rs>), 'g'^~e>), 
                                aead(kdf2(<'IK', z>), '0', h(<h(<h(<'IK', prologue>), 'g'^rs>), 'g'^~e>),
                                     'g'^~s)
                               >), 
                             aead(kdf2(<kdf1(<'IK', z>), z.1>), '0',
                                  h(<h(<h(<h(<'IK', prologue>), 'g'^rs>), 'g'^~e>), 
                                     aead(kdf2(<'IK', z>), '0', h(<h(<h(<'IK', prologue>), 'g'^rs>), 'g'^~e>),
                                          'g'^~s)
                                    >),
                                  payload)
                            >), 
                          'g'^~e.1>),
                       msg)
             ) @ #vk.6 )
        case c_aead
        solve( !KU( kdf2(<kdf1(<kdf1(<kdf1(<'IK', z>), z.1>), 'g'^(~e*~e.1)>), 
                          'g'^(~s*~e.1)>)
               ) @ #vk.7 )
          case c_kdf2
          solve( !KU( kdf1(<kdf1(<kdf1(<'IK', z>), z.1>), 'g'^(~e*~e.1)>)
                 ) @ #vk.11 )
            case c_kdf1
            solve( !KU( 'g'^(~s*~e.1) ) @ #vk.12 )
              case c_exp
              solve( !KU( ~s ) @ #vk.18 )
                case static_reveal
                by contradiction /* from formulas */
              qed
            next
              case channel_send_case_1
              solve( !KU( ~s ) @ #vk.16 )
                case static_reveal
                by contradiction /* from formulas */
              qed
            next
              case channel_send_case_2
              solve( !KU( ~e.1 ) @ #vk.17 )
                case ephemeral_reveal
                by contradiction /* from formulas */
              qed
            next
              case channel_send_case_3
              solve( !KU( ~s ) @ #vk.16 )
                case static_reveal
                by contradiction /* from formulas */
              qed
            next
              case ephemeral_keygen
              solve( !KU( ~s ) @ #vk.16 )
                case static_reveal
                by contradiction /* from formulas */
              qed
            next
              case static_keygen
              solve( !KU( ~e.1 ) @ #vk.16 )
                case ephemeral_reveal
                by contradiction /* from formulas */
              qed
            qed
          qed
        qed
      next
        case channel_send
        solve( !KU( ~n ) @ #vk.1 )
          case channel_send
          solve( !KU( kdf2(<
                            kdf1(<kdf1(<kdf1(<'IK', 'g'^(~e*~s)>), 'g'^(~s*~s.1)>), 'g'^(~e*~e.1)>), 
                            'g'^(~e.1*~s.1)>)
                 ) @ #vk.12 )
            case c_kdf2
            solve( !KU( kdf1(<kdf1(<kdf1(<'IK', 'g'^(~e*~s)>), 'g'^(~s*~s.1)>), 
                              'g'^(~e*~e.1)>)
                   ) @ #vk.15 )
              case c_kdf1
              solve( !KU( kdf1(<kdf1(<'IK', 'g'^(~e*~s)>), 'g'^(~s*~s.1)>) ) @ #vk.18 )
                case c_kdf1
                solve( !KU( kdf1(<'IK', 'g'^(~e*~s)>) ) @ #vk.21 )
                  case c_kdf1
                  solve( !KU( 'g'^(~e.1*~s.1) ) @ #vk.19 )
                    case c_exp
                    solve( !KU( ~e.1 ) @ #vk.28 )
                      case ephemeral_reveal
                      by contradiction /* from formulas */
                    qed
                  next
                    case channel_send_case_1
                    solve( !KU( ~e.1 ) @ #vk.27 )
                      case ephemeral_reveal
                      by contradiction /* from formulas */
                    qed
                  next
                    case channel_send_case_2
                    solve( !KU( ~s.1 ) @ #vk.26 )
                      case static_reveal
