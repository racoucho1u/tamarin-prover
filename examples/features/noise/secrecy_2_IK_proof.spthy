         ) ▶₁ #claim )
    case channel_receive
    solve( splitEqs(0) )
      case split_case_1
      solve( !KU( aead(kdf2(<
                             kdf1(<kdf1(<kdf1(<'IK', 'g'^~e>), 'g'^~s>), 'g'^(~e*~e.1)>), 
                             'g'^(~s*~e.1)>),
