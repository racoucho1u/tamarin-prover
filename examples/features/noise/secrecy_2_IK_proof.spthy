          (¬(∃ #honest. HonestPk( peer ) @ #honest))) ∨
         (∃ #reveal. (RevealEk( e ) @ #reveal) ∧ (#reveal < #claim))) ∨
        (∃ #reveal. (RevealLtk( me ) @ #reveal) ∧ (#reveal < #claim))) ∨
       (∃ #reveal. (RevealEk( re ) @ #reveal) ∧ (#reveal < #claim))) ∨
      (∃ #reveal. (RevealLtk( peer ) @ #reveal) ∧ (#reveal < #claim))))"
/*
guarded formula characterizing all counter-examples:
"∃ msg e me re peer #claim.
  (Secret_IK_2_Initiator( e, me, re, peer, msg ) @ #claim)
 ∧
  (∃ #attack. (K( msg ) @ #attack)) ∧
  (∃ #honest. (HonestEk( re ) @ #honest)) ∧
  (∃ #honest. (HonestPk( peer ) @ #honest)) ∧
  (∀ #reveal. (RevealEk( e ) @ #reveal) ⇒ ¬(#reveal < #claim)) ∧
  (∀ #reveal. (RevealLtk( me ) @ #reveal) ⇒ ¬(#reveal < #claim)) ∧
  (∀ #reveal. (RevealEk( re ) @ #reveal) ⇒ ¬(#reveal < #claim)) ∧
  (∀ #reveal. (RevealLtk( peer ) @ #reveal) ⇒ ¬(#reveal < #claim))"
*/
simplify
solve( HandshakeState_Initiator_1( id, hash, ck, k, ~e, ~s, 'g'^~key
       ) ▶₀ #claim )
  case Handshake_Initiator_Snd_1
  solve( Recv( <'g'^~e.1, 
                aead(kdf2(<
                           kdf1(<kdf1(<kdf1(<'IK', 'g'^(~e*~key)>), 'g'^(~key*~s)>), 'g'^(~e*~e.1)
                                >), 
                           'g'^(~s*~e.1)>),
                     '0',
                     h(<
                        h(<
                           h(<h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>), 
                              aead(kdf2(<'IK', 'g'^(~e*~key)>), '0',
                                   h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>), 'g'^~s)
                             >), 
                           aead(kdf2(<kdf1(<'IK', 'g'^(~e*~key)>), 'g'^(~key*~s)>), '0',
                                h(<h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>), 
                                   aead(kdf2(<'IK', 'g'^(~e*~key)>), '0',
                                        h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>), 'g'^~s)
                                  >),
                                payload)
                          >), 
                        'g'^~e.1>),
                     msg)
               >
         ) ▶₁ #claim )
    case channel_receive
    solve( !KU( aead(kdf2(<
                           kdf1(<kdf1(<kdf1(<'IK', 'g'^(~e*~key)>), 'g'^(~key*~s)>), 'g'^(~e*~e.1)
                                >), 
                           'g'^(~s*~e.1)>),
                     '0',
                     h(<
                        h(<
                           h(<h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>), 
                              aead(kdf2(<'IK', 'g'^(~e*~key)>), '0',
                                   h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>), 'g'^~s)
                             >), 
                           aead(kdf2(<kdf1(<'IK', 'g'^(~e*~key)>), 'g'^(~key*~s)>), '0',
                                h(<h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>), 
                                   aead(kdf2(<'IK', 'g'^(~e*~key)>), '0',
                                        h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>), 'g'^~s)
                                  >),
                                payload)
                          >), 
                        'g'^~e.1>),
                     msg)
           ) @ #vk.6 )
      case channel_send
      solve( !KU( ~n ) @ #vk.1 )
        case channel_send
        solve( !KU( kdf2(<
                          kdf1(<kdf1(<kdf1(<'IK', 'g'^(~e*~key)>), 'g'^(~key*~s)>), 'g'^(~e*~e.1)
                               >), 
                          'g'^(~s*~e.1)>)
               ) @ #vk.12 )
          case c_kdf2
          solve( !KU( kdf1(<kdf1(<kdf1(<'IK', 'g'^(~e*~key)>), 'g'^(~key*~s)>), 
                            'g'^(~e*~e.1)>)
                 ) @ #vk.15 )
            case c_kdf1
            solve( !KU( kdf1(<kdf1(<'IK', 'g'^(~e*~key)>), 'g'^(~key*~s)>)
                   ) @ #vk.18 )
              case c_kdf1
              solve( !KU( kdf1(<'IK', 'g'^(~e*~key)>) ) @ #vk.21 )
                case c_kdf1
                solve( !KU( 'g'^(~s*~e.1) ) @ #vk.19 )
                  case c_exp
                  solve( !KU( ~s ) @ #vk.28 )
                    case static_reveal
                    solve( !KU( ~e.1 ) @ #vk.29 )
                      case ephemeral_reveal
                      solve( !KU( 'g'^(~e*~e.1) ) @ #vk.24 )
                        case c_exp
                        solve( !KU( ~e ) @ #vk.31 )
                          case ephemeral_reveal
                          solve( !KU( 'g'^(~key*~s) ) @ #vk.27 )
                            case c_exp
                            solve( !KU( ~key ) @ #vk.33 )
                              case static_reveal
                              solve( !KU( 'g'^(~e*~key) ) @ #vk.32 )
                                case c_exp
                                solve( !KU( aead(kdf2(<'IK', 'g'^(~e*~key)>), '0',
                                                 h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>), 'g'^~s)
                                       ) @ #vk.29 )
                                  case channel_send
                                  solve( !KU( 'g'^~key ) @ #vk.26 )
                                    case channel_send
                                    solve( splitEqs(8) )
                                      case split_case_1
                                      solve( !KU( kdf2(<'IK', 'g'^~e0>) ) @ #vk.35 )
                                        case c_kdf2
                                        solve( !KU( 'g'^~e.1 ) @ #vk.30 )
                                          case channel_send
                                          solve( !KU( 'g'^~e ) @ #vk.31 )
                                            case channel_send
                                            solve( !KU( aead(kdf2(<kdf1(<'IK', 'g'^(~e*~key)>), 'g'^(~key*~s)
                                                                  >),
                                                             '0',
                                                             h(<
                                                                h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e
                                                                  >), 
                                                                aead(kdf2(<'IK', 'g'^(~e*~key)>), '0',
                                                                     h(<h(<h(<'IK', prologue>), 'g'^~key>), 
                                                                        'g'^~e>),
                                                                     'g'^~s)
                                                               >),
                                                             payload)
                                                   ) @ #vk.32 )
                                              case channel_send
                                              solve( !KU( 'g'^~e0 ) @ #vk.39 )
                                                case c_exp
                                                solve( !KU( ~e0 ) @ #vk.40 )
                                                  case ephemeral_reveal
                                                  SOLVED // trace found
                                                qed
                                              qed
                                            qed
                                          qed
                                        qed
                                      qed
                                    qed
                                  qed
                                qed
                              qed
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

rule (modulo E) Instrumentation_Initiator_2:
   [
   St_Initiator_1( ~id, me, peer ), MyEk_Initiator( ~id, e ),
   Handshake_Recv_2( ~id, msg )
   ]
  -->
   [ St_Initiator_2( ~id, e, me, peer ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Instrumentation_Initiator_3:
   [
   St_Initiator_2( ~id, e, me, peer ), PeerEk_Initiator( ~id, re ),
   In( msg )
   ]
  -->
   [ St_Initiator_3( ~id, e, me, re, peer ), I_Snd( ~id, '0', msg ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Instrumentation_Initiator_4:
   [ St_Initiator_3( ~id, e, me, re, peer ), I_Recv( ~id, '1', msg ) ]
  --[ Finish( ) ]->
   [ St_Initiator_4( ~id, e, me, re, peer ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Create_Responder:
   [ Fr( ~id ), !Pk( ~ltk, me ), In( prologue ) ]
  --[ Create_Responder( ) ]->
   [
   St_Responder_0( ~id, me ),
   Init_Handshake_Responder( ~id, prologue, ~ltk )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Instrumentation_Responder_1:
   [ St_Responder_0( ~id, me ), Handshake_Recv_1( ~id, msg ) ]
  -->
   [ St_Responder_1( ~id, me ) ]

  /* has exactly the trivial AC variant */

lemma Secrecy_IK_2_for_Responder_unless_dishonest_re_or_reveal_s_AnyTime_or_reveal_re_AnyTime_end:
  all-traces
  "∀ msg e me re peer #claim.
    (Secret_IK_2_Responder( e, me, re, peer, msg ) @ #claim) ⇒
    ((¬(∃ #attack. K( msg ) @ #attack)) ∨
     (((¬(∃ #honest. HonestEk( re ) @ #honest)) ∨
       (∃ #reveal. RevealLtk( me ) @ #reveal)) ∨
      (∃ #reveal. RevealEk( re ) @ #reveal)))"
/*
guarded formula characterizing all counter-examples:
"∃ msg e me re peer #claim.
  (Secret_IK_2_Responder( e, me, re, peer, msg ) @ #claim)
 ∧
  (∃ #attack. (K( msg ) @ #attack)) ∧
  (∃ #honest. (HonestEk( re ) @ #honest)) ∧
  (∀ #reveal. (RevealLtk( me ) @ #reveal) ⇒ ⊥) ∧
  (∀ #reveal. (RevealEk( re ) @ #reveal) ⇒ ⊥)"
*/
simplify
solve( HandshakeState_Responder_1( id, hash, ck, k, 'g'^~e, ~s, peer
       ) ▶₀ #claim )
  case Handshake_Responder_Recv_1
  solve( Handshake_Snd_2( ~id, msg ) ▶₁ #claim )
    case Instrumentation_Responder_2
    solve( Ek( ~e0 ) ▶₂ #claim )
      case ephemeral_keygen
      solve( !KU( ~n ) @ #vk )
        case channel_send
        solve( !KU( kdf2(<
                          kdf1(<kdf1(<kdf1(<'IK', 'g'^(~e*~s)>), z>), 'g'^(~e*~e0)>), z.1>)
               ) @ #vk.7 )
          case c_kdf2
          solve( !KU( kdf1(<kdf1(<kdf1(<'IK', 'g'^(~e*~s)>), z>), 'g'^(~e*~e0)>)
                 ) @ #vk.10 )
            case c_kdf1
            solve( !KU( kdf1(<kdf1(<'IK', 'g'^(~e*~s)>), z>) ) @ #vk.13 )
              case c_kdf1
              solve( !KU( kdf1(<'IK', 'g'^(~e*~s)>) ) @ #vk.16 )
                case c_kdf1
                solve( !KU( 'g'^(~e*~e0) ) @ #vk.15 )
                  case c_exp
                  solve( !KU( ~e ) @ #vk.23 )
                    case ephemeral_reveal
                    by contradiction /* from formulas */
                  qed
                next
                  case channel_send_case_1
                  solve( !KU( ~e0 ) @ #vk.21 )
                    case ephemeral_reveal
                    solve( splitEqs(11) )
                      case split_case_1
                      solve( !KU( 'g'^(~e*~s) ) @ #vk.21 )
                        case c_exp
                        solve( !KU( ~e ) @ #vk.26 )
                          case ephemeral_reveal
                          by contradiction /* from formulas */
                        qed
                      next
                        case channel_send_case_1
                        solve( !KU( ~s ) @ #vk.25 )
                          case static_reveal
                          by contradiction /* from formulas */
                        qed
                      next
                        case channel_send_case_2
                        solve( !KU( ~e ) @ #vk.26 )
                          case ephemeral_reveal
                          by contradiction /* from formulas */
                        qed
                      next
                        case static_keygen
                        solve( !KU( ~e ) @ #vk.25 )
                          case ephemeral_reveal
                          by contradiction /* from formulas */
                        qed
                      qed
                    next
                      case split_case_2
                      solve( !KU( 'g'^(~e*~s) ) @ #vk.21 )
                        case c_exp
                        solve( !KU( ~e ) @ #vk.27 )
                          case ephemeral_reveal
                          by contradiction /* from formulas */
                        qed
                      next
                        case channel_send_case_1
                        solve( !KU( ~s ) @ #vk.25 )
                          case static_reveal
                          by contradiction /* from formulas */
                        qed
                      next
                        case channel_send_case_2
                        solve( !KU( ~e ) @ #vk.26 )
                          case ephemeral_reveal
                          by contradiction /* from formulas */
                        qed
                      next
                        case static_keygen
                        solve( !KU( ~e ) @ #vk.25 )
                          case ephemeral_reveal
                          by contradiction /* from formulas */
                        qed
                      qed
                    qed
                  qed
                next
                  case channel_send_case_2
                  solve( !KU( ~e ) @ #vk.21 )
                    case ephemeral_reveal
                    by contradiction /* from formulas */
                  qed
                next
                  case channel_send_case_3
                  solve( !KU( ~e0 ) @ #vk.21 )
                    case ephemeral_reveal
                    solve( !KU( 'g'^(~e*~s) ) @ #vk.21 )
                      case c_exp
                      solve( !KU( ~e ) @ #vk.30 )
                        case ephemeral_reveal
                        by contradiction /* from formulas */
                      qed
                    next
                      case channel_send_case_1
                      solve( !KU( ~e ) @ #vk.29 )
                        case ephemeral_reveal
                        by contradiction /* from formulas */
                      qed
                    next
                      case channel_send_case_2
                      solve( !KU( ~s ) @ #vk.28 )
                        case static_reveal
                        by contradiction /* from formulas */
                      qed
                    next
                      case static_keygen
                      solve( !KU( ~e ) @ #vk.28 )
                        case ephemeral_reveal
                        by contradiction /* from formulas */
                      qed
                    qed
                  qed
                next
                  case ephemeral_keygen_case_1
                  solve( !KU( ~e ) @ #vk.21 )
                    case ephemeral_reveal
                    by contradiction /* from formulas */
                  qed
                next
                  case ephemeral_keygen_case_2
                  solve( !KU( ~e0 ) @ #vk.21 )
                    case ephemeral_reveal
                    solve( !KU( 'g'^(~e*~s) ) @ #vk.21 )
                      case c_exp
                      solve( !KU( ~e ) @ #vk.24 )
                        case ephemeral_reveal
                        by contradiction /* from formulas */
                      qed
                    next
                      case channel_send
                      solve( !KU( ~e ) @ #vk.23 )
                        case ephemeral_reveal
                        by contradiction /* from formulas */
                      qed
                    next
                      case ephemeral_keygen
                      solve( !KU( ~s ) @ #vk.22 )
                        case static_reveal
                        by contradiction /* from formulas */
                      qed
                    next
                      case static_keygen
                      solve( !KU( ~e ) @ #vk.22 )
                        case ephemeral_reveal
                        by contradiction /* from formulas */
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

