  (∀ #reveal. (RevealEk( re ) @ #reveal) ⇒ ¬(#reveal < #claim)) ∧
  (∀ #reveal. (RevealLtk( peer ) @ #reveal) ⇒ ¬(#reveal < #claim))"
*/
simplify
solve( HandshakeState_Responder_1( id, hash, ck, k, re, ~s, 'g'^~key
       ) ▶₀ #claim )
  case Handshake_Responder_Recv_1
  solve( Handshake_Snd_2( ~id, msg ) ▶₁ #claim )
    case Instrumentation_Responder_2
    solve( Ek( ~e0 ) ▶₂ #claim )
      case ephemeral_keygen
      solve( !KU( ~n ) @ #vk )
        case channel_send
        solve( !KU( kdf2(<kdf1(<kdf1(<kdf1(<'IK', z>), 'g'^(~key*~s)>), z.1>), 
                          'g'^(~e0*~key)>)
               ) @ #vk.7 )
          case c_kdf2
          solve( !KU( kdf1(<kdf1(<kdf1(<'IK', z>), 'g'^(~key*~s)>), z.1>)
                 ) @ #vk.10 )
            case c_kdf1
            solve( !KU( kdf1(<kdf1(<'IK', z>), 'g'^(~key*~s)>) ) @ #vk.13 )
              case c_kdf1
              solve( !KU( 'g'^(~e0*~key) ) @ #vk.12 )
                case channel_send_case_2
                solve( !KU( ~key ) @ #vk.18 )
                  case static_reveal
                  solve( !KU( 'g'^(~key*~s) ) @ #vk.18 )
                    case c_exp
                    solve( !KU( ~s ) @ #vk.21 )
                      case static_reveal
                      solve( !KU( aead(kdf2(<'IK', z>), '0',
                                       h(<h(<h(<'IK', prologue>), 'g'^~s>), re>), 'g'^~key)
                             ) @ #vk.15 )
                        case channel_send
                        solve( !KU( kdf1(<'IK', 'g'^(~e0*~s)>) ) @ #vk.20 )
                          case c_kdf1
                          solve( !KU( 'g'^(~e0*~e0.1) ) @ #vk.20 )
                            case channel_send_case_2
                            solve( !KU( ~e0 ) @ #vk.27 )
                              case ephemeral_reveal
                              solve( !KU( 'g'^(~e0*~s) ) @ #vk.27 )
                                case c_exp
                                solve( !KU( aead(kdf2(<kdf1(<'IK', 'g'^(~e0*~s)>), 'g'^(~key*~s)>), '0',
                                                 h(<h(<h(<h(<'IK', prologue>), 'g'^~s>), 'g'^~e0>), 
                                                    aead(kdf2(<'IK', 'g'^(~e0*~s)>), '0',
                                                         h(<h(<h(<'IK', prologue>), 'g'^~s>), 'g'^~e0>),
                                                         'g'^~key)
                                                   >),
                                                 payload)
                                       ) @ #vk.21 )
                                  case channel_send
                                  solve( !KU( 'g'^~s ) @ #vk.27 )
                                    case channel_send
                                    solve( splitEqs(21) )
                                      case split_case_1
                                      solve( !KU( kdf2(<'IK', 'g'^~e0.2>) ) @ #vk.29 )
                                        case c_kdf2
                                        solve( !KU( 'g'^~e0 ) @ #vk.24 )
                                          case channel_send
                                          solve( !KU( 'g'^~e0.2 ) @ #vk.33 )
                                            case c_exp
                                            solve( !KU( ~e0.2 ) @ #vk.34 )
                                              case ephemeral_reveal
                                              SOLVED // trace found
                                            qed
                                          qed
                                        qed
                                      qed
                                    qed
                                  qed
                                qed
                              qed
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

