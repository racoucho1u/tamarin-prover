                                        case split_case_1
                                        solve( !KU( kdf1(<'IK', 'g'^~s>) ) @ #vk.27 )
                                          case c_kdf1
                                          solve( !KU( kdf2(<'IK', 'g'^~s>) ) @ #vk.34 )
                                            case c_kdf2
                                            solve( !KU( h(<'IK', prologue>) ) @ #vk.37 )
                                              case c_h
                                              solve( !KU( 'g'^~e0.1 ) @ #vk.36 )
                                                case c_exp
                                                solve( !KU( ~e0.1 ) @ #vk.40 )
                                                  case ephemeral_reveal
                                                  solve( !KU( 'g'^~key ) @ #vk.29 )
                                                    case channel_send
                                                    solve( !KU( 'g'^~s ) @ #vk.40 )
                                                      case c_exp
                                                      solve( !KU( 'g'^~e0 ) @ #vk.27 )
                                                        case channel_send
