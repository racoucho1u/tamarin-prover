                                                                     h(<h(<h(<'IK', prologue>), 'g'^~key>), 
                                                                        'g'^~e>),
                                                                     'g'^~s)
                                                               >),
                                                             payload)
                                                   ) @ #vk.32 )
                                              case channel_send
                                              solve( !KU( 'g'^~e0 ) @ #vk.39 )
                                                case c_exp
                                                solve( !KU( ~e0 ) @ #vk.40 )
                                                  case ephemeral_reveal
                                                  SOLVED // trace found
                                                qed
                                              qed
                                            qed
                                          qed
                                        qed
                                      qed
                                    qed
                                  qed
                                qed
                              qed
                            qed
                          qed
                        qed
