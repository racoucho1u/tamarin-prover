rule (modulo E) Instrumentation_Responder_2:
   [
   St_Responder_1( ~id, me ), PeerEk_Responder( ~id, re ),
   PeerLtk_Responder( ~id, peer ), Fr( msg )
   ]
  -->
   [ St_Responder_2( ~id, me, re, peer ), Handshake_Snd_2( ~id, msg ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Instrumentation_Responder_3:
   [
   St_Responder_2( ~id, me, re, peer ), MyEk_Responder( ~id, e ),
   R_Recv( ~id, '0', msg )
   ]
  -->
   [ St_Responder_3( ~id, e, me, re, peer ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Instrumentation_Responder_4:
   [ St_Responder_3( ~id, e, me, re, peer ), In( msg ) ]
  -->
   [ St_Responder_4( ~id, e, me, re, peer ), R_Snd( ~id, '1', msg ) ]

  /* has exactly the trivial AC variant */

lemma executabilityPassiveAdv:
  exists-trace
  "(((∃ #i. Finish( ) @ #i) ∧
     ((∀ id m #j.
        (RawRecv( id, m ) @ #j) ⇒ (∃ #k. (RawSnd( id, m ) @ #k) ∧ (#k < #j))) ∧
      ((∀ id m m2 #a #b.
         ((RawSnd( id, m ) @ #a) ∧ (RawSnd( id, m2 ) @ #b)) ⇒ (#a = #b)) ∧
       ((∀ #a #b.
          ((Create_Initiator( ) @ #a) ∧ (Create_Initiator( ) @ #b)) ⇒ (#a = #b)) ∧
        (∀ #a #b.
          ((Create_Responder( ) @ #a) ∧ (Create_Responder( ) @ #b)) ⇒
          (#a = #b)))))) ∧
    ((¬(∃ key #k. RevealLtk( key ) @ #k)) ∧
     (¬(∃ key #k. RevealEk( key ) @ #k)))) ∧
   (∀ k #t. (Peer( k ) @ #t) ⇒ (∃ #h. HonestPk( k ) @ #h))"
/*
guarded formula characterizing all satisfying traces:
"(∃ #i. (Finish( ) @ #i)) ∧
 (∀ id m #j.
   (RawRecv( id, m ) @ #j) ⇒ ∃ #k. (RawSnd( id, m ) @ #k) ∧ #k < #j) ∧
 (∀ id m m2 #a #b.
   (RawSnd( id, m ) @ #a) ∧ (RawSnd( id, m2 ) @ #b) ⇒ #a = #b) ∧
 (∀ #a #b.
   (Create_Initiator( ) @ #a) ∧ (Create_Initiator( ) @ #b) ⇒ #a = #b) ∧
 (∀ #a #b.
   (Create_Responder( ) @ #a) ∧ (Create_Responder( ) @ #b) ⇒ #a = #b) ∧
 (∀ key #k. (RevealLtk( key ) @ #k) ⇒ ⊥) ∧
 (∀ key #k. (RevealEk( key ) @ #k) ⇒ ⊥) ∧
 (∀ k #t. (Peer( k ) @ #t) ⇒ ∃ #h. (HonestPk( k ) @ #h))"
*/
simplify
solve( St_Initiator_3( ~id, e, me, re, peer ) ▶₀ #i )
  case Instrumentation_Initiator_3
  solve( I_Recv( ~id, '1', msg ) ▶₁ #i )
    case I_Recv_from_R
    solve( RawSnd( 'Responder2',
                   <re, 
                    aead(kdf2(<
                               kdf1(<kdf1(<kdf1(<'IK', 'g'^(~e*~key)>), 'g'^(~key*~s)>), z>), z.1>),
                         '0',
                         h(<
                            h(<
                               h(<h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>), 
                                  aead(kdf2(<'IK', 'g'^(~e*~key)>), '0',
                                       h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>), 'g'^~s)
                                 >), 
                               aead(kdf2(<kdf1(<'IK', 'g'^(~e*~key)>), 'g'^(~key*~s)>), '0',
                                    h(<h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>), 
                                       aead(kdf2(<'IK', 'g'^(~e*~key)>), '0',
                                            h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>), 'g'^~s)
                                      >),
                                    msg.2)
                              >), 
                            re>),
                         msg.3)
                   >
           ) @ #k )
      case Handshake_Responder_Snd_2
      solve( HandshakeState_Responder_1( id.1,
                                         h(<
                                            h(<h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>), 
                                               aead(kdf2(<'IK', 'g'^(~e*~key)>), '0',
                                                    h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>), 'g'^~s)
                                              >), 
                                            aead(kdf2(<kdf1(<'IK', 'g'^(~e*~key)>), 'g'^(~key*~s)>), '0',
                                                 h(<h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>), 
                                                    aead(kdf2(<'IK', 'g'^(~e*~key)>), '0',
                                                         h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>),
                                                         'g'^~s)
                                                   >),
                                                 msg.1)
                                           >),
                                         kdf1(<kdf1(<'IK', 'g'^(~e*~key)>), 'g'^(~key*~s)>), k.1, 'g'^~e,
                                         ~s.1, 'g'^~s
             ) ▶₀ #k )
        case Handshake_Responder_Recv_1
        solve( Handshake_Snd_2( ~id.1, msg.2 ) ▶₁ #k )
          case Instrumentation_Responder_2
          solve( Ek( ~e0 ) ▶₂ #k )
            case ephemeral_keygen
            solve( RawSnd( <'R', '1'>,
                           <'1', 
                            aead(kdf2(kdf1(<
                                            kdf1(<kdf1(<kdf1(<'IK', 'g'^(~e*~key)>), 'g'^(~key*~s)>), 
                                                  'g'^(~e*~e0)>), 
                                            'g'^(~e0*~s)>)),
                                 '1', '0', msg)
                           >
                   ) @ #k.1 )
              case R_Snd_to_I
              solve( R_Snd( id.2, '1', msg ) ▶₀ #k.1 )
                case Instrumentation_Responder_4
                solve( !Transport_Responder( ~id.1, ki2r,
                                             kdf2(kdf1(<
                                                        kdf1(<
                                                              kdf1(<kdf1(<'IK', 'g'^(~e*~key)>), 'g'^(~key*~s)
                                                                   >), 
                                                              'g'^(~e*~e0)>), 
                                                        'g'^(~e0*~s)>))
                       ) ▶₁ #k.1 )
                  case Responder_to_transport_mode
                  solve( RawSnd( 'Initiator1',
                                 <'g'^~e, 
                                  aead(kdf2(<'IK', 'g'^(~e*~key)>), '0',
                                       h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>), 'g'^~s), 
                                  aead(kdf2(<kdf1(<'IK', 'g'^(~e*~key)>), 'g'^(~key*~s)>), '0',
                                       h(<h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>), 
                                          aead(kdf2(<'IK', 'g'^(~e*~key)>), '0',
                                               h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>), 'g'^~s)
                                         >),
                                       msg.1)
                                 >
                         ) @ #vr.4 )
                    case Handshake_Initiator_Snd_1
                    solve( RawSnd( <'I', '0'>,
                                   <'0', 
                                    aead(kdf1(kdf1(<
                                                    kdf1(<kdf1(<kdf1(<'IK', 'g'^(~e*~key)>), 'g'^(~key*~s)>), 
                                                          'g'^(~e*~e0)>), 
                                                    'g'^(~e0*~s)>)),
                                         '0', '0', msg.3)
                                   >
                           ) @ #k.2 )
                      case I_Snd_to_R
                      solve( I_Snd( id.2, '0', msg.3 ) ▶₀ #k.2 )
                        case Instrumentation_Initiator_3
                        solve( !Transport_Initiator( ~id,
                                                     kdf1(kdf1(<
                                                                kdf1(<
                                                                      kdf1(<kdf1(<'IK', 'g'^(~e*~key)>), 
                                                                            'g'^(~key*~s)>), 
                                                                      'g'^(~e*~e0)>), 
                                                                'g'^(~e0*~s)>)),
                                                     kr2i
                               ) ▶₁ #k.2 )
                          case Initiator_to_transport_mode
                          solve( !KU( aead(kdf2(<
                                                 kdf1(<kdf1(<kdf1(<'IK', 'g'^(~e*~key)>), 'g'^(~key*~s)>), 
                                                       'g'^(~e*~e0)>), 
                                                 'g'^(~e0*~s)>),
                                           '0',
                                           h(<
                                              h(<
                                                 h(<h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>), 
                                                    aead(kdf2(<'IK', 'g'^(~e*~key)>), '0',
                                                         h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>),
                                                         'g'^~s)
                                                   >), 
                                                 aead(kdf2(<kdf1(<'IK', 'g'^(~e*~key)>), 'g'^(~key*~s)>), '0',
                                                      h(<h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>), 
                                                         aead(kdf2(<'IK', 'g'^(~e*~key)>), '0',
                                                              h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>),
                                                              'g'^~s)
                                                        >),
                                                      msg.1)
                                                >), 
                                              'g'^~e0>),
                                           ~n)
                                 ) @ #vk.4 )
                            case channel_send
                            solve( !KU( aead(kdf2(kdf1(<
                                                        kdf1(<
                                                              kdf1(<kdf1(<'IK', 'g'^(~e*~key)>), 'g'^(~key*~s)
                                                                   >), 
                                                              'g'^(~e*~e0)>), 
                                                        'g'^(~e0*~s)>)),
                                             '1', '0', msg)
                                   ) @ #vk.9 )
                              case channel_send
                              solve( !KU( aead(kdf2(<'IK', 'g'^(~e*~key)>), '0',
                                               h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>), 'g'^~s)
                                     ) @ #vk.13 )
                                case channel_send
                                solve( !KU( aead(kdf1(kdf1(<
                                                            kdf1(<
                                                                  kdf1(<kdf1(<'IK', 'g'^(~e*~key)>), 
                                                                        'g'^(~key*~s)>), 
                                                                  'g'^(~e*~e0)>), 
                                                            'g'^(~e0*~s)>)),
                                                 '0', '0', msg.2)
                                       ) @ #vk.18 )
                                  case channel_send
                                  solve( !KU( 'g'^~key ) @ #vk.12 )
                                    case static_keygen
                                    solve( !KU( 'g'^~e0 ) @ #vk.12 )
                                      case channel_send
                                      solve( !KU( 'g'^~e ) @ #vk.15 )
                                        case channel_send
                                        solve( !KU( aead(kdf2(<kdf1(<'IK', 'g'^(~e*~key)>), 'g'^(~key*~s)>),
