    26. ~e0   = ~e0.213
        z     = 'g'^(x.423*inv((~e0.213*x.424)))
        z.1   = 'g'
        z.2   = 'g'^(x.423*inv(x.424))
        z.3   = 'g'^~e0.213
    
    27. ~e0   = ~e0.213
        z     = 'g'^(x.423*inv((~e0.213*x.424)))
        z.1   = 'g'^inv(~e0.213)
        z.2   = 'g'^(x.423*inv(x.424))
        z.3   = 'g'
    
    28. ~e0   = ~e0.214
        z     = 'g'^re.426
        z.1   = 'g'^inv((~e0.214*x.425))
        z.2   = 'g'^(~e0.214*re.426)
        z.3   = 'g'^inv(x.425)
    
    29. ~e0   = ~e0.214
        z     = 'g'^re.426
        z.1   = 'g'^(x.425*inv(~e0.214))
        z.2   = 'g'^(~e0.214*re.426)
        z.3   = 'g'^x.425
    
    30. ~e0   = ~e0.214
        z     = 'g'^inv((~e0.214*x.424))
        z.1   = 'g'^(x.425*inv((~e0.214*x.426)))
        z.2   = 'g'^inv(x.424)
        z.3   = 'g'^(x.425*inv(x.426))
    
    31. ~e0   = ~e0.214
        z     = 'g'^(x.424*inv(~e0.214))
        z.1   = 'g'^(x.425*inv((~e0.214*x.426)))
        z.2   = 'g'^x.424
        z.3   = 'g'^(x.425*inv(x.426))
    
    32. ~e0   = ~e0.214
        z     = 'g'^(x.424*inv((~e0.214*x.425)))
        z.1   = 'g'^rs.426
        z.2   = 'g'^(x.424*inv(x.425))
        z.3   = 'g'^(~e0.214*rs.426)
    
    33. ~e0   = ~e0.214
        z     = 'g'^(x.424*inv((~e0.214*x.425)))
        z.1   = 'g'^inv((~e0.214*x.426))
        z.2   = 'g'^(x.424*inv(x.425))
        z.3   = 'g'^inv(x.426)
    
    34. ~e0   = ~e0.214
        z     = 'g'^(x.424*inv((~e0.214*x.425)))
        z.1   = 'g'^(x.426*inv(~e0.214))
        z.2   = 'g'^(x.424*inv(x.425))
        z.3   = 'g'^x.426
    
    35. ~e0   = ~e0.215
        z     = 'g'^re.428
        z.1   = 'g'^(x.426*inv((~e0.215*x.427)))
        z.2   = 'g'^(~e0.215*re.428)
        z.3   = 'g'^(x.426*inv(x.427))
    
    36. ~e0   = ~e0.215
        z     = 'g'^(x.425*inv((~e0.215*x.426)))
        z.1   = 'g'^(x.427*inv((~e0.215*x.428)))
        z.2   = 'g'^(x.425*inv(x.426))
        z.3   = 'g'^(x.427*inv(x.428))
  */

rule (modulo E) Responder_to_transport_mode:
   [ HandshakeState_Responder_2( id, hash, ck, k, ~e, 'g'^re, ~s, 'g'^rs ) ]
  -->
   [ !Transport_Responder( id, kdf1(ck), kdf2(ck) ), !SessionId( id, hash )
   ]

  /*
  rule (modulo AC) Responder_to_transport_mode:
     [ HandshakeState_Responder_2( id, hash, ck, k, ~e, z, ~s, z.1 ) ]
    -->
     [ !Transport_Responder( id, kdf1(ck), kdf2(ck) ), !SessionId( id, hash )
     ]
    variants (modulo AC)
    1. z     = 'g'
       z.1   = 'g'
    
    2. z     = 'g'
       z.1   = 'g'^rs.11
    
    3. z     = 'g'^re.11
       z.1   = 'g'
    
    4. z     = 'g'^re.11
       z.1   = 'g'^rs.11
  */

rule (modulo E) I_Recv_from_R:
   [
   Recv( <n, aead(kr2i, n, '0', msg)> ),
   !Transport_Initiator( id, ki2r, kr2i )
   ]
  --[ RawRecv( <'R', n>, <n, aead(kr2i, n, '0', msg)> ) ]->
   [ I_Recv( id, n, msg ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) R_Recv_from_I:
   [
   Recv( <n, aead(ki2r, n, '0', msg)> ),
   !Transport_Responder( id, ki2r, kr2i )
   ]
  --[ RawRecv( <'I', n>, <n, aead(ki2r, n, '0', msg)> ) ]->
   [ R_Recv( id, n, msg ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) I_Snd_to_R:
   [ I_Snd( id, n, msg ), !Transport_Initiator( id, ki2r, kr2i ) ]
  --[ RawSnd( <'I', n>, <n, aead(ki2r, n, '0', msg)> ) ]->
   [ Send( <n, aead(ki2r, n, '0', msg)> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) R_Snd_to_I:
   [ R_Snd( id, n, msg ), !Transport_Responder( id, ki2r, kr2i ) ]
  --[ RawSnd( <'R', n>, <n, aead(kr2i, n, '0', msg)> ) ]->
   [ Send( <n, aead(kr2i, n, '0', msg)> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) channel_send:
   [ Send( m ) ] --> [ Out( m ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) channel_receive:
   [ In( m ) ] --> [ Recv( m ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) disclose_sid:
   [ !SessionId( ~id, h ) ] --> [ Out( h ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) static_keygen:
   [ Fr( ~key ) ]
  --[ HonestPk( 'g'^~key ) ]->
   [ !Pk( ~key, 'g'^~key ), Out( 'g'^~key ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) static_reveal:
   [ !Pk( ~s, 'g'^~s ) ] --[ RevealLtk( 'g'^~s ) ]-> [ Out( ~s ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) ephemeral_keygen:
   [ Fr( ~e ) ]
  --[ HonestEk( 'g'^~e ) ]->
   [ Ek( ~e ), Out( 'g'^~e ), RevealableEk( ~e ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) ephemeral_reveal:
   [ RevealableEk( ~e ) ] --[ RevealEk( 'g'^~e ) ]-> [ Out( ~e ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Create_Initiator:
   [ Fr( ~id ), !Pk( ~ltk, me ), In( prologue ), In( peer ) ]
  --[ Create_Initiator( ), Peer( peer ) ]->
   [
   St_Initiator_0( ~id, me, peer ),
   Init_Handshake_Initiator( ~id, prologue, ~ltk, peer )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Instrumentation_Initiator_1:
   [ St_Initiator_0( ~id, me, peer ), In( msg ) ]
  -->
   [ St_Initiator_1( ~id, me, peer ), Handshake_Snd_1( ~id, msg ) ]

  /* has exactly the trivial AC variant */

lemma Secrecy_IK_2_for_Initiator_unless_dishonest_re_or_reveal_s_AnyTime_or_reveal_re_AnyTime_end:
  all-traces
  "∀ msg e me re peer #claim.
    (Secret_IK_2_Initiator( e, me, re, peer, msg ) @ #claim) ⇒
    ((¬(∃ #attack. K( msg ) @ #attack)) ∨
     (((¬(∃ #honest. HonestEk( re ) @ #honest)) ∨
       (∃ #reveal. RevealLtk( me ) @ #reveal)) ∨
      (∃ #reveal. RevealEk( re ) @ #reveal)))"
/*
guarded formula characterizing all counter-examples:
"∃ msg e me re peer #claim.
  (Secret_IK_2_Initiator( e, me, re, peer, msg ) @ #claim)
 ∧
  (∃ #attack. (K( msg ) @ #attack)) ∧
  (∃ #honest. (HonestEk( re ) @ #honest)) ∧
  (∀ #reveal. (RevealLtk( me ) @ #reveal) ⇒ ⊥) ∧
  (∀ #reveal. (RevealEk( re ) @ #reveal) ⇒ ⊥)"
*/
simplify
solve( HandshakeState_Initiator_1( id, hash, ck, k, ~e, ~s, peer
       ) ▶₀ #claim )
  case Handshake_Initiator_Snd_1
  solve( Recv( <'g'^~e.1, 
                aead(kdf2(<kdf1(<kdf1(<kdf1(<'IK', z>), z.1>), 'g'^(~e*~e.1)>), 
                           'g'^(~s*~e.1)>),
                     '0',
                     h(<
                        h(<
                           h(<h(<h(<h(<'IK', prologue>), peer>), 'g'^~e>), 
                              aead(kdf2(<'IK', z>), '0', h(<h(<h(<'IK', prologue>), peer>), 'g'^~e>),
                                   'g'^~s)
                             >), 
                           aead(kdf2(<kdf1(<'IK', z>), z.1>), '0',
                                h(<h(<h(<h(<'IK', prologue>), peer>), 'g'^~e>), 
                                   aead(kdf2(<'IK', z>), '0', h(<h(<h(<'IK', prologue>), peer>), 'g'^~e>),
                                        'g'^~s)
                                  >),
                                payload)
                          >), 
                        'g'^~e.1>),
                     msg)
               >
         ) ▶₁ #claim )
    case channel_receive
    solve( splitEqs(0) )
      case split_case_1
      solve( !KU( aead(kdf2(<
                             kdf1(<kdf1(<kdf1(<'IK', 'g'^~e>), 'g'^~s>), 'g'^(~e*~e.1)>), 
                             'g'^(~s*~e.1)>),
                       '0',
                       h(<
                          h(<
                             h(<h(<h(<h(<'IK', prologue>), 'g'>), 'g'^~e>), 
                                aead(kdf2(<'IK', 'g'^~e>), '0',
                                     h(<h(<h(<'IK', prologue>), 'g'>), 'g'^~e>), 'g'^~s)
                               >), 
                             aead(kdf2(<kdf1(<'IK', 'g'^~e>), 'g'^~s>), '0',
                                  h(<h(<h(<h(<'IK', prologue>), 'g'>), 'g'^~e>), 
                                     aead(kdf2(<'IK', 'g'^~e>), '0',
                                          h(<h(<h(<'IK', prologue>), 'g'>), 'g'^~e>), 'g'^~s)
                                    >),
                                  payload)
                            >), 
                          'g'^~e.1>),
                       msg)
             ) @ #vk.6 )
        case c_aead
        solve( !KU( kdf2(<
                          kdf1(<kdf1(<kdf1(<'IK', 'g'^~e>), 'g'^~s>), 'g'^(~e*~e.1)>), 
                          'g'^(~s*~e.1)>)
               ) @ #vk.7 )
          case c_kdf2
          solve( !KU( kdf1(<kdf1(<kdf1(<'IK', 'g'^~e>), 'g'^~s>), 'g'^(~e*~e.1)>)
                 ) @ #vk.11 )
            case c_kdf1
            solve( !KU( kdf1(<kdf1(<'IK', 'g'^~e>), 'g'^~s>) ) @ #vk.14 )
              case c_kdf1
              solve( !KU( kdf1(<'IK', 'g'^~e>) ) @ #vk.17 )
                case c_kdf1
                solve( !KU( 'g'^(~s*~e.1) ) @ #vk.15 )
                  case c_exp
                  solve( !KU( ~s ) @ #vk.23 )
                    case static_reveal
                    by contradiction /* from formulas */
                  qed
                next
                  case channel_send_case_1
                  solve( !KU( ~s ) @ #vk.22 )
                    case static_reveal
                    by contradiction /* from formulas */
                  qed
                next
                  case channel_send_case_2
                  solve( !KU( ~e.1 ) @ #vk.23 )
                    case ephemeral_reveal
                    by contradiction /* from formulas */
                  qed
                next
                  case channel_send_case_3
                  solve( !KU( ~s ) @ #vk.22 )
                    case static_reveal
                    by contradiction /* from formulas */
                  qed
                next
                  case ephemeral_keygen
                  solve( !KU( ~s ) @ #vk.22 )
                    case static_reveal
                    by contradiction /* from formulas */
                  qed
                next
                  case static_keygen
                  solve( !KU( ~e.1 ) @ #vk.22 )
                    case ephemeral_reveal
                    by contradiction /* from formulas */
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    next
      case split_case_2
      solve( !KU( aead(kdf2(<
                             kdf1(<kdf1(<kdf1(<'IK', z>), z.1>), 'g'^(~e*~e.1)>), 'g'^(~s*~e.1)>),
                       '0',
                       h(<
                          h(<
                             h(<h(<h(<h(<'IK', prologue>), 'g'^rs>), 'g'^~e>), 
                                aead(kdf2(<'IK', z>), '0', h(<h(<h(<'IK', prologue>), 'g'^rs>), 'g'^~e>),
                                     'g'^~s)
                               >), 
                             aead(kdf2(<kdf1(<'IK', z>), z.1>), '0',
                                  h(<h(<h(<h(<'IK', prologue>), 'g'^rs>), 'g'^~e>), 
                                     aead(kdf2(<'IK', z>), '0', h(<h(<h(<'IK', prologue>), 'g'^rs>), 'g'^~e>),
                                          'g'^~s)
                                    >),
                                  payload)
                            >), 
                          'g'^~e.1>),
                       msg)
             ) @ #vk.6 )
        case c_aead
        solve( !KU( kdf2(<kdf1(<kdf1(<kdf1(<'IK', z>), z.1>), 'g'^(~e*~e.1)>), 
                          'g'^(~s*~e.1)>)
               ) @ #vk.7 )
          case c_kdf2
          solve( !KU( kdf1(<kdf1(<kdf1(<'IK', z>), z.1>), 'g'^(~e*~e.1)>)
                 ) @ #vk.11 )
            case c_kdf1
            solve( !KU( 'g'^(~s*~e.1) ) @ #vk.12 )
              case c_exp
              solve( !KU( ~s ) @ #vk.18 )
                case static_reveal
                by contradiction /* from formulas */
              qed
            next
              case channel_send_case_1
              solve( !KU( ~s ) @ #vk.16 )
                case static_reveal
                by contradiction /* from formulas */
              qed
            next
              case channel_send_case_2
              solve( !KU( ~e.1 ) @ #vk.17 )
                case ephemeral_reveal
                by contradiction /* from formulas */
              qed
            next
              case channel_send_case_3
              solve( !KU( ~s ) @ #vk.16 )
                case static_reveal
                by contradiction /* from formulas */
              qed
            next
              case ephemeral_keygen
              solve( !KU( ~s ) @ #vk.16 )
                case static_reveal
                by contradiction /* from formulas */
              qed
            next
              case static_keygen
              solve( !KU( ~e.1 ) @ #vk.16 )
                case ephemeral_reveal
                by contradiction /* from formulas */
              qed
            qed
          qed
        qed
      next
        case channel_send
        solve( !KU( ~n ) @ #vk.1 )
          case channel_send
          solve( !KU( kdf2(<
                            kdf1(<kdf1(<kdf1(<'IK', 'g'^(~e*~s)>), 'g'^(~s*~s.1)>), 'g'^(~e*~e.1)>), 
                            'g'^(~e.1*~s.1)>)
                 ) @ #vk.12 )
            case c_kdf2
            solve( !KU( kdf1(<kdf1(<kdf1(<'IK', 'g'^(~e*~s)>), 'g'^(~s*~s.1)>), 
                              'g'^(~e*~e.1)>)
                   ) @ #vk.15 )
              case c_kdf1
              solve( !KU( kdf1(<kdf1(<'IK', 'g'^(~e*~s)>), 'g'^(~s*~s.1)>) ) @ #vk.18 )
                case c_kdf1
                solve( !KU( kdf1(<'IK', 'g'^(~e*~s)>) ) @ #vk.21 )
                  case c_kdf1
                  solve( !KU( 'g'^(~e.1*~s.1) ) @ #vk.19 )
                    case c_exp
                    solve( !KU( ~e.1 ) @ #vk.28 )
                      case ephemeral_reveal
                      by contradiction /* from formulas */
                    qed
                  next
                    case channel_send_case_1
                    solve( !KU( ~e.1 ) @ #vk.27 )
                      case ephemeral_reveal
                      by contradiction /* from formulas */
                    qed
                  next
                    case channel_send_case_2
                    solve( !KU( ~s.1 ) @ #vk.26 )
                      case static_reveal
                      by contradiction /* from formulas */
                    qed
                  next
                    case ephemeral_keygen
                    solve( !KU( ~s.1 ) @ #vk.26 )
                      case static_reveal
                      by contradiction /* from formulas */
                    qed
                  next
                    case static_keygen
                    solve( !KU( ~e.1 ) @ #vk.26 )
                      case ephemeral_reveal
                      by contradiction /* from formulas */
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma Secrecy_IK_2_for_Initiator_unless_dishonest_re_or_reveal_s_AnyTime_or_reveal_re_AnyTime_or_reveal_rs_AnyTime_end:
  all-traces
  "∀ msg e me re peer #claim.
    (Secret_IK_2_Initiator( e, me, re, peer, msg ) @ #claim) ⇒
    ((¬(∃ #attack. K( msg ) @ #attack)) ∨
     ((((¬(∃ #honest. HonestEk( re ) @ #honest)) ∨
        (∃ #reveal. RevealLtk( me ) @ #reveal)) ∨
       (∃ #reveal. RevealEk( re ) @ #reveal)) ∨
      (∃ #reveal. RevealLtk( peer ) @ #reveal)))"
/*
guarded formula characterizing all counter-examples:
"∃ msg e me re peer #claim.
  (Secret_IK_2_Initiator( e, me, re, peer, msg ) @ #claim)
 ∧
  (∃ #attack. (K( msg ) @ #attack)) ∧
  (∃ #honest. (HonestEk( re ) @ #honest)) ∧
  (∀ #reveal. (RevealLtk( me ) @ #reveal) ⇒ ⊥) ∧
  (∀ #reveal. (RevealEk( re ) @ #reveal) ⇒ ⊥) ∧
  (∀ #reveal. (RevealLtk( peer ) @ #reveal) ⇒ ⊥)"
*/
simplify
solve( HandshakeState_Initiator_1( id, hash, ck, k, ~e, ~s, peer
       ) ▶₀ #claim )
  case Handshake_Initiator_Snd_1
  solve( Recv( <'g'^~e.1, 
                aead(kdf2(<kdf1(<kdf1(<kdf1(<'IK', z>), z.1>), 'g'^(~e*~e.1)>), 
                           'g'^(~s*~e.1)>),
                     '0',
                     h(<
                        h(<
                           h(<h(<h(<h(<'IK', prologue>), peer>), 'g'^~e>), 
                              aead(kdf2(<'IK', z>), '0', h(<h(<h(<'IK', prologue>), peer>), 'g'^~e>),
                                   'g'^~s)
                             >), 
                           aead(kdf2(<kdf1(<'IK', z>), z.1>), '0',
                                h(<h(<h(<h(<'IK', prologue>), peer>), 'g'^~e>), 
                                   aead(kdf2(<'IK', z>), '0', h(<h(<h(<'IK', prologue>), peer>), 'g'^~e>),
                                        'g'^~s)
                                  >),
                                payload)
                          >), 
                        'g'^~e.1>),
                     msg)
               >
         ) ▶₁ #claim )
    case channel_receive
    solve( splitEqs(0) )
      case split_case_1
      solve( !KU( aead(kdf2(<
                             kdf1(<kdf1(<kdf1(<'IK', 'g'^~e>), 'g'^~s>), 'g'^(~e*~e.1)>), 
                             'g'^(~s*~e.1)>),
                       '0',
                       h(<
                          h(<
                             h(<h(<h(<h(<'IK', prologue>), 'g'>), 'g'^~e>), 
                                aead(kdf2(<'IK', 'g'^~e>), '0',
                                     h(<h(<h(<'IK', prologue>), 'g'>), 'g'^~e>), 'g'^~s)
                               >), 
                             aead(kdf2(<kdf1(<'IK', 'g'^~e>), 'g'^~s>), '0',
                                  h(<h(<h(<h(<'IK', prologue>), 'g'>), 'g'^~e>), 
                                     aead(kdf2(<'IK', 'g'^~e>), '0',
                                          h(<h(<h(<'IK', prologue>), 'g'>), 'g'^~e>), 'g'^~s)
                                    >),
                                  payload)
                            >), 
                          'g'^~e.1>),
                       msg)
             ) @ #vk.6 )
        case c_aead
        solve( !KU( kdf2(<
                          kdf1(<kdf1(<kdf1(<'IK', 'g'^~e>), 'g'^~s>), 'g'^(~e*~e.1)>), 
                          'g'^(~s*~e.1)>)
               ) @ #vk.7 )
          case c_kdf2
          solve( !KU( kdf1(<kdf1(<kdf1(<'IK', 'g'^~e>), 'g'^~s>), 'g'^(~e*~e.1)>)
                 ) @ #vk.11 )
            case c_kdf1
            solve( !KU( kdf1(<kdf1(<'IK', 'g'^~e>), 'g'^~s>) ) @ #vk.14 )
              case c_kdf1
              solve( !KU( kdf1(<'IK', 'g'^~e>) ) @ #vk.17 )
                case c_kdf1
                solve( !KU( 'g'^(~s*~e.1) ) @ #vk.15 )
                  case c_exp
                  solve( !KU( ~s ) @ #vk.23 )
                    case static_reveal
                    by contradiction /* from formulas */
                  qed
                next
                  case channel_send_case_1
                  solve( !KU( ~s ) @ #vk.22 )
                    case static_reveal
                    by contradiction /* from formulas */
                  qed
                next
                  case channel_send_case_2
                  solve( !KU( ~e.1 ) @ #vk.23 )
                    case ephemeral_reveal
                    by contradiction /* from formulas */
                  qed
                next
                  case channel_send_case_3
                  solve( !KU( ~s ) @ #vk.22 )
                    case static_reveal
                    by contradiction /* from formulas */
                  qed
                next
                  case ephemeral_keygen
                  solve( !KU( ~s ) @ #vk.22 )
                    case static_reveal
                    by contradiction /* from formulas */
                  qed
                next
                  case static_keygen
                  solve( !KU( ~e.1 ) @ #vk.22 )
                    case ephemeral_reveal
                    by contradiction /* from formulas */
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    next
      case split_case_2
      solve( !KU( aead(kdf2(<
                             kdf1(<kdf1(<kdf1(<'IK', z>), z.1>), 'g'^(~e*~e.1)>), 'g'^(~s*~e.1)>),
                       '0',
                       h(<
                          h(<
                             h(<h(<h(<h(<'IK', prologue>), 'g'^rs>), 'g'^~e>), 
                                aead(kdf2(<'IK', z>), '0', h(<h(<h(<'IK', prologue>), 'g'^rs>), 'g'^~e>),
                                     'g'^~s)
                               >), 
                             aead(kdf2(<kdf1(<'IK', z>), z.1>), '0',
                                  h(<h(<h(<h(<'IK', prologue>), 'g'^rs>), 'g'^~e>), 
                                     aead(kdf2(<'IK', z>), '0', h(<h(<h(<'IK', prologue>), 'g'^rs>), 'g'^~e>),
                                          'g'^~s)
                                    >),
                                  payload)
                            >), 
                          'g'^~e.1>),
                       msg)
             ) @ #vk.6 )
        case c_aead
