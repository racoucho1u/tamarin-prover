                    solve( !KU( ~e.1 ) @ #vk.27 )
                      case ephemeral_reveal
                      by contradiction /* from formulas */
                    qed
                  next
                    case channel_send_case_2
                    solve( !KU( ~s.1 ) @ #vk.26 )
                      case static_reveal
                      solve( !KU( 'g'^(~e*~e.1) ) @ #vk.22 )
                        case c_exp
                        solve( !KU( ~e ) @ #vk.29 )
                          case ephemeral_reveal
                          by contradiction /* from formulas */
                        qed
                      next
                        case channel_send_case_1
                        solve( !KU( ~e.1 ) @ #vk.27 )
                          case ephemeral_reveal
                          by contradiction /* from formulas */
                        qed
                      next
                        case channel_send_case_2
                        solve( !KU( ~e ) @ #vk.27 )
                          case ephemeral_reveal
                          by contradiction /* from formulas */
                        qed
                      next
                        case ephemeral_keygen
                        solve( !KU( ~e.1 ) @ #vk.27 )
                          case ephemeral_reveal
                          by contradiction /* from formulas */
                        qed
                      qed
                    qed
                  next
                    case ephemeral_keygen
                    solve( !KU( ~s.1 ) @ #vk.26 )
                      case static_reveal
                      solve( !KU( 'g'^(~e*~e.1) ) @ #vk.22 )
                        case c_exp
                        solve( !KU( ~e ) @ #vk.29 )
                          case ephemeral_reveal
