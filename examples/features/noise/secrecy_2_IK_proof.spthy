                            case static_reveal
                            by contradiction /* from formulas */
                          qed
                        next
                          case channel_send
                          solve( !KU( ~s.1 ) @ #vk.28 )
                            case static_reveal
                            solve( splitEqs(10) )
                              case split_case_1
                              solve( !KU( kdf2(<'IK', 'g'^~e0>) ) @ #vk.28 )
                                case c_kdf2
                                solve( !KU( 'g'^(~e*~s) ) @ #vk.29 )
                                  case c_exp
                                  solve( !KU( ~e ) @ #vk.35 )
                                    case ephemeral_reveal
                                    by contradiction /* from formulas */
                                  qed
                                next
                                  case channel_send
                                  solve( !KU( ~e ) @ #vk.34 )
                                    case ephemeral_reveal
                                    by contradiction /* from formulas */
                                  qed
                                next
                                  case ephemeral_keygen
                                  solve( !KU( ~s ) @ #vk.34 )
                                    case static_reveal
                                    by contradiction /* from formulas */
                                  qed
                                qed
                              qed
                            next
                              case split_case_2
                              solve( !KU( 'g'^(~e*~s) ) @ #vk.27 )
                                case c_exp
                                solve( !KU( ~e ) @ #vk.34 )
                                  case ephemeral_reveal
                                  by contradiction /* from formulas */
                                qed
                              next
                                case channel_send
                                solve( !KU( ~e ) @ #vk.32 )
                                  case ephemeral_reveal
                                  by contradiction /* from formulas */
                                qed
                              next
                                case ephemeral_keygen
                                solve( !KU( ~s ) @ #vk.32 )
                                  case static_reveal
                                  by contradiction /* from formulas */
                                qed
                              qed
                            qed
                          qed
                        next
                          case static_keygen_case_1
                          solve( !KU( ~s ) @ #vk.27 )
                            case static_reveal
                            by contradiction /* from formulas */
                          qed
                        next
                          case static_keygen_case_2
                          solve( !KU( ~s.1 ) @ #vk.27 )
                            case static_reveal
                            solve( !KU( 'g'^(~e*~s) ) @ #vk.27 )
                              case c_exp
