              case c_kdf1
              solve( !KU( kdf1(<'IK', 'g'^~e>) ) @ #vk.17 )
                case c_kdf1
                solve( !KU( 'g'^(~s*~e.1) ) @ #vk.15 )
                  case c_exp
                  solve( !KU( ~s ) @ #vk.23 )
                    case static_reveal
                    by contradiction /* from formulas */
                  qed
                next
                  case channel_send_case_1
                  solve( !KU( ~s ) @ #vk.22 )
                    case static_reveal
                    by contradiction /* from formulas */
                  qed
                next
                  case channel_send_case_2
