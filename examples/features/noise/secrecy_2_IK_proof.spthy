                                               h(<h(<h(<'IK', prologue>), 'g'^~key>), 'g'^~e>), 'g'^~s)
                                     ) @ #vk.26 )
                                case channel_send
                                solve( !KU( 'g'^~key ) @ #vk.24 )
                                  case channel_send
