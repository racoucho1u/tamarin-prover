                                       h(<h(<h(<h(<'IK', prologue>), 'g'^~s>), re>), 
                                          aead(kdf2(<'IK', z>), '0',
                                               h(<h(<h(<'IK', prologue>), 'g'^~s>), re>), 'g'^~key)
                                         >),
                                       payload)
                             ) @ #vk.14 )
                        case c_aead
                        solve( !KU( kdf2(<kdf1(<'IK', z>), 'g'^(~key*~s)>) ) @ #vk.22 )
                          case c_kdf2
                          by contradiction /* cyclic */
                        qed
                      next
                        case channel_send
                        solve( !KU( kdf1(<'IK', 'g'^(~e0*~s)>) ) @ #vk.19 )
                          case c_kdf1
                          solve( !KU( kdf2(<'IK', 'g'^(~e0*~s)>) ) @ #vk.20 )
                            case c_kdf2
                            solve( !KU( 'g'^(~e0*~e0.1) ) @ #vk.20 )
                              case c_exp
                              solve( !KU( ~e0 ) @ #vk.29 )
                                case ephemeral_reveal
