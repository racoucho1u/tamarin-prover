        z.2   = 'g'^x.422
        z.3   = 'g'
    
    18. ~e0   = ~e0.213
        z     = 'g'
        z.1   = 'g'^(x.423*inv((~e0.213*x.424)))
        z.2   = 'g'^~e0.213
        z.3   = 'g'^(x.423*inv(x.424))
    
    19. ~e0   = ~e0.213
        z     = 'g'^inv(~e0.213)
        z.1   = 'g'^(x.423*inv((~e0.213*x.424)))
        z.2   = 'g'
