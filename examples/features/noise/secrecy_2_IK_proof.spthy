lemma Secrecy_IK_2_for_Responder_unless_dishonest_re_or_dishonest_rs_or_reveal_e_Before_or_reveal_rs_Before_end:
  all-traces
  "∀ msg e me re peer #claim.
    (Secret_IK_2_Responder( e, me, re, peer, msg ) @ #claim) ⇒
    ((¬(∃ #attack. K( msg ) @ #attack)) ∨
     ((((¬(∃ #honest. HonestEk( re ) @ #honest)) ∨
        (¬(∃ #honest. HonestPk( peer ) @ #honest))) ∨
       (∃ #reveal. (RevealEk( e ) @ #reveal) ∧ (#reveal < #claim))) ∨
      (∃ #reveal. (RevealLtk( peer ) @ #reveal) ∧ (#reveal < #claim))))"
/*
guarded formula characterizing all counter-examples:
"∃ msg e me re peer #claim.
  (Secret_IK_2_Responder( e, me, re, peer, msg ) @ #claim)
 ∧
  (∃ #attack. (K( msg ) @ #attack)) ∧
  (∃ #honest. (HonestEk( re ) @ #honest)) ∧
  (∃ #honest. (HonestPk( peer ) @ #honest)) ∧
  (∀ #reveal. (RevealEk( e ) @ #reveal) ⇒ ¬(#reveal < #claim)) ∧
  (∀ #reveal. (RevealLtk( peer ) @ #reveal) ⇒ ¬(#reveal < #claim))"
*/
simplify
solve( HandshakeState_Responder_1( id, hash, ck, k, 'g'^~e, ~s, 'g'^~key
       ) ▶₀ #claim )
  case Handshake_Responder_Recv_1
  solve( Handshake_Snd_2( ~id, msg ) ▶₁ #claim )
    case Instrumentation_Responder_2
    solve( Ek( ~e0 ) ▶₂ #claim )
      case ephemeral_keygen
      solve( !KU( ~n ) @ #vk )
        case channel_send
        solve( !KU( kdf2(<
                          kdf1(<kdf1(<kdf1(<'IK', 'g'^(~e*~s)>), 'g'^(~key*~s)>), 'g'^(~e*~e0)>), 
                          'g'^(~e0*~key)>)
               ) @ #vk.7 )
          case c_kdf2
          solve( !KU( kdf1(<kdf1(<kdf1(<'IK', 'g'^(~e*~s)>), 'g'^(~key*~s)>), 
                            'g'^(~e*~e0)>)
                 ) @ #vk.10 )
            case c_kdf1
            solve( !KU( kdf1(<kdf1(<'IK', 'g'^(~e*~s)>), 'g'^(~key*~s)>) ) @ #vk.13 )
              case c_kdf1
              solve( !KU( kdf1(<'IK', 'g'^(~e*~s)>) ) @ #vk.16 )
                case c_kdf1
                solve( !KU( 'g'^(~e0*~key) ) @ #vk.14 )
                  case c_exp
                  solve( !KU( ~e0 ) @ #vk.23 )
                    case ephemeral_reveal
                    solve( !KU( ~key ) @ #vk.24 )
                      case static_reveal
                      solve( !KU( 'g'^(~e*~e0) ) @ #vk.19 )
                        case c_exp
                        solve( !KU( ~e ) @ #vk.26 )
                          case ephemeral_reveal
                          solve( !KU( 'g'^(~key*~s) ) @ #vk.22 )
                            case c_exp
                            solve( !KU( ~s ) @ #vk.28 )
                              case static_reveal
                              solve( !KU( 'g'^(~e*~s) ) @ #vk.27 )
                                case c_exp
                                solve( !KU( aead(kdf2(<'IK', 'g'^(~e*~s)>), '0',
                                                 h(<h(<h(<'IK', prologue>), 'g'^~s>), 'g'^~e>), 'g'^~key)
                                       ) @ #vk.23 )
                                  case c_aead
                                  solve( !KU( kdf2(<'IK', 'g'^(~e*~s)>) ) @ #vk.30 )
                                    case c_kdf2
                                    solve( !KU( aead(kdf2(<kdf1(<'IK', 'g'^(~e*~s)>), 'g'^(~key*~s)>), '0',
                                                     h(<h(<h(<h(<'IK', prologue>), 'g'^~s>), 'g'^~e>), 
                                                        aead(kdf2(<'IK', 'g'^(~e*~s)>), '0',
                                                             h(<h(<h(<'IK', prologue>), 'g'^~s>), 'g'^~e>),
                                                             'g'^~key)
                                                       >),
                                                     payload)
                                           ) @ #vk.26 )
                                      case channel_send
                                      solve( !KU( h(<h(<h(<'IK', prologue>), 'g'^~s>), 'g'^~e>) ) @ #vk.31 )
                                        case c_h
                                        solve( !KU( h(<h(<'IK', prologue>), 'g'^~s>) ) @ #vk.36 )
                                          case c_h
                                          solve( !KU( h(<'IK', prologue>) ) @ #vk.38 )
                                            case c_h
                                            solve( !KU( 'g'^~e ) @ #vk.30 )
                                              case c_exp
                                              solve( !KU( 'g'^~key ) @ #vk.37 )
                                                case channel_send
                                                solve( splitEqs(11) )
                                                  case split_case_1
                                                  solve( !KU( kdf2(<'IK', 'g'^~e0.1>) ) @ #vk.40 )
                                                    case c_kdf2
                                                    solve( !KU( 'g'^~s ) @ #vk.41 )
                                                      case c_exp
                                                      solve( !KU( 'g'^~e0.1 ) @ #vk.44 )
                                                        case c_exp
                                                        solve( !KU( ~e0.1 ) @ #vk.45 )
                                                          case ephemeral_reveal
                                                          SOLVED // trace found
                                                        qed
                                                      qed
                                                    qed
                                                  qed
                                                qed
                                              qed
                                            qed
                                          qed
                                        qed
                                      qed
                                    qed
                                  qed
                                qed
                              qed
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

