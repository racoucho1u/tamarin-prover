lemma Secrecy_IK_2_for_Responder_unless_dishonest_rs_or_reveal_e_Before_or_reveal_re_AnyTime_or_reveal_rs_AnyTime_end:
  all-traces
  "∀ msg e me re peer #claim.
    (Secret_IK_2_Responder( e, me, re, peer, msg ) @ #claim) ⇒
    ((¬(∃ #attack. K( msg ) @ #attack)) ∨
     ((((¬(∃ #honest. HonestPk( peer ) @ #honest)) ∨
        (∃ #reveal. (RevealEk( e ) @ #reveal) ∧ (#reveal < #claim))) ∨
       (∃ #reveal. RevealEk( re ) @ #reveal)) ∨
      (∃ #reveal. RevealLtk( peer ) @ #reveal)))"
/*
guarded formula characterizing all counter-examples:
"∃ msg e me re peer #claim.
  (Secret_IK_2_Responder( e, me, re, peer, msg ) @ #claim)
 ∧
  (∃ #attack. (K( msg ) @ #attack)) ∧
  (∃ #honest. (HonestPk( peer ) @ #honest)) ∧
  (∀ #reveal. (RevealEk( e ) @ #reveal) ⇒ ¬(#reveal < #claim)) ∧
  (∀ #reveal. (RevealEk( re ) @ #reveal) ⇒ ⊥) ∧
  (∀ #reveal. (RevealLtk( peer ) @ #reveal) ⇒ ⊥)"
*/
simplify
solve( HandshakeState_Responder_1( id, hash, ck, k, re, ~s, 'g'^~key
       ) ▶₀ #claim )
  case Handshake_Responder_Recv_1
  solve( Handshake_Snd_2( ~id, msg ) ▶₁ #claim )
    case Instrumentation_Responder_2
    solve( Ek( ~e0 ) ▶₂ #claim )
      case ephemeral_keygen
      solve( !KU( ~n ) @ #vk )
        case channel_send
        solve( !KU( kdf2(<kdf1(<kdf1(<kdf1(<'IK', z>), 'g'^(~key*~s)>), z.1>), 
                          'g'^(~e0*~key)>)
               ) @ #vk.7 )
          case c_kdf2
          solve( !KU( kdf1(<kdf1(<kdf1(<'IK', z>), 'g'^(~key*~s)>), z.1>)
                 ) @ #vk.10 )
            case c_kdf1
            solve( !KU( kdf1(<kdf1(<'IK', z>), 'g'^(~key*~s)>) ) @ #vk.13 )
              case c_kdf1
              solve( !KU( 'g'^(~e0*~key) ) @ #vk.12 )
                case channel_send_case_1
                solve( !KU( ~e0 ) @ #vk.19 )
                  case ephemeral_reveal
                  solve( splitEqs(11) )
                    case split_case_1
                    solve( !KU( kdf2(<'IK', 'g'^~e0.1>) ) @ #vk.19 )
                      case c_kdf2
                      solve( !KU( 'g'^(~key*~s) ) @ #vk.19 )
                        case channel_send_case_2
                        solve( !KU( ~s ) @ #vk.26 )
                          case static_reveal
                          solve( !KU( aead(kdf2(<'IK', z>), '0',
                                           h(<h(<h(<'IK', prologue>), 'g'^~s>), re>), 'g'^~key)
                                 ) @ #vk.15 )
                            case c_aead
                            solve( !KU( aead(kdf2(<kdf1(<'IK', z>), 'g'^(~key*~s)>), '0',
                                             h(<h(<h(<h(<'IK', prologue>), 'g'^~s>), re>), 
                                                aead(kdf2(<'IK', z>), '0',
                                                     h(<h(<h(<'IK', prologue>), 'g'^~s>), re>), 'g'^~key)
                                               >),
                                             payload)
                                   ) @ #vk.17 )
                              case c_aead
                              solve( !KU( kdf2(<kdf1(<'IK', z>), 'g'^(~key*~s)>) ) @ #vk.30 )
                                case c_kdf2
                                solve( !KU( h(<h(<h(<'IK', prologue>), 'g'^~s>), re>) ) @ #vk.30 )
                                  case c_h
                                  solve( !KU( h(<h(<h(<h(<'IK', prologue>), 'g'^~s>), re>), 
                                                 aead(kdf2(<'IK', z>), '0',
                                                      h(<h(<h(<'IK', prologue>), 'g'^~s>), re>), 'g'^~key)
                                                >)
                                         ) @ #vk.32 )
                                    case c_h
                                    solve( !KU( h(<h(<'IK', prologue>), 'g'^~s>) ) @ #vk.35 )
                                      case c_h
                                      solve( splitEqs(0) )
                                        case split_case_1
                                        solve( !KU( kdf1(<'IK', 'g'^~s>) ) @ #vk.27 )
                                          case c_kdf1
                                          solve( !KU( kdf2(<'IK', 'g'^~s>) ) @ #vk.34 )
                                            case c_kdf2
                                            solve( !KU( h(<'IK', prologue>) ) @ #vk.37 )
                                              case c_h
                                              solve( !KU( 'g'^~e0.1 ) @ #vk.36 )
                                                case c_exp
                                                solve( !KU( ~e0.1 ) @ #vk.40 )
                                                  case ephemeral_reveal
                                                  solve( !KU( 'g'^~key ) @ #vk.26 )
                                                    case channel_send
                                                    solve( !KU( 'g'^~s ) @ #vk.40 )
                                                      case c_exp
                                                      solve( !KU( 'g'^~e0 ) @ #vk.35 )
                                                        case c_exp
                                                        SOLVED // trace found
                                                      qed
                                                    qed
                                                  qed
                                                qed
                                              qed
                                            qed
                                          qed
                                        qed
                                      qed
                                    qed
                                  qed
                                qed
                              qed
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

