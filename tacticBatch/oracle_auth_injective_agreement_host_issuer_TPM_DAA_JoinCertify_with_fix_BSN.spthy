              Honest( $AS.8 ), Honest( pk(KDF_EK(~TPM_EK_Seed.5)) ),
              Honest( 'Issuer' ), OnlyOnce( 'Host_Store_DAA_Key' )
              ]->
               [
               !EK_FOR_ISSUER( pk(KDF_EK(~TPM_EK_Seed.5)) ),
               Out( <pk(KDF_EK(~TPM_EK_Seed.5)), 
                     <'DAA_public_data', multp(~f.10, 'P1')>, 'join_Issuer_1'>
               ),
               Host_State_02( $PS.6, $AS.8, pk(KDF_EK(~TPM_EK_Seed.5)),
                              <'DAA_public_data', multp(~f.10, 'P1')>,
                              senc(~f.10, KDF_AES(~TPM_AES_Seed.9))
               )
               ]
    #vr.67: instance (modulo AC) TPM2_Hash:
               [ In_S( $AS.9, $PS.6, <p.2, 'TPM2_Hash'> ), Fr( ~tkt.1 ) ]
              --[ TPM2_Created_P_TPM( $PS.6, $AS.9 ), OnlyOnce( 'TPM2_Hash' ) ]->
               [
