              --[ Host_Init( $AS.8 ), OnlyOnce( 'Host_Init' ) ]->
               [ Host_Initialised( $AS.8 ) ]
    #vr.72: instance (modulo AC) Host_Passthrough_1:
               [
               In( <curlyH.5, len16(curlyK_hat.4), curlyK_hat.4, 
                    aenc(s.6, pk(KDF_EK(~TPM_EK_Seed.8))), 'Host_SendChallenge'>
               ),
               Host_State_02( $PS.7, $AS.8, pk(KDF_EK(~TPM_EK_Seed.8)),
                              <'DAA_public_data', multp(~f.12, 'P1')>,
                              senc(~f.12, KDF_AES(~TPM_AES_Seed.10))
               )
               ]
              --[
              Passthrough_ActivateCred( $PS.7, $AS.8 ),
              OnlyOnce( 'Host_Passthrough' )
              ]->
               [
               Out_S( $AS.8, $PS.7,
                      <senc(~f.12, KDF_AES(~TPM_AES_Seed.10)), 
                       <'DAA_public_data', multp(~f.12, 'P1')>, curlyH.5, 
                       len16(curlyK_hat.4), curlyK_hat.4, 
                       aenc(s.6, pk(KDF_EK(~TPM_EK_Seed.8))), 'TPM2_ActivateCredentials'>
               ),
               Host_State_03( $PS.7, $AS.8, pk(KDF_EK(~TPM_EK_Seed.8)),
                              <'DAA_public_data', multp(~f.12, 'P1')>,
                              senc(~f.12, KDF_AES(~TPM_AES_Seed.10))
               )
               ]
    #vr.73: instance (modulo AC) Host_Store_EK:
               [
               In_S( $PS.6, $AS.8,
                     <<'EK_public_data', pk(KDF_EK(~TPM_EK_Seed.5))>, 'returnEK'>
               )
               ]
              --[ Store_EK( $PS.6, $AS.8 ), OnlyOnce( 'Host_Store_EK' ) ]->
               [
               Out_S( $AS.8, $PS.6, <pk(KDF_EK(~TPM_EK_Seed.5)), 'createDAAKey'>
               ),
               Host_State_01( $PS.6, $AS.8, pk(KDF_EK(~TPM_EK_Seed.5)) )
               ]
    #vr.74: instance (modulo AC) Host_Store_DAA_Key:
               [
               In_S( $PS.7, $AS.8,
                     <senc(~f.12, KDF_AES(~TPM_AES_Seed.10)), 
                      <'DAA_public_data', multp(~f.12, 'P1')>, 'returnDAAKey'>
               ),
               Host_State_01( $PS.7, $AS.8, pk(KDF_EK(~TPM_EK_Seed.8)) )
               ]
              --[
              Store_DAA( $PS.7, $AS.8 ),
              PlatformSendKeys( $PS.7, $AS.8, pk(KDF_EK(~TPM_EK_Seed.8)),
                                <'DAA_public_data', multp(~f.12, 'P1')>, 'Issuer'
              ),
              Alive( $AS.8 ), Role( 'Platform' ), Honest( $PS.7 ),
              Honest( $AS.8 ), Honest( pk(KDF_EK(~TPM_EK_Seed.8)) ),
              Honest( 'Issuer' ), OnlyOnce( 'Host_Store_DAA_Key' )
              ]->
               [
               !EK_FOR_ISSUER( pk(KDF_EK(~TPM_EK_Seed.8)) ),
               Out( <pk(KDF_EK(~TPM_EK_Seed.8)), 
                     <'DAA_public_data', multp(~f.12, 'P1')>, 'join_Issuer_1'>
               ),
               Host_State_02( $PS.7, $AS.8, pk(KDF_EK(~TPM_EK_Seed.8)),
                              <'DAA_public_data', multp(~f.12, 'P1')>,
                              senc(~f.12, KDF_AES(~TPM_AES_Seed.10))
               )
               ]
    #vr.75: instance (modulo AC) Host_Store_EK:
               [
               In_S( $PS.7, $AS.8,
                     <<'EK_public_data', pk(KDF_EK(~TPM_EK_Seed.8))>, 'returnEK'>
               )
               ]
              --[ Store_EK( $PS.7, $AS.8 ), OnlyOnce( 'Host_Store_EK' ) ]->
               [
               Out_S( $AS.8, $PS.7, <pk(KDF_EK(~TPM_EK_Seed.8)), 'createDAAKey'>
               ),
               Host_State_01( $PS.7, $AS.8, pk(KDF_EK(~TPM_EK_Seed.8)) )
               ]
    #vr.76: instance (modulo AC) Host_CredentialsReveal:
               [
               Host_Org_Creds( $PS.8, $AS.12, pk(KDF_EK(~TPM_EK_Seed.9)),
                               multp(~f.1, 'P1'), multp(~y, multp(~f.1, 'P1')),
                               plus(multp(~x, multp(~f.1, 'P1')),
                                    multp(multp(multp(~f.1, ~x), ~y), multp(~f.4, 'P1'))),
                               multp(multp(~f.1, ~y), multp(~f.4, 'P1'))
               )
               ]
              --[
              KeyReveal( 'Host_OrgCred_Reveal', $AS.12 ),
              KeyReveal( 'TPM_OrgCred_Reveal', $PS.8 ),
              KeyReveal( 'PKE_OrgCred_Reveal', pk(KDF_EK(~TPM_EK_Seed.9)) )
              ]->
               [
               Out( <multp(~f.1, 'P1'), multp(~y, multp(~f.1, 'P1')), 
                     plus(multp(~x, multp(~f.1, 'P1')),
                          multp(multp(multp(~f.1, ~x), ~y), multp(~f.4, 'P1'))), 
                     multp(multp(~f.1, ~y), multp(~f.4, 'P1'))>
               )
               ]
    #vr.77: instance (modulo AC) d_0_fst:
               [
               !KD( <multp(~f.1, 'P1'), multp(~y, multp(~f.1, 'P1')), 
                     plus(multp(~x, multp(~f.1, 'P1')),
                          multp(multp(multp(~f.1, ~x), ~y), multp(~f.4, 'P1'))), 
                     multp(multp(~f.1, ~y), multp(~f.4, 'P1'))>
               )
               ]
              -->
               [ !KD( multp(~f.1, 'P1') ) ]
    #vr.78: instance (modulo AC) Host_JoinComplete:
               [
               In_S( $PS.8, $AS.12,
                     <curlyK(K_2_rec), 'ret_TPM2_ActivateCredentials_2'>
               ),
               !Pk( 'Issuer', PkX(~x, 'P2'), PkY(~y, 'P2') ),
               Host_State_06( $PS.8, $AS.12, pk(KDF_EK(~TPM_EK_Seed.9)),
                              <'DAA_public_data', multp(~f.4, 'P1')>,
                              senc(<multp(~f.1, 'P1'), multp(~y, multp(~f.1, 'P1')), 
                                    plus(multp(~x, multp(~f.1, 'P1')),
                                         multp(multp(multp(~f.1, ~x), ~y), multp(~f.4, 'P1'))), 
                                    multp(multp(~f.1, ~y), multp(~f.4, 'P1')), 
                                    H_n_8('P1', multp(~f.4, 'P1'), RB(x.2, 'P1'),
                                          RD(x.2, multp(~f.4, 'P1')), multp(~f.1, 'P1'),
                                          multp(~y, multp(~f.1, 'P1')),
                                          plus(multp(~x, multp(~f.1, 'P1')),
                                               multp(multp(multp(~f.1, ~x), ~y),
                                                     multp(~f.4, 'P1'))),
                                          multp(multp(~f.1, ~y), multp(~f.4, 'P1'))), 
                                    plus(x.2,
                                         multp(multp(~y, ~f.1),
                                               H_n_8('P1', multp(~f.4, 'P1'), RB(x.2, 'P1'),
                                                     RD(x.2, multp(~f.4, 'P1')), multp(~f.1, 'P1'),
                                                     multp(~y, multp(~f.1, 'P1')),
                                                     plus(multp(~x, multp(~f.1, 'P1')),
                                                          multp(multp(multp(~f.1, ~x), ~y),
                                                                multp(~f.4, 'P1'))),
                                                     multp(multp(~f.1, ~y), multp(~f.4, 'P1')))))
                                   >,
                                   curlyK(K_2_rec))
               )
               ]
              --[
              Eq( curlyK(K_2_rec), curlyK(K_2_rec) ),
              Eq( H_n_8('P1', multp(~f.4, 'P1'), RB(x.2, 'P1'),
                        RD(x.2, multp(~f.4, 'P1')), multp(~f.1, 'P1'),
                        multp(~y, multp(~f.1, 'P1')),
                        plus(multp(~x, multp(~f.1, 'P1')),
                             multp(multp(multp(~f.1, ~x), ~y), multp(~f.4, 'P1'))),
                        multp(multp(~f.1, ~y), multp(~f.4, 'P1'))),
                  H_n_8('P1', multp(~f.4, 'P1'), RB(x.2, 'P1'),
                        RD(x.2, multp(~f.4, 'P1')), multp(~f.1, 'P1'),
                        multp(~y, multp(~f.1, 'P1')),
                        plus(multp(~x, multp(~f.1, 'P1')),
                             multp(multp(multp(~f.1, ~x), ~y), multp(~f.4, 'P1'))),
                        multp(multp(~f.1, ~y), multp(~f.4, 'P1')))
              ),
              Eq( accept, accept ), Eq( accept, accept ),
              JoinCompleted( $PS.8, $AS.12, pk(KDF_EK(~TPM_EK_Seed.9)) ),
              Commit( pk(KDF_EK(~TPM_EK_Seed.9)), 'Issuer',
                      <multp(~f.1, 'P1'), multp(~y, multp(~f.1, 'P1')), 
                       plus(multp(~x, multp(~f.1, 'P1')),
                            multp(multp(multp(~f.1, ~x), ~y), multp(~f.4, 'P1'))), 
                       multp(multp(~f.1, ~y), multp(~f.4, 'P1'))>
              ),
              Role( 'Platform' ),
              Secret( pk(KDF_EK(~TPM_EK_Seed.9)), 'Issuer',
                      <multp(~f.1, 'P1'), multp(~y, multp(~f.1, 'P1')), 
                       plus(multp(~x, multp(~f.1, 'P1')),
                            multp(multp(multp(~f.1, ~x), ~y), multp(~f.4, 'P1'))), 
                       multp(multp(~f.1, ~y), multp(~f.4, 'P1'))>
              ),
              Honest( $PS.8 ), Honest( $AS.12 ),
              Honest( pk(KDF_EK(~TPM_EK_Seed.9)) ), Honest( 'Issuer' ),
              OnlyOnce( 'Host_JoinComplete' )
              ]->
               [
               !Host_State_RNDCreds( $PS.8, $AS.12, pk(KDF_EK(~TPM_EK_Seed.9)),
                                     multp(~f.1, 'P1'), multp(~y, multp(~f.1, 'P1')),
                                     plus(multp(~x, multp(~f.1, 'P1')),
                                          multp(multp(multp(~f.1, ~x), ~y), multp(~f.4, 'P1'))),
                                     multp(multp(~f.1, ~y), multp(~f.4, 'P1'))
               ),
               !Host_Join_Complete( $PS.8, $AS.12, pk(KDF_EK(~TPM_EK_Seed.9)) ),
               Host_Org_Creds( $PS.8, $AS.12, pk(KDF_EK(~TPM_EK_Seed.9)),
                               multp(~f.1, 'P1'), multp(~y, multp(~f.1, 'P1')),
                               plus(multp(~x, multp(~f.1, 'P1')),
                                    multp(multp(multp(~f.1, ~x), ~y), multp(~f.4, 'P1'))),
                               multp(multp(~f.1, ~y), multp(~f.4, 'P1'))
               )
               ]
    #vr.79: instance (modulo AC) Host_Passthrough_2:
               [
               In( <curlyH.6, len16(curlyK_2_hat.1), curlyK_2_hat.1, 
                    aenc(~s_2.2, pk(KDF_EK(~TPM_EK_Seed.9))), 
                    senc(<multp(~f.1, 'P1'), multp(~y, multp(~f.1, 'P1')), 
                          plus(multp(~x, multp(~f.1, 'P1')),
                               multp(multp(multp(~f.1, ~x), ~y), multp(~f.4, 'P1'))), 
                          multp(multp(~f.1, ~y), multp(~f.4, 'P1')), 
