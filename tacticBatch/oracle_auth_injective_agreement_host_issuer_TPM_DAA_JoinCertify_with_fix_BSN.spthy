                          KDF_a(~s_2.1, 'STORAGE',
                                <'SHA256', H_SHA256(<'DAA_public_data', multp(~f, 'P1')>)>)), 
                     aenc(~s_2.1, pk(KDF_EK(~TPM_EK_Seed.1))), 
                     senc(<multp(~x.1, 'P1'), multp(~y, multp(~x.1, 'P1')), 
                           plus(multp(~x, multp(~x.1, 'P1')),
                                multp(multp(multp(~x.1, ~x), ~y), multp(~f, 'P1'))), 
                           multp(multp(~x.1, ~y), multp(~f, 'P1')), 
                           H_n_8('P1', multp(~f, 'P1'), RB(~l, 'P1'), RD(~l, multp(~f, 'P1')),
                                 multp(~x.1, 'P1'), multp(~y, multp(~x.1, 'P1')),
                                 plus(multp(~x, multp(~x.1, 'P1')),
                                      multp(multp(multp(~x.1, ~x), ~y), multp(~f, 'P1'))),
                                 multp(multp(~x.1, ~y), multp(~f, 'P1'))), 
                           plus(~l,
                                multp(multp(~y, ~x.1),
                                      H_n_8('P1', multp(~f, 'P1'), RB(~l, 'P1'),
                                            RD(~l, multp(~f, 'P1')), multp(~x.1, 'P1'),
                                            multp(~y, multp(~x.1, 'P1')),
                                            plus(multp(~x, multp(~x.1, 'P1')),
                                                 multp(multp(multp(~x.1, ~x), ~y),
                                                       multp(~f, 'P1'))),
                                            multp(multp(~x.1, ~y), multp(~f, 'P1')))))
                          >,
