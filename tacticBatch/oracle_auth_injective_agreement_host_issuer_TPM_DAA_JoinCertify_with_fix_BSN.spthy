                                KDF_a(<'1', ~s.2>, 'STORAGE',
                                      <'1', 'SHA256', H_SHA256(<'DAA_public_data', multp(~f, 'P1')>)
                                      >))), 
                     senc(<'1', curlyK(~K_1.4)>,
                          KDF_a(<'1', ~s.2>, 'STORAGE',
