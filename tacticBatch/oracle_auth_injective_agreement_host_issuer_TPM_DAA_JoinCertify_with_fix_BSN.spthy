    #vr.53: instance (modulo AC) Host_Store_DAA_Key:
               [
               In_S( $PS.4, $AS.4,
                     <senc(~f.7, KDF_AES(~TPM_AES_Seed.5)), 
                      <'DAA_public_data', multp(~f.7, 'P1')>, 'returnDAAKey'>
               ),
               Host_State_01( $PS.4, $AS.4, pk(KDF_EK(~TPM_EK_Seed.2)) )
               ]
              --[
              Store_DAA( $PS.4, $AS.4 ),
              PlatformSendKeys( $PS.4, $AS.4, pk(KDF_EK(~TPM_EK_Seed.2)),
                                <'DAA_public_data', multp(~f.7, 'P1')>, 'Issuer'
              ),
              Alive( $AS.4 ), Role( 'Platform' ), Honest( $PS.4 ),
              Honest( $AS.4 ), Honest( pk(KDF_EK(~TPM_EK_Seed.2)) ),
              Honest( 'Issuer' ), OnlyOnce( 'Host_Store_DAA_Key' )
              ]->
               [
               !EK_FOR_ISSUER( pk(KDF_EK(~TPM_EK_Seed.2)) ),
               Out( <pk(KDF_EK(~TPM_EK_Seed.2)), 
                     <'DAA_public_data', multp(~f.7, 'P1')>, 'join_Issuer_1'>
               ),
               Host_State_02( $PS.4, $AS.4, pk(KDF_EK(~TPM_EK_Seed.2)),
                              <'DAA_public_data', multp(~f.7, 'P1')>,
                              senc(~f.7, KDF_AES(~TPM_AES_Seed.5))
               )
               ]
    #vr.54: instance (modulo AC) TPM2_Hash:
               [ In_S( $AS.5, $PS.4, <p, 'TPM2_Hash'> ), Fr( ~tkt ) ]
              --[ TPM2_Created_P_TPM( $PS.4, $AS.5 ), OnlyOnce( 'TPM2_Hash' ) ]->
               [
               Out_S( $PS.4, $AS.5, <H_k_1(p), Nonce(~tkt), 'ret_TPM2_Hash'> ),
