                           H_n_8('P1', multp(~f, 'P1'), RB(~l, 'P1'), RD(~l, multp(~f, 'P1')),
                                 multp(~x.1, 'P1'), multp(~y, multp(~x.1, 'P1')),
                                 plus(multp(~x, multp(~x.1, 'P1')),
                                      multp(multp(multp(~x.1, ~x), ~y), multp(~f, 'P1'))),
                                 multp(multp(~x.1, ~y), multp(~f, 'P1'))), 
                           plus(~l,
                                multp(multp(~y, ~x.1),
                                      H_n_8('P1', multp(~f, 'P1'), RB(~l, 'P1'),
                                            RD(~l, multp(~f, 'P1')), multp(~x.1, 'P1'),
                                            multp(~y, multp(~x.1, 'P1')),
                                            plus(multp(~x, multp(~x.1, 'P1')),
                                                 multp(multp(multp(~x.1, ~x), ~y),
                                                       multp(~f, 'P1'))),
                                            multp(multp(~x.1, ~y), multp(~f, 'P1')))))
                          >,
                          curlyK(~K_2)), 
                     'Host_CompleteJoin'>
               )
               ]
              -->
               [
               !KD( senc(<multp(~x.1, 'P1'), multp(~y, multp(~x.1, 'P1')), 
                          plus(multp(~x, multp(~x.1, 'P1')),
                               multp(multp(multp(~x.1, ~x), ~y), multp(~f, 'P1'))), 
                          multp(multp(~x.1, ~y), multp(~f, 'P1')), 
                          H_n_8('P1', multp(~f, 'P1'), RB(~l, 'P1'), RD(~l, multp(~f, 'P1')),
                                multp(~x.1, 'P1'), multp(~y, multp(~x.1, 'P1')),
                                plus(multp(~x, multp(~x.1, 'P1')),
                                     multp(multp(multp(~x.1, ~x), ~y), multp(~f, 'P1'))),
                                multp(multp(~x.1, ~y), multp(~f, 'P1'))), 
                          plus(~l,
                               multp(multp(~y, ~x.1),
                                     H_n_8('P1', multp(~f, 'P1'), RB(~l, 'P1'),
                                           RD(~l, multp(~f, 'P1')), multp(~x.1, 'P1'),
                                           multp(~y, multp(~x.1, 'P1')),
                                           plus(multp(~x, multp(~x.1, 'P1')),
                                                multp(multp(multp(~x.1, ~x), ~y), multp(~f, 'P1'))),
                                           multp(multp(~x.1, ~y), multp(~f, 'P1')))))
                         >,
                         curlyK(~K_2))
               )
               ]
    #vf.21: instance (modulo AC) Fresh:
               [ ] --> [ Fr( ~r.1 ) ]
    #vr.21: instance (modulo AC) Issuer_Check_EK_Send_Challenge:
               [
               In( <pk(KDF_EK(~TPM_EK_Seed.1)), 
                    <'DAA_public_data', multp(~f, 'P1')>, 'join_Issuer_1'>
               ),
               Fr( ~K_1.2 ), Fr( ~s.1 ),
               !EK_FOR_ISSUER( pk(KDF_EK(~TPM_EK_Seed.1)) )
               ]
              --[
              Check_Ek( pk(KDF_EK(~TPM_EK_Seed.1)) ),
              Check_QPD( <'DAA_public_data', multp(~f, 'P1')> ),
              Associate( curlyK(~K_1.2), pk(KDF_EK(~TPM_EK_Seed.1)),
                         <'DAA_public_data', multp(~f, 'P1')>
              ),
              Alive( 'Issuer' ), Honest( 'Issuer' ),
              Honest( pk(KDF_EK(~TPM_EK_Seed.1)) ),
              IssuerReceivedKeys( 'Issuer', pk(KDF_EK(~TPM_EK_Seed.1)),
                                  <'DAA_public_data', multp(~f, 'P1')>
              ),
              OnlyOnce( 'Issuer_Check_EK_Send_Challenge' )
              ]->
               [
               Out( <
                     MAC(<'1', 
                          len16(senc(<'1', curlyK(~K_1.2)>,
                                     KDF_a(<'1', ~s.1>, 'STORAGE',
                                           <'1', 'SHA256', 
                                            H_SHA256(<'DAA_public_data', multp(~f, 'P1')>)>))), 
                          senc(<'1', curlyK(~K_1.2)>,
                               KDF_a(<'1', ~s.1>, 'STORAGE',
                                     <'1', 'SHA256', H_SHA256(<'DAA_public_data', multp(~f, 'P1')>)
                                     >)), 
                          '1', 'SHA256', H_SHA256(<'DAA_public_data', multp(~f, 'P1')>)>,
                         KDF_a(<'1', ~s.1>, 'INTEGRITY', 'NULL')), 
                     len16(senc(<'1', curlyK(~K_1.2)>,
                                KDF_a(<'1', ~s.1>, 'STORAGE',
                                      <'1', 'SHA256', H_SHA256(<'DAA_public_data', multp(~f, 'P1')>)
                                      >))), 
                     senc(<'1', curlyK(~K_1.2)>,
                          KDF_a(<'1', ~s.1>, 'STORAGE',
                                <'1', 'SHA256', H_SHA256(<'DAA_public_data', multp(~f, 'P1')>)>)), 
                     aenc(<'1', ~s.1>, pk(KDF_EK(~TPM_EK_Seed.1))), 'Host_SendChallenge'
                    >
               ),
               Issuer_State_01( 'Issuer', curlyK(~K_1.2),
                                pk(KDF_EK(~TPM_EK_Seed.1)), <'DAA_public_data', multp(~f, 'P1')>
               )
               ]
    #vf.22: instance (modulo AC) Fresh:
               [ ] --> [ Fr( ~l.2 ) ]
    #vr.22: instance (modulo AC) Host_Store_DAA_Key:
               [
               In_S( $PS.2, $AS.2,
                     <senc(~f.5, KDF_AES(~TPM_AES_Seed.2)), 
                      <'DAA_public_data', multp(~f.5, 'P1')>, 'returnDAAKey'>
               ),
               Host_State_01( $PS.2, $AS.2, pk(KDF_EK(~TPM_EK_Seed.1)) )
               ]
              --[
              Store_DAA( $PS.2, $AS.2 ),
              PlatformSendKeys( $PS.2, $AS.2, pk(KDF_EK(~TPM_EK_Seed.1)),
                                <'DAA_public_data', multp(~f.5, 'P1')>, 'Issuer'
              ),
              Alive( $AS.2 ), Role( 'Platform' ), Honest( $PS.2 ),
              Honest( $AS.2 ), Honest( pk(KDF_EK(~TPM_EK_Seed.1)) ),
              Honest( 'Issuer' ), OnlyOnce( 'Host_Store_DAA_Key' )
              ]->
               [
               !EK_FOR_ISSUER( pk(KDF_EK(~TPM_EK_Seed.1)) ),
               Out( <pk(KDF_EK(~TPM_EK_Seed.1)), 
                     <'DAA_public_data', multp(~f.5, 'P1')>, 'join_Issuer_1'>
               ),
               Host_State_02( $PS.2, $AS.2, pk(KDF_EK(~TPM_EK_Seed.1)),
                              <'DAA_public_data', multp(~f.5, 'P1')>,
                              senc(~f.5, KDF_AES(~TPM_AES_Seed.2))
               )
               ]
    #vf.23: instance (modulo AC) Fresh:
               [ ] --> [ Fr( ~s_2.2 ) ]
    #vr.23: instance (modulo AC) Host_Store_EK:
               [
               In_S( $PS.2, $AS.2,
                     <<'EK_public_data', pk(KDF_EK(~TPM_EK_Seed.1))>, 'returnEK'>
               )
               ]
              --[ Store_EK( $PS.2, $AS.2 ), OnlyOnce( 'Host_Store_EK' ) ]->
               [
               Out_S( $AS.2, $PS.2, <pk(KDF_EK(~TPM_EK_Seed.1)), 'createDAAKey'>
               ),
               Host_State_01( $PS.2, $AS.2, pk(KDF_EK(~TPM_EK_Seed.1)) )
               ]
    #vf.24: instance (modulo AC) Fresh:
               [ ] --> [ Fr( ~K_2.2 ) ]
    #vr.24: instance (modulo AC) Issuer_Verify_Challenge_Issue_Credentials:
               [
               In( <curlyK(~K_1.3), Nonce(n_J.3), 
                    H_n_2(Nonce(n_J.3),
                          H_k_1(H_k_4('P1', multp(f.2, 'P1'), E(r_cv.4, 'P1'),
                                      <PkX(~x, 'P2'), PkY(~y, 'P2'), curlyK(~K_1.3), 
                                       pk(KDF_EK(~TPM_EK_Seed))>))), 
                    plus(r_cv.4,
                         multp(H_n_2(Nonce(n_J.3),
                                     H_k_1(H_k_4('P1', multp(f.2, 'P1'), E(r_cv.4, 'P1'),
                                                 <PkX(~x, 'P2'), PkY(~y, 'P2'), curlyK(~K_1.3), 
                                                  pk(KDF_EK(~TPM_EK_Seed))>))),
                               f.2)), 
                    'Issuer_SendChallengeResponse'>
               ),
               Issuer_State_01( 'Issuer', curlyK(~K_1.3),
                                pk(KDF_EK(~TPM_EK_Seed)), <'DAA_public_data', multp(f.2, 'P1')>
               ),
               !Pk( 'Issuer', PkX(~x, 'P2'), PkY(~y, 'P2') ),
               !Ltk( 'Issuer', ~x, ~y ), Fr( ~r.1 ), Fr( ~l.2 ), Fr( ~s_2.2 ),
               Fr( ~K_2.2 )
               ]
              --[
              Eq( curlyK(~K_1.3), curlyK(~K_1.3) ),
              Eq( H_n_2(Nonce(n_J.3),
                        H_k_1(H_k_4('P1', multp(f.2, 'P1'), E(r_cv.4, 'P1'),
                                    <PkX(~x, 'P2'), PkY(~y, 'P2'), curlyK(~K_1.3), 
                                     pk(KDF_EK(~TPM_EK_Seed))>))),
                  H_n_2(Nonce(n_J.3),
                        H_k_1(H_k_4('P1', multp(f.2, 'P1'), E(r_cv.4, 'P1'),
                                    <PkX(~x, 'P2'), PkY(~y, 'P2'), curlyK(~K_1.3), 
                                     pk(KDF_EK(~TPM_EK_Seed))>)))
              ),
              Commit( 'Issuer', pk(KDF_EK(~TPM_EK_Seed)), curlyK(~K_1.3) ),
              Running( 'Issuer', pk(KDF_EK(~TPM_EK_Seed)),
                       <multp(~r.1, 'P1'), multp(~y, multp(~r.1, 'P1')), 
                        plus(multp(~x, multp(~r.1, 'P1')),
                             multp(multp(multp(~r.1, ~x), ~y), multp(f.2, 'P1'))), 
                        multp(multp(~r.1, ~y), multp(f.2, 'P1'))>
              ),
              Alive( 'Issuer' ), Honest( 'Issuer' ),
              Honest( pk(KDF_EK(~TPM_EK_Seed)) ),
              Issuer_VerifyChallengeIssueCredentials( 'Issuer',
                                                      pk(KDF_EK(~TPM_EK_Seed))
              ),
              OnlyOnce( 'Issuer_Verify_Challenge' )
              ]->
               [
               Out( <
                     MAC(<
                          len16(senc(curlyK(~K_2.2),
                                     KDF_a(~s_2.2, 'STORAGE',
                                           <'SHA256', 
                                            H_SHA256(<'DAA_public_data', multp(f.2, 'P1')>)>))), 
                          senc(curlyK(~K_2.2),
                               KDF_a(~s_2.2, 'STORAGE',
                                     <'SHA256', H_SHA256(<'DAA_public_data', multp(f.2, 'P1')>)>)), 
                          'SHA256', H_SHA256(<'DAA_public_data', multp(f.2, 'P1')>)>,
                         KDF_a(~s_2.2, 'INTEGRITY', 'NULL')), 
                     len16(senc(curlyK(~K_2.2),
                                KDF_a(~s_2.2, 'STORAGE',
                                      <'SHA256', H_SHA256(<'DAA_public_data', multp(f.2, 'P1')>)
                                      >))), 
                     senc(curlyK(~K_2.2),
                          KDF_a(~s_2.2, 'STORAGE',
                                <'SHA256', H_SHA256(<'DAA_public_data', multp(f.2, 'P1')>)>)), 
                     aenc(~s_2.2, pk(KDF_EK(~TPM_EK_Seed))), 
                     senc(<multp(~r.1, 'P1'), multp(~y, multp(~r.1, 'P1')), 
                           plus(multp(~x, multp(~r.1, 'P1')),
                                multp(multp(multp(~r.1, ~x), ~y), multp(f.2, 'P1'))), 
                           multp(multp(~r.1, ~y), multp(f.2, 'P1')), 
                           H_n_8('P1', multp(f.2, 'P1'), RB(~l.2, 'P1'),
                                 RD(~l.2, multp(f.2, 'P1')), multp(~r.1, 'P1'),
                                 multp(~y, multp(~r.1, 'P1')),
                                 plus(multp(~x, multp(~r.1, 'P1')),
                                      multp(multp(multp(~r.1, ~x), ~y), multp(f.2, 'P1'))),
                                 multp(multp(~r.1, ~y), multp(f.2, 'P1'))), 
                           plus(~l.2,
                                multp(multp(~y, ~r.1),
                                      H_n_8('P1', multp(f.2, 'P1'), RB(~l.2, 'P1'),
                                            RD(~l.2, multp(f.2, 'P1')), multp(~r.1, 'P1'),
                                            multp(~y, multp(~r.1, 'P1')),
                                            plus(multp(~x, multp(~r.1, 'P1')),
                                                 multp(multp(multp(~r.1, ~x), ~y),
                                                       multp(f.2, 'P1'))),
                                            multp(multp(~r.1, ~y), multp(f.2, 'P1')))))
                          >,
                          curlyK(~K_2.2)), 
                     'Host_CompleteJoin'>
               )
               ]
    #vf.25: instance (modulo AC) isend:
               [
               !KU( <pk(KDF_EK(~TPM_EK_Seed)), 
                     <'DAA_public_data', multp(f.2, 'P1')>, 'join_Issuer_1'>
               )
               ]
              --[
              K( <pk(KDF_EK(~TPM_EK_Seed)), 
                  <'DAA_public_data', multp(f.2, 'P1')>, 'join_Issuer_1'>
              )
              ]->
               [
               In( <pk(KDF_EK(~TPM_EK_Seed)), 
                    <'DAA_public_data', multp(f.2, 'P1')>, 'join_Issuer_1'>
               )
               ]
    #vr.25: instance (modulo AC) d_0_snd:
               [
               !KD( <
                     MAC(<
