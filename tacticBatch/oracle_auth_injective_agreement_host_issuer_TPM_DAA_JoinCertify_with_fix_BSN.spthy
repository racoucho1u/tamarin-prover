    #vf.12: instance (modulo AC) isend:
               [
               !KU( <curlyK(~K_1.4), Nonce(~n_J.1), 
                     H_n_2(Nonce(~n_J.1),
                           H_k_1(H_k_4('P1', multp(~f, 'P1'), E(~r_cv.5, 'P1'),
                                       <PkX(~x, 'P2'), PkY(~y, 'P2'), curlyK(~K_1.4), 
                                        pk(KDF_EK(~TPM_EK_Seed.1))>))), 
                     plus(~r_cv.5,
                          multp(H_n_2(Nonce(~n_J.1),
                                      H_k_1(H_k_4('P1', multp(~f, 'P1'), E(~r_cv.5, 'P1'),
                                                  <PkX(~x, 'P2'), PkY(~y, 'P2'), curlyK(~K_1.4), 
                                                   pk(KDF_EK(~TPM_EK_Seed.1))>))),
                                ~f)), 
                     'Issuer_SendChallengeResponse'>
               )
               ]
              --[
              K( <curlyK(~K_1.4), Nonce(~n_J.1), 
                  H_n_2(Nonce(~n_J.1),
                        H_k_1(H_k_4('P1', multp(~f, 'P1'), E(~r_cv.5, 'P1'),
                                    <PkX(~x, 'P2'), PkY(~y, 'P2'), curlyK(~K_1.4), 
                                     pk(KDF_EK(~TPM_EK_Seed.1))>))), 
                  plus(~r_cv.5,
                       multp(H_n_2(Nonce(~n_J.1),
                                   H_k_1(H_k_4('P1', multp(~f, 'P1'), E(~r_cv.5, 'P1'),
                                               <PkX(~x, 'P2'), PkY(~y, 'P2'), curlyK(~K_1.4), 
                                                pk(KDF_EK(~TPM_EK_Seed.1))>))),
                             ~f)), 
                  'Issuer_SendChallengeResponse'>
              )
              ]->
               [
               In( <curlyK(~K_1.4), Nonce(~n_J.1), 
                    H_n_2(Nonce(~n_J.1),
                          H_k_1(H_k_4('P1', multp(~f, 'P1'), E(~r_cv.5, 'P1'),
                                      <PkX(~x, 'P2'), PkY(~y, 'P2'), curlyK(~K_1.4), 
                                       pk(KDF_EK(~TPM_EK_Seed.1))>))), 
                    plus(~r_cv.5,
                         multp(H_n_2(Nonce(~n_J.1),
                                     H_k_1(H_k_4('P1', multp(~f, 'P1'), E(~r_cv.5, 'P1'),
                                                 <PkX(~x, 'P2'), PkY(~y, 'P2'), curlyK(~K_1.4), 
