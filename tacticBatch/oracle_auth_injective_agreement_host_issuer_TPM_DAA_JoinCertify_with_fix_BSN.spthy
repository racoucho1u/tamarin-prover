               [
               In_S( $PS.6, $AS.8,
                     <curlyK(K_2_rec), 'ret_TPM2_ActivateCredentials_2'>
               ),
               !Pk( 'Issuer', PkX(~x, 'P2'), PkY(~y, 'P2') ),
               Host_State_06( $PS.6, $AS.8, pk(KDF_EK(~TPM_EK_Seed.5)),
