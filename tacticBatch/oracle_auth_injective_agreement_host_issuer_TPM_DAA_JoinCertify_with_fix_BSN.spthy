                   aenc(<'1', ~s>, pk(KDF_EK(~TPM_EK_Seed))), 'Host_SendChallenge'>
              ),
              Host_State_02( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)),
                             <'DAA_public_data', multp(~f, 'P1')>,
                             senc(~f, KDF_AES(~TPM_AES_Seed))
              )
              ]
             --[
             Passthrough_ActivateCred( $PS, $AS ),
             OnlyOnce( 'Host_Passthrough' )
             ]->
              [
              Out_S( $AS, $PS,
                     <senc(~f, KDF_AES(~TPM_AES_Seed)), 
                      <'DAA_public_data', multp(~f, 'P1')>, curlyH.1, len16(curlyK_hat), 
                      curlyK_hat, aenc(<'1', ~s>, pk(KDF_EK(~TPM_EK_Seed))), 
                      'TPM2_ActivateCredentials'>
              ),
              Host_State_03( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)),
                             <'DAA_public_data', multp(~f, 'P1')>,
                             senc(~f, KDF_AES(~TPM_AES_Seed))
