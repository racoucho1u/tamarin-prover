               ]
    #vr.56: instance (modulo AC) TPM2_Commit:
               [
               In_S( $AS.7, $PS.4,
                     <BSN('bottom'), BSN('bottom'), BSN('bottom'), 'TPM2_Commit'>
               ),
               Fr( ~cv.1 ), Fr( ~r_cv.2 )
               ]
              --[ TPM2_Commited( $PS.4, $AS.7 ), OnlyOnce( 'TPM2_Commit' ) ]->
               [
               Out_S( $PS.4, $AS.7,
