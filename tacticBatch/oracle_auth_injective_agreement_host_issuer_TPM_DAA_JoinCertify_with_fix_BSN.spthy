                                multp(multp(~r, ~y), multp(~f.9, 'P1'))), 
                          plus(~l.1,
                               multp(multp(~y, ~r),
                                     H_n_8('P1', multp(~f.9, 'P1'), RB(~l.1, 'P1'),
                                           RD(~l.1, multp(~f.9, 'P1')), multp(~r, 'P1'),
                                           multp(~y, multp(~r, 'P1')),
