                  H_n_2(Nonce(n_J.2),
                        H_k_1(H_k_4('P1', multp(~f, 'P1'), E(r_cv.3, 'P1'),
                                    <PkX(~x, 'P2'), PkY(~y, 'P2'), curlyK(~K_1.3), 
                                     pk(KDF_EK(~TPM_EK_Seed.1))>)))
              ),
              Commit( 'Issuer', pk(KDF_EK(~TPM_EK_Seed.1)), curlyK(~K_1.3) ),
              Running( 'Issuer', pk(KDF_EK(~TPM_EK_Seed.1)),
                       <multp(~x.1, 'P1'), multp(~y, multp(~x.1, 'P1')), 
                        plus(multp(~x, multp(~x.1, 'P1')),
                             multp(multp(multp(~x.1, ~x), ~y), multp(~f, 'P1'))), 
                        multp(multp(~x.1, ~y), multp(~f, 'P1'))>
              ),
              Alive( 'Issuer' ), Honest( 'Issuer' ),
              Honest( pk(KDF_EK(~TPM_EK_Seed.1)) ),
              Issuer_VerifyChallengeIssueCredentials( 'Issuer',
