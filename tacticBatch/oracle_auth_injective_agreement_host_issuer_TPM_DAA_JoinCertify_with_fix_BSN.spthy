               [
               In_S( $PS.8, $AS.12,
                     <curlyK(K_2_rec), 'ret_TPM2_ActivateCredentials_2'>
               ),
               !Pk( 'Issuer', PkX(~x, 'P2'), PkY(~y, 'P2') ),
               Host_State_06( $PS.8, $AS.12, pk(KDF_EK(~TPM_EK_Seed.9)),
                              <'DAA_public_data', multp(~f.4, 'P1')>,
                              senc(<multp(~f.1, 'P1'), multp(~y, multp(~f.1, 'P1')), 
                                    plus(multp(~x, multp(~f.1, 'P1')),
                                         multp(multp(multp(~f.1, ~x), ~y), multp(~f.4, 'P1'))), 
                                    multp(multp(~f.1, ~y), multp(~f.4, 'P1')), 
                                    H_n_8('P1', multp(~f.4, 'P1'), RB(x.2, 'P1'),
                                          RD(x.2, multp(~f.4, 'P1')), multp(~f.1, 'P1'),
                                          multp(~y, multp(~f.1, 'P1')),
                                          plus(multp(~x, multp(~f.1, 'P1')),
                                               multp(multp(multp(~f.1, ~x), ~y),
                                                     multp(~f.4, 'P1'))),
                                          multp(multp(~f.1, ~y), multp(~f.4, 'P1'))), 
                                    plus(x.2,
                                         multp(multp(~y, ~f.1),
                                               H_n_8('P1', multp(~f.4, 'P1'), RB(x.2, 'P1'),
                                                     RD(x.2, multp(~f.4, 'P1')), multp(~f.1, 'P1'),
                                                     multp(~y, multp(~f.1, 'P1')),
                                                     plus(multp(~x, multp(~f.1, 'P1')),
                                                          multp(multp(multp(~f.1, ~x), ~y),
                                                                multp(~f.4, 'P1'))),
                                                     multp(multp(~f.1, ~y), multp(~f.4, 'P1')))))
                                   >,
                                   curlyK(K_2_rec))
               )
               ]
              --[
              Eq( curlyK(K_2_rec), curlyK(K_2_rec) ),
              Eq( H_n_8('P1', multp(~f.4, 'P1'), RB(x.2, 'P1'),
                        RD(x.2, multp(~f.4, 'P1')), multp(~f.1, 'P1'),
                        multp(~y, multp(~f.1, 'P1')),
                        plus(multp(~x, multp(~f.1, 'P1')),
                             multp(multp(multp(~f.1, ~x), ~y), multp(~f.4, 'P1'))),
                        multp(multp(~f.1, ~y), multp(~f.4, 'P1'))),
                  H_n_8('P1', multp(~f.4, 'P1'), RB(x.2, 'P1'),
                        RD(x.2, multp(~f.4, 'P1')), multp(~f.1, 'P1'),
                        multp(~y, multp(~f.1, 'P1')),
                        plus(multp(~x, multp(~f.1, 'P1')),
                             multp(multp(multp(~f.1, ~x), ~y), multp(~f.4, 'P1'))),
                        multp(multp(~f.1, ~y), multp(~f.4, 'P1')))
              ),
              Eq( accept, accept ), Eq( accept, accept ),
              JoinCompleted( $PS.8, $AS.12, pk(KDF_EK(~TPM_EK_Seed.9)) ),
              Commit( pk(KDF_EK(~TPM_EK_Seed.9)), 'Issuer',
                      <multp(~f.1, 'P1'), multp(~y, multp(~f.1, 'P1')), 
                       plus(multp(~x, multp(~f.1, 'P1')),
                            multp(multp(multp(~f.1, ~x), ~y), multp(~f.4, 'P1'))), 
                       multp(multp(~f.1, ~y), multp(~f.4, 'P1'))>
              ),
              Role( 'Platform' ),
              Secret( pk(KDF_EK(~TPM_EK_Seed.9)), 'Issuer',
                      <multp(~f.1, 'P1'), multp(~y, multp(~f.1, 'P1')), 
                       plus(multp(~x, multp(~f.1, 'P1')),
                            multp(multp(multp(~f.1, ~x), ~y), multp(~f.4, 'P1'))), 
                       multp(multp(~f.1, ~y), multp(~f.4, 'P1'))>
              ),
              Honest( $PS.8 ), Honest( $AS.12 ),
              Honest( pk(KDF_EK(~TPM_EK_Seed.9)) ), Honest( 'Issuer' ),
              OnlyOnce( 'Host_JoinComplete' )
              ]->
               [
               !Host_State_RNDCreds( $PS.8, $AS.12, pk(KDF_EK(~TPM_EK_Seed.9)),
                                     multp(~f.1, 'P1'), multp(~y, multp(~f.1, 'P1')),
                                     plus(multp(~x, multp(~f.1, 'P1')),
                                          multp(multp(multp(~f.1, ~x), ~y), multp(~f.4, 'P1'))),
                                     multp(multp(~f.1, ~y), multp(~f.4, 'P1'))
               ),
               !Host_Join_Complete( $PS.8, $AS.12, pk(KDF_EK(~TPM_EK_Seed.9)) ),
               Host_Org_Creds( $PS.8, $AS.12, pk(KDF_EK(~TPM_EK_Seed.9)),
                               multp(~f.1, 'P1'), multp(~y, multp(~f.1, 'P1')),
                               plus(multp(~x, multp(~f.1, 'P1')),
                                    multp(multp(multp(~f.1, ~x), ~y), multp(~f.4, 'P1'))),
                               multp(multp(~f.1, ~y), multp(~f.4, 'P1'))
               )
               ]
