                                                     multp(~f.3, 'P1'))),
                                          multp(multp(~f.1, ~y), multp(~f.3, 'P1'))), 
                                    plus(x.2,
                                         multp(multp(~y, ~f.1),
                                               H_n_8('P1', multp(~f.3, 'P1'), RB(x.2, 'P1'),
                                                     RD(x.2, multp(~f.3, 'P1')), multp(~f.1, 'P1'),
                                                     multp(~y, multp(~f.1, 'P1')),
                                                     plus(multp(~x, multp(~f.1, 'P1')),
                                                          multp(multp(multp(~f.1, ~x), ~y),
                                                                multp(~f.3, 'P1'))),
                                                     multp(multp(~f.1, ~y), multp(~f.3, 'P1')))))
                                   >,
