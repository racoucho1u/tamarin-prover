    #vr.22: instance (modulo AC) Host_Store_DAA_Key:
               [
               In_S( $PS.2, $AS.2,
                     <senc(~f.4, KDF_AES(~TPM_AES_Seed.2)), 
                      <'DAA_public_data', multp(~f.4, 'P1')>, 'returnDAAKey'>
               ),
