               TPM_tkt( $PS.4, Nonce(~tkt.1) ),
               !TPM_DAA_SK( $PS.4, pk(KDF_EK(~TPM_EK_Seed.4)), ~f ),
               TPM_CV_E( $PS.4, Nonce(~cv.2), ~r_cv.3 ), Fr( ~n_J.1 )
               ]
              --[
              TPM2_Signed_P_TPM( $PS.4, $AS.4 ),
              Eq( Nonce(~cv.2), Nonce(~cv.2) ),
              Eq( Nonce(~tkt.1), Nonce(~tkt.1) ), OnlyOnce( 'TPM2_Sign' )
              ]->
               [
               Out_S( $PS.4, $AS.4,
                      <Nonce(~n_J.1), 
                       plus(~r_cv.3,
                            multp(H_n_2(Nonce(~n_J.1),
                                        H_k_1(H_k_4('P1', multp(~f, 'P1'), E(~r_cv.3, 'P1'),
                                                    <PkX(~x, 'P2'), PkY(~y, 'P2'), curlyK(~K_1.3), 
                                                     pk(KDF_EK(~TPM_EK_Seed.1))>))),
                                  ~f)), 
                       'ret_TPM2_Sign'>
               )
               ]
