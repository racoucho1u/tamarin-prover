              !Ltk( 'Issuer', ~x, ~y ), Fr( ~r ), Fr( ~l.1 ), Fr( ~s_2 ),
              Fr( ~K_2.1 )
              ]
             --[
             Eq( curlyK(~K_1.1), curlyK(~K_1.1) ),
             Eq( H_n_2(Nonce(~n_J.1),
                       H_k_1(H_k_4('P1', multp(~f.9, 'P1'), E(~r_cv.6, 'P1'),
                                   <PkX(~x, 'P2'), PkY(~y, 'P2'), curlyK(~K_1.1), 
