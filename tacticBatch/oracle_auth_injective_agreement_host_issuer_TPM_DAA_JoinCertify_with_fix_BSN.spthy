    #vr.65: instance (modulo AC) Host_ReceiveCurlyK:
               [
               In_S( $PS.7, $AS.8, <curlyK(K_1.7), 'ret_TPM2_ActivateCredentials'>
               ),
               !Pk( 'Issuer', PkX(~x, 'P2'), PkY(~y, 'P2') ),
