               ),
               !TPM_DAA_SK( $PS.6, pk(KDF_EK(~TPM_EK_Seed.13)), ~f.1 )
               ]
    #vr.69: instance (modulo AC) TPM2_Commit:
               [
               In_S( $AS.11, $PS.6,
                     <BSN('bottom'), BSN('bottom'), BSN('bottom'), 'TPM2_Commit'>
               ),
               Fr( ~cv.3 ), Fr( ~r_cv.2 )
