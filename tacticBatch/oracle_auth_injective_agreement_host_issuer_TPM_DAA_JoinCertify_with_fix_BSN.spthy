                                plus(multp(~x, multp(~f.1, 'P1')),
                                     multp(multp(multp(~f.1, ~x), ~y), multp(~f.4, 'P1'))),
                                multp(multp(~f.1, ~y), multp(~f.4, 'P1'))), 
                          plus(x.2,
                               multp(multp(~y, ~f.1),
                                     H_n_8('P1', multp(~f.4, 'P1'), RB(x.2, 'P1'),
                                           RD(x.2, multp(~f.4, 'P1')), multp(~f.1, 'P1'),
                                           multp(~y, multp(~f.1, 'P1')),
                                           plus(multp(~x, multp(~f.1, 'P1')),
                                                multp(multp(multp(~f.1, ~x), ~y),
                                                      multp(~f.4, 'P1'))),
                                           multp(multp(~f.1, ~y), multp(~f.4, 'P1')))))
                         >,
                         curlyK(K_2_rec)), 
                    'Host_CompleteJoin'>
               ),
               Host_State_05( $PS.8, $AS.12, pk(KDF_EK(~TPM_EK_Seed.9)),
                              <'DAA_public_data', multp(~f.4, 'P1')>,
                              senc(~f.4, KDF_AES(~TPM_AES_Seed.11))
               )
               ]
              --[
              Passthrough_ActivateCred2( $PS.8, $AS.12 ),
              OnlyOnce( 'Host_Passthrough_2' )
              ]->
               [
               Out_S( $AS.12, $PS.8,
                      <senc(~f.4, KDF_AES(~TPM_AES_Seed.11)), 
                       <'DAA_public_data', multp(~f.4, 'P1')>, curlyH.6, 
                       len16(curlyK_2_hat.1), curlyK_2_hat.1, 
                       aenc(~s_2.2, pk(KDF_EK(~TPM_EK_Seed.9))), 
                       'TPM2_ActivateCredentials_2'>
               ),
               Host_State_06( $PS.8, $AS.12, pk(KDF_EK(~TPM_EK_Seed.9)),
                              <'DAA_public_data', multp(~f.4, 'P1')>,
                              senc(<multp(~f.1, 'P1'), multp(~y, multp(~f.1, 'P1')), 
                                    plus(multp(~x, multp(~f.1, 'P1')),
                                         multp(multp(multp(~f.1, ~x), ~y), multp(~f.4, 'P1'))), 
                                    multp(multp(~f.1, ~y), multp(~f.4, 'P1')), 
                                    H_n_8('P1', multp(~f.4, 'P1'), RB(x.2, 'P1'),
                                          RD(x.2, multp(~f.4, 'P1')), multp(~f.1, 'P1'),
                                          multp(~y, multp(~f.1, 'P1')),
                                          plus(multp(~x, multp(~f.1, 'P1')),
                                               multp(multp(multp(~f.1, ~x), ~y),
                                                     multp(~f.4, 'P1'))),
                                          multp(multp(~f.1, ~y), multp(~f.4, 'P1'))), 
                                    plus(x.2,
                                         multp(multp(~y, ~f.1),
                                               H_n_8('P1', multp(~f.4, 'P1'), RB(x.2, 'P1'),
                                                     RD(x.2, multp(~f.4, 'P1')), multp(~f.1, 'P1'),
                                                     multp(~y, multp(~f.1, 'P1')),
                                                     plus(multp(~x, multp(~f.1, 'P1')),
                                                          multp(multp(multp(~f.1, ~x), ~y),
                                                                multp(~f.4, 'P1'))),
                                                     multp(multp(~f.1, ~y), multp(~f.4, 'P1')))))
                                   >,
                                   curlyK(K_2_rec))
