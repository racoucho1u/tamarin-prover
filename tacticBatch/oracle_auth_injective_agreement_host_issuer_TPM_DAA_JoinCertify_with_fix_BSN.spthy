                                            multp(multp(~x.1, ~y), multp(~f, 'P1')))))
                          >,
                          curlyK(~K_2)), 
                     'Host_CompleteJoin'>
               )
               ]
              -->
               [
               !KD( senc(<multp(~x.1, 'P1'), multp(~y, multp(~x.1, 'P1')), 
                          plus(multp(~x, multp(~x.1, 'P1')),
                               multp(multp(multp(~x.1, ~x), ~y), multp(~f, 'P1'))), 
                          multp(multp(~x.1, ~y), multp(~f, 'P1')), 
                          H_n_8('P1', multp(~f, 'P1'), RB(~l, 'P1'), RD(~l, multp(~f, 'P1')),
                                multp(~x.1, 'P1'), multp(~y, multp(~x.1, 'P1')),
                                plus(multp(~x, multp(~x.1, 'P1')),
                                     multp(multp(multp(~x.1, ~x), ~y), multp(~f, 'P1'))),
                                multp(multp(~x.1, ~y), multp(~f, 'P1'))), 
                          plus(~l,
                               multp(multp(~y, ~x.1),
                                     H_n_8('P1', multp(~f, 'P1'), RB(~l, 'P1'),
                                           RD(~l, multp(~f, 'P1')), multp(~x.1, 'P1'),
                                           multp(~y, multp(~x.1, 'P1')),
                                           plus(multp(~x, multp(~x.1, 'P1')),
                                                multp(multp(multp(~x.1, ~x), ~y), multp(~f, 'P1'))),
                                           multp(multp(~x.1, ~y), multp(~f, 'P1')))))
                         >,
                         curlyK(~K_2))
               )
               ]
    #vf.21: instance (modulo AC) Fresh:
               [ ] --> [ Fr( ~K_1 ) ]
    #vr.21: instance (modulo AC) Issuer_Check_EK_Send_Challenge:
               [
               In( <pk(KDF_EK(~TPM_EK_Seed.1)), 
                    <'DAA_public_data', multp(~f, 'P1')>, 'join_Issuer_1'>
               ),
               Fr( ~K_1.4 ), Fr( ~s.2 ),
               !EK_FOR_ISSUER( pk(KDF_EK(~TPM_EK_Seed.1)) )
               ]
              --[
              Check_Ek( pk(KDF_EK(~TPM_EK_Seed.1)) ),
              Check_QPD( <'DAA_public_data', multp(~f, 'P1')> ),
              Associate( curlyK(~K_1.4), pk(KDF_EK(~TPM_EK_Seed.1)),
                         <'DAA_public_data', multp(~f, 'P1')>
              ),
              Alive( 'Issuer' ), Honest( 'Issuer' ),
              Honest( pk(KDF_EK(~TPM_EK_Seed.1)) ),
              IssuerReceivedKeys( 'Issuer', pk(KDF_EK(~TPM_EK_Seed.1)),
                                  <'DAA_public_data', multp(~f, 'P1')>
              ),
              OnlyOnce( 'Issuer_Check_EK_Send_Challenge' )
              ]->
               [
               Out( <
                     MAC(<'1', 
                          len16(senc(<'1', curlyK(~K_1.4)>,
                                     KDF_a(<'1', ~s.2>, 'STORAGE',
                                           <'1', 'SHA256', 
                                            H_SHA256(<'DAA_public_data', multp(~f, 'P1')>)>))), 
                          senc(<'1', curlyK(~K_1.4)>,
                               KDF_a(<'1', ~s.2>, 'STORAGE',
                                     <'1', 'SHA256', H_SHA256(<'DAA_public_data', multp(~f, 'P1')>)
                                     >)), 
                          '1', 'SHA256', H_SHA256(<'DAA_public_data', multp(~f, 'P1')>)>,
                         KDF_a(<'1', ~s.2>, 'INTEGRITY', 'NULL')), 
                     len16(senc(<'1', curlyK(~K_1.4)>,
                                KDF_a(<'1', ~s.2>, 'STORAGE',
                                      <'1', 'SHA256', H_SHA256(<'DAA_public_data', multp(~f, 'P1')>)
                                      >))), 
                     senc(<'1', curlyK(~K_1.4)>,
                          KDF_a(<'1', ~s.2>, 'STORAGE',
                                <'1', 'SHA256', H_SHA256(<'DAA_public_data', multp(~f, 'P1')>)>)), 
                     aenc(<'1', ~s.2>, pk(KDF_EK(~TPM_EK_Seed.1))), 'Host_SendChallenge'
                    >
               ),
               Issuer_State_01( 'Issuer', curlyK(~K_1.4),
                                pk(KDF_EK(~TPM_EK_Seed.1)), <'DAA_public_data', multp(~f, 'P1')>
               )
               ]
