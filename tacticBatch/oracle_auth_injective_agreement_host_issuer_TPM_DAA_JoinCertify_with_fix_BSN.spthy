    #vr.12: instance (modulo AC) Issuer_Check_EK_Send_Challenge:
               [
               In( <pk(KDF_EK(~TPM_EK_Seed)), 
                    <'DAA_public_data', multp(~f.1, 'P1')>, 'join_Issuer_1'>
               ),
               Fr( ~K_1.2 ), Fr( ~s.1 ),
               !EK_FOR_ISSUER( pk(KDF_EK(~TPM_EK_Seed)) )
               ]
              --[
              Check_Ek( pk(KDF_EK(~TPM_EK_Seed)) ),
              Check_QPD( <'DAA_public_data', multp(~f.1, 'P1')> ),
              Associate( curlyK(~K_1.2), pk(KDF_EK(~TPM_EK_Seed)),
                         <'DAA_public_data', multp(~f.1, 'P1')>
              ),
              Alive( 'Issuer' ), Honest( 'Issuer' ),
              Honest( pk(KDF_EK(~TPM_EK_Seed)) ),
              IssuerReceivedKeys( 'Issuer', pk(KDF_EK(~TPM_EK_Seed)),
                                  <'DAA_public_data', multp(~f.1, 'P1')>
              ),
              OnlyOnce( 'Issuer_Check_EK_Send_Challenge' )
              ]->
               [
               Out( <
                     MAC(<'1', 
                          len16(senc(<'1', curlyK(~K_1.2)>,
                                     KDF_a(<'1', ~s.1>, 'STORAGE',
                                           <'1', 'SHA256', 
                                            H_SHA256(<'DAA_public_data', multp(~f.1, 'P1')>)>))), 
                          senc(<'1', curlyK(~K_1.2)>,
                               KDF_a(<'1', ~s.1>, 'STORAGE',
                                     <'1', 'SHA256', 
                                      H_SHA256(<'DAA_public_data', multp(~f.1, 'P1')>)>)), 
                          '1', 'SHA256', H_SHA256(<'DAA_public_data', multp(~f.1, 'P1')>)>,
                         KDF_a(<'1', ~s.1>, 'INTEGRITY', 'NULL')), 
                     len16(senc(<'1', curlyK(~K_1.2)>,
                                KDF_a(<'1', ~s.1>, 'STORAGE',
                                      <'1', 'SHA256', 
                                       H_SHA256(<'DAA_public_data', multp(~f.1, 'P1')>)>))), 
                     senc(<'1', curlyK(~K_1.2)>,
                          KDF_a(<'1', ~s.1>, 'STORAGE',
                                <'1', 'SHA256', H_SHA256(<'DAA_public_data', multp(~f.1, 'P1')>)
                                >)), 
                     aenc(<'1', ~s.1>, pk(KDF_EK(~TPM_EK_Seed))), 'Host_SendChallenge'>
               ),
               Issuer_State_01( 'Issuer', curlyK(~K_1.2),
                                pk(KDF_EK(~TPM_EK_Seed)), <'DAA_public_data', multp(~f.1, 'P1')>
               )
               ]
    #vf.13: instance (modulo AC) Fresh:
               [ ] --> [ Fr( ~x.1 ) ]
    #vr.13: instance (modulo AC) Host_Store_DAA_Key:
               [
               In_S( $PS.1, $AS.1,
                     <senc(~f.4, KDF_AES(~TPM_AES_Seed.1)), 
                      <'DAA_public_data', multp(~f.4, 'P1')>, 'returnDAAKey'>
               ),
               Host_State_01( $PS.1, $AS.1, pk(KDF_EK(~TPM_EK_Seed)) )
               ]
              --[
              Store_DAA( $PS.1, $AS.1 ),
              PlatformSendKeys( $PS.1, $AS.1, pk(KDF_EK(~TPM_EK_Seed)),
                                <'DAA_public_data', multp(~f.4, 'P1')>, 'Issuer'
              ),
              Alive( $AS.1 ), Role( 'Platform' ), Honest( $PS.1 ),
              Honest( $AS.1 ), Honest( pk(KDF_EK(~TPM_EK_Seed)) ),
              Honest( 'Issuer' ), OnlyOnce( 'Host_Store_DAA_Key' )
              ]->
               [
               !EK_FOR_ISSUER( pk(KDF_EK(~TPM_EK_Seed)) ),
               Out( <pk(KDF_EK(~TPM_EK_Seed)), 
                     <'DAA_public_data', multp(~f.4, 'P1')>, 'join_Issuer_1'>
               ),
               Host_State_02( $PS.1, $AS.1, pk(KDF_EK(~TPM_EK_Seed)),
                              <'DAA_public_data', multp(~f.4, 'P1')>,
                              senc(~f.4, KDF_AES(~TPM_AES_Seed.1))
               )
               ]
    #vf.14: instance (modulo AC) Fresh:
