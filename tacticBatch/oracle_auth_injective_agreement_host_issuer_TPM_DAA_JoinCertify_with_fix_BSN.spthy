              TPM2_Signed_P_TPM( $PS.4, $AS.4 ),
              Eq( Nonce(~cv.1), Nonce(~cv.1) ), Eq( Nonce(~tkt), Nonce(~tkt) ),
              OnlyOnce( 'TPM2_Sign' )
              ]->
               [
               Out_S( $PS.4, $AS.4,
                      <Nonce(~n_J), 
                       plus(~r_cv.1,
