    #vr.15: instance (modulo AC) Issuer_Verify_Challenge_Issue_Credentials:
               [
               In( <curlyK(~K_1.5), Nonce(~n_J.2), 
                    H_n_2(Nonce(~n_J.2),
                          H_k_1(H_k_4('P1', multp(~f, 'P1'), E(r_cv.3, 'P1'),
                                      <PkX(~x, 'P2'), PkY(~y, 'P2'), curlyK(~K_1.5), 
                                       pk(KDF_EK(~TPM_EK_Seed.1))>))), 
                    plus(r_cv.3,
                         multp(H_n_2(Nonce(~n_J.2),
                                     H_k_1(H_k_4('P1', multp(~f, 'P1'), E(r_cv.3, 'P1'),
                                                 <PkX(~x, 'P2'), PkY(~y, 'P2'), curlyK(~K_1.5), 
                                                  pk(KDF_EK(~TPM_EK_Seed.1))>))),
                               ~f)), 
                    'Issuer_SendChallengeResponse'>
               ),
               Issuer_State_01( 'Issuer', curlyK(~K_1.5),
                                pk(KDF_EK(~TPM_EK_Seed.1)), <'DAA_public_data', multp(~f, 'P1')>
               ),
               !Pk( 'Issuer', PkX(~x, 'P2'), PkY(~y, 'P2') ),
               !Ltk( 'Issuer', ~x, ~y ), Fr( ~x.1 ), Fr( ~l ), Fr( ~s_2.1 ),
               Fr( ~K_2 )
               ]
              --[
              Eq( curlyK(~K_1.5), curlyK(~K_1.5) ),
              Eq( H_n_2(Nonce(~n_J.2),
                        H_k_1(H_k_4('P1', multp(~f, 'P1'), E(r_cv.3, 'P1'),
                                    <PkX(~x, 'P2'), PkY(~y, 'P2'), curlyK(~K_1.5), 
                                     pk(KDF_EK(~TPM_EK_Seed.1))>))),
                  H_n_2(Nonce(~n_J.2),
                        H_k_1(H_k_4('P1', multp(~f, 'P1'), E(r_cv.3, 'P1'),
                                    <PkX(~x, 'P2'), PkY(~y, 'P2'), curlyK(~K_1.5), 
                                     pk(KDF_EK(~TPM_EK_Seed.1))>)))
              ),
              Commit( 'Issuer', pk(KDF_EK(~TPM_EK_Seed.1)), curlyK(~K_1.5) ),
              Running( 'Issuer', pk(KDF_EK(~TPM_EK_Seed.1)),
                       <multp(~x.1, 'P1'), multp(~y, multp(~x.1, 'P1')), 
                        plus(multp(~x, multp(~x.1, 'P1')),
                             multp(multp(multp(~x.1, ~x), ~y), multp(~f, 'P1'))), 
                        multp(multp(~x.1, ~y), multp(~f, 'P1'))>
              ),
              Alive( 'Issuer' ), Honest( 'Issuer' ),
              Honest( pk(KDF_EK(~TPM_EK_Seed.1)) ),
              Issuer_VerifyChallengeIssueCredentials( 'Issuer',
                                                      pk(KDF_EK(~TPM_EK_Seed.1))
              ),
              OnlyOnce( 'Issuer_Verify_Challenge' )
              ]->
               [
               Out( <
                     MAC(<
                          len16(senc(curlyK(~K_2),
                                     KDF_a(~s_2.1, 'STORAGE',
                                           <'SHA256', H_SHA256(<'DAA_public_data', multp(~f, 'P1')>)
                                           >))), 
                          senc(curlyK(~K_2),
                               KDF_a(~s_2.1, 'STORAGE',
                                     <'SHA256', H_SHA256(<'DAA_public_data', multp(~f, 'P1')>)>)), 
                          'SHA256', H_SHA256(<'DAA_public_data', multp(~f, 'P1')>)>,
                         KDF_a(~s_2.1, 'INTEGRITY', 'NULL')), 
                     len16(senc(curlyK(~K_2),
                                KDF_a(~s_2.1, 'STORAGE',
                                      <'SHA256', H_SHA256(<'DAA_public_data', multp(~f, 'P1')>)
                                      >))), 
                     senc(curlyK(~K_2),
                          KDF_a(~s_2.1, 'STORAGE',
                                <'SHA256', H_SHA256(<'DAA_public_data', multp(~f, 'P1')>)>)), 
                     aenc(~s_2.1, pk(KDF_EK(~TPM_EK_Seed.1))), 
                     senc(<multp(~x.1, 'P1'), multp(~y, multp(~x.1, 'P1')), 
                           plus(multp(~x, multp(~x.1, 'P1')),
                                multp(multp(multp(~x.1, ~x), ~y), multp(~f, 'P1'))), 
                           multp(multp(~x.1, ~y), multp(~f, 'P1')), 
                           H_n_8('P1', multp(~f, 'P1'), RB(~l, 'P1'), RD(~l, multp(~f, 'P1')),
                                 multp(~x.1, 'P1'), multp(~y, multp(~x.1, 'P1')),
                                 plus(multp(~x, multp(~x.1, 'P1')),
                                      multp(multp(multp(~x.1, ~x), ~y), multp(~f, 'P1'))),
                                 multp(multp(~x.1, ~y), multp(~f, 'P1'))), 
                           plus(~l,
                                multp(multp(~y, ~x.1),
                                      H_n_8('P1', multp(~f, 'P1'), RB(~l, 'P1'),
                                            RD(~l, multp(~f, 'P1')), multp(~x.1, 'P1'),
                                            multp(~y, multp(~x.1, 'P1')),
                                            plus(multp(~x, multp(~x.1, 'P1')),
                                                 multp(multp(multp(~x.1, ~x), ~y),
                                                       multp(~f, 'P1'))),
                                            multp(multp(~x.1, ~y), multp(~f, 'P1')))))
                          >,
                          curlyK(~K_2)), 
                     'Host_CompleteJoin'>
               )
               ]
