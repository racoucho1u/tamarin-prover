    #vr.80: instance (modulo AC) Host_ReceiveEAndCV:
               [
               In_S( $PS.8, $AS.12,
                     <E(r_cv.7, 'P1'), Nonce(cv.6), 'retTPM2_commit'>
               ),
               Host_State_04( $PS.8, $AS.12, pk(KDF_EK(~TPM_EK_Seed.9)),
                              <'DAA_public_data', multp(~f.4, 'P1')>,
                              senc(~f.4, KDF_AES(~TPM_AES_Seed.11)),
                              <PkX(~x, 'P2'), PkY(~y, 'P2'), curlyK(K_1.8), 
                               pk(KDF_EK(~TPM_EK_Seed.9))>
               )
               ]
              --[
              Host_Created_p( $PS.8, $AS.12 ), OnlyOnce( 'Host_ReceiveEAndCV' )
              ]->
               [
               Out_S( $AS.12, $PS.8,
                      <
                       H_k_4('P1', multp(~f.4, 'P1'), E(r_cv.7, 'P1'),
                             <PkX(~x, 'P2'), PkY(~y, 'P2'), curlyK(K_1.8), 
                              pk(KDF_EK(~TPM_EK_Seed.9))>), 
                       'TPM2_Hash'>
               ),
               Host_cv( $PS.8, $AS.12, Nonce(cv.6) ),
               Host_State_05( $PS.8, $AS.12, pk(KDF_EK(~TPM_EK_Seed.9)),
                              <'DAA_public_data', multp(~f.4, 'P1')>,
                              senc(~f.4, KDF_AES(~TPM_AES_Seed.11))
               )
               ]
    #vr.81: instance (modulo AC) Host_ReceiveCurlyK:
