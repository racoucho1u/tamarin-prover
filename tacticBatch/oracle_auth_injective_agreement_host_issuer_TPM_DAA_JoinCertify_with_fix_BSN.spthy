    #vr.63: instance (modulo AC) TPM2_Sign:
               [
               In_S( $AS.8, $PS.6,
                     <
                      H_k_1(H_k_4('P1', multp(~f.1, 'P1'), E(~r_cv.2, 'P1'),
                                  <PkX(~x, 'P2'), PkY(~y, 'P2'), curlyK(~K_1.2), 
                                   pk(KDF_EK(~TPM_EK_Seed))>)), 
                      Nonce(~tkt.1), Nonce(~cv.3), 'TPM2_Sign'>
               ),
               TPM_tkt( $PS.6, Nonce(~tkt.1) ),
               !TPM_DAA_SK( $PS.6, pk(KDF_EK(~TPM_EK_Seed.13)), ~f.1 ),
               TPM_CV_E( $PS.6, Nonce(~cv.3), ~r_cv.2 ), Fr( ~n_J.1 )
               ]
              --[
              TPM2_Signed_P_TPM( $PS.6, $AS.8 ),
              Eq( Nonce(~cv.3), Nonce(~cv.3) ),
              Eq( Nonce(~tkt.1), Nonce(~tkt.1) ), OnlyOnce( 'TPM2_Sign' )
              ]->
               [
               Out_S( $PS.6, $AS.8,
                      <Nonce(~n_J.1), 
                       plus(~r_cv.2,
                            multp(H_n_2(Nonce(~n_J.1),
                                        H_k_1(H_k_4('P1', multp(~f.1, 'P1'), E(~r_cv.2, 'P1'),
                                                    <PkX(~x, 'P2'), PkY(~y, 'P2'), curlyK(~K_1.2), 
                                                     pk(KDF_EK(~TPM_EK_Seed))>))),
                                  ~f.1)), 
                       'ret_TPM2_Sign'>
               )
               ]
