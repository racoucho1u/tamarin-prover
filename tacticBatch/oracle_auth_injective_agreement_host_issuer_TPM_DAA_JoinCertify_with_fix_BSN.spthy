                                                <PkX(~x, 'P2'), PkY(~y, 'P2'), curlyK(~K_1.2), 
                                                 pk(KDF_EK(~TPM_EK_Seed))>))),
                              ~f.1)), 
                   'Issuer_SendChallengeResponse'>
              ),
              Issuer_State_01( 'Issuer', curlyK(~K_1.2),
                               pk(KDF_EK(~TPM_EK_Seed)), <'DAA_public_data', multp(~f.1, 'P1')>
              ),
              !Pk( 'Issuer', PkX(~x, 'P2'), PkY(~y, 'P2') ),
              !Ltk( 'Issuer', ~x, ~y ), Fr( ~r ), Fr( ~l.1 ), Fr( ~s_2 ),
              Fr( ~K_2.1 )
              ]
             --[
             Eq( curlyK(~K_1.2), curlyK(~K_1.2) ),
             Eq( H_n_2(Nonce(~n_J.1),
                       H_k_1(H_k_4('P1', multp(~f.1, 'P1'), E(~r_cv.2, 'P1'),
                                   <PkX(~x, 'P2'), PkY(~y, 'P2'), curlyK(~K_1.2), 
                                    pk(KDF_EK(~TPM_EK_Seed))>))),
                 H_n_2(Nonce(~n_J.1),
                       H_k_1(H_k_4('P1', multp(~f.1, 'P1'), E(~r_cv.2, 'P1'),
                                   <PkX(~x, 'P2'), PkY(~y, 'P2'), curlyK(~K_1.2), 
                                    pk(KDF_EK(~TPM_EK_Seed))>)))
             ),
             Commit( 'Issuer', pk(KDF_EK(~TPM_EK_Seed)), curlyK(~K_1.2) ),
             Running( 'Issuer', pk(KDF_EK(~TPM_EK_Seed)),
                      <multp(~r, 'P1'), multp(~y, multp(~r, 'P1')), 
                       plus(multp(~x, multp(~r, 'P1')),
                            multp(multp(multp(~r, ~x), ~y), multp(~f.1, 'P1'))), 
                       multp(multp(~r, ~y), multp(~f.1, 'P1'))>
             ),
             Alive( 'Issuer' ), Honest( 'Issuer' ),
             Honest( pk(KDF_EK(~TPM_EK_Seed)) ),
             Issuer_VerifyChallengeIssueCredentials( 'Issuer',
                                                     pk(KDF_EK(~TPM_EK_Seed))
             ),
             OnlyOnce( 'Issuer_Verify_Challenge' )
             ]->
              [
              Out( <
                    MAC(<
                         len16(senc(curlyK(~K_2.1),
                                    KDF_a(~s_2, 'STORAGE',
                                          <'SHA256', 
                                           H_SHA256(<'DAA_public_data', multp(~f.1, 'P1')>)>))), 
                         senc(curlyK(~K_2.1),
                              KDF_a(~s_2, 'STORAGE',
                                    <'SHA256', H_SHA256(<'DAA_public_data', multp(~f.1, 'P1')>)>)), 
                         'SHA256', H_SHA256(<'DAA_public_data', multp(~f.1, 'P1')>)>,
                        KDF_a(~s_2, 'INTEGRITY', 'NULL')), 
                    len16(senc(curlyK(~K_2.1),
                               KDF_a(~s_2, 'STORAGE',
                                     <'SHA256', H_SHA256(<'DAA_public_data', multp(~f.1, 'P1')>)
                                     >))), 
                    senc(curlyK(~K_2.1),
                         KDF_a(~s_2, 'STORAGE',
                               <'SHA256', H_SHA256(<'DAA_public_data', multp(~f.1, 'P1')>)>)), 
                    aenc(~s_2, pk(KDF_EK(~TPM_EK_Seed))), 
