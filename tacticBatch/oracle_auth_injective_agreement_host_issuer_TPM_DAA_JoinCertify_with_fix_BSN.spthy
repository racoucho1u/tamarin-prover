                                     <'1', 'SHA256', H_SHA256(<'DAA_public_data', multp(f.2, 'P1')>)
                                     >)), 
                          '1', 'SHA256', H_SHA256(<'DAA_public_data', multp(f.2, 'P1')>)>,
                         KDF_a(<'1', ~s>, 'INTEGRITY', 'NULL')), 
                     len16(senc(<'1', curlyK(~K_1)>,
                                KDF_a(<'1', ~s>, 'STORAGE',
                                      <'1', 'SHA256', 
                                       H_SHA256(<'DAA_public_data', multp(f.2, 'P1')>)>))), 
                     senc(<'1', curlyK(~K_1)>,
                          KDF_a(<'1', ~s>, 'STORAGE',
                                <'1', 'SHA256', H_SHA256(<'DAA_public_data', multp(f.2, 'P1')>)
                                >)), 
                     aenc(<'1', ~s>, pk(KDF_EK(~TPM_EK_Seed))), 'Host_SendChallenge'>
               ),
               Issuer_State_01( 'Issuer', curlyK(~K_1), pk(KDF_EK(~TPM_EK_Seed)),
                                <'DAA_public_data', multp(f.2, 'P1')>
