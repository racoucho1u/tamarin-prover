    #vr.29: instance (modulo AC) Issuer_Check_EK_Send_Challenge:
               [
               In( <pk(KDF_EK(~TPM_EK_Seed)), 
                    <'DAA_public_data', multp(f.2, 'P1')>, 'join_Issuer_1'>
               ),
               Fr( ~K_1.3 ), Fr( ~s.2 ),
               !EK_FOR_ISSUER( pk(KDF_EK(~TPM_EK_Seed)) )
               ]
              --[
              Check_Ek( pk(KDF_EK(~TPM_EK_Seed)) ),
              Check_QPD( <'DAA_public_data', multp(f.2, 'P1')> ),
              Associate( curlyK(~K_1.3), pk(KDF_EK(~TPM_EK_Seed)),
                         <'DAA_public_data', multp(f.2, 'P1')>
              ),
              Alive( 'Issuer' ), Honest( 'Issuer' ),
              Honest( pk(KDF_EK(~TPM_EK_Seed)) ),
              IssuerReceivedKeys( 'Issuer', pk(KDF_EK(~TPM_EK_Seed)),
                                  <'DAA_public_data', multp(f.2, 'P1')>
              ),
              OnlyOnce( 'Issuer_Check_EK_Send_Challenge' )
              ]->
               [
               Out( <
                     MAC(<'1', 
                          len16(senc(<'1', curlyK(~K_1.3)>,
                                     KDF_a(<'1', ~s.2>, 'STORAGE',
                                           <'1', 'SHA256', 
                                            H_SHA256(<'DAA_public_data', multp(f.2, 'P1')>)>))), 
                          senc(<'1', curlyK(~K_1.3)>,
                               KDF_a(<'1', ~s.2>, 'STORAGE',
                                     <'1', 'SHA256', H_SHA256(<'DAA_public_data', multp(f.2, 'P1')>)
                                     >)), 
                          '1', 'SHA256', H_SHA256(<'DAA_public_data', multp(f.2, 'P1')>)>,
                         KDF_a(<'1', ~s.2>, 'INTEGRITY', 'NULL')), 
                     len16(senc(<'1', curlyK(~K_1.3)>,
                                KDF_a(<'1', ~s.2>, 'STORAGE',
                                      <'1', 'SHA256', 
                                       H_SHA256(<'DAA_public_data', multp(f.2, 'P1')>)>))), 
                     senc(<'1', curlyK(~K_1.3)>,
                          KDF_a(<'1', ~s.2>, 'STORAGE',
                                <'1', 'SHA256', H_SHA256(<'DAA_public_data', multp(f.2, 'P1')>)
                                >)), 
                     aenc(<'1', ~s.2>, pk(KDF_EK(~TPM_EK_Seed))), 'Host_SendChallenge'>
               ),
               Issuer_State_01( 'Issuer', curlyK(~K_1.3),
                                pk(KDF_EK(~TPM_EK_Seed)), <'DAA_public_data', multp(f.2, 'P1')>
               )
               ]
