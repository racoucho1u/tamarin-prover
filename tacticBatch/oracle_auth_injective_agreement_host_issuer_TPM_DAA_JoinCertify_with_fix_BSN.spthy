               TPM_CV_E( $PS.4, Nonce(~cv.1), ~r_cv.2 ), Fr( ~n_J )
               ]
              --[
              TPM2_Signed_P_TPM( $PS.4, $AS.4 ),
              Eq( Nonce(~cv.1), Nonce(~cv.1) ), Eq( Nonce(~tkt), Nonce(~tkt) ),
              OnlyOnce( 'TPM2_Sign' )
              ]->
               [
               Out_S( $PS.4, $AS.4,
                      <Nonce(~n_J), 
                       plus(~r_cv.2,
