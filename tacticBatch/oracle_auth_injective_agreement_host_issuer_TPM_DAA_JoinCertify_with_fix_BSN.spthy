              Role( 'Platform' ),
              Secret( pk(KDF_EK(~TPM_EK_Seed.5)), 'Issuer',
                      <multp(~f.1, 'P1'), multp(~y, multp(~f.1, 'P1')), 
                       plus(multp(~x, multp(~f.1, 'P1')),
                            multp(multp(multp(~f.1, ~x), ~y), multp(~f.3, 'P1'))), 
                       multp(multp(~f.1, ~y), multp(~f.3, 'P1'))>
              ),
              Honest( $PS.6 ), Honest( $AS.8 ),
              Honest( pk(KDF_EK(~TPM_EK_Seed.5)) ), Honest( 'Issuer' ),
              OnlyOnce( 'Host_JoinComplete' )
