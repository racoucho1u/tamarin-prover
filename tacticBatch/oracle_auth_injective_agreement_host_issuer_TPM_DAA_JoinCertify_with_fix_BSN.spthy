                         KDF_a(<'1', ~s.1>, 'INTEGRITY', 'NULL')), 
                     len16(senc(<'1', curlyK(~K_1.2)>,
                                KDF_a(<'1', ~s.1>, 'STORAGE',
                                      <'1', 'SHA256', 
                                       H_SHA256(<'DAA_public_data', multp(~f.6, 'P1')>)>))), 
                     senc(<'1', curlyK(~K_1.2)>,
                          KDF_a(<'1', ~s.1>, 'STORAGE',
                                <'1', 'SHA256', H_SHA256(<'DAA_public_data', multp(~f.6, 'P1')>)
