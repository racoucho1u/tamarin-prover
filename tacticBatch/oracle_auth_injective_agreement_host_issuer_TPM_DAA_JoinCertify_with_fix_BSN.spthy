                             curlyK(K_1.8)
               ),
               Host_State_04( $PS.8, $AS.12, pk(KDF_EK(~TPM_EK_Seed.9)),
                              <'DAA_public_data', multp(~f.4, 'P1')>,
                              senc(~f.4, KDF_AES(~TPM_AES_Seed.11)),
                              <PkX(~x, 'P2'), PkY(~y, 'P2'), curlyK(K_1.8), 
                               pk(KDF_EK(~TPM_EK_Seed.9))>
               )
               ]
