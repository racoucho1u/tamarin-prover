           In_S( $PS, $AS, <curlyK(~K_2), 'ret_TPM2_ActivateCredentials_2'> ),
           !Pk( 'Issuer', PkX(~x, 'P2'), PkY(~y, 'P2') ),
           Host_State_06( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)),
                          <'DAA_public_data', multp(~f, 'P1')>,
                          senc(<multp(~x.1, 'P1'), multp(~y, multp(~x.1, 'P1')), 
                                plus(multp(~x, multp(~x.1, 'P1')),
                                     multp(multp(multp(~x.1, ~x), ~y), multp(~f, 'P1'))), 
                                multp(multp(~x.1, ~y), multp(~f, 'P1')), 
                                H_n_8('P1', multp(~f, 'P1'), RB(~l, 'P1'), RD(~l, multp(~f, 'P1')),
                                      multp(~x.1, 'P1'), multp(~y, multp(~x.1, 'P1')),
                                      plus(multp(~x, multp(~x.1, 'P1')),
                                           multp(multp(multp(~x.1, ~x), ~y), multp(~f, 'P1'))),
                                      multp(multp(~x.1, ~y), multp(~f, 'P1'))), 
                                plus(~l,
                                     multp(multp(~y, ~x.1),
                                           H_n_8('P1', multp(~f, 'P1'), RB(~l, 'P1'),
                                                 RD(~l, multp(~f, 'P1')), multp(~x.1, 'P1'),
                                                 multp(~y, multp(~x.1, 'P1')),
                                                 plus(multp(~x, multp(~x.1, 'P1')),
                                                      multp(multp(multp(~x.1, ~x), ~y),
                                                            multp(~f, 'P1'))),
                                                 multp(multp(~x.1, ~y), multp(~f, 'P1')))))
                               >,
                               curlyK(~K_2))
           )
           ]
          --[
          Eq( curlyK(~K_2), curlyK(~K_2) ),
          Eq( H_n_8('P1', multp(~f, 'P1'), RB(~l, 'P1'),
                    RD(~l, multp(~f, 'P1')), multp(~x.1, 'P1'),
                    multp(~y, multp(~x.1, 'P1')),
                    plus(multp(~x, multp(~x.1, 'P1')),
                         multp(multp(multp(~x.1, ~x), ~y), multp(~f, 'P1'))),
                    multp(multp(~x.1, ~y), multp(~f, 'P1'))),
              H_n_8('P1', multp(~f, 'P1'), RB(~l, 'P1'), RD(~l, multp(~f, 'P1')),
                    multp(~x.1, 'P1'), multp(~y, multp(~x.1, 'P1')),
                    plus(multp(~x, multp(~x.1, 'P1')),
                         multp(multp(multp(~x.1, ~x), ~y), multp(~f, 'P1'))),
                    multp(multp(~x.1, ~y), multp(~f, 'P1')))
          ),
          Eq( accept, accept ), Eq( accept, accept ),
          JoinCompleted( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)) ),
          Commit( pk(KDF_EK(~TPM_EK_Seed)), 'Issuer',
                  <multp(~x.1, 'P1'), multp(~y, multp(~x.1, 'P1')), 
                   plus(multp(~x, multp(~x.1, 'P1')),
                        multp(multp(multp(~x.1, ~x), ~y), multp(~f, 'P1'))), 
                   multp(multp(~x.1, ~y), multp(~f, 'P1'))>
          ),
          Role( 'Platform' ),
          Secret( pk(KDF_EK(~TPM_EK_Seed)), 'Issuer',
                  <multp(~x.1, 'P1'), multp(~y, multp(~x.1, 'P1')), 
                   plus(multp(~x, multp(~x.1, 'P1')),
                        multp(multp(multp(~x.1, ~x), ~y), multp(~f, 'P1'))), 
                   multp(multp(~x.1, ~y), multp(~f, 'P1'))>
          ),
          Honest( $PS ), Honest( $AS ), Honest( pk(KDF_EK(~TPM_EK_Seed)) ),
          Honest( 'Issuer' ), OnlyOnce( 'Host_JoinComplete' )
          ]->
           [
           !Host_State_RNDCreds( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)),
                                 multp(~x.1, 'P1'), multp(~y, multp(~x.1, 'P1')),
                                 plus(multp(~x, multp(~x.1, 'P1')),
                                      multp(multp(multp(~x.1, ~x), ~y), multp(~f, 'P1'))),
                                 multp(multp(~x.1, ~y), multp(~f, 'P1'))
           ),
           !Host_Join_Complete( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)) ),
           Host_Org_Creds( $PS, $AS, pk(KDF_EK(~TPM_EK_Seed)),
                           multp(~x.1, 'P1'), multp(~y, multp(~x.1, 'P1')),
                           plus(multp(~x, multp(~x.1, 'P1')),
                                multp(multp(multp(~x.1, ~x), ~y), multp(~f, 'P1'))),
                           multp(multp(~x.1, ~y), multp(~f, 'P1'))
           )
           ]
