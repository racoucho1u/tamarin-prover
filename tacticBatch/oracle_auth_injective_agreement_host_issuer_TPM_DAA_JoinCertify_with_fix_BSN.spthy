                                 RD(~l.1, multp(~f.1, 'P1')), multp(~r, 'P1'),
                                 multp(~y, multp(~r, 'P1')),
                                 plus(multp(~x, multp(~r, 'P1')),
                                      multp(multp(multp(~r, ~x), ~y), multp(~f.1, 'P1'))),
                                 multp(multp(~r, ~y), multp(~f.1, 'P1'))), 
                           plus(~l.1,
                                multp(multp(~y, ~r),
                                      H_n_8('P1', multp(~f.1, 'P1'), RB(~l.1, 'P1'),
                                            RD(~l.1, multp(~f.1, 'P1')), multp(~r, 'P1'),
                                            multp(~y, multp(~r, 'P1')),
                                            plus(multp(~x, multp(~r, 'P1')),
                                                 multp(multp(multp(~r, ~x), ~y),
                                                       multp(~f.1, 'P1'))),
                                            multp(multp(~r, ~y), multp(~f.1, 'P1')))))
                          >,
                          curlyK(~K_2.1)), 
                     'Host_CompleteJoin'>
               )
               ]
              -->
               [
               !KD( <aenc(~s_2, pk(KDF_EK(~TPM_EK_Seed))), 
                     senc(<multp(~r, 'P1'), multp(~y, multp(~r, 'P1')), 
                           plus(multp(~x, multp(~r, 'P1')),
                                multp(multp(multp(~r, ~x), ~y), multp(~f.1, 'P1'))), 
                           multp(multp(~r, ~y), multp(~f.1, 'P1')), 
                           H_n_8('P1', multp(~f.1, 'P1'), RB(~l.1, 'P1'),
                                 RD(~l.1, multp(~f.1, 'P1')), multp(~r, 'P1'),
                                 multp(~y, multp(~r, 'P1')),
                                 plus(multp(~x, multp(~r, 'P1')),
                                      multp(multp(multp(~r, ~x), ~y), multp(~f.1, 'P1'))),
                                 multp(multp(~r, ~y), multp(~f.1, 'P1'))), 
                           plus(~l.1,
                                multp(multp(~y, ~r),
                                      H_n_8('P1', multp(~f.1, 'P1'), RB(~l.1, 'P1'),
                                            RD(~l.1, multp(~f.1, 'P1')), multp(~r, 'P1'),
                                            multp(~y, multp(~r, 'P1')),
                                            plus(multp(~x, multp(~r, 'P1')),
                                                 multp(multp(multp(~r, ~x), ~y),
                                                       multp(~f.1, 'P1'))),
                                            multp(multp(~r, ~y), multp(~f.1, 'P1')))))
                          >,
                          curlyK(~K_2.1)), 
                     'Host_CompleteJoin'>
               )
               ]
    #vf.11: instance (modulo AC) Fresh:
               [ ] --> [ Fr( ~s.1 ) ]
    #vr.11: instance (modulo AC) d_0_fst:
               [
