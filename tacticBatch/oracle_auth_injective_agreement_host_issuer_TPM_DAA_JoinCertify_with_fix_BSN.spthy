               Out( <pk(KDF_EK(~TPM_EK_Seed.1)), 
                     <'DAA_public_data', multp(~f.7, 'P1')>, 'join_Issuer_1'>
               ),
               Host_State_02( $PS.2, $AS.2, pk(KDF_EK(~TPM_EK_Seed.1)),
                              <'DAA_public_data', multp(~f.7, 'P1')>,
                              senc(~f.7, KDF_AES(~TPM_AES_Seed.2))
