    #vr.76: instance (modulo AC) Host_CredentialsReveal:
               [
               Host_Org_Creds( $PS.8, $AS.12, pk(KDF_EK(~TPM_EK_Seed.9)),
                               multp(~f.1, 'P1'), multp(~y, multp(~f.1, 'P1')),
                               plus(multp(~x, multp(~f.1, 'P1')),
                                    multp(multp(multp(~f.1, ~x), ~y), multp(~f.4, 'P1'))),
                               multp(multp(~f.1, ~y), multp(~f.4, 'P1'))
               )
               ]
              --[
              KeyReveal( 'Host_OrgCred_Reveal', $AS.12 ),
              KeyReveal( 'TPM_OrgCred_Reveal', $PS.8 ),
