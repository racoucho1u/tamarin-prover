                             curlyK(K_1.7)
               ),
               Host_State_04( $PS.7, $AS.8, pk(KDF_EK(~TPM_EK_Seed.8)),
                              <'DAA_public_data', multp(~f.11, 'P1')>,
                              senc(~f.11, KDF_AES(~TPM_AES_Seed.10)),
                              <PkX(~x, 'P2'), PkY(~y, 'P2'), curlyK(K_1.7), 
                               pk(KDF_EK(~TPM_EK_Seed.8))>
               )
               ]
    #vr.66: instance (modulo AC) Host_Store_DAA_Key:
               [
               In_S( $PS.6, $AS.8,
                     <senc(~f.10, KDF_AES(~TPM_AES_Seed.9)), 
                      <'DAA_public_data', multp(~f.10, 'P1')>, 'returnDAAKey'>
               ),
