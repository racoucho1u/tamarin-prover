                         <'DAA_public_data', multp(~f.9, 'P1')>
              ),
              Alive( 'Issuer' ), Honest( 'Issuer' ),
              Honest( pk(KDF_EK(~TPM_EK_Seed)) ),
              IssuerReceivedKeys( 'Issuer', pk(KDF_EK(~TPM_EK_Seed)),
                                  <'DAA_public_data', multp(~f.9, 'P1')>
              ),
              OnlyOnce( 'Issuer_Check_EK_Send_Challenge' )
              ]->
               [
               Out( <
                     MAC(<'1', 
                          len16(senc(<'1', curlyK(~K_1.2)>,
                                     KDF_a(<'1', ~s.1>, 'STORAGE',
                                           <'1', 'SHA256', 
                                            H_SHA256(<'DAA_public_data', multp(~f.9, 'P1')>)>))), 
                          senc(<'1', curlyK(~K_1.2)>,
                               KDF_a(<'1', ~s.1>, 'STORAGE',
                                     <'1', 'SHA256', 
                                      H_SHA256(<'DAA_public_data', multp(~f.9, 'P1')>)>)), 
                          '1', 'SHA256', H_SHA256(<'DAA_public_data', multp(~f.9, 'P1')>)>,
                         KDF_a(<'1', ~s.1>, 'INTEGRITY', 'NULL')), 
                     len16(senc(<'1', curlyK(~K_1.2)>,
                                KDF_a(<'1', ~s.1>, 'STORAGE',
                                      <'1', 'SHA256', 
                                       H_SHA256(<'DAA_public_data', multp(~f.9, 'P1')>)>))), 
                     senc(<'1', curlyK(~K_1.2)>,
                          KDF_a(<'1', ~s.1>, 'STORAGE',
                                <'1', 'SHA256', H_SHA256(<'DAA_public_data', multp(~f.9, 'P1')>)
                                >)), 
                     aenc(<'1', ~s.1>, pk(KDF_EK(~TPM_EK_Seed))), 'Host_SendChallenge'>
               ),
               Issuer_State_01( 'Issuer', curlyK(~K_1.2),
                                pk(KDF_EK(~TPM_EK_Seed)), <'DAA_public_data', multp(~f.9, 'P1')>
               )
               ]
