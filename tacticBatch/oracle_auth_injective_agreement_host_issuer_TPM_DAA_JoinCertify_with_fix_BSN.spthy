    #vr.12: instance (modulo AC) Issuer_Check_EK_Send_Challenge:
               [
               In( <pk(KDF_EK(~TPM_EK_Seed)), 
                    <'DAA_public_data', multp(~f.1, 'P1')>, 'join_Issuer_1'>
               ),
               Fr( ~K_1.2 ), Fr( ~s.1 ),
               !EK_FOR_ISSUER( pk(KDF_EK(~TPM_EK_Seed)) )
               ]
              --[
              Check_Ek( pk(KDF_EK(~TPM_EK_Seed)) ),
              Check_QPD( <'DAA_public_data', multp(~f.1, 'P1')> ),
              Associate( curlyK(~K_1.2), pk(KDF_EK(~TPM_EK_Seed)),
                         <'DAA_public_data', multp(~f.1, 'P1')>
              ),
              Alive( 'Issuer' ), Honest( 'Issuer' ),
              Honest( pk(KDF_EK(~TPM_EK_Seed)) ),
              IssuerReceivedKeys( 'Issuer', pk(KDF_EK(~TPM_EK_Seed)),
                                  <'DAA_public_data', multp(~f.1, 'P1')>
              ),
              OnlyOnce( 'Issuer_Check_EK_Send_Challenge' )
              ]->
               [
               Out( <
                     MAC(<'1', 
                          len16(senc(<'1', curlyK(~K_1.2)>,
                                     KDF_a(<'1', ~s.1>, 'STORAGE',
                                           <'1', 'SHA256', 
                                            H_SHA256(<'DAA_public_data', multp(~f.1, 'P1')>)>))), 
                          senc(<'1', curlyK(~K_1.2)>,
                               KDF_a(<'1', ~s.1>, 'STORAGE',
                                     <'1', 'SHA256', 
                                      H_SHA256(<'DAA_public_data', multp(~f.1, 'P1')>)>)), 
                          '1', 'SHA256', H_SHA256(<'DAA_public_data', multp(~f.1, 'P1')>)>,
                         KDF_a(<'1', ~s.1>, 'INTEGRITY', 'NULL')), 
                     len16(senc(<'1', curlyK(~K_1.2)>,
                                KDF_a(<'1', ~s.1>, 'STORAGE',
                                      <'1', 'SHA256', 
                                       H_SHA256(<'DAA_public_data', multp(~f.1, 'P1')>)>))), 
                     senc(<'1', curlyK(~K_1.2)>,
                          KDF_a(<'1', ~s.1>, 'STORAGE',
                                <'1', 'SHA256', H_SHA256(<'DAA_public_data', multp(~f.1, 'P1')>)
                                >)), 
                     aenc(<'1', ~s.1>, pk(KDF_EK(~TPM_EK_Seed))), 'Host_SendChallenge'>
               ),
               Issuer_State_01( 'Issuer', curlyK(~K_1.2),
                                pk(KDF_EK(~TPM_EK_Seed)), <'DAA_public_data', multp(~f.1, 'P1')>
               )
               ]
    #vf.13: instance (modulo AC) Fresh:
               [ ] --> [ Fr( ~x.1 ) ]
    #vr.13: instance (modulo AC) Host_Store_DAA_Key:
               [
               In_S( $PS.1, $AS.1,
                     <senc(~f.3, KDF_AES(~TPM_AES_Seed.1)), 
                      <'DAA_public_data', multp(~f.3, 'P1')>, 'returnDAAKey'>
               ),
               Host_State_01( $PS.1, $AS.1, pk(KDF_EK(~TPM_EK_Seed)) )
               ]
              --[
              Store_DAA( $PS.1, $AS.1 ),
              PlatformSendKeys( $PS.1, $AS.1, pk(KDF_EK(~TPM_EK_Seed)),
                                <'DAA_public_data', multp(~f.3, 'P1')>, 'Issuer'
              ),
              Alive( $AS.1 ), Role( 'Platform' ), Honest( $PS.1 ),
              Honest( $AS.1 ), Honest( pk(KDF_EK(~TPM_EK_Seed)) ),
              Honest( 'Issuer' ), OnlyOnce( 'Host_Store_DAA_Key' )
              ]->
               [
               !EK_FOR_ISSUER( pk(KDF_EK(~TPM_EK_Seed)) ),
               Out( <pk(KDF_EK(~TPM_EK_Seed)), 
                     <'DAA_public_data', multp(~f.3, 'P1')>, 'join_Issuer_1'>
               ),
               Host_State_02( $PS.1, $AS.1, pk(KDF_EK(~TPM_EK_Seed)),
                              <'DAA_public_data', multp(~f.3, 'P1')>,
                              senc(~f.3, KDF_AES(~TPM_AES_Seed.1))
               )
               ]
    #vf.14: instance (modulo AC) Fresh:
               [ ] --> [ Fr( ~l ) ]
    #vr.14: instance (modulo AC) Host_Store_EK:
               [
               In_S( $PS.1, $AS.1,
                     <<'EK_public_data', pk(KDF_EK(~TPM_EK_Seed))>, 'returnEK'>
               )
               ]
              --[ Store_EK( $PS.1, $AS.1 ), OnlyOnce( 'Host_Store_EK' ) ]->
               [
               Out_S( $AS.1, $PS.1, <pk(KDF_EK(~TPM_EK_Seed)), 'createDAAKey'> ),
               Host_State_01( $PS.1, $AS.1, pk(KDF_EK(~TPM_EK_Seed)) )
               ]
    #vf.15: instance (modulo AC) Fresh:
               [ ] --> [ Fr( ~s_2.1 ) ]
    #vr.15: instance (modulo AC) Issuer_Verify_Challenge_Issue_Credentials:
               [
               In( <curlyK(~K_1.4), Nonce(~n_J.1), 
                    H_n_2(Nonce(~n_J.1),
                          H_k_1(H_k_4('P1', multp(~f, 'P1'), E(~r_cv.4, 'P1'),
                                      <PkX(~x, 'P2'), PkY(~y, 'P2'), curlyK(~K_1.4), 
                                       pk(KDF_EK(~TPM_EK_Seed.1))>))), 
                    plus(~r_cv.4,
                         multp(H_n_2(Nonce(~n_J.1),
                                     H_k_1(H_k_4('P1', multp(~f, 'P1'), E(~r_cv.4, 'P1'),
                                                 <PkX(~x, 'P2'), PkY(~y, 'P2'), curlyK(~K_1.4), 
                                                  pk(KDF_EK(~TPM_EK_Seed.1))>))),
                               ~f)), 
                    'Issuer_SendChallengeResponse'>
               ),
               Issuer_State_01( 'Issuer', curlyK(~K_1.4),
                                pk(KDF_EK(~TPM_EK_Seed.1)), <'DAA_public_data', multp(~f, 'P1')>
               ),
               !Pk( 'Issuer', PkX(~x, 'P2'), PkY(~y, 'P2') ),
               !Ltk( 'Issuer', ~x, ~y ), Fr( ~x.1 ), Fr( ~l ), Fr( ~s_2.1 ),
               Fr( ~K_2 )
               ]
              --[
              Eq( curlyK(~K_1.4), curlyK(~K_1.4) ),
              Eq( H_n_2(Nonce(~n_J.1),
                        H_k_1(H_k_4('P1', multp(~f, 'P1'), E(~r_cv.4, 'P1'),
                                    <PkX(~x, 'P2'), PkY(~y, 'P2'), curlyK(~K_1.4), 
                                     pk(KDF_EK(~TPM_EK_Seed.1))>))),
                  H_n_2(Nonce(~n_J.1),
                        H_k_1(H_k_4('P1', multp(~f, 'P1'), E(~r_cv.4, 'P1'),
                                    <PkX(~x, 'P2'), PkY(~y, 'P2'), curlyK(~K_1.4), 
                                     pk(KDF_EK(~TPM_EK_Seed.1))>)))
              ),
              Commit( 'Issuer', pk(KDF_EK(~TPM_EK_Seed.1)), curlyK(~K_1.4) ),
              Running( 'Issuer', pk(KDF_EK(~TPM_EK_Seed.1)),
                       <multp(~x.1, 'P1'), multp(~y, multp(~x.1, 'P1')), 
                        plus(multp(~x, multp(~x.1, 'P1')),
                             multp(multp(multp(~x.1, ~x), ~y), multp(~f, 'P1'))), 
                        multp(multp(~x.1, ~y), multp(~f, 'P1'))>
              ),
              Alive( 'Issuer' ), Honest( 'Issuer' ),
              Honest( pk(KDF_EK(~TPM_EK_Seed.1)) ),
              Issuer_VerifyChallengeIssueCredentials( 'Issuer',
                                                      pk(KDF_EK(~TPM_EK_Seed.1))
              ),
              OnlyOnce( 'Issuer_Verify_Challenge' )
              ]->
               [
               Out( <
                     MAC(<
                          len16(senc(curlyK(~K_2),
                                     KDF_a(~s_2.1, 'STORAGE',
                                           <'SHA256', H_SHA256(<'DAA_public_data', multp(~f, 'P1')>)
                                           >))), 
                          senc(curlyK(~K_2),
                               KDF_a(~s_2.1, 'STORAGE',
                                     <'SHA256', H_SHA256(<'DAA_public_data', multp(~f, 'P1')>)>)), 
                          'SHA256', H_SHA256(<'DAA_public_data', multp(~f, 'P1')>)>,
                         KDF_a(~s_2.1, 'INTEGRITY', 'NULL')), 
                     len16(senc(curlyK(~K_2),
                                KDF_a(~s_2.1, 'STORAGE',
                                      <'SHA256', H_SHA256(<'DAA_public_data', multp(~f, 'P1')>)
                                      >))), 
                     senc(curlyK(~K_2),
                          KDF_a(~s_2.1, 'STORAGE',
                                <'SHA256', H_SHA256(<'DAA_public_data', multp(~f, 'P1')>)>)), 
                     aenc(~s_2.1, pk(KDF_EK(~TPM_EK_Seed.1))), 
                     senc(<multp(~x.1, 'P1'), multp(~y, multp(~x.1, 'P1')), 
                           plus(multp(~x, multp(~x.1, 'P1')),
                                multp(multp(multp(~x.1, ~x), ~y), multp(~f, 'P1'))), 
                           multp(multp(~x.1, ~y), multp(~f, 'P1')), 
                           H_n_8('P1', multp(~f, 'P1'), RB(~l, 'P1'), RD(~l, multp(~f, 'P1')),
                                 multp(~x.1, 'P1'), multp(~y, multp(~x.1, 'P1')),
                                 plus(multp(~x, multp(~x.1, 'P1')),
                                      multp(multp(multp(~x.1, ~x), ~y), multp(~f, 'P1'))),
                                 multp(multp(~x.1, ~y), multp(~f, 'P1'))), 
                           plus(~l,
                                multp(multp(~y, ~x.1),
                                      H_n_8('P1', multp(~f, 'P1'), RB(~l, 'P1'),
                                            RD(~l, multp(~f, 'P1')), multp(~x.1, 'P1'),
                                            multp(~y, multp(~x.1, 'P1')),
                                            plus(multp(~x, multp(~x.1, 'P1')),
                                                 multp(multp(multp(~x.1, ~x), ~y),
                                                       multp(~f, 'P1'))),
                                            multp(multp(~x.1, ~y), multp(~f, 'P1')))))
                          >,
                          curlyK(~K_2)), 
                     'Host_CompleteJoin'>
               )
               ]
