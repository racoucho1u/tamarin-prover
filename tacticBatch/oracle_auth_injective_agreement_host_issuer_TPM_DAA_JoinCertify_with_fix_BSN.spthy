               ]
              --[
              K( <curlyK(~K_1.4), Nonce(n_J.3), 
                  H_n_2(Nonce(n_J.3),
                        H_k_1(H_k_4('P1', multp(f.2, 'P1'), E(r_cv.4, 'P1'),
                                    <PkX(~x, 'P2'), PkY(~y, 'P2'), curlyK(~K_1.4), 
                                     pk(KDF_EK(~TPM_EK_Seed))>))), 
                  plus(r_cv.4,
                       multp(H_n_2(Nonce(n_J.3),
                                   H_k_1(H_k_4('P1', multp(f.2, 'P1'), E(r_cv.4, 'P1'),
                                               <PkX(~x, 'P2'), PkY(~y, 'P2'), curlyK(~K_1.4), 
                                                pk(KDF_EK(~TPM_EK_Seed))>))),
                             f.2)), 
                  'Issuer_SendChallengeResponse'>
              )
              ]->
               [
               In( <curlyK(~K_1.4), Nonce(n_J.3), 
                    H_n_2(Nonce(n_J.3),
                          H_k_1(H_k_4('P1', multp(f.2, 'P1'), E(r_cv.4, 'P1'),
                                      <PkX(~x, 'P2'), PkY(~y, 'P2'), curlyK(~K_1.4), 
                                       pk(KDF_EK(~TPM_EK_Seed))>))), 
                    plus(r_cv.4,
                         multp(H_n_2(Nonce(n_J.3),
                                     H_k_1(H_k_4('P1', multp(f.2, 'P1'), E(r_cv.4, 'P1'),
                                                 <PkX(~x, 'P2'), PkY(~y, 'P2'), curlyK(~K_1.4), 
                                                  pk(KDF_EK(~TPM_EK_Seed))>))),
                               f.2)), 
                    'Issuer_SendChallengeResponse'>
               )
               ]
    #vr.20: instance (modulo AC) d_0_fst:
               [
               !KD( <
                     senc(<multp(~x.1, 'P1'), multp(~y, multp(~x.1, 'P1')), 
                           plus(multp(~x, multp(~x.1, 'P1')),
                                multp(multp(multp(~x.1, ~x), ~y), multp(~f, 'P1'))), 
                           multp(multp(~x.1, ~y), multp(~f, 'P1')), 
                           H_n_8('P1', multp(~f, 'P1'), RB(~l, 'P1'), RD(~l, multp(~f, 'P1')),
                                 multp(~x.1, 'P1'), multp(~y, multp(~x.1, 'P1')),
                                 plus(multp(~x, multp(~x.1, 'P1')),
                                      multp(multp(multp(~x.1, ~x), ~y), multp(~f, 'P1'))),
                                 multp(multp(~x.1, ~y), multp(~f, 'P1'))), 
                           plus(~l,
                                multp(multp(~y, ~x.1),
                                      H_n_8('P1', multp(~f, 'P1'), RB(~l, 'P1'),
                                            RD(~l, multp(~f, 'P1')), multp(~x.1, 'P1'),
                                            multp(~y, multp(~x.1, 'P1')),
                                            plus(multp(~x, multp(~x.1, 'P1')),
                                                 multp(multp(multp(~x.1, ~x), ~y),
                                                       multp(~f, 'P1'))),
                                            multp(multp(~x.1, ~y), multp(~f, 'P1')))))
                          >,
                          curlyK(~K_2)), 
                     'Host_CompleteJoin'>
               )
               ]
              -->
               [
               !KD( senc(<multp(~x.1, 'P1'), multp(~y, multp(~x.1, 'P1')), 
                          plus(multp(~x, multp(~x.1, 'P1')),
                               multp(multp(multp(~x.1, ~x), ~y), multp(~f, 'P1'))), 
                          multp(multp(~x.1, ~y), multp(~f, 'P1')), 
                          H_n_8('P1', multp(~f, 'P1'), RB(~l, 'P1'), RD(~l, multp(~f, 'P1')),
                                multp(~x.1, 'P1'), multp(~y, multp(~x.1, 'P1')),
                                plus(multp(~x, multp(~x.1, 'P1')),
                                     multp(multp(multp(~x.1, ~x), ~y), multp(~f, 'P1'))),
                                multp(multp(~x.1, ~y), multp(~f, 'P1'))), 
                          plus(~l,
                               multp(multp(~y, ~x.1),
                                     H_n_8('P1', multp(~f, 'P1'), RB(~l, 'P1'),
                                           RD(~l, multp(~f, 'P1')), multp(~x.1, 'P1'),
                                           multp(~y, multp(~x.1, 'P1')),
                                           plus(multp(~x, multp(~x.1, 'P1')),
                                                multp(multp(multp(~x.1, ~x), ~y), multp(~f, 'P1'))),
                                           multp(multp(~x.1, ~y), multp(~f, 'P1')))))
                         >,
                         curlyK(~K_2))
               )
               ]
    #vf.21: instance (modulo AC) Fresh:
               [ ] --> [ Fr( ~r.1 ) ]
    #vr.21: instance (modulo AC) Issuer_Check_EK_Send_Challenge:
               [
               In( <pk(KDF_EK(~TPM_EK_Seed.1)), 
                    <'DAA_public_data', multp(~f, 'P1')>, 'join_Issuer_1'>
               ),
               Fr( ~K_1.3 ), Fr( ~s.1 ),
               !EK_FOR_ISSUER( pk(KDF_EK(~TPM_EK_Seed.1)) )
               ]
              --[
              Check_Ek( pk(KDF_EK(~TPM_EK_Seed.1)) ),
              Check_QPD( <'DAA_public_data', multp(~f, 'P1')> ),
              Associate( curlyK(~K_1.3), pk(KDF_EK(~TPM_EK_Seed.1)),
                         <'DAA_public_data', multp(~f, 'P1')>
              ),
              Alive( 'Issuer' ), Honest( 'Issuer' ),
              Honest( pk(KDF_EK(~TPM_EK_Seed.1)) ),
              IssuerReceivedKeys( 'Issuer', pk(KDF_EK(~TPM_EK_Seed.1)),
                                  <'DAA_public_data', multp(~f, 'P1')>
              ),
              OnlyOnce( 'Issuer_Check_EK_Send_Challenge' )
              ]->
               [
               Out( <
                     MAC(<'1', 
                          len16(senc(<'1', curlyK(~K_1.3)>,
                                     KDF_a(<'1', ~s.1>, 'STORAGE',
                                           <'1', 'SHA256', 
                                            H_SHA256(<'DAA_public_data', multp(~f, 'P1')>)>))), 
                          senc(<'1', curlyK(~K_1.3)>,
                               KDF_a(<'1', ~s.1>, 'STORAGE',
                                     <'1', 'SHA256', H_SHA256(<'DAA_public_data', multp(~f, 'P1')>)
                                     >)), 
                          '1', 'SHA256', H_SHA256(<'DAA_public_data', multp(~f, 'P1')>)>,
                         KDF_a(<'1', ~s.1>, 'INTEGRITY', 'NULL')), 
                     len16(senc(<'1', curlyK(~K_1.3)>,
                                KDF_a(<'1', ~s.1>, 'STORAGE',
                                      <'1', 'SHA256', H_SHA256(<'DAA_public_data', multp(~f, 'P1')>)
                                      >))), 
                     senc(<'1', curlyK(~K_1.3)>,
                          KDF_a(<'1', ~s.1>, 'STORAGE',
                                <'1', 'SHA256', H_SHA256(<'DAA_public_data', multp(~f, 'P1')>)>)), 
                     aenc(<'1', ~s.1>, pk(KDF_EK(~TPM_EK_Seed.1))), 'Host_SendChallenge'
                    >
               ),
               Issuer_State_01( 'Issuer', curlyK(~K_1.3),
                                pk(KDF_EK(~TPM_EK_Seed.1)), <'DAA_public_data', multp(~f, 'P1')>
               )
               ]
    #vf.22: instance (modulo AC) Fresh:
               [ ] --> [ Fr( ~l.2 ) ]
    #vr.22: instance (modulo AC) Host_Store_DAA_Key:
               [
               In_S( $PS.2, $AS.2,
                     <senc(~f.6, KDF_AES(~TPM_AES_Seed.2)), 
                      <'DAA_public_data', multp(~f.6, 'P1')>, 'returnDAAKey'>
               ),
               Host_State_01( $PS.2, $AS.2, pk(KDF_EK(~TPM_EK_Seed.1)) )
               ]
              --[
              Store_DAA( $PS.2, $AS.2 ),
              PlatformSendKeys( $PS.2, $AS.2, pk(KDF_EK(~TPM_EK_Seed.1)),
                                <'DAA_public_data', multp(~f.6, 'P1')>, 'Issuer'
              ),
              Alive( $AS.2 ), Role( 'Platform' ), Honest( $PS.2 ),
              Honest( $AS.2 ), Honest( pk(KDF_EK(~TPM_EK_Seed.1)) ),
              Honest( 'Issuer' ), OnlyOnce( 'Host_Store_DAA_Key' )
              ]->
               [
               !EK_FOR_ISSUER( pk(KDF_EK(~TPM_EK_Seed.1)) ),
               Out( <pk(KDF_EK(~TPM_EK_Seed.1)), 
                     <'DAA_public_data', multp(~f.6, 'P1')>, 'join_Issuer_1'>
               ),
               Host_State_02( $PS.2, $AS.2, pk(KDF_EK(~TPM_EK_Seed.1)),
                              <'DAA_public_data', multp(~f.6, 'P1')>,
                              senc(~f.6, KDF_AES(~TPM_AES_Seed.2))
               )
               ]
