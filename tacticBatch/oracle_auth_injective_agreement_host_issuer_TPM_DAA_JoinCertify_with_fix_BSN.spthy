               Out( <multp(~f.1, 'P1'), multp(~y, multp(~f.1, 'P1')), 
                     plus(multp(~x, multp(~f.1, 'P1')),
                          multp(multp(multp(~f.1, ~x), ~y), multp(~f.4, 'P1'))), 
                     multp(multp(~f.1, ~y), multp(~f.4, 'P1'))>
